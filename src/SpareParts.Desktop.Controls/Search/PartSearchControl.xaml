<UserControl x:Class="SpareParts.Desktop.Wpf.PartSearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinWidth="320">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PartSearchInputStyle" TargetType="TextBox">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="White"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FontSize"                 Value="15"/>
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PartResultRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding"         Value="16 12"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="RowBg"
                                    Background="Transparent"
                                    BorderThickness="0 0 0 1"
                                    BorderBrush="#0DFFFFFF"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="AccentBar"
                                    Width="3" HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch"
                                    Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg"     Property="Background" Value="#0DFFFFFF"/>
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBg"     Property="Background" Value="#18FF5722"/>
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PartIconBtnStyle" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="PART"
                   FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0 0 0 6"/>

        <!-- Input pill -->
        <Border Grid.Row="1"
                x:Name="InputPill"
                Background="#FF1A1A22"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Height="52">
            <Grid Margin="14 0 8 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search icon (no selection) -->
                <TextBlock Grid.Column="0" x:Name="SearchIcon"
                           Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0 0 10 0"/>

                <!-- Selected indicator -->
                <StackPanel Grid.Column="0" x:Name="SelectedIndicator"
                            Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0 0 10 0" Visibility="Collapsed">
                    <Ellipse Width="9" Height="9"
                             Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center" Margin="0 0 8 0"/>
                    <TextBlock x:Name="SelectedNameInline"
                               FontSize="14" FontWeight="SemiBold" Foreground="White"
                               VerticalAlignment="Center" MaxWidth="200"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Style="{StaticResource PartSearchInputStyle}"
                         Text="{Binding PartSearchText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                         KeyUp="SearchBox_KeyUp"
                         GotFocus="SearchBox_GotFocus"
                         LostFocus="SearchBox_LostFocus"/>

                <TextBlock x:Name="Placeholder" Grid.Column="1"
                           Text="Scan barcode or type code/name…"
                           FontSize="15" FontFamily="Segoe UI"
                           Foreground="#55FFFFFF"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

                <!-- Clear button -->
                <Button x:Name="ClearBtn" Grid.Column="2"
                        Style="{StaticResource PartIconBtnStyle}"
                        Width="32" Height="32" Margin="6 0"
                        Visibility="Collapsed"
                        Click="ClearPart_Click" ToolTip="Clear part">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>

                <!-- Search button -->
                <Button x:Name="SearchBtn" Grid.Column="2"
                        Style="{StaticResource PartIconBtnStyle}"
                        Width="32" Height="32" Margin="6 0"
                        Click="SearchButton_Click" ToolTip="Search parts">
                    <Border CornerRadius="8" Background="{DynamicResource AccentBrush}" Width="30" Height="30">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>
        </Border>

        <!-- Price sub-label when selected -->
        <TextBlock Grid.Row="2"
                   x:Name="PriceLabel"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="6 4 0 0"
                   Visibility="Hidden"/>

        <!-- Popup
             StaysOpen="True" — we close it manually so clicking inside
             (e.g. on a list item) doesn't dismiss it immediately. -->
        <Popup x:Name="ResultsPopup"
               PlacementTarget="{Binding ElementName=InputPill}"
               Placement="Bottom"
               VerticalOffset="6"
               StaysOpen="True"
               AllowsTransparency="True"
               PopupAnimation="Fade">

            <Border Background="#FF1E1E28"
                    BorderBrush="#33FF5722"
                    BorderThickness="1"
                    CornerRadius="12"
                    MinWidth="{Binding ActualWidth, ElementName=InputPill}"
                    MaxHeight="380"
                    Margin="0 0 6 6" >
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.65" BlurRadius="28" ShadowDepth="10"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Header -->
                    <Border Grid.Row="0"
                            Background="#0DFF5722" BorderBrush="#1AFF5722"
                            BorderThickness="0 0 0 1" CornerRadius="12 12 0 0"
                            Padding="16 10">
                        <DockPanel>
                            <TextBlock Text="PARTS"
                                       FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center" DockPanel.Dock="Left"/>
                            <TextBlock x:Name="CountLabel"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Results -->
                    <ListBox x:Name="ResultsList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding FilteredParts, ElementName=Root}"
                             ItemContainerStyle="{StaticResource PartResultRowStyle}"
                             PreviewMouseLeftButtonUp="ResultItem_Click"
                             KeyDown="ResultsList_KeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding InternalCode}"
                                                   FontSize="13" FontWeight="SemiBold" Foreground="White"/>
                                        <TextBlock FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0 3 0 0" TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding Name}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding OEMNumber}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Barcode}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border Grid.Column="1"
                                            Background="#1AFF5722" BorderBrush="#33FF5722"
                                            BorderThickness="1" CornerRadius="5"
                                            Padding="8 3" VerticalAlignment="Center" Margin="10 0 0 0">
                                        <TextBlock FontSize="12" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   Text="{Binding SalePrice, StringFormat={}{0:N0}}"/>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState" Grid.Row="1"
                                VerticalAlignment="Center" HorizontalAlignment="Center"
                                Margin="0 24" Visibility="Collapsed">
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="32" Foreground="#33FFFFFF" HorizontalAlignment="Center"/>
                        <TextBlock Text="No parts found"
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center" Margin="0 10 0 0"/>
                    </StackPanel>

                    <!-- Footer hint -->
                    <Border Grid.Row="2" BorderBrush="#1AFFFFFF" BorderThickness="0 1 0 0"
                            Padding="16 8" CornerRadius="0 0 12 12">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#1AFFFFFF" CornerRadius="3" Padding="5 2" Margin="0 0 5 0">
                                <TextBlock Text="↵" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <TextBlock Text="select   " FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="#1AFFFFFF" CornerRadius="3" Padding="5 2" Margin="0 0 5 0">
                                <TextBlock Text="Esc" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <TextBlock Text="close" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Popup>

    </Grid>
</UserControl>
