<UserControl x:Class="SpareParts.Desktop.Wpf.RoleSearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpareParts.Desktop.Wpf"
             x:Name="Root"
             MinWidth="200">
    <UserControl.Resources>
        <Style x:Key="RoleInputStyle" TargetType="TextBox">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="White"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FontSize"                 Value="15"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoleRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding"         Value="16 14"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="RowBg" Background="Transparent"
                                    BorderThickness="0 0 0 1" BorderBrush="#0DFFFFFF"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch" Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg"     Property="Background" Value="#0DFFFFFF"/>
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBg"     Property="Background" Value="#18FF5722"/>
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="RoleIconBtnStyle" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <Border x:Name="InputPill" Background="#FF1A1A22"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Height="52">
            <Grid Margin="14 0 8 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="RoleIcon"
                           Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0 0 10 0"/>

                <StackPanel Grid.Column="0" x:Name="SelectedIndicator"
                            Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0 0 10 0" Visibility="Collapsed">
                    <Border x:Name="RoleBadge" CornerRadius="5" Padding="8 3" Margin="0 0 8 0">
                        <TextBlock x:Name="SelectedRoleText" FontSize="13" FontWeight="Bold"/>
                    </Border>
                </StackPanel>

                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Style="{StaticResource RoleInputStyle}"
                         Text="{Binding RoleSearchText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                         KeyUp="SearchBox_KeyUp" GotFocus="SearchBox_GotFocus"/>

                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Choose a role…"
                           FontSize="15" Foreground="#55FFFFFF"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>

                <Button x:Name="ClearBtn" Grid.Column="2" Style="{StaticResource RoleIconBtnStyle}"
                        Width="32" Height="32" Margin="6 0" Visibility="Collapsed"
                        Click="ClearRole_Click">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>

                <Button x:Name="DropBtn" Grid.Column="2" Style="{StaticResource RoleIconBtnStyle}"
                        Width="32" Height="32" Margin="6 0" Click="DropBtn_Click">
                    <Border CornerRadius="8" Background="{DynamicResource AccentBrush}" Width="30" Height="30">
                        <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="11"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>
        </Border>

        <!-- StaysOpen="True" — closed manually -->
        <Popup x:Name="ResultsPopup"
               PlacementTarget="{Binding ElementName=InputPill}"
               Placement="Bottom" VerticalOffset="6"
               StaysOpen="True"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#FF1E1E28" BorderBrush="#33FF5722" BorderThickness="1"
                    CornerRadius="12"
                    MinWidth="{Binding ActualWidth, ElementName=InputPill}"
                    Margin="0 0 6 6">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.65" BlurRadius="28" ShadowDepth="10"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="#0DFF5722" BorderBrush="#1AFF5722"
                            BorderThickness="0 0 0 1" CornerRadius="12 12 0 0" Padding="16 10">
                        <TextBlock Text="SELECT ROLE" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>

                    <!-- NO <ListBox.Items> here — ItemsSource set in code-behind -->
                    <ListBox x:Name="ResultsList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             ItemContainerStyle="{StaticResource RoleRowStyle}"
                             MouseDoubleClick="ResultItem_DoubleClick"
                             KeyDown="ResultsList_KeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="{Binding BadgeColor}"
                                            CornerRadius="5" Padding="10 4" Margin="0 0 14 0"
                                            VerticalAlignment="Center" MinWidth="70" HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                                   Foreground="{Binding BadgeTextColor}"
                                                   HorizontalAlignment="Center"/>
                                    </Border>
                                    <TextBlock Grid.Column="1" Text="{Binding Description}"
                                               FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Border Grid.Row="2" BorderBrush="#1AFFFFFF" BorderThickness="0 1 0 0"
                            CornerRadius="0 0 12 12" Padding="12 10"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Margin="0 0 8 0"
                                    Background="#FF1A1A22"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="6">
                                <TextBox x:Name="NewRoleBox"
                                         Height="32" Padding="8 0"
                                         FontSize="13" Background="Transparent"
                                         Foreground="White"
                                         CaretBrush="{DynamicResource AccentBrush}"
                                         BorderThickness="0"
                                         VerticalContentAlignment="Center"
                                         KeyDown="NewRoleBox_KeyDown">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox">
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="TextBox">
                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center"/>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Border>
                            <Button Grid.Column="1" Content="＋ Add Role"
                                    Click="AddRole_Click"
                                    Height="32" Padding="12 0"
                                    FontSize="12" FontWeight="SemiBold"
                                    Foreground="White" Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="Bd" CornerRadius="6"
                                                Background="{DynamicResource AccentBrush}"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"
                                                              TextBlock.Foreground="White"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Opacity" Value="0.85"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
