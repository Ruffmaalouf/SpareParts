<UserControl x:Class="SpareParts.Desktop.Wpf.WarehouseSearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root"
             MinWidth="240">
    <UserControl.Resources>
        <Style x:Key="WhSearchInputStyle" TargetType="TextBox">
            <Setter Property="Background"               Value="Transparent"/>
            <Setter Property="Foreground"               Value="White"/>
            <Setter Property="CaretBrush"               Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness"          Value="0"/>
            <Setter Property="FontSize"                 Value="15"/>
            <Setter Property="FontFamily"               Value="Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                  Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WhRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding"         Value="16 12"/>
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid>
                            <Border x:Name="RowBg" Background="Transparent"
                                    BorderThickness="0 0 0 1" BorderBrush="#0DFFFFFF"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter/>
                            </Border>
                            <Border x:Name="AccentBar" Width="3" HorizontalAlignment="Left"
                                    VerticalAlignment="Stretch" Background="Transparent"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="RowBg"     Property="Background" Value="#0DFFFFFF"/>
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="RowBg"     Property="Background" Value="#18FF5722"/>
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WhIconBtnStyle" TargetType="Button">
            <Setter Property="Background"       Value="Transparent"/>
            <Setter Property="BorderThickness"  Value="0"/>
            <Setter Property="Cursor"           Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock Text="WAREHOUSE" FontSize="11" FontWeight="Bold" FontFamily="Segoe UI"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 6"/>

        <Border x:Name="InputPill" Background="#FF1A1A22"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                CornerRadius="10" Height="52">
            <Grid Margin="14 0 8 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" x:Name="WSearchIcon"
                           Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="0 0 10 0"/>

                <StackPanel Grid.Column="0" x:Name="SelectedIndicator"
                            Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="0 0 10 0" Visibility="Collapsed">
                    <Ellipse Width="9" Height="9" Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center" Margin="0 0 8 0"/>
                    <TextBlock x:Name="SelectedNameInline" FontSize="14" FontWeight="SemiBold"
                               Foreground="White" VerticalAlignment="Center"
                               MaxWidth="160" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <TextBox x:Name="SearchBox" Grid.Column="1"
                         Style="{StaticResource WhSearchInputStyle}"
                         Text="{Binding WarehouseSearchText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                         KeyUp="SearchBox_KeyUp" GotFocus="SearchBox_GotFocus"/>

                <TextBlock x:Name="Placeholder" Grid.Column="1" Text="Type warehouse name…"
                           FontSize="15" FontFamily="Segoe UI" Foreground="#55FFFFFF"
                           VerticalAlignment="Center" IsHitTestVisible="False"/>

                <Button x:Name="ClearBtn" Grid.Column="2" Style="{StaticResource WhIconBtnStyle}"
                        Width="32" Height="32" Margin="6 0" Visibility="Collapsed"
                        Click="ClearWarehouse_Click" ToolTip="Clear">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Button>

                <Button x:Name="SearchBtn" Grid.Column="2" Style="{StaticResource WhIconBtnStyle}"
                        Width="32" Height="32" Margin="6 0"
                        Click="SearchButton_Click" ToolTip="Search warehouses">
                    <Border CornerRadius="8" Background="{DynamicResource AccentBrush}" Width="30" Height="30">
                        <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>
        </Border>

        <!-- StaysOpen="True" — closed manually on outside click -->
        <Popup x:Name="ResultsPopup"
               PlacementTarget="{Binding ElementName=InputPill}"
               Placement="Bottom" VerticalOffset="6"
               StaysOpen="True"
               AllowsTransparency="True" PopupAnimation="Fade">
            <Border Background="#FF1E1E28" BorderBrush="#33FF5722" BorderThickness="1"
                    CornerRadius="12"
                    MinWidth="{Binding ActualWidth, ElementName=InputPill}"
                    MaxHeight="300" Margin="0 0 6 6">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.65" BlurRadius="28" ShadowDepth="10"/>
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#0DFF5722" BorderBrush="#1AFF5722"
                            BorderThickness="0 0 0 1" CornerRadius="12 12 0 0" Padding="16 10">
                        <TextBlock Text="WAREHOUSES" FontSize="11" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                    <ListBox x:Name="ResultsList" Grid.Row="1"
                             Background="Transparent" BorderThickness="0"
                             ItemsSource="{Binding FilteredWarehouses, ElementName=Root}"
                             ItemContainerStyle="{StaticResource WhRowStyle}"
                             PreviewMouseLeftButtonUp="ResultItem_Click"
                             KeyDown="ResultsList_KeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding Name}"
                                               FontSize="14" FontWeight="SemiBold" Foreground="White"/>
                                    <Border Grid.Column="1" Background="#1AFF5722" BorderBrush="#33FF5722"
                                            BorderThickness="1" CornerRadius="5" Padding="8 3"
                                            VerticalAlignment="Center" Margin="10 0 0 0">
                                        <TextBlock FontSize="11" Foreground="{DynamicResource AccentBrush}" FontWeight="Bold">
                                            <Run Text="#"/><Run Text="{Binding Id}"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
