<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- THEME: Squadra Corse / Lamborghini SC (Giallo Yellow) — palette only; shared control templates live in Themes/Shared/PerformanceThemeTemplate.xaml -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SpareParts.Desktop.Wpf;component/Themes/Shared/PerformanceThemeTemplate.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Brushes — using element syntax (no Color= attribute) to avoid BAML parse issues -->
    <SolidColorBrush x:Key="AppBackgroundBrush">#090909</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackgroundBrush">#131313</SolidColorBrush>
    <SolidColorBrush x:Key="CardHighlightBrush">#1E1E1E</SolidColorBrush>
    <SolidColorBrush x:Key="CardBgBrush">#131313</SolidColorBrush>
    <SolidColorBrush x:Key="CardBgSoftBrush">#1E1E1E</SolidColorBrush>
    <SolidColorBrush x:Key="CardBorderBrush">#22FFD600</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#FFD600</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBlueBrush">#FFC400</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimaryBrush">#F5F5F0</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush">#888878</SolidColorBrush>
    <SolidColorBrush x:Key="BorderBrush">#22FFD600</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderOverlayBrush">#AA090909</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderCardBrush">#131313</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderBorderBrush">#FFD600</SolidColorBrush>
    <Color x:Key="ColorSportOrange">#FFD600</Color>
    <Color x:Key="ColorMatteBlack">#090909</Color>
    <Color x:Key="ColorGunmetal">#131313</Color>
    <Color x:Key="ColorSlate">#1E1E1E</Color>
    <Color x:Key="ColorChrome">#F5F5F0</Color>
    <Color x:Key="ColorMuted">#888878</Color>

    <!-- Text color drawn on top of AccentBrush (e.g. PrimaryButtonStyle) -->
    <SolidColorBrush x:Key="AccentForegroundBrush">#090909</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush">#FFE033</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush">#CCAA00</SolidColorBrush>

    <!-- Mid-gradient stop color for RacingStripeBrush (defined in the shared template) -->
    <Color x:Key="RacingStripeMidColor">#FF998200</Color>

</ResourceDictionary>
