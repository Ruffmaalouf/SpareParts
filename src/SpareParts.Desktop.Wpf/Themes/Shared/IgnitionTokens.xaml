<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        IGNITION DESIGN TOKENS (Report 02 "Visual Design System" §13 — cross-platform token mapping).

        One key per token, 1:1 with the web CSS custom properties (Ig-prefixed here) and the
        React Native theme.js entries. This dictionary is merged by:
          1. Themes/IgnitionTheme.xaml            — the selectable app-wide Ignition theme, and
          2. the Ignition views (dashboard/client workspace) — so those screens always render
             with the correct Ignition tokens regardless of which theme is currently active.

        Do not rename keys — the cross-platform token audit checks these names verbatim.
    -->

    <!-- Backgrounds / carbon elevation steps -->
    <SolidColorBrush x:Key="IgBrushCanvas">#0A0A0B</SolidColorBrush>
    <SolidColorBrush x:Key="IgBrushSurface">#131316</SolidColorBrush>
    <SolidColorBrush x:Key="IgBrushElevated">#1B1B1F</SolidColorBrush>
    <SolidColorBrush x:Key="IgBrushElevated2">#232328</SolidColorBrush>

    <!-- Border -->
    <SolidColorBrush x:Key="IgBrushBorder">#26262B</SolidColorBrush>

    <!-- Text -->
    <SolidColorBrush x:Key="IgBrushTextPrimary">#FAFAFA</SolidColorBrush>
    <SolidColorBrush x:Key="IgBrushTextSecondary">#A1A1AA</SolidColorBrush>
    <SolidColorBrush x:Key="IgBrushTextMuted">#6B6B74</SolidColorBrush>

    <!-- Accent (brake-caliper orange — one use per screen) -->
    <SolidColorBrush x:Key="IgBrushAccent">#F97316</SolidColorBrush>
    <SolidColorBrush x:Key="IgBrushAccentHover">#EA580C</SolidColorBrush>

    <!-- Semantic -->
    <SolidColorBrush x:Key="IgBrushSuccess">#22C55E</SolidColorBrush>
    <SolidColorBrush x:Key="IgBrushWarning">#FBBF24</SolidColorBrush>
    <SolidColorBrush x:Key="IgBrushDanger">#EF4444</SolidColorBrush>
    <SolidColorBrush x:Key="IgBrushInfo">#38BDF8</SolidColorBrush>

    <!-- Typography. Plus Jakarta Sans / Inter / JetBrains Mono per spec; each falls back to an
         always-installed Windows face until the .ttf files are packaged as app resources. -->
    <FontFamily x:Key="IgFontDisplay">Plus Jakarta Sans, Segoe UI</FontFamily>
    <FontFamily x:Key="IgFontBody">Inter, Segoe UI</FontFamily>
    <FontFamily x:Key="IgFontMono">JetBrains Mono, Consolas</FontFamily>

    <!-- Geometry -->
    <CornerRadius x:Key="IgCornerRadiusLg">16</CornerRadius>
    <CornerRadius x:Key="IgCornerRadiusPill">999</CornerRadius>

    <!-- Elevation shadow L1 -->
    <DropShadowEffect x:Key="IgShadowL1" Color="#000000" BlurRadius="14" ShadowDepth="3" Opacity="0.35"/>

    <!-- Spacing -->
    <Thickness x:Key="IgSpace4">16</Thickness>

    <!-- Motion -->
    <Duration x:Key="IgDurationBase">0:0:0.22</Duration>

    <!-- Layout -->
    <GridLength x:Key="IgRailWidth">72</GridLength>

</ResourceDictionary>
