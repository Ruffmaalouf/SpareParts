<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Cockpit Control Center design system (WPF)
         Mirrors the approved web/mobile cockpit design. All resources are
         prefixed "Ck" and use new keys, so merging this dictionary does NOT
         retheme existing screens; views opt in by referencing these keys.
         ============================================================ -->

    <!-- ===== Palette ===== -->
    <Color x:Key="CkBgColor">#FF070708</Color>
    <Color x:Key="CkPanelColor">#FF121217</Color>
    <Color x:Key="CkPanel2Color">#FF16161C</Color>
    <Color x:Key="CkBorderColor">#FF24242C</Color>
    <Color x:Key="CkRedColor">#FFFF3B3B</Color>
    <Color x:Key="CkOrangeColor">#FFFF8A3D</Color>
    <Color x:Key="CkTextColor">#FFF4F4F7</Color>
    <Color x:Key="CkMutedColor">#FF8C8C9C</Color>
    <Color x:Key="CkMuted2Color">#FF5D5D6D</Color>
    <Color x:Key="CkGreenColor">#FF2BDB8F</Color>

    <SolidColorBrush x:Key="CkBgBrush" Color="{StaticResource CkBgColor}"/>
    <SolidColorBrush x:Key="CkPanelBrush" Color="{StaticResource CkPanelColor}"/>
    <SolidColorBrush x:Key="CkPanel2Brush" Color="{StaticResource CkPanel2Color}"/>
    <SolidColorBrush x:Key="CkBorderBrush" Color="{StaticResource CkBorderColor}"/>
    <SolidColorBrush x:Key="CkRedBrush" Color="{StaticResource CkRedColor}"/>
    <SolidColorBrush x:Key="CkOrangeBrush" Color="{StaticResource CkOrangeColor}"/>
    <SolidColorBrush x:Key="CkTextBrush" Color="{StaticResource CkTextColor}"/>
    <SolidColorBrush x:Key="CkMutedBrush" Color="{StaticResource CkMutedColor}"/>
    <SolidColorBrush x:Key="CkMuted2Brush" Color="{StaticResource CkMuted2Color}"/>
    <SolidColorBrush x:Key="CkGreenBrush" Color="{StaticResource CkGreenColor}"/>

    <LinearGradientBrush x:Key="CkAccentBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF7A44" Offset="0"/>
        <GradientStop Color="#FFFF3B3B" Offset="0.6"/>
        <GradientStop Color="#FFE02A30" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CkRailBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#FF0B0B0E" Offset="0"/>
        <GradientStop Color="#FF060608" Offset="0.55"/>
        <GradientStop Color="#FF0A0709" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CkSidebarBrush" StartPoint="0,0" EndPoint="0.2,1">
        <GradientStop Color="#FF101015" Offset="0"/>
        <GradientStop Color="#FF0B0B0F" Offset="0.5"/>
        <GradientStop Color="#FF08080B" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="CkCardBrush" StartPoint="0,0" EndPoint="0.3,1">
        <GradientStop Color="#FF16161C" Offset="0"/>
        <GradientStop Color="#FF0C0C0F" Offset="0.65"/>
    </LinearGradientBrush>

    <!-- ============================================================
         Core semantic-brush OVERRIDES.
         This dictionary is merged LAST in App.xaml, so re-defining the
         shared semantic keys here repaints the entire existing desktop
         UI (sidebar, header, cards, grids, inputs) with the cockpit
         palette without touching the 7k-line MainWindow markup — every
         consumer reads these via DynamicResource.
         ============================================================ -->
    <Color x:Key="ColorRaceBlack">#FF070708</Color>
    <Color x:Key="ColorPitLane">#FF121217</Color>
    <Color x:Key="ColorCabin">#FF16161C</Color>
    <Color x:Key="ColorCockpit">#FF16161C</Color>
    <Color x:Key="ColorRacingRed">#FFFF3B3B</Color>
    <Color x:Key="ColorRedHot">#FFFF7A44</Color>
    <Color x:Key="ColorRedDeep">#FFE02A30</Color>
    <Color x:Key="ColorTextWhite">#FFF4F4F7</Color>
    <Color x:Key="ColorTextDim">#FF5D5D6D</Color>
    <Color x:Key="ColorTextMid">#FF8C8C9C</Color>
    <Color x:Key="ColorSportOrange">#FFFF8A3D</Color>
    <Color x:Key="ColorNeonGreen">#FF2BDB8F</Color>
    <Color x:Key="ColorCarbonLine">#FF24242C</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush"  Color="#FF070708"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FF121217"/>
    <SolidColorBrush x:Key="CardHighlightBrush"  Color="#FF16161C"/>
    <SolidColorBrush x:Key="AccentBrush"         Color="#FFE2231A"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"    Color="#FFF4F4F7"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"  Color="#FF8C8C9C"/>
    <SolidColorBrush x:Key="BorderBrush"         Color="#FF24242C"/>
    <SolidColorBrush x:Key="CardBorderBrush"     Color="#FF24242C"/>
    <SolidColorBrush x:Key="CardBgBrush"         Color="#FF121217"/>
    <SolidColorBrush x:Key="CardBgSoftBrush"     Color="#FF16161C"/>
    <SolidColorBrush x:Key="AccentBlueBrush"     Color="#FFFF3B3B"/>
    <SolidColorBrush x:Key="AccentGreenBrush"    Color="#FF2BDB8F"/>
    <SolidColorBrush x:Key="AccentOrangeBrush"   Color="#FFFF8A3D"/>
    <SolidColorBrush x:Key="FocusRingBrush"      Color="#FFFF7A44"/>

    <LinearGradientBrush x:Key="RacingStripeBrush" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFF7A44" Offset="0"/>
        <GradientStop Color="#FFFF3B3B" Offset="0.6"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="SidebarAccentLineBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="Transparent" Offset="0"/>
        <GradientStop Color="#FFFF7A44"   Offset="0.15"/>
        <GradientStop Color="#FFFF3B3B"   Offset="0.85"/>
        <GradientStop Color="Transparent" Offset="1"/>
    </LinearGradientBrush>

    <DropShadowEffect x:Key="RedGlowEffect"
                      Color="#FFFF4628"
                      BlurRadius="22"
                      ShadowDepth="0"
                      Opacity="0.55"/>

    <!-- ===== Card / panel ===== -->
    <Style x:Key="CkPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource CkCardBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CkBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="18"/>
        <Setter Property="Padding" Value="19"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="26" ShadowDepth="8" Opacity="0.45"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== KPI card ===== -->
    <Style x:Key="CkKpiCardStyle" TargetType="Border" BasedOn="{StaticResource CkPanelStyle}">
        <Setter Property="CornerRadius" Value="17"/>
        <Setter Property="Padding" Value="15 15 14 12"/>
    </Style>
    <Style x:Key="CkKpiLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CkMuted2Brush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="CkKpiValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CkTextBrush}"/>
        <Setter Property="FontSize" Value="20"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="Margin" Value="0 3 0 0"/>
    </Style>
    <Style x:Key="CkKpiDeltaStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource CkGreenBrush}"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0 5 0 0"/>
    </Style>

    <!-- ===== Sidebar nav item ===== -->
    <Style x:Key="CkNavItemStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{StaticResource CkMutedBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="13 11"/>
        <Setter Property="Margin" Value="0 0 0 3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="ActiveBar" Width="3.5" HorizontalAlignment="Left" CornerRadius="3"
                                Margin="-6 6 0 6" Background="{StaticResource CkAccentBrush}" Opacity="0"/>
                        <Border x:Name="NavRoot" CornerRadius="12" Background="Transparent"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"/>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="NavRoot" Property="Background" Value="#14FFFFFF"/>
                            <Setter Property="Foreground" Value="{StaticResource CkTextBrush}"/>
                        </Trigger>
                        <Trigger Property="Tag" Value="Active">
                            <Setter TargetName="NavRoot" Property="Background" Value="#33FF5A2D"/>
                            <Setter TargetName="ActiveBar" Property="Opacity" Value="1"/>
                            <Setter Property="Foreground" Value="{StaticResource CkTextBrush}"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Primary (New Sale) button ===== -->
    <Style x:Key="CkPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Padding" Value="20 11"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" CornerRadius="13" Background="{StaticResource CkAccentBrush}"
                            Padding="{TemplateBinding Padding}">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFFF4628" BlurRadius="22" ShadowDepth="0" Opacity="0.6"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="0.92"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Search / input box ===== -->
    <Style x:Key="CkSearchBoxStyle" TargetType="TextBox">
        <Setter Property="Foreground" Value="{StaticResource CkTextBrush}"/>
        <Setter Property="CaretBrush" Value="{StaticResource CkOrangeBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16 12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" CornerRadius="12" Background="#FF0B0B0E"
                            BorderBrush="{StaticResource CkBorderBrush}" BorderThickness="1">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource CkOrangeBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== DataGrid (Parts & Inventory) ===== -->
    <Style x:Key="CkDataGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="#FF101014"/>
        <Setter Property="Foreground" Value="{StaticResource CkMutedBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="12 10"/>
        <Setter Property="BorderBrush" Value="{StaticResource CkBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
    </Style>
    <Style x:Key="CkDataGridRowStyle" TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource CkTextBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0DFFFFFF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#26FF5A2D"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CkDataGridCellStyle" TargetType="DataGridCell">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="12 9"/>
        <Setter Property="FontSize" Value="12.5"/>
        <Setter Property="Foreground" Value="{StaticResource CkTextBrush}"/>
    </Style>
    <Style x:Key="CkDataGridStyle" TargetType="DataGrid">
        <Setter Property="Background" Value="{StaticResource CkPanelBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource CkBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="RowBackground" Value="Transparent"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#FF1A1A20"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
        <Setter Property="AutoGenerateColumns" Value="False"/>
        <Setter Property="CanUserAddRows" Value="False"/>
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="ColumnHeaderStyle" Value="{StaticResource CkDataGridColumnHeaderStyle}"/>
        <Setter Property="RowStyle" Value="{StaticResource CkDataGridRowStyle}"/>
        <Setter Property="CellStyle" Value="{StaticResource CkDataGridCellStyle}"/>
    </Style>

    <!-- ===== Stock status pill (DataGrid tag) ===== -->
    <Style x:Key="CkStockPillStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="9 4"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="Background" Value="#1F2BDB8F"/>
    </Style>

    <!-- ===== Fade/slide-in animation for dashboard cards ===== -->
    <Storyboard x:Key="CkCardFadeIn">
        <DoubleAnimation Storyboard.TargetProperty="Opacity"
                         From="0" To="1" Duration="0:0:0.35"/>
        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                         From="14" To="0" Duration="0:0:0.35">
            <DoubleAnimation.EasingFunction>
                <CubicEase EasingMode="EaseOut"/>
            </DoubleAnimation.EasingFunction>
        </DoubleAnimation>
    </Storyboard>

</ResourceDictionary>
