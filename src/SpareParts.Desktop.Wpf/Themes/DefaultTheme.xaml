<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Color x:Key="ColorMatteBlack">#FF121212</Color>
    <Color x:Key="ColorGunmetal">#FF1E1E24</Color>
    <Color x:Key="ColorSlate">#FF2B2B36</Color>

    <Color x:Key="ColorSportOrange">#FFFF5722</Color>
    <Color x:Key="ColorChrome">#FFE0E0E0</Color>
    <Color x:Key="ColorMuted">#FF9E9EA5</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush" Color="{StaticResource ColorMatteBlack}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{StaticResource ColorGunmetal}"/>
    <SolidColorBrush x:Key="CardHighlightBrush" Color="{StaticResource ColorSlate}"/>

    <SolidColorBrush x:Key="AccentBrush"
                 Color="{StaticResource ColorSportOrange}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource ColorChrome}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource ColorMuted}"/>

    <SolidColorBrush x:Key="BorderBrush" Color="#33FFFFFF"/>

    <!-- 🔧 added: base card border + car tile brushes -->
    <SolidColorBrush x:Key="CardBorderBrush" Color="#22FFFFFF"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="{StaticResource ColorGunmetal}"/>
    <SolidColorBrush x:Key="CardBgSoftBrush" Color="{StaticResource ColorSlate}"/>
    <SolidColorBrush x:Key="AccentBlueBrush" Color="#FF42A5F5"/>

  

    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style TargetType="TextBox">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="Padding" Value="4 8"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="CaretBrush" Value="{StaticResource AccentBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#0DFFFFFF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="BrandTileStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="6"/>
        <Setter Property="Width" Value="100"/>
        <Setter Property="Height" Value="100"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Container" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="12"
                            BorderThickness="1"
                            BorderBrush="#1AFFFFFF">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.3"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Container" Property="Background" Value="{StaticResource CardHighlightBrush}"/>
                            <Setter TargetName="Container" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="Container" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="{StaticResource ColorSportOrange}" BlurRadius="15" ShadowDepth="0" Opacity="0.4"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="Padding" Value="20 10"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdr" 
                            CornerRadius="6" 
                            Background="{TemplateBinding Background}">
                        <Border.Effect>
                            <DropShadowEffect Color="#FFD84315" BlurRadius="10" ShadowDepth="2" Opacity="0.4"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="#FFFF7043"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="#FFBF360C"/>
                            <Setter TargetName="bdr" Property="Effect" Value="{x:Null}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16 8"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdr" 
                            CornerRadius="6" 
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" 
                                          VerticalAlignment="Center" 
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="#1AFFFFFF"/>
                            <Setter TargetName="bdr" Property="BorderBrush" Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="GridLinesVisibility" Value="Horizontal"/>
        <Setter Property="HorizontalGridLinesBrush" Value="#1AFFFFFF"/>
        <Setter Property="VerticalGridLinesBrush" Value="Transparent"/>
        <Setter Property="RowHeight" Value="40"/>
        <Setter Property="HeadersVisibility" Value="Column"/>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontWeight" Value="Normal"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="10 0"/>
        <Setter Property="Height" Value="30"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontSize" Value="14"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#0DFFFFFF"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#1AFFFFFF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="10 0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="CarTileStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource CardBgSoftBrush}"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Margin" Value="10"/>
        <Setter Property="Width" Value="250"/>
        <Setter Property="Height" Value="200"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Container" 
                            Background="{TemplateBinding Background}" 
                            CornerRadius="10"
                            BorderThickness="1"
                            Padding="15"
                            BorderBrush="#1AFFFFFF">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" Height="100" CornerRadius="8" Background="#FF1E293B" Margin="0 0 0 10">
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" HorizontalAlignment="Center" 
                                           FontSize="14" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Opacity="0.5"/>
                            </Border>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16"/>
                                <TextBlock Text="{Binding BasePrice, StringFormat=C}" Foreground="{StaticResource AccentBlueBrush}" FontWeight="SemiBold" Margin="0 4 0 0"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Container" Property="Background" Value="{StaticResource CardBgBrush}"/>
                            <Setter TargetName="Container" Property="BorderBrush" Value="{StaticResource AccentBlueBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="NeonScrollArrowStyle" TargetType="RepeatButton">
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Focusable" Value="False"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.9"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Opacity" Value="0.6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- CLEAN SCROLLBAR (NO CYAN GLOW) -->
    <Style x:Key="NeonScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="OverridesDefaultStyle" Value="True"/>
        <Setter Property="Width" Value="12"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="#151515">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- UP ARROW BUTTON -->
                        <RepeatButton Grid.Row="0"
                                      Command="ScrollBar.LineUpCommand"
                                      Style="{StaticResource NeonScrollArrowStyle}">
                            <Path Data="M 5 0 L 0 5 L 10 5 Z"
                                  Fill="{StaticResource AccentBrush}"/>
                        </RepeatButton>

                        <!-- TRACK + THUMB -->
                        <Track x:Name="PART_Track" Grid.Row="1">
                            <Track.Thumb>
                                <Thumb Width="12" Height="30">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="6"
                                                    Background="{StaticResource CardHighlightBrush}"
                                                    BorderBrush="{StaticResource AccentBrush}"
                                                    BorderThickness="1"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>

                        <!-- DOWN ARROW BUTTON -->
                        <RepeatButton Grid.Row="2"
                                      Command="ScrollBar.LineDownCommand"
                                      Style="{StaticResource NeonScrollArrowStyle}">
                            <Path Data="M 0 0 L 10 0 L 5 5 Z"
                                  Fill="{StaticResource AccentBrush}"/>
                        </RepeatButton>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ThemeComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <!-- Hover = same highlight as cards -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd"
                                Property="Background"
                                Value="{StaticResource CardHighlightBrush}" />
                        </Trigger>

                        <!-- Selected = highlight + accent text -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd"
                                Property="Background"
                                Value="{StaticResource CardHighlightBrush}" />
                            <Setter Property="Foreground"
                                Value="{StaticResource AccentBrush}" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Theme selector ComboBox: full custom template, no cyan -->
    <Style x:Key="ThemeComboBoxStyle" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ThemeComboBoxItemStyle}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <!-- Clickable main area -->
                        <ToggleButton x:Name="PART_ToggleButton"
                                  Background="Transparent"
                                  BorderThickness="0"
                                  Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                  ClickMode="Press">
                            <Border x:Name="Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Selected text -->
                                    <ContentPresenter Grid.Column="0"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Left"
                                                  Margin="0,0,4,0" />

                                    <!-- Arrow, vertically centered -->
                                    <Path Grid.Column="1"
                                      Data="M0,0 L4,4 8,0 Z"
                                      Fill="{TemplateBinding Foreground}"
                                      Width="10"
                                      Height="10"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Center"
                                      Margin="0,0,6,0"/>
                                </Grid>
                            </Border>
                        </ToggleButton>

                        <!-- Dropdown popup -->
                        <Popup x:Name="PART_Popup"
                           Placement="Bottom"
                           PlacementTarget="{Binding ElementName=PART_ToggleButton}"
                           IsOpen="{TemplateBinding IsDropDownOpen}"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Slide">
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="2">
                                <ScrollViewer MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <StackPanel IsItemsHost="True"/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Hover on closed combo -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border"
                                Property="Background"
                                Value="{StaticResource CardHighlightBrush}"/>
                            <Setter TargetName="Border"
                                Property="BorderBrush"
                                Value="{StaticResource AccentBrush}"/>
                        </Trigger>

                        <!-- Focus outline -->
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Border"
                                Property="BorderBrush"
                                Value="{StaticResource AccentBrush}"/>
                        </Trigger>

                        <!-- Disabled -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin" Value="0,6,0,6"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border Background="Transparent">
                        <Border x:Name="OuterBorder"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="10"
                            BorderBrush="{StaticResource CardHighlightBrush}"
                            BorderThickness="1"
                            Padding="8">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- HEADER -->
                                <ToggleButton x:Name="HeaderSite"
                                          Grid.Row="0"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          FocusVisualStyle="{x:Null}"
                                          Cursor="Hand"
                                          OverridesDefaultStyle="True"
                                          IsChecked="{Binding IsExpanded,
                                                              Mode=TwoWay,
                                                              RelativeSource={RelativeSource TemplatedParent}}">

                                    <!-- FULLY CUSTOM TOGGLEBUTTON TEMPLATE -->
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Header text (GERMAN / KOREAN / JAPANESE) -->
                                                <ContentPresenter Grid.Column="0"
                                                              VerticalAlignment="Center"
                                                              Margin="2,0,0,0"
                                                              RecognizesAccessKey="True"
                                                              TextElement.FontSize="12"
                                                              TextElement.FontWeight="Bold"
                                                              TextElement.Foreground="{StaticResource TextSecondaryBrush}" />

                                                <!-- Arrow -->
                                                <Path x:Name="Arrow"
                                                  Grid.Column="1"
                                                  Data="M 0 0 L 6 4 L 12 0"
                                                  Stroke="{StaticResource AccentBrush}"
                                                  StrokeThickness="1.5"
                                                  Margin="8,0,0,0"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center">
                                                    <Path.RenderTransform>
                                                        <RotateTransform Angle="0"
                                                                     CenterX="6"
                                                                     CenterY="2"/>
                                                    </Path.RenderTransform>
                                                </Path>
                                            </Grid>

                                            <!-- LOCAL TRIGGERS: ARROW + HOVER (NO OS THEME) -->
                                            <ControlTemplate.Triggers>
                                                <!-- Rotate arrow when expanded -->
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow"
                                                        Property="RenderTransform">
                                                        <Setter.Value>
                                                            <RotateTransform Angle="180"
                                                                         CenterX="6"
                                                                         CenterY="2"/>
                                                        </Setter.Value>
                                                    </Setter>
                                                </Trigger>

                                                <!-- Optional: header hover effect -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Arrow"
                                                        Property="Stroke"
                                                        Value="{StaticResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>

                                    <!-- Feed Expander.Header text into ToggleButton -->
                                    <ToggleButton.Content>
                                        <TextBlock Text="{TemplateBinding Header}"
                                               FontSize="12"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                    </ToggleButton.Content>
                                </ToggleButton>

                                <!-- CONTENT -->
                                <ContentPresenter x:Name="ExpandSite"
                                              Grid.Row="1"
                                              Margin="0,8,0,0"
                                              Visibility="Collapsed"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                            </Grid>
                        </Border>
                    </Border>

                    <!-- EXPANDER TRIGGERS -->
                    <ControlTemplate.Triggers>

                        <!-- Expanded: show content + highlight card -->
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite"
                                Property="Visibility"
                                Value="Visible"/>
                            <Setter TargetName="OuterBorder"
                                Property="BorderBrush"
                                Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="OuterBorder"
                                Property="Background"
                                Value="{StaticResource CardHighlightBrush}"/>
                        </Trigger>

                        <!-- Hover: card-style glow (no cyan) -->
                        <Trigger SourceName="HeaderSite" Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder"
                                Property="Background"
                                Value="{StaticResource CardHighlightBrush}"/>
                            <Setter TargetName="OuterBorder"
                                Property="BorderBrush"
                                Value="{StaticResource AccentBrush}"/>
                        </Trigger>

                        <!-- Pressed -->
                        <Trigger SourceName="HeaderSite" Property="IsPressed" Value="True">
                            <Setter TargetName="OuterBorder"
                                Property="Background"
                                Value="{StaticResource AppBackgroundBrush}"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>