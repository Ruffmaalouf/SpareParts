<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- THEME: Porsche RS (Guards Red) — palette only; shared control templates live in Themes/Shared/PerformanceThemeTemplate.xaml -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SpareParts.Desktop.Wpf;component/Themes/Shared/PerformanceThemeTemplate.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Brushes — using element syntax (no Color= attribute) to avoid BAML parse issues -->
    <SolidColorBrush x:Key="AppBackgroundBrush">#0C0C0E</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackgroundBrush">#181818</SolidColorBrush>
    <SolidColorBrush x:Key="CardHighlightBrush">#222222</SolidColorBrush>
    <SolidColorBrush x:Key="CardBgBrush">#181818</SolidColorBrush>
    <SolidColorBrush x:Key="CardBgSoftBrush">#222222</SolidColorBrush>
    <SolidColorBrush x:Key="CardBorderBrush">#22E30613</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#E30613</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBlueBrush">#FF6B6B</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimaryBrush">#F2F2F2</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush">#888888</SolidColorBrush>
    <SolidColorBrush x:Key="BorderBrush">#22E30613</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderOverlayBrush">#AA0C0C0E</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderCardBrush">#181818</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderBorderBrush">#E30613</SolidColorBrush>
    <Color x:Key="ColorSportOrange">#E30613</Color>
    <Color x:Key="ColorMatteBlack">#0C0C0E</Color>
    <Color x:Key="ColorGunmetal">#181818</Color>
    <Color x:Key="ColorSlate">#222222</Color>
    <Color x:Key="ColorChrome">#F2F2F2</Color>
    <Color x:Key="ColorMuted">#888888</Color>

    <!-- Text color drawn on top of AccentBrush (e.g. PrimaryButtonStyle) -->
    <SolidColorBrush x:Key="AccentForegroundBrush">White</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush">#FF1A28</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush">#AA0010</SolidColorBrush>

    <!-- Mid-gradient stop color for RacingStripeBrush (defined in the shared template) -->
    <Color x:Key="RacingStripeMidColor">#FF880008</Color>

</ResourceDictionary>
