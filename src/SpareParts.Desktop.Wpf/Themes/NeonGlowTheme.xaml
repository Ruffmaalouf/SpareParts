<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- THEME: Neon Glow (Electric Cyan) — palette only; shared control templates live in Themes/Shared/PerformanceThemeTemplate.xaml -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SpareParts.Desktop.Wpf;component/Themes/Shared/PerformanceThemeTemplate.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Brushes — using element syntax (no Color= attribute) to avoid BAML parse issues -->
    <SolidColorBrush x:Key="AppBackgroundBrush">#080810</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackgroundBrush">#0D0D1A</SolidColorBrush>
    <SolidColorBrush x:Key="CardHighlightBrush">#141428</SolidColorBrush>
    <SolidColorBrush x:Key="CardBgBrush">#0D0D1A</SolidColorBrush>
    <SolidColorBrush x:Key="CardBgSoftBrush">#141428</SolidColorBrush>
    <SolidColorBrush x:Key="CardBorderBrush">#2200E5FF</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#00E5FF</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBlueBrush">#00B0FF</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimaryBrush">#E0F7FA</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush">#4DD0E1</SolidColorBrush>
    <SolidColorBrush x:Key="BorderBrush">#2200E5FF</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderOverlayBrush">#AA080810</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderCardBrush">#0D0D1A</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderBorderBrush">#00E5FF</SolidColorBrush>
    <Color x:Key="ColorSportOrange">#00E5FF</Color>
    <Color x:Key="ColorMatteBlack">#080810</Color>
    <Color x:Key="ColorGunmetal">#0D0D1A</Color>
    <Color x:Key="ColorSlate">#141428</Color>
    <Color x:Key="ColorChrome">#E0F7FA</Color>
    <Color x:Key="ColorMuted">#4DD0E1</Color>

    <!-- Text color drawn on top of AccentBrush (e.g. PrimaryButtonStyle) -->
    <SolidColorBrush x:Key="AccentForegroundBrush">#080810</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush">#40EFFF</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush">#00B8D4</SolidColorBrush>

    <!-- Mid-gradient stop color for RacingStripeBrush (defined in the shared template) -->
    <Color x:Key="RacingStripeMidColor">#FF007A8C</Color>

</ResourceDictionary>
