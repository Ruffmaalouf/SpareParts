<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- APEX WORKSHOP THEME — Light workspace / Black sidebar / Orange accent -->

    <!-- Color Primitives -->
    <Color x:Key="ColorWorkspace">#FFF0EEEA</Color>
    <Color x:Key="ColorSurface">#FFFFFFFF</Color>
    <Color x:Key="ColorSurface2">#FFE8E6E1</Color>
    <Color x:Key="ColorInput">#FFF8F7F4</Color>
    <Color x:Key="ColorSidebar">#FF111110</Color>
    <Color x:Key="ColorSidebarHover">#FF1E1E1C</Color>
    <Color x:Key="ColorAccent">#FFD4500C</Color>
    <Color x:Key="ColorAccentHover">#FFBF4510</Color>
    <Color x:Key="ColorDanger">#FFDC2626</Color>
    <Color x:Key="ColorSuccess">#FF16A34A</Color>
    <Color x:Key="ColorAmber">#FFB45309</Color>
    <Color x:Key="ColorText">#FF1A1917</Color>
    <Color x:Key="ColorMuted">#FF706D67</Color>
    <Color x:Key="ColorSoft">#FFA09D98</Color>
    <Color x:Key="ColorLine">#FFDEDCD7</Color>
    <Color x:Key="ColorLineBright">#FFC8C6C0</Color>

    <!-- Surface Brushes -->
    <SolidColorBrush x:Key="AppBackgroundBrush"    Color="{StaticResource ColorWorkspace}"/>
    <SolidColorBrush x:Key="CardBackgroundBrush"   Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="CardHighlightBrush"    Color="{StaticResource ColorSurface2}"/>
    <SolidColorBrush x:Key="CardElevatedBrush"     Color="{StaticResource ColorInput}"/>
    <SolidColorBrush x:Key="AccentBrush"           Color="{StaticResource ColorAccent}"/>
    <SolidColorBrush x:Key="AccentDimBrush"        Color="{StaticResource ColorAccentHover}"/>
    <SolidColorBrush x:Key="AccentVioletBrush"     Color="#FF7C5CFC"/>
    <SolidColorBrush x:Key="TextPrimaryBrush"      Color="{StaticResource ColorText}"/>
    <SolidColorBrush x:Key="TextSecondaryBrush"    Color="{StaticResource ColorMuted}"/>
    <SolidColorBrush x:Key="TextSoftBrush"         Color="{StaticResource ColorSoft}"/>
    <SolidColorBrush x:Key="BorderBrush"           Color="{StaticResource ColorLineBright}"/>
    <SolidColorBrush x:Key="CardBorderBrush"       Color="{StaticResource ColorLine}"/>
    <SolidColorBrush x:Key="CardBgBrush"           Color="{StaticResource ColorSurface}"/>
    <SolidColorBrush x:Key="CardBgSoftBrush"       Color="{StaticResource ColorSurface2}"/>
    <SolidColorBrush x:Key="AccentBlueBrush"       Color="#FF7C5CFC"/>
    <SolidColorBrush x:Key="DangerBrush"           Color="{StaticResource ColorDanger}"/>
    <SolidColorBrush x:Key="SuccessBrush"          Color="{StaticResource ColorSuccess}"/>

    <!-- Sidebar-specific brushes (inverted for dark sidebar) -->
    <SolidColorBrush x:Key="SidebarBackgroundBrush"    Color="{StaticResource ColorSidebar}"/>
    <SolidColorBrush x:Key="SidebarTextBrush"          Color="#FFF7F6F4"/>
    <SolidColorBrush x:Key="SidebarMutedBrush"         Color="#806E6B68"/>
    <SolidColorBrush x:Key="SidebarBorderBrush"        Color="#14FFFFFF"/>
    <SolidColorBrush x:Key="SidebarHoverBrush"         Color="#0DFFFFFF"/>
    <SolidColorBrush x:Key="SidebarActiveBrush"        Color="{StaticResource ColorAccent}"/>

    <!-- Preloader -->
    <SolidColorBrush x:Key="PreloaderOverlayBrush">#CCF0EEEA</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderCardBrush">#FFFFFFFF</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderBorderBrush">#FFD4500C</SolidColorBrush>

    <!-- ── Global TextBlock ── -->
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe UI Variable, Segoe UI, sans-serif"/>
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal"/>
    </Style>

    <!-- ── TextBox — boxed light style ── -->
    <Style TargetType="TextBox">
        <Setter Property="Background"               Value="{StaticResource CardElevatedBrush}"/>
        <Setter Property="Foreground"               Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness"          Value="1.5"/>
        <Setter Property="Padding"                  Value="10 0"/>
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="Height"                   Value="38"/>
        <Setter Property="CaretBrush"               Value="{StaticResource AccentBrush}"/>
        <Setter Property="SelectionBrush"           Value="#33D4500C"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="bdr"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="bdr" Property="Background"  Value="{StaticResource CardBackgroundBrush}"/>
                            <Setter TargetName="bdr" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FFD4500C" BlurRadius="8" ShadowDepth="0" Opacity="0.18"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource TextSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bdr" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── PasswordBox ── -->
    <Style TargetType="PasswordBox">
        <Setter Property="Background"               Value="{StaticResource CardElevatedBrush}"/>
        <Setter Property="Foreground"               Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush"              Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness"          Value="1.5"/>
        <Setter Property="Padding"                  Value="10 0"/>
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="Height"                   Value="38"/>
        <Setter Property="CaretBrush"               Value="{StaticResource AccentBrush}"/>
        <Setter Property="SelectionBrush"           Value="#33D4500C"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="bdr"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="6">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="bdr" Property="Background"  Value="{StaticResource CardBackgroundBrush}"/>
                            <Setter TargetName="bdr" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FFD4500C" BlurRadius="8" ShadowDepth="0" Opacity="0.18"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource TextSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bdr" Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Primary Button ── -->
    <Style x:Key="PrimaryButtonStyle" TargetType="Button">
        <Setter Property="Background"  Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Foreground"  Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="Padding"     Value="20 0"/>
        <Setter Property="Height"      Value="40"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdr" CornerRadius="8"
                            Background="{TemplateBinding Background}">
                        <Border.Effect>
                            <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="2" Opacity="0.12"/>
                        </Border.Effect>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground"                  Value="White"/>
                            <Setter TargetName="bdr" Property="Effect">
                                <Setter.Value>
                                    <DropShadowEffect Color="#FFD4500C" BlurRadius="14" ShadowDepth="0" Opacity="0.35"/>
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="{StaticResource AccentDimBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bdr" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Secondary Button ── -->
    <Style x:Key="SecondaryButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding"         Value="16 0"/>
        <Setter Property="Height"          Value="38"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdr" CornerRadius="8"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter TargetName="bdr" Property="Background"  Value="{StaticResource AppBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="{StaticResource CardHighlightBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bdr" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Danger Button ── -->
    <Style x:Key="DangerButtonStyle" TargetType="Button">
        <Setter Property="Background"  Value="{StaticResource DangerBrush}"/>
        <Setter Property="Foreground"  Value="White"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="Padding"     Value="18 0"/>
        <Setter Property="Height"      Value="38"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdr" CornerRadius="8" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="#FFB91C1C"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bdr" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Ghost Button ── -->
    <Style x:Key="GhostButtonStyle" TargetType="Button">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Foreground"      Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding"         Value="10 0"/>
        <Setter Property="Height"          Value="34"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="bdr" CornerRadius="6"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource TextPrimaryBrush}"/>
                            <Setter Property="Foreground"                   Value="{StaticResource TextPrimaryBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── DataGrid ── -->
    <Style TargetType="DataGrid">
        <Setter Property="Background"               Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="Foreground"               Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderThickness"          Value="0"/>
        <Setter Property="RowBackground"            Value="Transparent"/>
        <Setter Property="AlternatingRowBackground" Value="Transparent"/>
        <Setter Property="HorizontalGridLinesBrush" Value="Transparent"/>
        <Setter Property="VerticalGridLinesBrush"   Value="Transparent"/>
        <Setter Property="GridLinesVisibility"      Value="None"/>
        <Setter Property="ColumnHeaderHeight"       Value="38"/>
        <Setter Property="RowHeight"                Value="46"/>
        <Setter Property="FontSize"                 Value="13"/>
        <Setter Property="SelectionMode"            Value="Single"/>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="#0CD4500C"/>
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="BorderBrush" Value="#22D4500C"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background"      Value="{StaticResource AppBackgroundBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextSoftBrush}"/>
        <Setter Property="FontSize"        Value="10"/>
        <Setter Property="FontWeight"      Value="Bold"/>
        <Setter Property="Padding"         Value="14 10"/>
        <Setter Property="BorderBrush"     Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1.5"/>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="Padding"         Value="14 8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Background="{TemplateBinding Background}" BorderThickness="0"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ── Scrollbar ── -->
    <Style x:Key="ApexScrollArrow" TargetType="RepeatButton">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Focusable"       Value="False"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent"/>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ApexScrollBar" TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Width"      Value="5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <RepeatButton x:Name="DecreaseButton" Grid.Row="0" Width="5" Height="5"
                                      Command="ScrollBar.LineUpCommand"
                                      Style="{StaticResource ApexScrollArrow}"/>
                        <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                            <Track.Thumb>
                                <Thumb x:Name="ScrollThumb" Width="5" MinHeight="32">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border CornerRadius="3"
                                                    Background="{StaticResource BorderBrush}"
                                                    Opacity="0.7"/>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                        </Track>
                        <RepeatButton x:Name="IncreaseButton" Grid.Row="2" Width="5" Height="5"
                                      Command="ScrollBar.LineDownCommand"
                                      Style="{StaticResource ApexScrollArrow}"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Orientation" Value="Horizontal">
                            <Setter TargetName="DecreaseButton" Property="Grid.Row"    Value="1"/>
                            <Setter TargetName="DecreaseButton" Property="Grid.Column" Value="0"/>
                            <Setter TargetName="DecreaseButton" Property="Command"     Value="ScrollBar.LineLeftCommand"/>
                            <Setter TargetName="PART_Track"     Property="Grid.Row"    Value="1"/>
                            <Setter TargetName="PART_Track"     Property="Grid.Column" Value="1"/>
                            <Setter TargetName="PART_Track"     Property="IsDirectionReversed" Value="False"/>
                            <Setter TargetName="ScrollThumb"    Property="Width"       Value="32"/>
                            <Setter TargetName="ScrollThumb"    Property="Height"      Value="5"/>
                            <Setter TargetName="ScrollThumb"    Property="MinWidth"    Value="32"/>
                            <Setter TargetName="ScrollThumb"    Property="MinHeight"   Value="5"/>
                            <Setter TargetName="IncreaseButton" Property="Grid.Row"    Value="1"/>
                            <Setter TargetName="IncreaseButton" Property="Grid.Column" Value="2"/>
                            <Setter TargetName="IncreaseButton" Property="Command"     Value="ScrollBar.LineRightCommand"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width"  Value="Auto"/>
                <Setter Property="Height" Value="5"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="ScrollBar" BasedOn="{StaticResource ApexScrollBar}"/>

    <!-- ── ComboBox ── -->
    <Style x:Key="ThemeComboBoxItemStyle" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background" Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="Padding"    Value="10 6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#0CD4500C"/>
                            <Setter Property="Foreground"                 Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBox">
        <Setter Property="Background"           Value="{StaticResource CardElevatedBrush}"/>
        <Setter Property="Foreground"           Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush"          Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness"      Value="1.5"/>
        <Setter Property="Padding"              Value="10 0"/>
        <Setter Property="FontSize"             Value="13"/>
        <Setter Property="Height"               Value="38"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="bdr"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="30"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                <Path Grid.Column="1" Data="M 0 0 L 5 5 L 10 0"
                                      Stroke="{StaticResource TextSoftBrush}"
                                      StrokeThickness="1.5" Fill="Transparent"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True" Focusable="False">
                            <Border MinWidth="{TemplateBinding ActualWidth}"
                                    MaxHeight="280"
                                    Background="{StaticResource CardBackgroundBrush}"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1.5" CornerRadius="8"
                                    Margin="0 4 0 0">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="20" ShadowDepth="4" Opacity="0.14"/>
                                </Border.Effect>
                                <ScrollViewer>
                                    <ItemsPresenter/>
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource TextSoftBrush}"/>
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="bdr" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="bdr" Property="Opacity" Value="0.45"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Resources>
            <Style TargetType="ComboBoxItem" BasedOn="{StaticResource ThemeComboBoxItemStyle}"/>
        </Style.Resources>
    </Style>

    <!-- ── ListBox ── -->
    <Style TargetType="ListBox">
        <Setter Property="Background"      Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding"         Value="4"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                            <ItemsPresenter/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Padding"         Value="10 8"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="bdr" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}" CornerRadius="4"
                            Margin="0 1">
                        <ContentPresenter VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="bdr" Property="Background" Value="#0CD4500C"/>
                            <Setter Property="Foreground"                  Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── ProgressBar ── -->
    <Style TargetType="ProgressBar">
        <Setter Property="Background"      Value="{StaticResource CardHighlightBrush}"/>
        <Setter Property="Foreground"      Value="{StaticResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Height"          Value="6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border x:Name="Track" Background="{TemplateBinding Background}" CornerRadius="3">
                        <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}"
                                HorizontalAlignment="Left" CornerRadius="3">
                            <Border.Effect>
                                <DropShadowEffect Color="#FFD4500C" BlurRadius="6" ShadowDepth="0" Opacity="0.4"/>
                            </Border.Effect>
                        </Border>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── CheckBox ── -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="FontSize"    Value="13"/>
        <Setter Property="Cursor"      Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="18"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="box" Grid.Column="0"
                                Width="16" Height="16" CornerRadius="4"
                                Background="Transparent"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1.5">
                            <Path x:Name="check" Data="M 2 8 L 6 12 L 14 4"
                                  Stroke="White" StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed"/>
                        </Border>
                        <ContentPresenter Grid.Column="1" Margin="8 0 0 0"
                                          VerticalAlignment="Center"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="box"   Property="Background"  Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="box"   Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="check" Property="Visibility"  Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Toggle Switch ── -->
    <Style x:Key="ToggleSwitchStyle" TargetType="ToggleButton">
        <Setter Property="Cursor"  Value="Hand"/>
        <Setter Property="Width"   Value="40"/>
        <Setter Property="Height"  Value="22"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="track" CornerRadius="11"
                            Background="{StaticResource CardHighlightBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1.5">
                        <Border x:Name="thumb" Width="14" Height="14"
                                CornerRadius="7" Margin="2 0"
                                HorizontalAlignment="Left"
                                Background="{StaticResource TextSoftBrush}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="track" Property="Background"  Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="track" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter TargetName="thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="thumb" Property="Background"  Value="White"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── TabControl / TabItem ── -->
    <Style TargetType="TabControl">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground"      Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="Padding"         Value="16 10"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Cursor"          Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}"
                            BorderThickness="0 0 0 2.5" BorderBrush="Transparent">
                        <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource AppBackgroundBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                            <Setter Property="Foreground"                  Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Separator ── -->
    <Style TargetType="Separator">
        <Setter Property="Background"  Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="Height"      Value="1"/>
        <Setter Property="Margin"      Value="0 6"/>
    </Style>

    <!-- ── Expander ── -->
    <Style x:Key="SectionExpanderStyle" TargetType="Expander">
        <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Margin"     Value="0 6"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border x:Name="OuterBorder"
                            Background="{StaticResource CardBackgroundBrush}"
                            CornerRadius="10"
                            BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1.5"
                            Padding="8">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderSite" Grid.Row="0"
                                          Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}"
                                          Cursor="Hand">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="4 8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ContentPresenter Grid.Column="0" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="Arrow" Grid.Column="1" Text="›"
                                                           FontSize="16" Foreground="{StaticResource TextSoftBrush}"
                                                           VerticalAlignment="Center" Margin="8 0 0 0"/>
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="Text"       Value="⌄"/>
                                                <Setter TargetName="Arrow" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter ContentSource="Header"/>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Grid.Row="1"
                                              Margin="0 8 0 0" Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite"  Property="Visibility"  Value="Visible"/>
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        </Trigger>
                        <Trigger SourceName="HeaderSite" Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="Background"  Value="{StaticResource AppBackgroundBrush}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Typography ── -->
    <Style x:Key="HeadingLargeStyle" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="26"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="HeadingMediumStyle" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="18"/>
        <Setter Property="FontWeight"  Value="SemiBold"/>
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="SectionLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="10"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="Foreground"  Value="{StaticResource TextSoftBrush}"/>
    </Style>

    <Style x:Key="MutedTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize"    Value="12"/>
    </Style>

    <Style x:Key="AccentValueStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontSize"    Value="18"/>
        <Setter Property="FontWeight"  Value="Bold"/>
    </Style>

    <Style x:Key="PriceTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
        <Setter Property="FontSize"    Value="20"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="FontFamily"  Value="Consolas, Courier New"/>
    </Style>

    <Style x:Key="MetricValueStyle" TargetType="TextBlock">
        <Setter Property="FontSize"    Value="28"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="Foreground"  Value="{StaticResource TextPrimaryBrush}"/>
    </Style>

    <Style x:Key="MetricLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextSoftBrush}"/>
        <Setter Property="FontSize"    Value="10"/>
        <Setter Property="FontWeight"  Value="Bold"/>
    </Style>

    <Style x:Key="InputLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="{StaticResource TextSecondaryBrush}"/>
        <Setter Property="FontSize"    Value="11"/>
        <Setter Property="FontWeight"  Value="Bold"/>
        <Setter Property="Margin"      Value="0 0 0 5"/>
    </Style>

    <!-- ── Cards ── -->
    <Style x:Key="KpiCardStyle" TargetType="Border">
        <Setter Property="CornerRadius"    Value="10"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush"     Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="Background"      Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="Padding"         Value="18 16"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="2" Opacity="0.07"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="SectionCardStyle" TargetType="Border">
        <Setter Property="CornerRadius"    Value="10"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush"     Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="Background"      Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="Padding"         Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="Black" BlurRadius="10" ShadowDepth="1" Opacity="0.06"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="ElevatedCardStyle" TargetType="Border">
        <Setter Property="CornerRadius"    Value="12"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="BorderBrush"     Value="{StaticResource AccentBrush}"/>
        <Setter Property="Background"      Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="Padding"         Value="20"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect Color="#FFD4500C" BlurRadius="20" ShadowDepth="0" Opacity="0.12"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ── Status badges ── -->
    <Style x:Key="BadgeAvailableStyle" TargetType="Border">
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Padding"         Value="8 3"/>
        <Setter Property="Background"      Value="#0C22C55E"/>
        <Setter Property="BorderBrush"     Value="#2216A34A"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="BadgeReservedStyle" TargetType="Border">
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Padding"         Value="8 3"/>
        <Setter Property="Background"      Value="#0CF59E0B"/>
        <Setter Property="BorderBrush"     Value="#22B45309"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="BadgeSoldStyle" TargetType="Border">
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Padding"         Value="8 3"/>
        <Setter Property="Background"      Value="#08706D67"/>
        <Setter Property="BorderBrush"     Value="#20706D67"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="BadgeDangerStyle" TargetType="Border">
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="Padding"         Value="8 3"/>
        <Setter Property="Background"      Value="#0CDC2626"/>
        <Setter Property="BorderBrush"     Value="#22DC2626"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style x:Key="BadgeTextAvailableStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="#15803D"/>
        <Setter Property="FontSize"    Value="10"/>
        <Setter Property="FontWeight"  Value="Bold"/>
    </Style>

    <Style x:Key="BadgeTextReservedStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="#B45309"/>
        <Setter Property="FontSize"    Value="10"/>
        <Setter Property="FontWeight"  Value="Bold"/>
    </Style>

    <Style x:Key="BadgeTextDangerStyle" TargetType="TextBlock">
        <Setter Property="Foreground"  Value="#B91C1C"/>
        <Setter Property="FontSize"    Value="10"/>
        <Setter Property="FontWeight"  Value="Bold"/>
    </Style>

    <!-- ── Utility styles ── -->
    <Style x:Key="AccentTagStyle" TargetType="Border">
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"     Value="#22D4500C"/>
        <Setter Property="Background"      Value="#0CD4500C"/>
        <Setter Property="Padding"         Value="8 3"/>
    </Style>

    <Style x:Key="SuccessTagStyle" TargetType="Border">
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"     Value="#2216A34A"/>
        <Setter Property="Background"      Value="#0C16A34A"/>
        <Setter Property="Padding"         Value="8 3"/>
    </Style>

    <Style x:Key="WarningTagStyle" TargetType="Border">
        <Setter Property="CornerRadius"    Value="6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="BorderBrush"     Value="#22B45309"/>
        <Setter Property="Background"      Value="#0CB45309"/>
        <Setter Property="Padding"         Value="8 3"/>
    </Style>

    <Style x:Key="ToolbarStripStyle" TargetType="Border">
        <Setter Property="Background"      Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="BorderBrush"     Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1.5"/>
        <Setter Property="Padding"         Value="14 10"/>
    </Style>

    <Style x:Key="DataGridRowWithBorderStyle" TargetType="DataGridRow">
        <Setter Property="Background"      Value="Transparent"/>
        <Setter Property="BorderBrush"     Value="{StaticResource CardBorderBrush}"/>
        <Setter Property="BorderThickness" Value="0 0 0 1"/>
        <Setter Property="Foreground"      Value="{StaticResource TextPrimaryBrush}"/>
        <Setter Property="MinHeight"       Value="46"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background"  Value="{StaticResource AppBackgroundBrush}"/>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background"  Value="#0CD4500C"/>
                <Setter Property="BorderBrush" Value="#22D4500C"/>
                <Setter Property="Foreground"  Value="{StaticResource AccentBrush}"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="AccentLeftCardStyle" TargetType="Border">
        <Setter Property="CornerRadius"    Value="0 8 8 0"/>
        <Setter Property="BorderThickness" Value="4 0 0 0"/>
        <Setter Property="BorderBrush"     Value="{StaticResource AccentBrush}"/>
        <Setter Property="Background"      Value="{StaticResource CardBackgroundBrush}"/>
        <Setter Property="Padding"         Value="14 12"/>
    </Style>

    <Style x:Key="DataGridRowHeader" TargetType="DataGridRowHeader">
        <Setter Property="Background"  Value="Transparent"/>
        <Setter Property="Width"       Value="0"/>
    </Style>

</ResourceDictionary>
