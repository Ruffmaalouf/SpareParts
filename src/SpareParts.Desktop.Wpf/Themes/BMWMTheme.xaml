<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- THEME: BMW M Power (M-Blue) — palette only; shared control templates live in Themes/Shared/PerformanceThemeTemplate.xaml -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SpareParts.Desktop.Wpf;component/Themes/Shared/PerformanceThemeTemplate.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Brushes — using element syntax (no Color= attribute) to avoid BAML parse issues -->
    <SolidColorBrush x:Key="AppBackgroundBrush">#0D0D12</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackgroundBrush">#14141C</SolidColorBrush>
    <SolidColorBrush x:Key="CardHighlightBrush">#1E1E2C</SolidColorBrush>
    <SolidColorBrush x:Key="CardBgBrush">#14141C</SolidColorBrush>
    <SolidColorBrush x:Key="CardBgSoftBrush">#1E1E2C</SolidColorBrush>
    <SolidColorBrush x:Key="CardBorderBrush">#221C69D4</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#1C69D4</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBlueBrush">#5B9BD5</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimaryBrush">#E8EAED</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush">#8899BB</SolidColorBrush>
    <SolidColorBrush x:Key="BorderBrush">#281C69D4</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderOverlayBrush">#AA0D0D12</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderCardBrush">#14141C</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderBorderBrush">#1C69D4</SolidColorBrush>
    <Color x:Key="ColorSportOrange">#1C69D4</Color>
    <Color x:Key="ColorMatteBlack">#0D0D12</Color>
    <Color x:Key="ColorGunmetal">#14141C</Color>
    <Color x:Key="ColorSlate">#1E1E2C</Color>
    <Color x:Key="ColorChrome">#E8EAED</Color>
    <Color x:Key="ColorMuted">#8899BB</Color>

    <!-- Text color drawn on top of AccentBrush (e.g. PrimaryButtonStyle) -->
    <SolidColorBrush x:Key="AccentForegroundBrush">White</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush">#2E7FE8</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush">#1050A8</SolidColorBrush>

    <!-- Mid-gradient stop color for RacingStripeBrush (defined in the shared template) -->
    <Color x:Key="RacingStripeMidColor">#FF0F3D7A</Color>

</ResourceDictionary>
