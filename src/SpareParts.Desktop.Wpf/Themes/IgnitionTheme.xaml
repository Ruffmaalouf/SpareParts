<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- THEME: Ignition (Carbon Black / Brake-Caliper Orange) — Ignition redesign package, Report 02.
         Palette-only dictionary following the performance-theme structure; shared control templates
         live in Themes/Shared/PerformanceThemeTemplate.xaml and the Ig* design tokens live in
         Themes/Shared/IgnitionTokens.xaml (Report 02 §13 cross-platform token mapping). -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SpareParts.Desktop.Wpf;component/Themes/Shared/IgnitionTokens.xaml"/>
        <ResourceDictionary Source="/SpareParts.Desktop.Wpf;component/Themes/Shared/PerformanceThemeTemplate.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Brushes — using element syntax (no Color= attribute) to avoid BAML parse issues.
         Values map 1:1 onto the Ignition tokens so every existing style/template that
         references these keys via DynamicResource repaints in Ignition colors. -->
    <SolidColorBrush x:Key="AppBackgroundBrush">#0A0A0B</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackgroundBrush">#131316</SolidColorBrush>
    <SolidColorBrush x:Key="CardHighlightBrush">#1B1B1F</SolidColorBrush>
    <SolidColorBrush x:Key="CardBgBrush">#131316</SolidColorBrush>
    <SolidColorBrush x:Key="CardBgSoftBrush">#1B1B1F</SolidColorBrush>
    <SolidColorBrush x:Key="CardBorderBrush">#26262B</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#F97316</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBlueBrush">#38BDF8</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimaryBrush">#FAFAFA</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush">#A1A1AA</SolidColorBrush>
    <SolidColorBrush x:Key="BorderBrush">#26262B</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderOverlayBrush">#AA0A0A0B</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderCardBrush">#131316</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderBorderBrush">#F97316</SolidColorBrush>
    <Color x:Key="ColorSportOrange">#F97316</Color>
    <Color x:Key="ColorMatteBlack">#0A0A0B</Color>
    <Color x:Key="ColorGunmetal">#131316</Color>
    <Color x:Key="ColorSlate">#1B1B1F</Color>
    <Color x:Key="ColorChrome">#FAFAFA</Color>
    <Color x:Key="ColorMuted">#6B6B74</Color>

    <!-- Text color drawn on top of AccentBrush (e.g. PrimaryButtonStyle) -->
    <SolidColorBrush x:Key="AccentForegroundBrush">#0A0A0B</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush">#EA580C</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush">#C2410C</SolidColorBrush>

    <!-- Mid-gradient stop color for RacingStripeBrush (defined in the shared template) -->
    <Color x:Key="RacingStripeMidColor">#FFEA580C</Color>

</ResourceDictionary>
