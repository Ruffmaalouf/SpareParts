<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- THEME: Mercedes AMG (Chrome Silver) — palette only; shared control templates live in Themes/Shared/PerformanceThemeTemplate.xaml -->

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/SpareParts.Desktop.Wpf;component/Themes/Shared/PerformanceThemeTemplate.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Brushes — using element syntax (no Color= attribute) to avoid BAML parse issues -->
    <SolidColorBrush x:Key="AppBackgroundBrush">#111114</SolidColorBrush>
    <SolidColorBrush x:Key="CardBackgroundBrush">#1A1A1E</SolidColorBrush>
    <SolidColorBrush x:Key="CardHighlightBrush">#242428</SolidColorBrush>
    <SolidColorBrush x:Key="CardBgBrush">#1A1A1E</SolidColorBrush>
    <SolidColorBrush x:Key="CardBgSoftBrush">#242428</SolidColorBrush>
    <SolidColorBrush x:Key="CardBorderBrush">#22C8C8D0</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBrush">#C8C8D0</SolidColorBrush>
    <SolidColorBrush x:Key="AccentBlueBrush">#B0C4DE</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimaryBrush">#F0F0F2</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryBrush">#8888A0</SolidColorBrush>
    <SolidColorBrush x:Key="BorderBrush">#28C8C8D0</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderOverlayBrush">#AA111114</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderCardBrush">#1A1A1E</SolidColorBrush>
    <SolidColorBrush x:Key="PreloaderBorderBrush">#C8C8D0</SolidColorBrush>
    <Color x:Key="ColorSportOrange">#C8C8D0</Color>
    <Color x:Key="ColorMatteBlack">#111114</Color>
    <Color x:Key="ColorGunmetal">#1A1A1E</Color>
    <Color x:Key="ColorSlate">#242428</Color>
    <Color x:Key="ColorChrome">#F0F0F2</Color>
    <Color x:Key="ColorMuted">#8888A0</Color>

    <!-- Text color drawn on top of AccentBrush (e.g. PrimaryButtonStyle) -->
    <SolidColorBrush x:Key="AccentForegroundBrush">#111114</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryButtonHoverBrush">#E0E0E8</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryButtonPressedBrush">#A0A0A8</SolidColorBrush>

    <!-- Mid-gradient stop color for RacingStripeBrush (defined in the shared template) -->
    <Color x:Key="RacingStripeMidColor">#FF808090</Color>

</ResourceDictionary>
