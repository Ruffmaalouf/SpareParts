<UserControl x:Class="SpareParts.Desktop.Wpf.UsersTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpareParts.Desktop.Wpf">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <local:InverseBoolConverter   x:Key="InvBool"/>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize"   Value="10"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin"     Value="0 12 0 4"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>

        <Style x:Key="DeactivateBtn" TargetType="Button">
            <Setter Property="Background"      Value="#22E53935"/>
            <Setter Property="Foreground"      Value="#FFE57373"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor"          Value="Hand"/>
            <Setter Property="FontSize"        Value="10"/>
            <Setter Property="Padding"         Value="6 3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" CornerRadius="4"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#44E53935"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- ══ LEFT — DataGrid ══ -->
        <Grid Grid.Column="0" Margin="0 0 12 0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 10">
                <Button Content="↻  Refresh"
                        Command="{Binding LoadCommand}"
                        Style="{DynamicResource SecondaryButtonStyle}"
                        Padding="14 6" Margin="0 0 8 0"/>
                <Button Content="＋  New User"
                        Command="{Binding NewCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Padding="14 6"/>
            </StackPanel>

            <DataGrid Grid.Row="1"
                      ItemsSource="{Binding Users}"
                      SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      GridLinesVisibility="None"
                      RowHeight="42" ColumnHeaderHeight="36"
                      CanUserReorderColumns="False" CanUserResizeRows="False">
                <DataGrid.Columns>

                    <DataGridTextColumn Header="USERNAME"  Binding="{Binding Username}"
                                        Width="120" FontWeight="SemiBold"/>
                    <DataGridTextColumn Header="FULL NAME" Binding="{Binding FullName}"  Width="150"/>
                    <DataGridTextColumn Header="EMAIL"     Binding="{Binding Email}"     Width="170"/>

                    <!-- ROLE -->
                    <DataGridTemplateColumn Header="ROLE" Width="95">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8 3"
                                        HorizontalAlignment="Left" Margin="4 0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#2200E5FF"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                    <Setter Property="Background" Value="#22FF5722"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding Role}" Value="Manager">
                                                    <Setter Property="Background" Value="#221C69D4"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Role}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FF00E5FF"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Role}" Value="Admin">
                                                        <Setter Property="Foreground" Value="#FFFF7043"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Role}" Value="Manager">
                                                        <Setter Property="Foreground" Value="#FF64B5F6"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- STATUS -->
                    <DataGridTemplateColumn Header="STATUS" Width="85">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Padding="8 3"
                                        HorizontalAlignment="Left" Margin="4 0">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#22E53935"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                    <Setter Property="Background" Value="#224CAF50"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding StatusBadge}" FontSize="11" FontWeight="Bold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFE57373"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF81C784"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <DataGridTextColumn Header="LAST LOGIN" Binding="{Binding LastLoginDisplay}" Width="150"/>

                    <!-- DEACTIVATE -->
                    <DataGridTemplateColumn Header="" Width="90">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Deactivate"
                                        Style="{StaticResource DeactivateBtn}"
                                        Command="{Binding DataContext.DeactivateCommand,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Grid.Row="2" Text="{Binding Status}"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="12" Margin="0 8 0 0"/>
        </Grid>

        <!-- ══ RIGHT — Form ══ -->
        <Border Grid.Column="1"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="8" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.2"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>

                    <!-- Title: no inline Style= attribute + TextBlock.Style together -->
                    <TextBlock FontSize="16" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0 0 0 4">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="New User"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Text" Value="Edit User"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0 0 0 16">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="Fill in details and click Save"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Text" Value="Leave password blank to keep existing"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Text="USERNAME" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FormUsername, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding IsEditing, Converter={StaticResource InvBool}}"
                             Height="36" Padding="8 0"/>

                    <TextBlock Text="FULL NAME" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FormFullName, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" Padding="8 0"/>

                    <TextBlock Text="EMAIL (optional)" Style="{StaticResource FieldLabel}"/>
                    <TextBox Text="{Binding FormEmail, UpdateSourceTrigger=PropertyChanged}"
                             Height="36" Padding="8 0"/>

                    <TextBlock Text="ROLE" Style="{StaticResource FieldLabel}"/>
                    <ComboBox ItemsSource="{Binding Roles}"
                              SelectedItem="{Binding FormRole, Mode=TwoWay}"
                              Height="36"/>

                    <!-- Password label — dynamic text WITHOUT double Style -->
                    <TextBlock Margin="0 12 0 4" FontSize="10" FontWeight="Bold"
                               FontFamily="Segoe UI"
                               Foreground="{DynamicResource TextSecondaryBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="PASSWORD"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEditing}" Value="True">
                                        <Setter Property="Text" Value="NEW PASSWORD (blank = keep)"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <PasswordBox x:Name="PasswordInput" Height="36"
                                 PasswordChanged="PasswordInput_Changed"/>

                    <StackPanel Orientation="Horizontal" Margin="0 16 0 0"
                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}">
                        <CheckBox IsChecked="{Binding FormIsActive}"
                                  VerticalAlignment="Center" Margin="0 0 8 0"/>
                        <TextBlock Text="Account is Active"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" FontSize="13"/>
                    </StackPanel>

                    <Grid Margin="0 20 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Content="Cancel"
                                Command="{Binding NewCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Height="38"/>

                        <Button Grid.Column="2" Height="38"
                                Command="{Binding SaveCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvBool}}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                    <Setter Property="Content" Value="Save User"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Content" Value="Saving…"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>
