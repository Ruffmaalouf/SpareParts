<Window x:Class="SpareParts.Desktop.Wpf.ManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpareParts.Desktop.Wpf"
        xmlns:controls="clr-namespace:SpareParts.Desktop.Wpf;assembly=SpareParts.Desktop.Controls"
        Title="Management — Maalouf Auto Parts"
        Width="1150" Height="780"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBackgroundBrush}">

    <!-- Resources inherited from App.xaml — no local merge needed so themes apply correctly -->

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl Grid.Row="0"
                    Background="Transparent"
                    BorderThickness="0"
                    Margin="16,16,16,0">

            <!-- ════════════════════════════════════════════════════
                 TAB 1 — CUSTOMERS
            ════════════════════════════════════════════════════ -->
            <TabItem Header="👤  Customers">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Form -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="10" Padding="24" Margin="0 0 12 0">
                        <StackPanel>
                            <TextBlock Text="New Customer" FontSize="18" FontWeight="Bold" Margin="0 0 0 4"/>
                            <TextBlock Text="Fill in the details and save."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 20"/>

                            <TextBlock Text="NAME *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                            <TextBlock Text="PHONE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                            <TextBlock Text="EMAIL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewCustomerEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                            <TextBlock Text="ADDRESS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewCustomerAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                            <TextBlock Text="TAX NUMBER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewCustomerTax, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                            <TextBlock Text="OPENING BALANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewCustomerBalance, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 24"/>

                            <Button Content="＋  Save Customer"
                                    Command="{Binding SaveCustomerCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Height="42"/>
                        </StackPanel>
                    </Border>

                    <!-- List -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                <TextBlock Text="All Customers" FontSize="18" FontWeight="Bold"
                                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <Button Content="↻  Refresh"
                                        Command="{Binding LoadAllCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        DockPanel.Dock="Right"
                                        Padding="14 6"/>
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Customers}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID"      Binding="{Binding Id}"             Width="55"/>
                                    <DataGridTextColumn Header="Name"    Binding="{Binding Name}"           Width="*"/>
                                    <DataGridTextColumn Header="Phone"   Binding="{Binding Phone}"          Width="130"/>
                                    <DataGridTextColumn Header="Email"   Binding="{Binding Email}"          Width="200"/>
                                    <DataGridTextColumn Header="Balance" Binding="{Binding OpeningBalance, StringFormat={}{0:N0}}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 TAB 2 — SUPPLIERS
            ════════════════════════════════════════════════════ -->
            <TabItem Header="🏭  Suppliers">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Form -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="10" Padding="24" Margin="0 0 12 0">
                        <StackPanel>
                            <TextBlock Text="New Supplier" FontSize="18" FontWeight="Bold" Margin="0 0 0 4"/>
                            <TextBlock Text="Fill in the details and save."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 20"/>

                            <TextBlock Text="NAME *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewSupplierName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                            <TextBlock Text="PHONE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewSupplierPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                            <TextBlock Text="EMAIL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewSupplierEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                            <TextBlock Text="ADDRESS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewSupplierAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                            <TextBlock Text="TAX NUMBER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewSupplierTax, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                            <TextBlock Text="OPENING BALANCE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewSupplierBalance, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 24"/>

                            <Button Content="＋  Save Supplier"
                                    Command="{Binding SaveSupplierCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Height="42"/>
                        </StackPanel>
                    </Border>

                    <!-- List -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                <TextBlock Text="All Suppliers" FontSize="18" FontWeight="Bold"
                                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <Button Content="↻  Refresh"
                                        Command="{Binding LoadAllCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        DockPanel.Dock="Right"
                                        Padding="14 6"/>
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Suppliers}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID"      Binding="{Binding Id}"             Width="55"/>
                                    <DataGridTextColumn Header="Name"    Binding="{Binding Name}"           Width="*"/>
                                    <DataGridTextColumn Header="Phone"   Binding="{Binding Phone}"          Width="130"/>
                                    <DataGridTextColumn Header="Email"   Binding="{Binding Email}"          Width="200"/>
                                    <DataGridTextColumn Header="Balance" Binding="{Binding OpeningBalance, StringFormat={}{0:N0}}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 TAB 3 — BRANDS
            ════════════════════════════════════════════════════ -->
            <TabItem Header="🏷  Brands">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Form -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="10" Padding="24" Margin="0 0 12 0">
                        <StackPanel>
                            <TextBlock Text="New Brand" FontSize="18" FontWeight="Bold" Margin="0 0 0 4"/>
                            <TextBlock Text="Add a new car manufacturer brand."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 20"/>

                            <TextBlock Text="BRAND NAME *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewBrandName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 16"/>

                            <CheckBox Content="Active" IsChecked="{Binding NewBrandIsActive}"
                                      Foreground="{DynamicResource TextPrimaryBrush}" Margin="0 0 0 24"/>

                            <Button Content="＋  Save Brand"
                                    Command="{Binding SaveBrandCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Height="42"/>
                        </StackPanel>
                    </Border>

                    <!-- List -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                <TextBlock Text="All Brands" FontSize="18" FontWeight="Bold"
                                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <Button Content="↻  Refresh"
                                        Command="{Binding LoadAllCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        DockPanel.Dock="Right"
                                        Padding="14 6"/>
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Brands}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID"     Binding="{Binding Id}"       Width="60"/>
                                    <DataGridTextColumn Header="Name"   Binding="{Binding Name}"     Width="*"/>
                                    <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 TAB 4 — PARTS
            ════════════════════════════════════════════════════ -->
            <TabItem Header="🔩  Parts">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Form -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="10" Padding="24" Margin="0 0 12 0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="New Part" FontSize="18" FontWeight="Bold" Margin="0 0 0 4"/>
                                <TextBlock Text="Register a new spare part."
                                           FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 20"/>

                                <TextBlock Text="INTERNAL CODE *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding NewPartCode, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                                <TextBlock Text="PART NAME *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding NewPartName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                                <TextBlock Text="OEM NUMBER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding NewPartOEM, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                                <Grid Margin="0 0 0 14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="COST PRICE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                        <TextBox Text="{Binding NewPartCostPrice, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="SALE PRICE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                        <TextBox Text="{Binding NewPartSalePrice, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0 0 0 14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CATEGORY ID" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                        <TextBox Text="{Binding NewPartCategoryId, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="BRAND ID" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                        <TextBox Text="{Binding NewPartBrandId, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <Grid Margin="0 0 0 14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="CURRENCY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                        <TextBox Text="{Binding NewPartCurrency, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="MIN STOCK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                        <TextBox Text="{Binding NewPartMinStock, UpdateSourceTrigger=PropertyChanged}"/>
                                    </StackPanel>
                                </Grid>

                                <TextBlock Text="NOTES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding NewPartNotes, UpdateSourceTrigger=PropertyChanged}"
                                         Height="60" TextWrapping="Wrap" AcceptsReturn="True" Margin="0 0 0 24"/>

                                <Button Content="＋  Save Part"
                                        Command="{Binding SavePartCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch"
                                        Height="42"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <!-- List -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                <TextBlock Text="All Parts" FontSize="18" FontWeight="Bold"
                                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <Button Content="↻  Refresh"
                                        Command="{Binding LoadAllCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        DockPanel.Dock="Right"
                                        Padding="14 6"/>
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding Parts}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID"        Binding="{Binding Id}"                               Width="50"/>
                                    <DataGridTextColumn Header="Code"      Binding="{Binding InternalCode}"                     Width="100"/>
                                    <DataGridTextColumn Header="Name"      Binding="{Binding Name}"                             Width="*"/>
                                    <DataGridTextColumn Header="OEM"       Binding="{Binding OEMNumber}"                        Width="100"/>
                                    <DataGridTextColumn Header="Cost"      Binding="{Binding CostPrice, StringFormat={}{0:N0}}" Width="80"/>
                                    <DataGridTextColumn Header="Sale"      Binding="{Binding SalePrice, StringFormat={}{0:N0}}" Width="80"/>
                                    <DataGridTextColumn Header="Min Stock" Binding="{Binding MinStock}"                         Width="80"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 TAB 5 — CAR MODELS
            ════════════════════════════════════════════════════ -->
            <TabItem Header="🚗  Car Models">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Form -->
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="10" Padding="24" Margin="0 0 12 0">
                        <StackPanel>
                            <TextBlock Text="New Car Model" FontSize="18" FontWeight="Bold" Margin="0 0 0 4"/>
                            <TextBlock Text="Add a model to a brand."
                                       FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 20"/>

                            <TextBlock Text="MODEL NAME *" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewCarModelName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                            <Grid Margin="0 0 0 14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="10"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="YEAR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCarModelYear, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="BRAND ID" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCarModelBrandId, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="ENGINE TYPE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewCarModelEngine, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 14"/>

                            <TextBlock Text="BASE PRICE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                            <TextBox Text="{Binding NewCarModelBasePrice, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 24"/>

                            <Button Content="＋  Save Car Model"
                                    Command="{Binding SaveCarModelCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    HorizontalAlignment="Stretch"
                                    Height="42"/>
                        </StackPanel>
                    </Border>

                    <!-- List -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                <TextBlock Text="All Car Models" FontSize="18" FontWeight="Bold"
                                           VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                <Button Content="↻  Refresh"
                                        Command="{Binding LoadAllCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        DockPanel.Dock="Right"
                                        Padding="14 6"/>
                            </DockPanel>
                            <DataGrid Grid.Row="1" ItemsSource="{Binding CarModels}"
                                      AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID"         Binding="{Binding Id}"         Width="50"/>
                                    <DataGridTextColumn Header="Name"       Binding="{Binding Name}"       Width="*"/>
                                    <DataGridTextColumn Header="Year"       Binding="{Binding Year}"       Width="80"/>
                                    <DataGridTextColumn Header="Engine"     Binding="{Binding EngineType}" Width="140"/>
                                    <DataGridTextColumn Header="Base Price" Binding="{Binding BasePrice, StringFormat={}{0:N0}}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ════════════════════════════════════════════════════
                 TAB 6 — USERS
            ════════════════════════════════════════════════════ -->
            <TabItem Header="👥  Users">
                <controls:UsersTab DataContext="{Binding UsersVm}" Margin="10"/>
            </TabItem>

        </TabControl>

        <!-- ══ STATUS BAR ══ -->
        <Border Grid.Row="1"
                Background="{DynamicResource CardBackgroundBrush}"
                Padding="20 10" Margin="16 6 16 16"
                CornerRadius="8">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="●" FontSize="10" VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" Margin="0 0 8 0"/>
                <TextBlock Text="{Binding Status}" FontSize="13"
                           Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
