<UserControl x:Class="SpareParts.Desktop.Wpf.CustomerSearchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SpareParts.Desktop.Wpf"
             x:Name="Root">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Inverted bool → visibility for "no results" label -->
        <Style x:Key="SearchInputStyle" TargetType="TextBox">
            <Setter Property="Background"              Value="Transparent"/>
            <Setter Property="Foreground"              Value="White"/>
            <Setter Property="CaretBrush"              Value="{DynamicResource AccentBrush}"/>
            <Setter Property="BorderThickness"         Value="0"/>
            <Setter Property="FontSize"                Value="14"/>
            <Setter Property="FontFamily"              Value="Segoe UI"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding"                 Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer x:Name="PART_ContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      VerticalAlignment="Center"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Result row hover style -->
        <Style x:Key="ResultRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding"     Value="14 10"/>
            <Setter Property="Foreground"  Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background"  Value="Transparent"/>
            <Setter Property="Cursor"      Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                BorderThickness="0 0 0 1"
                                BorderBrush="#0DFFFFFF">
                            <!-- accent left bar on hover/select -->
                            <Border x:Name="AccentBar"
                                    Width="3" HorizontalAlignment="Left"
                                    Background="Transparent"
                                    Margin="-14 -10 0 -10"/>
                            <!-- this is a trick: overlap the content -->
                        </Border>
                        <ControlTemplate.Resources/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row"       Property="Background" Value="#0DFFFFFF"/>
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row"       Property="Background" Value="#18FF5722"/>
                                <Setter TargetName="AccentBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <StackPanel MinWidth="240">

        <!-- Label -->
        <TextBlock Text="CUSTOMER"
                   FontSize="10"
                   FontWeight="Bold"
                   FontFamily="Segoe UI"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="0 0 0 6"/>

        <!-- ═══ INPUT PILL ═══════════════════════════════════════════════ -->
        <Border x:Name="InputPill"
                Background="#FF1A1A22"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Height="40">
            <Grid Margin="12 0 6 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search icon (always visible when no customer selected) -->
                <TextBlock Grid.Column="0"
                           Text="&#xE721;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           Margin="0 0 8 0"
                           Visibility="{Binding HasSelectedCustomer, ElementName=Root,
                                        Converter={StaticResource BoolToVis}}">
                    <!-- inverted - shown when NO customer -->
                    <!-- We'll control this in code-behind via Name -->
                </TextBlock>

                <!-- When customer IS selected: accent dot + name inline -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="0 0 8 0"
                            x:Name="SelectedIndicator"
                            Visibility="Collapsed">
                    <Ellipse Width="8" Height="8"
                             Fill="{DynamicResource AccentBrush}"
                             VerticalAlignment="Center"
                             Margin="0 0 8 0"/>
                    <TextBlock x:Name="SelectedNameInline"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="White"
                               VerticalAlignment="Center"
                               MaxWidth="140"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <!-- Text input -->
                <TextBox x:Name="SearchBox"
                         Grid.Column="1"
                         Style="{StaticResource SearchInputStyle}"
                         Text="{Binding CustomerSearchText, ElementName=Root, UpdateSourceTrigger=PropertyChanged}"
                         KeyUp="SearchBox_KeyUp"
                         GotFocus="SearchBox_GotFocus"/>

                <!-- Placeholder text (sits behind TextBox) -->
                <TextBlock x:Name="Placeholder"
                           Grid.Column="1"
                           Text="Type name or phone…"
                           FontSize="14"
                           FontFamily="Segoe UI"
                           Foreground="#66FFFFFF"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>

                <!-- Clear button (only when customer selected) -->
                <Button x:Name="ClearBtn"
                        Grid.Column="2"
                        Width="28" Height="28"
                        Margin="4 0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Visibility="Collapsed"
                        Click="ClearCustomer_Click"
                        ToolTip="Clear customer">
                    <TextBlock Text="&#xE711;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"/>
                </Button>

                <!-- Search button (when no customer) -->
                <Button x:Name="SearchBtn"
                        Grid.Column="2"
                        Width="28" Height="28"
                        Margin="4 0"
                        Background="Transparent"
                        BorderThickness="0"
                        Cursor="Hand"
                        Click="SearchButton_Click"
                        ToolTip="Search customers">
                    <Border CornerRadius="6"
                            Background="{DynamicResource AccentBrush}"
                            Width="26" Height="26">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="12"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                </Button>
            </Grid>
        </Border>

        <!-- ═══ PHONE SUB-LABEL when customer selected ═══════════════════ -->
        <TextBlock x:Name="PhoneLabel"
                   FontSize="11"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Margin="4 4 0 0"
                   Visibility="Collapsed"/>

        <!-- ═══ DROPDOWN POPUP ═══════════════════════════════════════════ -->
        <Popup x:Name="ResultsPopup"
               PlacementTarget="{Binding ElementName=InputPill}"
               Placement="Bottom"
               VerticalOffset="4"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">

            <Border Background="#FF1E1E28"
                    BorderBrush="#33FF5722"
                    BorderThickness="1"
                    CornerRadius="10"
                    MinWidth="{Binding ActualWidth, ElementName=InputPill}"
                    MaxHeight="300"
                    Margin="0 0 4 4">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.6"
                                      BlurRadius="24" ShadowDepth="8"/>
                </Border.Effect>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Popup header bar -->
                    <Border Grid.Row="0"
                            Background="#0DFF5722"
                            BorderBrush="#1AFF5722"
                            BorderThickness="0 0 0 1"
                            CornerRadius="10 10 0 0"
                            Padding="14 8">
                        <DockPanel>
                            <TextBlock Text="CUSTOMERS"
                                       FontSize="10" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Left"/>
                            <TextBlock x:Name="CountLabel"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <!-- Results list -->
                    <ListBox x:Name="ResultsList"
                             Grid.Row="1"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemsSource="{Binding FilteredCustomers, ElementName=Root}"
                             ItemContainerStyle="{StaticResource ResultRowStyle}"
                             MouseDoubleClick="ResultItem_DoubleClick"
                             KeyDown="ResultsList_KeyDown"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             MaxHeight="210">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"/>
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="0 2 0 0">
                                            <Run Text="{Binding Phone}"/>
                                            <Run Text=" · "/><Run Text="{Binding Email}"/>
                                        </TextBlock>
                                    </StackPanel>
                                    <!-- ID badge -->
                                    <Border Grid.Column="1"
                                            Background="#1AFF5722"
                                            BorderBrush="#33FF5722"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6 2"
                                            VerticalAlignment="Center"
                                            Margin="8 0 0 0">
                                        <TextBlock FontSize="10"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="Bold">
                                            <Run Text="#"/><Run Text="{Binding Id}"/>
                                        </TextBlock>
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Empty state -->
                    <StackPanel x:Name="EmptyState"
                                Grid.Row="1"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center"
                                Margin="0 20"
                                Visibility="Collapsed">
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="28"
                                   Foreground="#33FFFFFF"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="No customers found"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0 8 0 0"/>
                    </StackPanel>

                    <!-- Footer hint -->
                    <Border Grid.Row="2"
                            BorderBrush="#1AFFFFFF"
                            BorderThickness="0 1 0 0"
                            Padding="14 7"
                            CornerRadius="0 0 10 10">
                        <StackPanel Orientation="Horizontal">
                            <Border Background="#1AFFFFFF" CornerRadius="3" Padding="4 1" Margin="0 0 4 0">
                                <TextBlock Text="↵" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <TextBlock Text="select  " FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                            <Border Background="#1AFFFFFF" CornerRadius="3" Padding="4 1" Margin="0 0 4 0">
                                <TextBlock Text="Esc" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Border>
                            <TextBlock Text="close" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Popup>

    </StackPanel>
</UserControl>
