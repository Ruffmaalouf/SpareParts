<Window x:Class="SpareParts.Desktop.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maalouf Auto Parts — Login"
        Width="960" Height="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/DefaultTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Underline TextBox -->
            <Style x:Key="LoginFieldStyle" TargetType="TextBox">
                <Setter Property="Background"               Value="#FF1E1E28"/>
                <Setter Property="Foreground"               Value="#FFE0E0E0"/>
                <Setter Property="BorderBrush"              Value="#44FFFFFF"/>
                <Setter Property="BorderThickness"          Value="0 0 0 2"/>
                <Setter Property="Padding"                  Value="12 0"/>
                <Setter Property="FontSize"                 Value="14"/>
                <Setter Property="FontFamily"               Value="Segoe UI"/>
                <Setter Property="CaretBrush"               Value="#FFFF5722"/>
                <Setter Property="SelectionBrush"           Value="#44FF5722"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="#FF1E1E28"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6 6 0 0"
                                    MinHeight="44">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Foreground="#FFE0E0E0"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush"  Value="#FFFF5722"/>
                                    <Setter TargetName="Bd" Property="Background"   Value="#FF262630"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush"  Value="#88FF5722"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Underline PasswordBox -->
            <Style x:Key="LoginPasswordStyle" TargetType="PasswordBox">
                <Setter Property="Background"               Value="#FF1E1E28"/>
                <Setter Property="Foreground"               Value="#FFE0E0E0"/>
                <Setter Property="BorderBrush"              Value="#44FFFFFF"/>
                <Setter Property="BorderThickness"          Value="0 0 0 2"/>
                <Setter Property="Padding"                  Value="12 0"/>
                <Setter Property="FontSize"                 Value="18"/>
                <Setter Property="FontFamily"               Value="Segoe UI"/>
                <Setter Property="PasswordChar"             Value="●"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd"
                                    Background="#FF1E1E28"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="6 6 0 0"
                                    MinHeight="44">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush"  Value="#FFFF5722"/>
                                    <Setter TargetName="Bd" Property="Background"   Value="#FF262630"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush"  Value="#88FF5722"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Drop-shadow shell -->
    <Border CornerRadius="16" Background="#FF121218">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="40" ShadowDepth="8" Opacity="0.6"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ LEFT — branding panel ══ -->
            <Border Grid.Column="0" CornerRadius="16 0 0 16" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF0D0D14" Offset="0"/>
                        <GradientStop Color="#FF1A1A2E" Offset="0.5"/>
                        <GradientStop Color="#FF0D0D14" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Decorative glow circles -->
                    <Ellipse Width="300" Height="300"
                             HorizontalAlignment="Right" VerticalAlignment="Top"
                             Margin="0,-80,-80,0" Opacity="0.07">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFFF5722" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>
                    <Ellipse Width="180" Height="180"
                             HorizontalAlignment="Left" VerticalAlignment="Bottom"
                             Margin="-50,0,0,-50" Opacity="0.09">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFFF5722" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="40">

                        <!-- Logo circle -->
                        <Border Width="100" Height="100" CornerRadius="50"
                                Margin="0 0 0 28" HorizontalAlignment="Center">
                            <Border.Background>
                                <RadialGradientBrush>
                                    <GradientStop Color="#22FF5722" Offset="0"/>
                                    <GradientStop Color="#08FF5722" Offset="1"/>
                                </RadialGradientBrush>
                            </Border.Background>
                            <Border.Effect>
                                <DropShadowEffect Color="#FFFF5722" BlurRadius="20"
                                                  ShadowDepth="0" Opacity="0.35"/>
                            </Border.Effect>
                            <!-- Fallback text logo if image not present -->
                            <TextBlock Text="M" FontSize="42" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI"/>
                        </Border>

                        <TextBlock Text="MAALOUF"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="White" HorizontalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="AUTO PARTS"
                                   FontSize="13" FontWeight="Light"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0 2 0 0" FontFamily="Segoe UI"/>

                        <!-- Orange divider -->
                        <Border Height="1" Width="140" Margin="0 22 0 22"
                                HorizontalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <TextBlock Text="Parts Management System"
                                   FontSize="12" Foreground="#FF9E9EA5"
                                   HorizontalAlignment="Center" FontFamily="Segoe UI"/>
                        <TextBlock Text="v3.0  ·  API-Connected"
                                   FontSize="10" Foreground="#FF4A4A5A"
                                   HorizontalAlignment="Center"
                                   Margin="0 4 0 0" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ RIGHT — login form ══ -->
            <Border Grid.Column="1" CornerRadius="0 16 16 0" Background="#FF18181F">

                <Grid>
                    <!-- Close button -->
                    <Button Content="✕"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0 14 14 0" Width="28" Height="28"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#FF555565" FontSize="13"
                            Cursor="Hand" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="4"
                                                    Background="{TemplateBinding Background}" Padding="2">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#22E53935"/>
                                                    <Setter Property="Foreground"                  Value="#FFE53935"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Drag bar -->
                    <Border Height="44" VerticalAlignment="Top" Background="Transparent"
                            MouseLeftButtonDown="DragBar_MouseDown"/>

                    <!-- Form -->
                    <StackPanel VerticalAlignment="Center" Margin="52 0 52 0">

                        <TextBlock Text="Welcome back"
                                   FontSize="24" FontWeight="SemiBold"
                                   Foreground="White" Margin="0 0 0 4" FontFamily="Segoe UI"/>
                        <TextBlock Text="Sign in to your account"
                                   FontSize="13" Foreground="#FF9E9EA5"
                                   Margin="0 0 0 34" FontFamily="Segoe UI"/>

                        <!-- Username -->
                        <TextBlock Text="USERNAME" FontSize="10" FontWeight="Bold"
                                   Foreground="#FF7A7A8A" Margin="0 0 0 6" FontFamily="Segoe UI"/>
                        <TextBox x:Name="UsernameBox"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginFieldStyle}"
                                 Height="44" KeyDown="Field_KeyDown"/>

                        <!-- Password -->
                        <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold"
                                   Foreground="#FF7A7A8A" Margin="0 20 0 6" FontFamily="Segoe UI"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource LoginPasswordStyle}"
                                     Height="44" KeyDown="Field_KeyDown"/>

                        <!-- Error banner -->
                        <Border Margin="0 14 0 0" Background="#1AE53935" CornerRadius="6"
                                Padding="12 8"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠  " Foreground="#FFE53935" FontSize="13"/>
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="#FFE57373" FontSize="13"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Sign In button -->
                        <Button x:Name="LoginBtn"
                                Height="46" Margin="0 22 0 0"
                                FontSize="13" FontWeight="Bold"
                                Cursor="Hand" Click="LoginButton_Click"
                                IsEnabled="{Binding IsIdle}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="8"
                                                        Background="{DynamicResource AccentBrush}">
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#FFFF5722" BlurRadius="16"
                                                                          ShadowDepth="0" Opacity="0.4"/>
                                                    </Border.Effect>
                                                    <TextBlock x:Name="Txt" Text="SIGN IN"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="White"
                                                               FontSize="13" FontWeight="Bold"
                                                               FontFamily="Segoe UI"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FFFF7043"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background" Value="#FFBF360C"/>
                                                        <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.55"/>
                                                        <Setter TargetName="Txt" Property="Text"   Value="SIGNING IN…"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>

                    <!-- API status bar -->
                    <Border VerticalAlignment="Bottom" Padding="20 10"
                            CornerRadius="0 0 16 0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StatusDot}" FontSize="9"
                                       Foreground="{Binding StatusBrush}"
                                       VerticalAlignment="Center" Margin="0 0 6 0"/>
                            <TextBlock Text="{Binding StatusText}"
                                       FontSize="11" Foreground="#FF6A6A7A"
                                       VerticalAlignment="Center" FontFamily="Segoe UI"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
