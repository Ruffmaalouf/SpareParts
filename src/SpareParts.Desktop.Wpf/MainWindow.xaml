                        <TextBlock Text="{Binding PurchasesVm.Status}"
                                   Foreground="{Binding PurchasesVm.StatusBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding PurchasesVm.ScreenSummary}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Right"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="12">
