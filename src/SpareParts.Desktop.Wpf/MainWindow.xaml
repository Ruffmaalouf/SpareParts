                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="↻ Refresh"
                                        Command="{Binding PurchasesVm.LoadCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="120"
                                        Margin="0 0 10 0"/>
                                <Button Content="✓ Post Selected"
                                        Command="{Binding PurchasesVm.PostSelectedPurchaseCommand}"
                                        IsEnabled="{Binding PurchasesVm.CanPostSelectedPurchase}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="150"
                                        Margin="0 0 10 0"/>
                                <Button Content="🗑 Delete Selected"
                                        Command="{Binding PurchasesVm.DeleteSelectedPurchaseCommand}"
                                        IsEnabled="{Binding PurchasesVm.CanDeleteSelectedPurchase}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="160"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding PurchasesVm.RecentPurchases}"
                                  SelectedItem="{Binding PurchasesVm.SelectedRecentPurchase, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Margin="0 0 0 18">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Purchase #"
                                                    Binding="{Binding PurchaseNumber}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Date"
                                                    Binding="{Binding PurchaseDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                    Width="105"/>
                                <DataGridTextColumn Header="Used Car"
                                                    Binding="{Binding UsedCar}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Supplier"
                                                    Binding="{Binding SupplierName}"
                                                    Width="160"/>
                                <DataGridTextColumn Header="Base"
                                                    Binding="{Binding BaseCurrencyCode}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Counter"
                                                    Binding="{Binding CounterCurrencyCode}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Total Base"
                                                    Binding="{Binding TotalBaseAmount, StringFormat={}{0:N4}}"
                                                    Width="105"/>
                                <DataGridTextColumn Header="Total Counter"
                                                    Binding="{Binding TotalCounterAmount, StringFormat={}{0:N4}}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Paid Base"
                                                    Binding="{Binding PaidAmount, StringFormat={}{0:N4}}"
                                                    Width="95"/>
                                <DataGridTextColumn Header="Paid Counter"
                                                    Binding="{Binding PaidCounterAmount, StringFormat={}{0:N4}}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Lines"
                                                    Binding="{Binding LineCount}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Payment"
                                                    Binding="{Binding PaymentStatus}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="Posting"
                                                    Binding="{Binding PostingStatus}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="Posted At"
                                                    Binding="{Binding PostedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                    Width="145"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2"
                                Padding="12"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Purchase Lines"
                                           FontSize="17"
                                           FontWeight="Bold"/>

                                <StackPanel Grid.Row="1"
                                            Margin="0 8 0 12">
                                    <TextBlock Text="{Binding PurchasesVm.SelectedPurchaseDetailSummary}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding PurchasesVm.SelectedPurchaseNotes}"
                                               Margin="0 6 0 0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding PurchasesVm.SelectedPurchaseDetail.Lines}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#"
                                                            Binding="{Binding SortOrder}"
                                                            Width="45"/>
                                        <DataGridTextColumn Header="Detail"
                                                            Binding="{Binding Description}"
                                                            Width="170"/>
                                        <DataGridTextColumn Header="Amount"
                                                            Binding="{Binding Amount, StringFormat={}{0:N4}}"
                                                            Width="110"/>
                                        <DataGridTextColumn Header="Currency"
                                                            Binding="{Binding CurrencyCode}"
                                                            Width="90"/>
                                        <DataGridTextColumn Header="Rate"
                                                            Binding="{Binding RateToBase, StringFormat={}{0:N8}}"
                                                            Width="110"/>
                                        <DataGridTextColumn Header="Base"
                                                            Binding="{Binding BaseAmount, StringFormat={}{0:N4}}"
                                                            Width="110"/>
                                        <DataGridTextColumn Header="Counter"
                                                            Binding="{Binding CounterAmount, StringFormat={}{0:N4}}"
                                                            Width="110"/>
                                        <DataGridTextColumn Header="Account"
                                                            Binding="{Binding AccountCode}"
                                                            Width="100"/>
                                        <DataGridTextColumn Header="Account Name"
                                                            Binding="{Binding AccountName}"
                                                            Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Stock Management ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=StockManagement}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Stock Management" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Monitor stock levels and replenish low inventory."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120" Margin="0 0 10 0"/>
                        <Button Content="Open Part Purchases"
                                Command="{Binding GoToPurchasesCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="170"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="12">
                    <DataGrid ItemsSource="{Binding StockSnapshots}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Part Code" Binding="{Binding PartCode}" Width="140"/>
                            <DataGridTextColumn Header="Part Name" Binding="{Binding PartName}" Width="*"/>
                            <DataGridTextColumn Header="Warehouse" Binding="{Binding Warehouse}" Width="220"/>
                            <DataGridTextColumn Header="On Hand" Binding="{Binding OnHand}" Width="100"/>
                            <DataGridTextColumn Header="Min Stock" Binding="{Binding MinStock}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ── AR Experience ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=ArExperience}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="AR Experience" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Launch augmented reality preview to visualize selected parts on a vehicle."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right"
                            Content="⟵ Home"
                            Command="{Binding GoToHomeCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="120"/>
                </DockPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="28">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="760">
                        <TextBlock Text="AR module ready"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   HorizontalAlignment="Center"/>
                        <TextBlock Text="This new screen is reserved for augmented reality workflows. Connect your AR rendering service or device bridge here to start a live part overlay session."
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0 14 0 0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding ArStatusMessage}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="0 18 0 0"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <Grid Width="620" Height="360" Margin="0 16 0 0">
                            <Border Background="#11000000" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10"/>
                            <Image Source="{Binding ArPreviewImage}" Stretch="UniformToFill" Margin="8" Opacity="0.92"/>
                            <Canvas Margin="8">
                                <Border Background="#E61A1A1A"
                                        BorderBrush="{DynamicResource AccentBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="10"
                                        Width="230"
                                        Canvas.Left="{Binding ArOverlayLeft}"
                                        Canvas.Top="{Binding ArOverlayTop}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding ArOverlayTitle}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ArOverlayDiagnostic}" FontSize="11" Margin="0 6 0 0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>
                            </Canvas>
                        </Grid>
                        <TextBlock Text="Reference images"
                                   FontWeight="SemiBold"
                                   Margin="0 14 0 0"/>
                        <TextBlock Text="{Binding ArReferenceImages}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   MaxWidth="620"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 20 0 0">
                            <Button Content="Start AR Session"
                                    Command="{Binding StartArSessionCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="180"/>
                            <Button Content="Stop AR Session"
                                    Command="{Binding StopArSessionCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="180"
                                    Margin="12 0 0 0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ── Car Selection ── -->
            <Grid Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=CarSelection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.Background>
                    <VisualBrush Stretch="Uniform" AlignmentX="Center" AlignmentY="Center" Opacity="0.04">
                        <VisualBrush.Visual>
                            <Image Source="{Binding SelectedBrand.Logo}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.Background>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20 20 20 10">
                    <Button Content="⟵ Back" Command="{Binding GoToHomeCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="100" Margin="0 0 20 0"/>
                    <Image Source="{Binding SelectedBrand.Logo}" Height="50" Margin="0 0 16 0"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding SelectedBrand.Name}" FontSize="26" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AvailableCars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectCarCommand, ElementName=RootWindow}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Margin="8" Padding="0">
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            CornerRadius="8" Padding="10" Width="220">
                                        <StackPanel>
                                            <Image Source="{Binding Image}" Height="100"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0 8 0 0"/>
                                            <TextBlock Text="{Binding BrandName}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ── Part Selection ── -->
            <Grid Margin="20" Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=PartSelection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 20">
                    <Button Content="⟵ Back to Cars" Command="{Binding GoToCarSelectionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="150" Margin="0 0 20 0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedCar.Name, TargetNullValue='Select a car'}"
                                   FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedCar.BrandName}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AvailableParts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectPartCommand, ElementName=RootWindow}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Margin="8" Padding="0">
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            CornerRadius="8" Padding="10" Width="260">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Code}" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0 4 0 0"/>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0} USD}"
                                                       FontSize="14" FontWeight="SemiBold" Margin="0 8 0 0"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ── POS Invoice Tabs ── -->
            <TabControl Margin="10"
                        Style="{StaticResource InvoiceTabControlStyle}"
                        ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource InvoiceTabItemStyle}"
                        Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=Pos}">

                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Header}" FontSize="13" VerticalAlignment="Center"/>
                            <Button Content="✕"
                                    Command="{Binding DataContext.CloseTabCommand, ElementName=RootWindow}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="11" Padding="8 0 0 0"
                                    VerticalAlignment="Center" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ── Header ───────────────────────────────────────────────── -->
                            <DockPanel Grid.Row="0" Margin="20,20,20,10">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{Binding SaleModeTitle}" FontSize="26" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SaleModeSubtitle}" FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 4 0 0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoadedFromSearch}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button ToolTip="Edit Invoice"
                                            Command="{Binding EditInvoiceCommand}"
                                            IsEnabled="{Binding IsEditEnabled}"
                                            Style="{StaticResource InvoiceIconButtonStyle}"
                                            Width="52"
                                            Height="52"
                                            Margin="0 0 8 0">
                                        <TextBlock Text="✎" FontSize="24" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button ToolTip="Save Invoice"
                                            Command="{Binding SaveInvoiceCommand}"
                                            IsEnabled="{Binding IsSaveEnabled}"
                                            Style="{StaticResource InvoiceIconButtonStyle}"
                                            Width="52"
                                            Height="52"
                                            Margin="0 0 8 0">
                                        <TextBlock Text="💾" FontSize="20"/>
                                    </Button>
                                    <Button ToolTip="Reset Invoice"
                                            Command="{Binding ResetInvoiceCommand}"
                                            IsEnabled="{Binding IsResetEnabled}"
                                            Style="{StaticResource InvoiceIconButtonStyle}"
                                            Width="52"
                                            Height="52">
                                        <TextBlock Text="↺" FontSize="24" FontWeight="SemiBold"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <!-- ── Form card ─────────────────────────────────────────────── -->
                            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8" Padding="20" Margin="20,0,20,15"
                    IsEnabled="{Binding IsInvoiceContentEnabled}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="20" ShadowDepth="5"/>
                                </Border.Effect>

                                <StackPanel>

                                    <!-- Row 1: Customer + Warehouse -->
                                    <Grid Margin="0 0 0 16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="270"/>
                                        </Grid.ColumnDefinitions>

                                        <controls:CustomerSearchControl
                            Grid.Column="0"
                            SelectedCustomerId="{Binding CustomerId, Mode=TwoWay}"
                            VerticalAlignment="Top"/>

                                        <controls:WarehouseSearchControl
                            Grid.Column="4"
                            SelectedWarehouseId="{Binding WarehouseId, Mode=TwoWay}"
                            VerticalAlignment="Top"/>

                                        <controls:SaleDatePickerControl
                            Grid.Column="6"
                            Label="DATE"
                            PopupTitle="SELECT INVOICE DATE"
                            SelectedDate="{Binding InvoiceDate, Mode=TwoWay}"
                            VerticalAlignment="Top"/>
                                    </Grid>

                                    <Grid Margin="0 0 0 16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="320"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="BASE RATE" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 6"/>
                                            <Border Background="#FF1A1A22" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Height="52" Padding="14 0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedCounterRate, StringFormat={}{0:N6}}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text=" " FontSize="15"/>
                                                    <TextBlock Text="{Binding SelectedCurrencyCode}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <controls:CurrencyCodeSelectorControl
                                            Grid.Column="2"
                                            CurrencyCodes="{Binding CurrencyCodes}"
                                            SelectedCurrencyCode="{Binding SelectedCurrencyCode, Mode=TwoWay}"
                                            VerticalAlignment="Top"/>
                                    </Grid>

                                    <!-- Row 2: Part | Qty | Price | [Add] [Submit] -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <!-- Part search -->
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="88"/>
                                            <!-- Qty -->
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="120"/>
                                            <!-- Unit Price -->
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="130"/>
                                            <!-- Add button -->
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="180"/>
                                            <!-- Submit button -->
                                        </Grid.ColumnDefinitions>

                                        <!--
                            PartSearchControl
                            SelectedPartId          → NewPartId          (part FK for the invoice line)
                            SelectedPartPrice       → NewUnitPrice       (auto-fills price)
                            SelectedPartDescription → NewPartDescription  (stored so Description column shows)
                        -->
                                        <controls:PartSearchControl
                            Grid.Column="0"
                            SelectedPartId="{Binding NewPartId,          Mode=TwoWay}"
                            SelectedPartPrice="{Binding NewUnitPrice,     Mode=TwoWay}"
                            SelectedPartDescription="{Binding NewPartDescription, Mode=TwoWay}"
                            VerticalAlignment="Top"/>

                                        <!-- Qty pill -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                            <TextBlock Text="QTY" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0 0 0 6"/>
                                            <Border Background="#FF1A1A22"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Height="52">
                                                <TextBox Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="15"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Padding="8 0" CaretBrush="{DynamicResource AccentBrush}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Center"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Border>
                                        </StackPanel>

                                        <!-- Unit Price pill (auto-filled, cashier can override) -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Top">
                                            <TextBlock Text="UNIT PRICE" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0 0 0 6"/>
                                            <Border Background="#FF1A1A22"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Height="52">
                                                <TextBox Text="{Binding NewUnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="15"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         Padding="8 0" CaretBrush="{DynamicResource AccentBrush}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Border>
                                        </StackPanel>

                                        <!--
                            ＋ Add button  — PrimaryButtonStyle (same glowing pill as Submit)
                            Height="52" matches the pill inputs above for perfect alignment
                        -->
                                        <Button Grid.Column="6"
                                Content="＋  Add Line"
                                Command="{Binding AddItemCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="52"
                                Margin="0,17,0,0"
                                VerticalAlignment="Top"/>

                                        <!-- Submit Invoice button -->
                                        <Button Grid.Column="8"
                                Content="✔  Submit Invoice"
                                Command="{Binding SubmitSaleCommand}" 
                                Height="52"
                                Margin="0,17,0,0"
                                VerticalAlignment="Top">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsModifyMode}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ── Items DataGrid ────────────────────────────────────────── -->
                            <Border Grid.Row="2" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Margin="20,0,20,0"
                    IsEnabled="{Binding IsInvoiceContentEnabled}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.10" BlurRadius="15" ShadowDepth="3"/>
                                </Border.Effect>
                                <DataGrid ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" BorderThickness="0"
                          GridLinesVisibility="None"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Part #"
                                            Binding="{Binding PartId}"
                                            Width="80"/>
                                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding Description}"
                                            Width="*"/>
                                        <DataGridTextColumn Header="Qty"
                                            Binding="{Binding Quantity}"
                                            Width="60"/>
                                        <DataGridTextColumn Header="Unit Price"
                                            Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                            Width="120"/>
                                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding LineTotal, StringFormat={}{0:N0}}"
                                            Width="110"
                                            FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Base Amount"
                                            Binding="{Binding BaseAmount, StringFormat={}{0:N0}}"
                                            Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- ── Footer totals ─────────────────────────────────────────── -->
                            <Border Grid.Row="3" Margin="20,10,20,20" Padding="16 12"
                                    IsEnabled="{Binding IsInvoiceContentEnabled}">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Total (USD):" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0}}"
                               FontSize="14" FontWeight="SemiBold" Margin="0 0 30 0"/>

                                    <TextBlock Text="Base Amount:" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBlock Text="{Binding BaseAmountTotal, StringFormat={}{0:N0}}"
                               FontSize="14" FontWeight="SemiBold" Margin="0 0 30 0"/>

                                    <TextBlock Text="Paid (USD):" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                             Width="150" FontSize="14" FontWeight="SemiBold"
                             Background="Transparent" BorderThickness="0 0 0 1"
                             Margin="0 0 30 0"/>

                                    <TextBlock Text="Paid (Base):" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBlock Text="{Binding PaidAmountBase, StringFormat={}{0:N0}}"
                               FontSize="14" FontWeight="SemiBold" Margin="0 0 30 0"/>

                                    <TextBlock Text="Remaining (USD):" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBlock Text="{Binding RemainingAmountUsd, StringFormat={}{0:N0}}"
                               FontSize="14" FontWeight="SemiBold" Margin="0 0 30 0"/>

                                    <TextBlock Text="Remaining (Base):" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBlock Text="{Binding RemainingAmountBase, StringFormat={}{0:N0}}"
                               FontSize="14" FontWeight="SemiBold"/>
                                </WrapPanel>
                            </Border>

                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>


            </TabControl>

            <!-- ══ GLOBAL APP FEEDBACK CENTER ══ -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0 0 24 24"
                    Width="430"
                    MaxHeight="260"
                    Background="#CC10141E"
                    CornerRadius="10"
                    Padding="12"
                    Panel.ZIndex="10">
                <StackPanel>
                    <DockPanel Margin="0 0 0 8">
                        <TextBlock Text="Activity Feed"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>
                        <Button Content="{Binding FeedToggleText}"
                                Command="{Binding ToggleFeedCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10 4"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="220">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFeedVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Margin="0 2 0 2" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFE57373"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF81C784"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>


            <!-- ══ INVOICE SEARCH OVERLAY ══ -->
            <Grid Panel.ZIndex="18">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInvoiceSearchOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Background="#80000000"/>

                <Border Width="760"
                        MaxHeight="620"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0 0 0 12">
                            <TextBlock Text="Search Invoices"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       DockPanel.Dock="Left"/>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding OpenInvoiceSearchCommand}"
                                    Content="✕"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="40"
                                    Height="34"/>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0 0 0 12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding InvoiceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="40"
                                     FontSize="14"
                                     Padding="10"
                                     VerticalContentAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Margin="8 0 0 0"
                                    Width="110"
                                    Height="40"
                                    Content="↻ Reload"
                                    Command="{Binding ReloadInvoiceSearchCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>

                        <DataGrid Grid.Row="2"
                                  Name="InvoiceSearchResultsGrid"
                                  ItemsSource="{Binding InvoiceSearchResults}"
                                  AutoGenerateColumns="False"
                                  MouseDoubleClick="InvoiceSearchResults_MouseDoubleClick"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber}" Width="170"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerId}" Width="90"/>
                                <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseId}" Width="90"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, StringFormat={}{0:N0}}" Width="120"/>
                                <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, StringFormat={}{0:N0}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ MANAGEMENT OVERLAY — ZIndex 20, shown when IsManagementOpen=True ══ -->
            <Grid Panel.ZIndex="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsManagementOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Dim backdrop -->
                <Border Background="#AA000000"/>

                <!-- Panel -->
                <Border Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1 0 0 0"
                        HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel header bar -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0 0 0 1" Padding="20 14">
                            <DockPanel>
                                <TextBlock Text="⚙  Management"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center"
                                           DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding ManagementVm.Status}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="16 0 0 0"
                                           DockPanel.Dock="Left"/>
                                <Button Content="✕  Close"
                                        Command="{Binding OpenManagementCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Padding="16 6"
                                        DockPanel.Dock="Right"/>
                            </DockPanel>
                        </Border>

                        <!-- Management tabs via DataTemplate (defined in Window.Resources above) -->
                        <ContentControl Grid.Row="1"
                                        Content="{Binding ManagementVm}"
                                        Margin="0"/>
                    </Grid>
                </Border>
            </Grid>

        </Grid><!-- end main content Grid -->

        <!-- ══ GLOBAL DATA LOADING PRELOADER ══ -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="40">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGlobalLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource PreloaderOverlayBrush}"/>

            <Border Width="320"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PreloaderCardBrush}"
                    BorderBrush="{DynamicResource PreloaderBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="0"
                                      Opacity="0.35"
                                      Color="#FF000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Syncing dashboard"
                               HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ProgressBar IsIndeterminate="True"
                                 Height="10"
                                 Margin="0 16 0 0"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="#22000000"/>
                    <TextBlock Text="Fetching latest inventory, pricing, and customer data..."
                               Margin="0 14 0 0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid><!-- end root Grid -->
</Window>
