                                <Button Command="{Binding GoToArCommand}"
                                        Click="QuickActionMenuItem_Click"
                                        Style="{StaticResource QuickActionMenuButtonStyle}"
                                        Visibility="{Binding CanViewArScreen, Converter={StaticResource BoolToVis}}"
                                        Content="🕶️  AR Experience"/>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <Popup Placement="Top"
                           PlacementTarget="{Binding ElementName=ThemesToggle}"
                           IsOpen="{Binding IsChecked, ElementName=ThemesToggle}"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="10"
                                Width="252">
                            <StackPanel>
                                <TextBlock Text="Themes"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="4 2 4 10"/>
                                <ScrollViewer MaxHeight="220"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Themes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0 0 0 6"
                                                        Click="ThemeMenuItem_Click"
                                                        Command="{Binding DataContext.SelectThemeCommand, ElementName=RootWindow}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Card"
                                                                    Background="{DynamicResource AppBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="12"
                                                                    Padding="10 8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Ellipse Grid.Column="0"
                                                                             Width="10"
                                                                             Height="10"
                                                                             Fill="{Binding AccentBrush}"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0 0 10 0"/>
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                        <TextBlock Text="{Binding SubTitle}"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="✓"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource AccentBrush}"
                                                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="6 0 0 0"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Card" Property="Background" Value="#0DFFFFFF"/>
                                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{}{0:D}'}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Right"
                               Margin="0 2 4 0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ MAIN CONTENT AREA ══════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Button x:Name="ShowSidebarButton"
                    Click="ShowSidebarButton_Click"
                    Style="{StaticResource SidebarToggleButtonStyle}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="18 18 0 0"
                    Panel.ZIndex="30"
                    ToolTip="Show navigation panel"
                    Visibility="Collapsed"
                    Opacity="0">
                <TextBlock Text="☰"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Button>

            <!-- ── Home Page ── -->
            <Grid Margin="5,0,40,10"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=HomePage}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/MaaloufLogo.png" Width="866" Height="500"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Maalouf Auto Parts" FontSize="28" FontWeight="Bold"
                               Margin="0 20 0 0" HorizontalAlignment="Center"/>
                    <WrapPanel HorizontalAlignment="Center" Margin="0 30 0 0">
                        <Button Content="Start New Sale" Command="{Binding GoToPosCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding CanViewPosScreen, Converter={StaticResource BoolToVis}}"
                                Width="200" Margin="0 0 12 12"/>
                        <Button Content="Open Part Purchases" Command="{Binding GoToPurchasesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanViewPurchasesScreen, Converter={StaticResource BoolToVis}}"
                                Width="200" Margin="0 0 12 12"/>
                        <Button Content="Open Used Car Purchases" Command="{Binding GoToUsedCarPurchasesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanViewPurchasesScreen, Converter={StaticResource BoolToVis}}"
                                Width="220" Margin="0 0 12 12"/>
                        <Button Content="Open Stock" Command="{Binding GoToStockManagementCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanViewStockManagementScreen, Converter={StaticResource BoolToVis}}"
                                Width="200" Margin="0 0 12 12"/>
                        <Button Content="Open Accounting" Command="{Binding GoToAccountingCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanViewAccountingScreen, Converter={StaticResource BoolToVis}}"
                                Width="200" Margin="0 0 12 12"/>
                        <Button Content="Open Manual Journal" Command="{Binding GoToManualJournalCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanViewManualJournalScreen, Converter={StaticResource BoolToVis}}"
                                Width="200" Margin="0 0 12 12"/>
                        <Button Content="Open AR" Command="{Binding GoToArCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanViewArScreen, Converter={StaticResource BoolToVis}}"
                                Width="200" Margin="0 0 12 12"/>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <!-- ── Accounting ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=Accounting}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Accounting Review" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Review journal activity, inspect posted entries, and monitor ledger and trial balance results."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"
                                Margin="0 0 10 0"/>
                        <Button Content="↻ Refresh"
                                Command="{Binding ManagementVm.AccountingVm.LoadReviewCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"
                                Margin="0 0 10 0"/>
                        <Button Content="Manual Journal"
                                Command="{Binding GoToManualJournalCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanViewManualJournalScreen, Converter={StaticResource BoolToVis}}"
