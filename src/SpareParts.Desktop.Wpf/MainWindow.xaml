                                <Button Command="{Binding GoToManualJournalCommand}"
                                        Click="QuickActionMenuItem_Click"
                                        Style="{StaticResource QuickActionMenuButtonStyle}"
                                        Visibility="{Binding CanViewManualJournalScreen, Converter={StaticResource BoolToVis}}"
