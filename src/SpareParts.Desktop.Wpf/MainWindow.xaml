                                <Button Command="{Binding GoToUsedCarPurchasesCommand}"
                                        Click="QuickActionMenuItem_Click"
                                        Style="{StaticResource QuickActionMenuButtonStyle}"
                                        Visibility="{Binding CanViewPurchasesScreen, Converter={StaticResource BoolToVis}}"
                                        Content="🚘  Used Car Purchases"/>

                                <Button Command="{Binding GoToStockManagementCommand}"
                                        Click="QuickActionMenuItem_Click"
                                        Style="{StaticResource QuickActionMenuButtonStyle}"
                                        Visibility="{Binding CanViewStockManagementScreen, Converter={StaticResource BoolToVis}}"
