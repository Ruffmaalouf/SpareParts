                        <Button Content="⟵ Used Car Purchases"
                                Command="{Binding GoToUsedCarPurchasesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="180" Margin="0 0 10 0"/>
                        <Button Content="⟵ Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"/>
                    </StackPanel>
                </DockPanel>

