                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Used Car Purchases" FontSize="30" FontWeight="Bold"/>
