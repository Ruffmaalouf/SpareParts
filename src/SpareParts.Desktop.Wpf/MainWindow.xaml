                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0 0 0 12">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Saved Purchases"
                                           FontSize="18"
                                           FontWeight="Bold"/>
