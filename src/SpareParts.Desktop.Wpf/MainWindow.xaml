<Window x:Class="SpareParts.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpareParts.Desktop.Wpf"
        xmlns:controls="clr-namespace:SpareParts.Desktop.Wpf;assembly=SpareParts.Desktop.Controls"
        xmlns:vm="clr-namespace:SpareParts.Desktop.Wpf.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Name="RootWindow"
        Title="Maalouf Auto Parts"
        Width="1300" Height="850"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/ManagementTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:ScreenToVisibilityConverter x:Key="ScreenToVisibilityConverter"/>
            <BooleanToVisibilityConverter      x:Key="BoolToVis"/>

        <!-- ══════ Invoice Tab Item ══════ -->
        <Style x:Key="InvoiceTabItemStyle" TargetType="TabItem">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Margin"          Value="0 0 4 0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="6 6 0 0" Padding="14 7">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"  Value="{DynamicResource CardHighlightBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════ Invoice TabControl ══════ -->
        <Style x:Key="InvoiceTabControlStyle" TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{DynamicResource AppBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0 0 0 1" Padding="8 6 8 0">
                                <DockPanel>
                                    <TabPanel x:Name="HeaderPanel" DockPanel.Dock="Left"
                                              IsItemsHost="True" VerticalAlignment="Bottom"/>
                                    <Button DockPanel.Dock="Left" Content="＋  New Invoice"
                                            Command="{Binding AddTabCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Height="30" Padding="12 4"
                                            Margin="8 0 0 4" VerticalAlignment="Bottom"/>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════════════════
         ROOT GRID — Sidebar | Content
    ════════════════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ SIDEBAR ════════════════════════════════════════════════════ -->
        <Border Grid.Column="0"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="#0DFFFFFF" BorderThickness="0 0 1 0"
                Margin="0,-10,0,10" Panel.ZIndex="2">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo -->
                <StackPanel Grid.Row="0" Margin="0 0 0 30">
                    <StackPanel.InputBindings>
                        <MouseBinding Command="{Binding GoToHomeCommand}" MouseAction="LeftClick"/>
                    </StackPanel.InputBindings>
                    <Image Source="/Assets/MaaloufLogo.png" Width="232" Height="231" Panel.ZIndex="-10"/>
                    <TextBlock FontSize="20" FontWeight="SemiBold" Foreground="White" Text="Maalouf Auto Parts"/>
                    <TextBlock Text="Parts Management" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- Selected brand card -->
                <Border Grid.Row="1" Background="{DynamicResource AppBackgroundBrush}"
                        CornerRadius="12" Padding="16" Margin="0 0 0 30">
                    <StackPanel>
                        <TextBlock Text="SELECTED MANUFACTURE" FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0 10 0 0" VerticalAlignment="Center">
                            <Image Source="{Binding SelectedBrand.Logo}"
                                   Width="40" Height="40" Margin="0 0 12 0"
                                   Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedBrand.Name, TargetNullValue='None Selected'}"
                                           FontSize="18" FontWeight="SemiBold" Foreground="White"/>
                                <TextBlock Text="{Binding SelectedBrand.Country, StringFormat=' ({0})'}"
                                           FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Brand groups -->
                <Grid Grid.Row="2">
                    <ScrollViewer VerticalScrollBarVisibility="Hidden">
                        <ItemsControl ItemsSource="{Binding BrandGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander Style="{StaticResource SectionExpanderStyle}"
                                              Header="{Binding RegionGroup}" IsExpanded="False">
                                        <ScrollViewer VerticalScrollBarVisibility="Hidden" MaxHeight="220">
                                            <ItemsControl ItemsSource="{Binding Brands}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Style="{StaticResource BrandTileStyle}"
                                                                Command="{Binding DataContext.SelectBrandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                ToolTip="{Binding Name}">
                                                            <StackPanel VerticalAlignment="Center">
                                                                <Image Source="{Binding Logo}" Height="50"
                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                <TextBlock Text="{Binding Name}" Margin="8" FontSize="11"
                                                                           HorizontalAlignment="Center"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>
                                                        </Button>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

                <!-- Bottom: management button + themes + date -->
                <StackPanel Grid.Row="3" Margin="0 0 0 10" VerticalAlignment="Bottom">

                    <Button Command="{Binding OpenManagementCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            HorizontalAlignment="Stretch" Height="38" Margin="0 0 0 16">
                        <Button.Content>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="⚙  Management"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsManagementOpen}" Value="True">
                                                <Setter Property="Text" Value="✕  Close Management"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Button.Content>
                    </Button>

                    <TextBlock Text="THEME" FontSize="10" FontWeight="Bold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 8"/>
                    <ScrollViewer MaxHeight="192" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Themes}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Margin="0 0 0 4"
                                            Command="{Binding DataContext.SelectThemeCommand, ElementName=RootWindow}"
                                            CommandParameter="{Binding}">
                                        <Button.Template>
                                            <ControlTemplate TargetType="Button">
                                                <Grid>
                                                    <Border x:Name="Card" CornerRadius="6"
                                                            Background="Transparent"
                                                            BorderBrush="#15FFFFFF" BorderThickness="1"
                                                            Padding="8 6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <Ellipse Grid.Column="0" Width="10" Height="10"
                                                                     Fill="{Binding AccentBrush}"
                                                                     VerticalAlignment="Center" Margin="0 0 8 0"/>
                                                            <StackPanel Grid.Column="1">
                                                                <TextBlock Text="{Binding Name}" FontSize="12"
                                                                           FontWeight="SemiBold" Foreground="White"/>
                                                                <TextBlock Text="{Binding SubTitle}" FontSize="10"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="2" Text="✓" FontSize="12"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                                       VerticalAlignment="Center" Margin="4 0 0 0"/>
                                                        </Grid>
                                                    </Border>
                                                </Grid>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Card" Property="Background" Value="#15FFFFFF"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Button.Template>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{}{0:D}'}"
                               FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center" Margin="0 10 0 0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ MAIN CONTENT AREA ══════════════════════════════════════════ -->
        <Grid Grid.Column="1">

            <!-- ── Home Page ── -->
            <Grid Margin="5,0,40,10"
                  Background="{DynamicResource CardBackgroundBrush}"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=HomePage}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Image Source="/Assets/MaaloufLogo.png" Width="866" Height="500"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="Maalouf Auto Parts" FontSize="28" FontWeight="Bold"
                               Margin="0 20 0 0" HorizontalAlignment="Center"/>
                    <Button Content="Start New Sale" Command="{Binding GoToPosCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="200" Margin="0 30 0 0"/>
                </StackPanel>
            </Grid>

            <!-- ── Car Selection ── -->
            <Grid Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=CarSelection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.Background>
                    <VisualBrush Stretch="Uniform" AlignmentX="Center" AlignmentY="Center" Opacity="0.04">
                        <VisualBrush.Visual>
                            <Image Source="{Binding SelectedBrand.Logo}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.Background>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20 20 20 10">
                    <Button Content="⟵ Back" Command="{Binding GoToHomeCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="100" Margin="0 0 20 0"/>
                    <Image Source="{Binding SelectedBrand.Logo}" Height="50" Margin="0 0 16 0"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding SelectedBrand.Name}" FontSize="26" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AvailableCars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectCarCommand, ElementName=RootWindow}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Margin="8" Padding="0">
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            CornerRadius="8" Padding="10" Width="220">
                                        <StackPanel>
                                            <Image Source="{Binding Image}" Height="100"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0 8 0 0"/>
                                            <TextBlock Text="{Binding Year}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding EngineType}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding BasePrice, StringFormat='Price: {0:N0}'}"
                                                       FontSize="14" FontWeight="Bold" Margin="0 4 0 0"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ── Part Selection ── -->
            <Grid Margin="20" Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=PartSelection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 20">
                    <Button Content="⟵ Back to Cars" Command="{Binding GoToCarSelectionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="150" Margin="0 0 20 0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedCar.Name, TargetNullValue='Select a car'}"
                                   FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedCar.Year}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AvailableParts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectPartCommand, ElementName=RootWindow}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Margin="8" Padding="0">
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            CornerRadius="8" Padding="10" Width="260">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Code}" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0 4 0 0"/>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0} USD}"
                                                       FontSize="14" FontWeight="SemiBold" Margin="0 8 0 0"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ── POS Invoice Tabs ── -->
            <TabControl Margin="10"
                        Style="{StaticResource InvoiceTabControlStyle}"
                        ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource InvoiceTabItemStyle}"
                        Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=Pos}">

                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Header}" FontSize="13" VerticalAlignment="Center"/>
                            <Button Content="✕"
                                    Command="{Binding DataContext.CloseTabCommand, ElementName=RootWindow}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="11" Padding="8 0 0 0"
                                    VerticalAlignment="Center" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ── Header ───────────────────────────────────────────────── -->
                            <StackPanel Grid.Row="0" Margin="20,20,20,10">
                                <TextBlock Text="New Sale" FontSize="26" FontWeight="Bold"/>
                                <TextBlock Text="Enter invoice details below" FontSize="14"
                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 4 0 0"/>
                            </StackPanel>

                            <!-- ── Form card ─────────────────────────────────────────────── -->
                            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8" Padding="20" Margin="20,0,20,15">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="20" ShadowDepth="5"/>
                                </Border.Effect>

                                <StackPanel>

                                    <!-- Row 1: Customer + Warehouse -->
                                    <Grid Margin="0 0 0 16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="190"/>
                                        </Grid.ColumnDefinitions>

                                        <controls:CustomerSearchControl
                            Grid.Column="0"
                            SelectedCustomerId="{Binding CustomerId, Mode=TwoWay}"
                            VerticalAlignment="Top"/>

                                        <controls:WarehouseSearchControl
                            Grid.Column="2"
                            SelectedWarehouseId="{Binding WarehouseId, Mode=TwoWay}"
                            VerticalAlignment="Top"/>

                                        <controls:SaleDatePickerControl
                            Grid.Column="4"
                            Label="DATE"
                            SelectedDate="{Binding InvoiceDate, Mode=TwoWay}"
                            VerticalAlignment="Top"/>
                                    </Grid>

                                    <!-- Row 2: Part | Qty | Price | [Add] [Submit] -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <!-- Part search -->
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="88"/>
                                            <!-- Qty -->
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="120"/>
                                            <!-- Unit Price -->
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="130"/>
                                            <!-- Add button -->
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="180"/>
                                            <!-- Submit button -->
                                        </Grid.ColumnDefinitions>

                                        <!--
                            PartSearchControl
                            SelectedPartId          → NewPartId          (part FK for the invoice line)
                            SelectedPartPrice       → NewUnitPrice       (auto-fills price)
                            SelectedPartDescription → NewPartDescription  (stored so Description column shows)
                        -->
                                        <controls:PartSearchControl
                            Grid.Column="0"
                            SelectedPartId="{Binding NewPartId,          Mode=TwoWay}"
                            SelectedPartPrice="{Binding NewUnitPrice,     Mode=TwoWay}"
                            SelectedPartDescription="{Binding NewPartDescription, Mode=TwoWay}"
                            VerticalAlignment="Top"/>

                                        <!-- Qty pill -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                            <TextBlock Text="QTY" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0 0 0 6"/>
                                            <Border Background="#FF1A1A22"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Height="52">
                                                <TextBox Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="15"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Padding="8 0" CaretBrush="{DynamicResource AccentBrush}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Center"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Border>
                                        </StackPanel>

                                        <!-- Unit Price pill (auto-filled, cashier can override) -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Top">
                                            <TextBlock Text="UNIT PRICE" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0 0 0 6"/>
                                            <Border Background="#FF1A1A22"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Height="52">
                                                <TextBox Text="{Binding NewUnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="15"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         Padding="8 0" CaretBrush="{DynamicResource AccentBrush}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Border>
                                        </StackPanel>

                                        <!--
                            ＋ Add button  — PrimaryButtonStyle (same glowing pill as Submit)
                            Height="52" matches the pill inputs above for perfect alignment
                        -->
                                        <Button Grid.Column="6"
                                Content="＋  Add Line"
                                Command="{Binding AddItemCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="52"
                                Margin="0,17,0,0"
                                VerticalAlignment="Top"/>

                                        <!-- Submit Invoice button -->
                                        <Button Grid.Column="8"
                                Content="✔  Submit Invoice"
                                Command="{Binding SubmitSaleCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="52"
                                Margin="0,17,0,0"
                                VerticalAlignment="Top">
                                            <!-- Slightly different shade so the two buttons are visually distinct -->
                                            <Button.Resources>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                    <Setter Property="Opacity" Value="0.92"/>
                                                </Style>
                                            </Button.Resources>
                                        </Button>

                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ── Items DataGrid ────────────────────────────────────────── -->
                            <Border Grid.Row="2" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Margin="20,0,20,0">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.10" BlurRadius="15" ShadowDepth="3"/>
                                </Border.Effect>
                                <DataGrid ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" BorderThickness="0"
                          GridLinesVisibility="None"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Part #"
                                            Binding="{Binding PartId}"
                                            Width="80"/>
                                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding Description}"
                                            Width="*"/>
                                        <DataGridTextColumn Header="Qty"
                                            Binding="{Binding Quantity}"
                                            Width="60"/>
                                        <DataGridTextColumn Header="Unit Price"
                                            Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                            Width="120"/>
                                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding LineTotal, StringFormat={}{0:N0}}"
                                            Width="110"
                                            FontWeight="Bold"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- ── Footer totals ─────────────────────────────────────────── -->
                            <Border Grid.Row="3" Margin="20,10,20,20" Padding="16 12">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Total:" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0}}"
                               FontSize="14" FontWeight="SemiBold" Margin="0 0 30 0"/>

                                    <TextBlock Text="Paid:" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                             Width="150" FontSize="14" FontWeight="SemiBold"
                             Background="Transparent" BorderThickness="0 0 0 1"
                             Margin="0 0 30 0"/>

                                    <TextBlock Text="Remaining:" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBlock Text="{Binding RemainingAmount, StringFormat={}{0:N0}}"
                               FontSize="14" FontWeight="SemiBold"/>
                                </StackPanel>
                            </Border>

                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>


            </TabControl>

            <!-- ══ GLOBAL APP FEEDBACK CENTER ══ -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0 0 24 24"
                    Width="430"
                    MaxHeight="260"
                    Background="#CC10141E"
                    CornerRadius="10"
                    Padding="12"
                    Panel.ZIndex="10">
                <StackPanel>
                    <DockPanel Margin="0 0 0 8">
                        <TextBlock Text="Activity Feed"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>
                        <Button Content="{Binding FeedToggleText}"
                                Command="{Binding ToggleFeedCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10 4"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="220">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFeedVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Margin="0 2 0 2" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFE57373"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF81C784"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- ══ MANAGEMENT OVERLAY — ZIndex 20, shown when IsManagementOpen=True ══ -->
            <Grid Panel.ZIndex="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsManagementOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Dim backdrop -->
                <Border Background="#AA000000"/>

                <!-- Panel -->
                <Border Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1 0 0 0"
                        HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel header bar -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0 0 0 1" Padding="20 14">
                            <DockPanel>
                                <TextBlock Text="⚙  Management"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center"
                                           DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding ManagementVm.Status}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="16 0 0 0"
                                           DockPanel.Dock="Left"/>
                                <Button Content="✕  Close"
                                        Command="{Binding OpenManagementCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Padding="16 6"
                                        DockPanel.Dock="Right"/>
                            </DockPanel>
                        </Border>

                        <!-- Management tabs via DataTemplate (defined in Window.Resources above) -->
                        <ContentControl Grid.Row="1"
                                        Content="{Binding ManagementVm}"
                                        Margin="0"/>
                    </Grid>
                </Border>
            </Grid>

        </Grid><!-- end main content Grid -->
    </Grid><!-- end root Grid -->
</Window>
