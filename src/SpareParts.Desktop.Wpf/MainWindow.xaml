                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120" Margin="0 0 10 0"/>
                        <Button Content="Part Purchases"
                                Command="{Binding GoToPurchasesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="150" Margin="0 0 10 0"/>
                        <Button Content="Used Car History"
                                Command="{Binding GoToPurchaseHistoryCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="160" Margin="0 0 10 0"/>
                        <Button Content="Open POS"
                                Command="{Binding GoToPosCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="120"/>
                    </StackPanel>
                </DockPanel>

                <local:UsedCarPurchasesControl Grid.Row="1"
                                               DataContext="{Binding PurchasesVm}"/>
            </Grid>

            <!-- ── Used Car Purchase History ── -->
