<Window x:Class="SpareParts.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpareParts.Desktop.Wpf"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Name="RootWindow"
        Title="Maalouf Auto Parts "
        Width="1300" Height="850"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        WindowState="Maximized">
    <Window.Resources>
        <local:ScreenToVisibilityConverter x:Key="ScreenToVisibilityConverter" />
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="177*"/>
            <ColumnDefinition Width="823*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource CardBackgroundBrush}" BorderBrush="#0DFFFFFF" BorderThickness="0 0 1 0" Margin="0,-10,0,10" Panel.ZIndex="2">
            <Grid Margin="24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0 0 0 30">
                    <StackPanel.InputBindings>
                        <MouseBinding Command="{Binding GoToHomeCommand}"
                      MouseAction="LeftClick" />
                    </StackPanel.InputBindings>

                    <Image Source="/Assets/MaaloufLogo.png"
           Width="232"
           Height="231"
           Panel.ZIndex="-10"/>
                    <TextBlock FontSize="20"
               FontWeight="SemiBold"
               Foreground="White"
               Text="Maalouf Auto Parts"/>
                    <TextBlock Text="Parts Management"
               FontSize="12"
               Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>

                <Border Grid.Row="1" 
        Background="{StaticResource AppBackgroundBrush}" 
        CornerRadius="12" 
        Padding="16" 
        Margin="0 0 0 30">

                    <StackPanel>

                        <TextBlock Text="SELECTED MANUFACTURE" 
                   FontSize="10" 
                   FontWeight="Bold" 
                   Foreground="{StaticResource TextSecondaryBrush}" />

                        <!-- Logo + brand info -->
                        <StackPanel Orientation="Horizontal" Margin="0 10 0 0" VerticalAlignment="Center">

                            <!-- LOGO -->
                            <Image Source="{Binding SelectedBrand.LogoPath}"
                   Width="40" Height="40"
                   Margin="0 0 12 0"
                   Stretch="Uniform"
                   RenderOptions.BitmapScalingMode="HighQuality"/>

                            <!-- Brand Name + Country -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding SelectedBrand.Name, TargetNullValue='None Selected'}" 
                           FontSize="18" 
                           FontWeight="SemiBold" 
                           Foreground="White" 
                           VerticalAlignment="Center"/>

                                <TextBlock Text="{Binding SelectedBrand.Country, StringFormat=' ({0})'}" 
                           FontSize="14" 
                           Foreground="{StaticResource TextSecondaryBrush}" 
                           VerticalAlignment="Center" 
                           Margin="4 0 0 0"/>
                            </StackPanel>

                        </StackPanel>

                    </StackPanel>
                </Border>
                <Grid Grid.Row="2">
                    <StackPanel>

                        <!-- GERMAN -->
                        <Expander Style="{StaticResource SectionExpanderStyle}"
                  Expanded="BrandExpander_Expanded"
                  Header="GERMAN"
                  IsExpanded="False">

                            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          MaxHeight="220">
                                <!-- adjust height -->
                                <ItemsControl ItemsSource="{Binding GermanBrands}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BrandTileStyle}" 
                                    Command="{Binding DataContext.SelectBrandCommand, ElementName=RootWindow}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Name}">
                                                <StackPanel VerticalAlignment="Center">
                                                    <Image Source="{Binding LogoPath}"
                                           Height="50"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="{Binding Name}"
                                               Margin="8 8 8 8"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>

                        <!-- KOREAN -->
                        <Expander Style="{StaticResource SectionExpanderStyle}"
                  Expanded="BrandExpander_Expanded"
                  Header="KOREAN"
                  IsExpanded="False">

                            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          MaxHeight="220">
                                <ItemsControl ItemsSource="{Binding KoreanBrands}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BrandTileStyle}" 
                                    Command="{Binding DataContext.SelectBrandCommand, ElementName=RootWindow}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Name}">
                                                <StackPanel VerticalAlignment="Center">
                                                    <Image Source="{Binding LogoPath}"
                                           Height="50"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="{Binding Name}"
                                               Margin="8 8 8 8"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>

                        <!-- JAPANESE -->
                        <Expander Style="{StaticResource SectionExpanderStyle}"
                  Expanded="BrandExpander_Expanded"
                  Header="JAPANESE"
                  IsExpanded="False">

                            <ScrollViewer VerticalScrollBarVisibility="Hidden"
                          MaxHeight="220">
                                <ItemsControl ItemsSource="{Binding JapaneseBrands}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource BrandTileStyle}" 
                                    Command="{Binding DataContext.SelectBrandCommand, ElementName=RootWindow}"
                                    CommandParameter="{Binding}"
                                    ToolTip="{Binding Name}">
                                                <StackPanel VerticalAlignment="Center">
                                                    <Image Source="{Binding LogoPath}"
                                           Height="40"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <TextBlock Text="{Binding Name}"
                                               Margin="0 8 0 0"
                                               FontSize="11"
                                               HorizontalAlignment="Center"
                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Expander>

                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0 0 0 10" VerticalAlignment="Bottom">
                    <TextBlock Text="THEME"
               FontSize="10"
               FontWeight="Bold"
               Foreground="{StaticResource TextSecondaryBrush}"
               Margin="0 0 0 4"/>

                    <ComboBox ItemsSource="{Binding Themes}"
          Style="{StaticResource ThemeComboBoxStyle}"
          SelectedItem="{Binding SelectedTheme}"
          DisplayMemberPath="Name"
          HorizontalAlignment="Stretch"
          MinWidth="220"
          Margin="0 0 0 6"/>


                    <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{}{0:D}'}" 
               FontSize="12"
               Foreground="{StaticResource TextSecondaryBrush}"
               HorizontalAlignment="Center"/>
                </StackPanel> 
            </Grid>
        </Border>

        <Grid Grid.Column="1" Grid.ColumnSpan="2"
      Margin="10,10,40,30"
      Background="{StaticResource CardBackgroundBrush}"
      Visibility="{Binding ActiveScreen,
                           Converter={StaticResource ScreenToVisibilityConverter},
                           ConverterParameter=Pos}">

            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto"/>
                <!-- Invoice header / add line form -->
                <RowDefinition Height="Auto"/>
                <!-- Items list -->
                <RowDefinition Height="*"/>
                <!-- Totals + submit -->
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ========= HEADER ========= -->
            <StackPanel Grid.Row="0" Margin="0,0,0,20">
                <TextBlock Text="New Sale"
                   FontSize="26"
                   FontWeight="Bold"/>
                <TextBlock Text="Enter invoice details below"
                   FontSize="14"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   Margin="0 4 0 0"/>
            </StackPanel>

            <!-- ========= FORM CARD ========= -->
            <Border Grid.Row="1"
            Background="{StaticResource CardBackgroundBrush}"
            CornerRadius="8"
            Padding="20"
            Margin="0,0,0,15">
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                              Opacity="0.15"
                              BlurRadius="20"
                              ShadowDepth="5"/>
                </Border.Effect>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Customer/Warehouse -->
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="0 0 40 0">
                        <StackPanel Margin="0 0 15 0">
                            <TextBlock Text="Customer ID"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Width="100"
                             Text="{Binding CustomerId}"
                             HorizontalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Warehouse"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Width="80"
                             Text="{Binding WarehouseId}"
                             HorizontalContentAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>

                    <!-- Part entry -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <StackPanel Margin="0 0 10 0">
                            <TextBlock Text="Part ID"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Width="80"
                             Text="{Binding NewPartId}"
                             HorizontalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0 0 10 0">
                            <TextBlock Text="Qty"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Width="60"
                             Text="{Binding NewQuantity}"
                             HorizontalContentAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Margin="0 0 15 0">
                            <TextBlock Text="Price"
                               FontSize="11"
                               Foreground="{StaticResource TextSecondaryBrush}"/>
                            <TextBox Width="90"
                             Text="{Binding NewUnitPrice}"
                             HorizontalContentAlignment="Right"/>
                        </StackPanel>

                        <Button Style="{StaticResource SecondaryButtonStyle}" 
                        Content="+ Add Line" 
                        Command="{Binding AddLineCommand}" 
                        VerticalAlignment="Bottom"
                        Height="36"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ========= ITEMS LIST (SCROLLABLE) ========= -->
            <Border Grid.Row="2"
            CornerRadius="8"
            Background="{StaticResource CardBackgroundBrush}">
                <Border.Effect>
                    <DropShadowEffect Color="Black"
                              Opacity="0.10"
                              BlurRadius="15"
                              ShadowDepth="3"/>
                </Border.Effect>

                <DataGrid ItemsSource="{Binding Items}" 
                  AutoGenerateColumns="False" 
                  CanUserAddRows="False"
                  HeadersVisibility="Column"
                  BorderThickness="0"
                  GridLinesVisibility="None"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  ScrollViewer.CanContentScroll="True"
                  Margin="0">

                    <!-- Neon scrollbar for the DataGrid scroll viewer -->
                    <DataGrid.Resources>
                        <Style TargetType="{x:Type ScrollBar}"
                       BasedOn="{StaticResource NeonScrollBar}"/>
                    </DataGrid.Resources>

                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Part #"
                                    Binding="{Binding PartId}"
                                    Width="100"/>
                        <DataGridTextColumn Header="Qty"
                                    Binding="{Binding Quantity}"
                                    Width="80"/>
                        <DataGridTextColumn Header="Unit Price"
                                    Binding="{Binding UnitPrice, StringFormat=C}"
                                    Width="120"/>
                        <DataGridTextColumn Header="Total"
                                    Binding="{Binding LineTotal, StringFormat=C}"
                                    Width="*"
                                    FontWeight="Bold"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Border>

            <!-- ========= FOOTER (TOTALS + SUBMIT) ========= -->
            <Border Grid.Row="3"
            Margin="0,10,0,0"
            Padding="10 10 0 0"
            Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: totals -->
                    <StackPanel Orientation="Horizontal"
                        VerticalAlignment="Center">
                        <TextBlock Text="Total:"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0 0 10 0"/>
                        <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0}}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Margin="0 20 20 0"/>

                        <TextBlock Text="Total Paid:"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0 0 10 0"/>
                        <TextBox Text="{Binding PaidAmount,
                                        UpdateSourceTrigger=PropertyChanged,
                                        StringFormat={}{0:N0}}"
                         Width="150"
                         FontSize="14"
                         FontWeight="SemiBold"
                         Background="Transparent"
                         BorderThickness="0 0 0 1"
                         Margin="0 0 20 0"/>

                        <TextBlock Text="Remaining:"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Margin="0 0 10 0"/>
                        <TextBlock Text="{Binding RemainingAmount, StringFormat={}{0:N0}}"
                           FontSize="14"
                           FontWeight="SemiBold"/>
                    </StackPanel>

                    <!-- Right: submit button -->
                    <Button Grid.Column="1" 
                    Content="Submit Invoice" 
                    Command="{Binding SubmitSaleCommand}"
                    Style="{StaticResource PrimaryButtonStyle}" 
                    Width="180"
                    HorizontalAlignment="Right"/>
                </Grid>
            </Border>

        </Grid>
        <Grid Grid.Column="1" Grid.ColumnSpan="2"
      Visibility="{Binding ActiveScreen,
                           Converter={StaticResource ScreenToVisibilityConverter},
                           ConverterParameter=CarSelection}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid.Background>
                <VisualBrush Stretch="Uniform" 
                 AlignmentX="Center" 
                 AlignmentY="Center" 
                 Opacity="0.56">
                    <VisualBrush.Visual>
                        <Image Source="{Binding SelectedBrand.LogoPath}"
                   Width="280"   
                            Height="600"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Grid.Background>
            <!-- Header with back button + title -->
            <!-- Header with back button + title -->
            <StackPanel Grid.Row="0"
            Orientation="Horizontal"
            Margin="0 0 0 20"
            VerticalAlignment="Center">

                <!-- Back Button -->
                <Button Content="⟵ Back"
            Command="{Binding GoToPosCommand}"
            Style="{StaticResource PrimaryButtonStyle}"
            Width="100"
            Margin="0 0 20 0"/>

                <!-- Logo + Text -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="{Binding SelectedBrand.LogoPath}"
               Width="40"
               Height="40"
               Margin="0 0 15 0"
               RenderOptions.BitmapScalingMode="HighQuality"
               Stretch="Uniform"/>

                    <StackPanel>
                        <TextBlock Text="{Binding SelectedBrand.Name, TargetNullValue=Select a Brand}"
                       FontSize="24"
                       FontWeight="Bold"/>

                        <TextBlock Text="Available Cars"
                       FontSize="14"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- Cars list with neon scroll -->
            <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}" 
                   BasedOn="{StaticResource NeonScrollBar}"/>
                </ScrollViewer.Resources>

                <ItemsControl ItemsSource="{Binding AvailableCars}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectCarCommand, ElementName=RootWindow}"
                            CommandParameter="{Binding}"
                            Opacity="0.50"
                            Margin="8"
                            Padding="0"
                            Background="Transparent"
                            BorderThickness="0">
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                CornerRadius="8"
                                Padding="10"
                                Width="220">
                                    <StackPanel>
                                        <Image Source="{Binding ImagePath}"
                                       Height="100"
                                       Stretch="UniformToFill"
                                       Opacity="0.50"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Name}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Margin="0 8 0 0"/>
                                        <TextBlock Text="{Binding Year}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding EngineType}"
                                           FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding BasePrice, StringFormat=Price: {0:N0}}"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Margin="0 4 0 0"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
        <Grid Grid.Column="1" Margin="40,30,40,30"
          Visibility="{Binding ActiveScreen,
                               Converter={StaticResource ScreenToVisibilityConverter},
                               ConverterParameter=PartSelection}" Grid.ColumnSpan="2">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 20">
                <Button Content="⟵ Back to Cars"
                    Command="{Binding GoToCarSelectionCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    Width="150"
                    Margin="0 0 20 0"/>

                <StackPanel>
                    <TextBlock Text="{Binding SelectedCar.Name, TargetNullValue=Select a car}"
                           FontSize="22"
                           FontWeight="Bold"/>
                    <TextBlock Text="{Binding SelectedCar.Year}"
                           FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"/>
                </StackPanel>
            </StackPanel>

            <!-- Parts list -->
            <ScrollViewer Margin="0,65,-24,-15" Grid.RowSpan="2" VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Resources>
                    <Style TargetType="{x:Type ScrollBar}" 
               BasedOn="{StaticResource NeonScrollBar}"/>
                </ScrollViewer.Resources>
                <ItemsControl ItemsSource="{Binding AvailableParts}" Width="955" Height="728">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>

                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Command="{Binding DataContext.SelectPartCommand, ElementName=RootWindow}"
                                CommandParameter="{Binding}"
                                Background="Transparent"
                                BorderThickness="0"
                                Margin="8"
                                Padding="0">
                                <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="8"
                                    Padding="10"
                                    Width="260">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Code}"
                                               FontSize="14"
                                               FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               Margin="0 4 0 0"/>
                                        <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0} USD}"
                                               FontSize="14"
                                               FontWeight="SemiBold"
                                               Margin="0 8 0 0"/>
                                    </StackPanel>
                                </Border>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

        </Grid>
        <Grid Grid.Column="1" Margin="5,0,40,10" Background="{StaticResource CardBackgroundBrush}" 
          Visibility="{Binding ActiveScreen,
                               Converter={StaticResource ScreenToVisibilityConverter},
                               ConverterParameter=HomePage}" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Your logo image -->

                    <!-- Your logo image -->

                    <!-- Your logo image -->
                    <Image Source="/Assets/MaaloufLogo.png"
                       Width="866"
                       Height="500"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"/>

                    <TextBlock Text="Maalouf Auto Parts"
                           FontSize="28"
                           FontWeight="Bold"
                           Margin="0 20 0 0"
                           HorizontalAlignment="Center"/>

                    <!-- Button to go to POS -->
                    <Button Content="Start New Sale"
                        Command="{Binding GoToPosCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="200"
                        Margin="0 30 0 0"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>