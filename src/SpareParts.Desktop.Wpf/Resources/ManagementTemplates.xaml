                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource CardHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0 0 8 0">
                                        <StackPanel>
                                            <TextBlock Text="Demand" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding DemandMatchPartCount}" FontSize="18" FontWeight="Bold"/>
                                        </StackPanel>
                                    </Border>
                                    <Border Background="{DynamicResource CardHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                                        <StackPanel>
                                            <TextBlock Text="Action" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding ActionNeededPartCount}" FontSize="18" FontWeight="Bold"/>
