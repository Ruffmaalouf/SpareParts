<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SpareParts.Desktop.Wpf"
                    xmlns:controls="clr-namespace:SpareParts.Desktop.Wpf;assembly=SpareParts.Desktop.Controls"
                    xmlns:ViewModels="clr-namespace:SpareParts.Desktop.Wpf;assembly=SpareParts.Desktop.ViewModels">

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ══════ Management DataTemplate ══════ -->
    <DataTemplate DataType="{x:Type ViewModels:ManagementViewModel}">
            <DataTemplate.Resources>
                <Style x:Key="InvisibleComboOverlayButtonStyle" TargetType="ToggleButton">
                    <Setter Property="Focusable" Value="False"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="BorderBrush" Value="Transparent"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="OverridesDefaultStyle" Value="True"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ToggleButton">
                                <Border Background="Transparent"/>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="ManagementComboBoxStyle" TargetType="ComboBox">
                    <Setter Property="Height" Value="52"/>
                    <Setter Property="Padding" Value="14 0"/>
                    <Setter Property="Margin" Value="0 0 0 10"/>
                    <Setter Property="Background" Value="#FF1A1A22"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="FontSize" Value="15"/>
                    <Setter Property="ItemContainerStyle" Value="{DynamicResource ThemeComboBoxItemStyle}"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ComboBox">
                                <Grid>
                                    <Border x:Name="OuterBorder"
                                            Background="{TemplateBinding Background}"
                                            BorderBrush="{TemplateBinding BorderBrush}"
                                            BorderThickness="{TemplateBinding BorderThickness}"
                                            CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <ContentPresenter Grid.Column="0"
                                                              Margin="{TemplateBinding Padding}"
                                                              VerticalAlignment="Center"
                                                              HorizontalAlignment="Left"
                                                              TextElement.Foreground="{TemplateBinding Foreground}"
                                                              Content="{TemplateBinding SelectionBoxItem}"
                                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"/>

                                            <Border Grid.Column="1"
                                                    Width="34"
                                                    Height="34"
                                                    Margin="0 0 8 0"
                                                    Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="8"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="&#xE70D;"
                                                           FontFamily="Segoe MDL2 Assets"
                                                           FontSize="11"
                                                           Foreground="White"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <Popup x:Name="PART_Popup"
                                           Placement="Bottom"
                                           AllowsTransparency="True"
                                           Focusable="False"
                                           IsOpen="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                           PopupAnimation="Fade">
                                        <Border Margin="0 6 0 0"
                                                MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"
                                                Background="#FF1E1E28"
                                                BorderBrush="#33FF5722"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                            <ScrollViewer Margin="4"
                                                          MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                                <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Contained"/>
                                            </ScrollViewer>
                                        </Border>
                                    </Popup>

                                    <ToggleButton Style="{StaticResource InvisibleComboOverlayButtonStyle}"
                                                  IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="HasItems" Value="False">
                                        <Setter TargetName="PART_Popup" Property="MinHeight" Value="60"/>
                                    </Trigger>
                                    <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                        <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.6"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

            </DataTemplate.Resources>
            <TabControl Background="Transparent" BorderThickness="0" Margin="0">

                <!-- TAB 1 — CUSTOMERS -->
                <TabItem Header="👤  Customers">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="10" Padding="24" Margin="0 0 12 0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="New Customer" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>
                                    <Button Content="＋  New / Clear Selection" Command="{Binding StartNewManagementItemCommand}" CommandParameter="Customer"
                                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Height="38" Margin="0 0 0 16"/>
                                    <TextBlock Text="Name *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Phone" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Email" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCustomerEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Address" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCustomerAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Tax Number" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCustomerTax, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Opening Balance" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCustomerBalance, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 20"/>
                                    <Button Content="＋  Save Customer" Command="{Binding SaveCustomerCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42"/>
                                    <Button Content="🗑  Delete Selected" Command="{Binding DeleteCustomerCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                                    <TextBlock Text="{Binding Status}" FontSize="12" Margin="0 10 0 0"
                                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                    <TextBlock Text="All Customers" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button Content="↻ Refresh" Command="{Binding LoadAllCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="14 6"/>
                                </DockPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Customers}"
                                          SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                          HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID"      Binding="{Binding Id}"             Width="50"/>
                                        <DataGridTextColumn Header="Name"    Binding="{Binding Name}"           Width="*"/>
                                        <DataGridTextColumn Header="Phone"   Binding="{Binding Phone}"          Width="120"/>
                                        <DataGridTextColumn Header="Email"   Binding="{Binding Email}"          Width="160"/>
                                        <DataGridTextColumn Header="Account" Binding="{Binding AccountDisplay}" Width="180"/>
                                        <DataGridTextColumn Header="Balance" Binding="{Binding OpeningBalance, StringFormat={}{0:N0}}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2 — SUPPLIERS -->
                <TabItem Header="🏭  Suppliers"
                         Visibility="{Binding CanViewSupplierTab, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="10" Padding="24" Margin="0 0 12 0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="New Supplier" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>
                                    <Button Content="＋  New / Clear Selection" Command="{Binding StartNewManagementItemCommand}" CommandParameter="Supplier"
                                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Height="38" Margin="0 0 0 16"/>
                                    <TextBlock Text="Name *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewSupplierName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Phone" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewSupplierPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Email" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewSupplierEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Address" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewSupplierAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Tax Number" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewSupplierTax, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Opening Balance" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewSupplierBalance, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 20"/>
                                    <Button Content="＋  Save Supplier" Command="{Binding SaveSupplierCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42"/>
                                    <Button Content="🗑  Delete Selected" Command="{Binding DeleteSupplierCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                    <TextBlock Text="All Suppliers" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button Content="↻ Refresh" Command="{Binding LoadAllCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="14 6"/>
                                </DockPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Suppliers}"
                                          SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                          HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID"      Binding="{Binding Id}"             Width="50"/>
                                        <DataGridTextColumn Header="Name"    Binding="{Binding Name}"           Width="*"/>
                                        <DataGridTextColumn Header="Phone"   Binding="{Binding Phone}"          Width="120"/>
                                        <DataGridTextColumn Header="Account" Binding="{Binding AccountDisplay}" Width="180"/>
                                        <DataGridTextColumn Header="Balance" Binding="{Binding OpeningBalance, StringFormat={}{0:N0}}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 3 — BRANDS -->
                <TabItem Header="🏷  Brands">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="10" Padding="24" Margin="0 0 12 0">
                            <StackPanel>
                                    <TextBlock Text="New Brand" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>
                                    <Button Content="＋  New / Clear Selection" Command="{Binding StartNewManagementItemCommand}" CommandParameter="Brand"
                                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Height="38" Margin="0 0 0 16"/>
                                <TextBlock Text="Name *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding NewBrandName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 20"/>
                                <Button Content="＋  Save Brand" Command="{Binding SaveBrandCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Height="42"/>
                                <Button Content="🗑  Delete Selected" Command="{Binding DeleteBrandCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                    <TextBlock Text="All Brands" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button Content="↻ Refresh" Command="{Binding LoadAllCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="14 6"/>
                                </DockPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Brands}"
                                          SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                          HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID"     Binding="{Binding Id}"       Width="50"/>
                                        <DataGridTextColumn Header="Name"   Binding="{Binding Name}"     Width="*"/>
                                        <DataGridTextColumn Header="Active" Binding="{Binding IsActive}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 4 — PARTS -->
                <TabItem Header="🔧  Parts">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="10" Padding="24" Margin="0 0 12 0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="New Part" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>
                                    <Button Content="＋  New / Clear Selection" Command="{Binding StartNewManagementItemCommand}" CommandParameter="Part"
                                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Height="38" Margin="0 0 0 16"/>
                                    <TextBlock Text="Internal Code *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartCode, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Name *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="OEM Number" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartOEM, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Category" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <ComboBox ItemsSource="{Binding Categories}"
                                              Style="{StaticResource ManagementComboBoxStyle}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding NewPartCategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              />
                                    <TextBlock Text="Brand" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <ComboBox ItemsSource="{Binding Brands}"
                                              Style="{StaticResource ManagementComboBoxStyle}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding NewPartBrandId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              />
                                    <TextBlock Text="Cost Price" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartCostPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Sale Price" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartSalePrice, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Average Price" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartAveragePrice, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Currency Code" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <ComboBox ItemsSource="{Binding CurrencyRates}"
                                              Style="{StaticResource ManagementComboBoxStyle}"
                                              DisplayMemberPath="Code"
                                              SelectedValuePath="Code"
                                              SelectedValue="{Binding NewPartCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Min Stock" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartMinStock, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Notes" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <Border Background="{DynamicResource CardHighlightBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            Padding="12"
                                            Margin="0 0 0 10">
                                        <StackPanel>
                                            <TextBlock Text="AI Assist" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="Draft concise catalog notes and estimate an average selling price from the current part details."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0 4 0 10"/>
                                            <Button Content="{Binding PartAiButtonText}"
                                                    Command="{Binding GeneratePartNotesCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    Height="36"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBox Text="{Binding NewPartNotes, UpdateSourceTrigger=PropertyChanged}"
                                             Height="90"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0 0 0 20"/>
                                    <Button Content="＋  Save Part" Command="{Binding SavePartCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42"/>
                                    <Button Content="🗑  Delete Selected" Command="{Binding DeletePartCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                    <TextBlock Text="All Parts" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button Content="↻ Refresh" Command="{Binding LoadAllCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="14 6"/>
                                </DockPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Parts}"
                                          SelectedItem="{Binding SelectedPart, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                          HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID"       Binding="{Binding Id}"                               Width="50"/>
                                        <DataGridTextColumn Header="Code"     Binding="{Binding InternalCode}"                     Width="100"/>
                                        <DataGridTextColumn Header="Name"     Binding="{Binding Name}"                             Width="*"/>
                                        <DataGridTextColumn Header="OEM"      Binding="{Binding OEMNumber}"                        Width="100"/>
                                        <DataGridTextColumn Header="Cost"     Binding="{Binding CostPrice, StringFormat={}{0:N0}}" Width="80"/>
                                        <DataGridTextColumn Header="Sale"     Binding="{Binding SalePrice, StringFormat={}{0:N0}}" Width="80"/>
                                        <DataGridTextColumn Header="Average"  Binding="{Binding AveragePrice, StringFormat={}{0:N0}}" Width="90"/>
                                        <DataGridTextColumn Header="Min Stock" Binding="{Binding MinStock}"                        Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 5 — CAR BRANDS -->
                <TabItem Header="🚘  Car Brands">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="10" Padding="24" Margin="0 0 12 0">
                            <StackPanel>
                                <TextBlock Text="Car Brand" FontSize="18" FontWeight="Bold" Margin="0 0 0 10"/>
                                <Button Content="＋  New / Clear Selection" Command="{Binding StartNewManagementItemCommand}" CommandParameter="CarBrand"
                                        Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Height="38" Margin="0 0 0 16"/>
                                <TextBlock Text="Name *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding NewCarBrandName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                <TextBlock Text="Country" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding NewCarBrandCountry, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                <TextBlock Text="Region Group" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding NewCarBrandRegionGroup, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                <TextBlock Text="Sort Order" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding NewCarBrandSortOrder, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 20"/>
                                <Button Content="＋  Save Car Brand" Command="{Binding SaveCarBrandCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Height="42"/>
                                <Button Content="🗑  Delete Selected" Command="{Binding DeleteCarBrandCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                    <TextBlock Text="All Car Brands" FontSize="18" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button Content="↻ Refresh" Command="{Binding LoadAllCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="14 6"/>
                                </DockPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding CarBrands}"
                                          SelectedItem="{Binding SelectedCarBrand, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                          HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID"          Binding="{Binding Id}"              Width="50"/>
                                        <DataGridTextColumn Header="Name"        Binding="{Binding Name}"            Width="*"/>
                                        <DataGridTextColumn Header="Country"     Binding="{Binding Country}"         Width="120"/>
                                        <DataGridTextColumn Header="Region"      Binding="{Binding RegionGroup}"     Width="120"/>
                                        <DataGridTextColumn Header="Sort Order"  Binding="{Binding SortOrder}"       Width="90"/>
                                        <DataGridCheckBoxColumn Header="Active"  Binding="{Binding IsActive}"        Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 6 — CAR MODELS -->
                <TabItem Header="🚗  Car Models">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
