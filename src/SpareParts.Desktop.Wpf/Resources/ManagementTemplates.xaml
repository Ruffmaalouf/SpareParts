                                        <ColumnDefinition Width="2*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox Grid.Column="0"
                                             Text="{Binding PartFilterText, UpdateSourceTrigger=PropertyChanged}"
                                             Margin="0 0 10 0"
                                             ToolTip="Search code, barcode, name, OEM, condition, donor car id, or notes"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding PartAvailabilityFilters}"
                                              SelectedItem="{Binding PartAvailabilityFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ManagementComboBoxStyle}"
                                              Margin="0 0 10 0"/>
                                     <StackPanel Grid.Column="2">
                                         <TextBlock Text="{Binding SelectedPartStockSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                         <TextBlock Text="{Binding SelectedPartPriceSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0 3 0 0"/>
                                         <TextBlock Text="{Binding SelectedPartDonorSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0 3 0 0"/>
                                         <TextBlock Text="{Binding SelectedPartDemandSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0 3 0 0"/>
                                         <TextBlock Text="{Binding SelectedPartActionSummary}" FontSize="11" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0 3 0 0"/>
                                     </StackPanel>
                                 </Grid>
                                <Border Grid.Row="3"
