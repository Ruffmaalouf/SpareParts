                                        <DataGridTextColumn Header="ID"       Binding="{Binding Id, Mode=OneWay}"                               Width="50"/>
                                        <DataGridTextColumn Header="Code"     Binding="{Binding InternalCode, Mode=OneWay}"                     Width="100"/>
                                        <DataGridTextColumn Header="Barcode"  Binding="{Binding Barcode, Mode=OneWay}"                          Width="120"/>
                                        <DataGridTextColumn Header="Name"     Binding="{Binding Name, Mode=OneWay}"                             Width="*"/>
                                        <DataGridTextColumn Header="Condition" Binding="{Binding Condition, Mode=OneWay}"                        Width="90"/>
                                        <DataGridTextColumn Header="Avail"    Binding="{Binding AvailableQuantity, Mode=OneWay}"                 Width="70"/>
                                        <DataGridTextColumn Header="Reserved" Binding="{Binding ReservedQuantity, Mode=OneWay}"                  Width="85"/>
                                        <DataGridTextColumn Header="On Hand"  Binding="{Binding StockQuantity, Mode=OneWay}"                     Width="80"/>
                                        <DataGridTextColumn Header="OEM"      Binding="{Binding OEMNumber, Mode=OneWay}"                        Width="100"/>
                                        <DataGridTextColumn Header="Donor"    Binding="{Binding UsedCarId, Mode=OneWay}"                         Width="70"/>
                                        <DataGridTextColumn Header="Cur"      Binding="{Binding Currency, Mode=OneWay}"                         Width="55"/>
                                        <DataGridTextColumn Header="Cost"     Binding="{Binding CostPrice, Mode=OneWay, StringFormat={}{0:N0}}" Width="80"/>
                                        <DataGridTextColumn Header="Sale"     Binding="{Binding SalePrice, Mode=OneWay, StringFormat={}{0:N0}}" Width="80"/>
                                        <DataGridTextColumn Header="Average"  Binding="{Binding AveragePrice, Mode=OneWay, StringFormat={}{0:N0}}" Width="90"/>
                                        <DataGridTextColumn Header="Market"   Binding="{Binding EstimatedMarketPrice, Mode=OneWay, StringFormat={}{0:N0}}" Width="90"/>
                                        <DataGridTextColumn Header="Allocated" Binding="{Binding AllocatedCost, Mode=OneWay, StringFormat={}{0:N0}}" Width="90"/>
                                        <DataGridTextColumn Header="Min"       Binding="{Binding MinimumSellPrice, Mode=OneWay, StringFormat={}{0:N0}}" Width="80"/>
                                        <DataGridTextColumn Header="Recommended" Binding="{Binding RecommendedPrice, Mode=OneWay, StringFormat={}{0:N0}}" Width="115"/>
                                        <DataGridTextColumn Header="Pricing"  Binding="{Binding PricingStatus, Mode=OneWay}" Width="105"/>
                                        <DataGridTextColumn Header="Min Stock" Binding="{Binding MinStock, Mode=OneWay}"                        Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="📣  Part Requests" DataContext="{Binding PartRequestsFeature}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="360"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="4" Padding="24" Margin="0 0 12 0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="New Request" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0 0 0 10"/>
                                    <Button Content="＋  New / Clear Selection"
                                            Command="{Binding DataContext.StartNewManagementItemCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="PartRequest"
                                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Height="38" Margin="0 0 0 16"/>

                                    <Border Background="{DynamicResource CardHighlightBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="14"
                                            Margin="0 0 0 16">
                                        <StackPanel>
                                            <TextBlock Text="Demand Signal" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding BoardSummary}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0 4 0 0"/>
                                        </StackPanel>
                                    </Border>

                                    <TextBlock Text="Existing Customer" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <ComboBox ItemsSource="{Binding Customers}"
                                              Style="{StaticResource ManagementComboBoxStyle}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding NewRequestCustomerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsTextSearchEnabled="True"/>
