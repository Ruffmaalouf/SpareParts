                                    <TextBlock Text="{Binding UsedCarShippingLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewUsedCarShipping, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 8"/>
                                    <TextBlock Text="{Binding UsedCarCustomsLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewUsedCarCustoms, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 8"/>
                                    <TextBlock Text="{Binding UsedCarRepairsLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewUsedCarRepairs, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 8"/>
                                    <TextBlock Text="Expected Sell-Through Rate" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewUsedCarExpectedSellThroughRate, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 8"/>
                                    <TextBlock Text="{Binding UsedCarTotalBeforeShippingLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewUsedCarTotalBeforeShipping, Mode=OneWay}" IsReadOnly="True" Margin="0 0 0 8"/>
                                    <TextBlock Text="{Binding UsedCarGrandTotalBaseLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewUsedCarGrandTotalBase, Mode=OneWay}" IsReadOnly="True" Margin="0 0 0 8"/>
                                    <TextBlock Text="{Binding UsedCarGrandTotalCounterLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewUsedCarGrandTotalCounter, Mode=OneWay}" IsReadOnly="True" Margin="0 0 0 20"/>

                                    <Button Content="💾  Save Used Car" Command="{Binding SaveCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch" Height="42"/>
                                    <Button Content="🗑  Remove Selected" Command="{Binding DeleteCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                                    <Button Content="Import from Excel"
                                            Command="{Binding ImportFromExcelCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                    <StackPanel Orientation="Vertical" DockPanel.Dock="Left">
                                        <TextBlock Text="Used Cars" FontSize="13" FontWeight="Bold"/>
                                        <StackPanel Orientation="Horizontal" Margin="0 6 0 0">
                                            <TextBlock Text="{Binding UsedCarsTotalDisplayLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UsedCarsTotalDisplayAmount, StringFormat={} {0:N2}}" FontSize="11" FontWeight="SemiBold" Margin="6 0 16 0" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UsedCarsNetProfitLossDisplayLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                            <TextBlock Text="{Binding UsedCarsNetProfitLossDisplayAmount, StringFormat={} {0:N2}}" FontSize="11" FontWeight="SemiBold" Margin="6 0 0 0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Content="↻ Refresh" Command="{Binding RefreshCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="14 6"/>
                                </DockPanel>

                                <Border Grid.Row="1" Background="{DynamicResource CardHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0 0 0 14">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0" Margin="0 0 0 10">
                                            <StackPanel DockPanel.Dock="Left">
                                                <TextBlock Text="Donor Command Center" FontSize="14" FontWeight="Bold"/>
                                                <TextBlock Text="{Binding SelectedUsedCarOperationalSummary}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           Margin="0 3 0 0"/>
                                            </StackPanel>
                                            <TextBlock Text="{Binding FilteredUsedCarsCount, StringFormat={}{0:N0} shown}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       DockPanel.Dock="Right"
                                                       VerticalAlignment="Center"/>
                                        </DockPanel>

                                        <Grid Grid.Row="1" Margin="0 0 0 10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding UsedCarFilterText, UpdateSourceTrigger=PropertyChanged}"
                                                     Margin="0 0 10 0"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding UsedCarStatusFilters}"
                                                      SelectedItem="{Binding UsedCarStatusFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource ManagementComboBoxStyle}"/>
                                        </Grid>

                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="3*"/>
                                            </Grid.ColumnDefinitions>

                                            <UniformGrid Grid.Column="0" Columns="2" Margin="0 0 12 0">
                                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0 0 8 8">
                                                    <StackPanel>
                                                        <TextBlock Text="Ready" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding UsedCarsReadyForTeardownCount, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold"/>
                                                        <TextBlock Text="received and shipped" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0 0 0 8">
                                                    <StackPanel>
                                                        <TextBlock Text="Profit" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding UsedCarsProfitUnlockedCount, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold"/>
                                                        <TextBlock Text="break-even reached" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0 0 8 0">
                                                    <StackPanel>
                                                        <TextBlock Text="Gap Open" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding UsedCarsBreakEvenRiskCount, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold"/>
                                                        <TextBlock Text="{Binding UsedCarsBreakEvenGapDisplayLabel}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                                                    <StackPanel>
                                                        <TextBlock Text="Needs Links" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Text="{Binding UsedCarsNeedsPartLinksCount, StringFormat={}{0:N0}}" FontSize="18" FontWeight="Bold"/>
                                                        <TextBlock Text="no removed parts" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </UniformGrid>

                                            <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="12">
                                                <StackPanel>
                                                    <TextBlock Text="Selected Next Action" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding SelectedUsedCarActionSummary}"
                                                               FontSize="15"
                                                               FontWeight="Bold"
                                                               TextWrapping="Wrap"
                                                               Margin="0 5 0 8"/>
                                                    <TextBlock Text="{Binding UsedCarsBreakEvenGapDisplayAmount, StringFormat={}Total open gap: {0:N2}}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Grid Grid.Row="2" Margin="0 0 0 14">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <DockPanel Grid.Row="0" Margin="0 0 0 10">
                                        <StackPanel DockPanel.Dock="Left">
                                            <TextBlock Text="Teardown Profit Map"
                                                       FontSize="15"
                                                       FontWeight="Bold"/>
                                            <TextBlock Text="{Binding SelectedUsedCar.ProfitMapBreakEvenStatus}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0 4 0 0"/>
                                        </StackPanel>
                                        <Button Content="Rank Parts"
                                                Command="{Binding OpenPartsCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                DockPanel.Dock="Right"
                                                Padding="12 5"/>
                                    </DockPanel>

                                    <UniformGrid Grid.Row="1" Columns="6" Margin="0 0 0 10">
                                        <Border Background="{DynamicResource CardHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0 0 8 0">
                                            <StackPanel>
                                                <TextBlock Text="Bought For" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedUsedCar.PurchaseCostDisplayText}" FontSize="15" FontWeight="Bold" Margin="0 4 0 0"/>
                                                <TextBlock Text="Purchase basis" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 2 0 0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource CardHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0 0 8 0">
                                            <StackPanel>
                                                <TextBlock Text="Teardown Costs" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedUsedCar.TeardownCostDisplayText}" FontSize="15" FontWeight="Bold" Margin="0 4 0 0"/>
                                                <TextBlock Text="Transport, fees, work" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 2 0 0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource CardHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0 0 8 0">
                                            <StackPanel>
                                                <TextBlock Text="Parts Removed" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedUsedCar.PartsRemovedValueDisplayText}" FontSize="15" FontWeight="Bold" Margin="0 4 0 0"/>
                                                <TextBlock Text="{Binding SelectedUsedCar.PartsRemovedCount, StringFormat={}{0:N0} part(s)}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 2 0 0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource CardHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0 0 8 0">
                                            <StackPanel>
                                                <TextBlock Text="Parts Sold" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedUsedCar.ProfitMapSoldValueDisplayText}" FontSize="15" FontWeight="Bold" Margin="0 4 0 0"/>
                                                <TextBlock Text="{Binding SelectedUsedCar.PartsSoldQuantity, StringFormat={}{0:N0} sold}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 2 0 0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource CardHighlightBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0 0 8 0">
                                            <StackPanel>
                                                <TextBlock Text="Remaining Stock" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedUsedCar.RemainingStockValueDisplayText}" FontSize="15" FontWeight="Bold" Margin="0 4 0 0"/>
                                                <TextBlock Text="{Binding SelectedUsedCar.RemainingStockQuantity, StringFormat={}{0:N0} in stock}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 2 0 0"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource CardHighlightBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4" Padding="10">
                                            <StackPanel>
                                                <TextBlock Text="Profit/Loss" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedUsedCar.NetProfitLossDisplayText}" FontSize="15" FontWeight="Bold" Margin="0 4 0 0"/>
                                                <TextBlock Text="{Binding SelectedUsedCar.ProfitMapBreakEvenStatus}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 2 0 0"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>

                                    <Grid Grid.Row="2" Margin="0 0 0 10">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="0 0 0 5">
                                            <TextBlock Text="Recovered"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding SelectedUsedCar.ProfitMapRecoveredPercentText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <ProgressBar Grid.Row="1"
                                                     Height="10"
                                                     Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding SelectedUsedCar.ProfitMapRecoveredPercentCapped, Mode=OneWay}"
                                                     Background="{DynamicResource CardHighlightBrush}"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     BorderThickness="0"/>
                                    </Grid>

                                    <UniformGrid Grid.Row="3" Columns="3">
                                        <StackPanel Margin="0 0 12 0">
                                            <TextBlock Text="Full Project Cost" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedUsedCar.FullCostDisplayText}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel Margin="0 0 12 0">
                                            <TextBlock Text="Recovered Value" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedUsedCar.ProfitMapRecoveredValueDisplayText}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="Break-Even Gap" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding SelectedUsedCar.ProfitMapBreakEvenGapDisplayText}" FontWeight="SemiBold"/>
                                        </StackPanel>
                                    </UniformGrid>
                                </Grid>

                                <DataGrid Grid.Row="3" ItemsSource="{Binding FilteredUsedCars}" SelectedItem="{Binding SelectedUsedCar, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow" HeadersVisibility="Column"
                                          BorderThickness="0" GridLinesVisibility="All" ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Foreground" Value="#C62828"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsReceived}" Value="True">
                                                    <Setter Property="Foreground" Value="#2E7D32"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsWholesaleSold}" Value="True">
                                                    <Setter Property="Foreground" Value="#5E35B1"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode, Mode=OneWay}" Width="110"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding SaleStatusText, Mode=OneWay}" Width="135"/>
                                        <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName, Mode=OneWay}" Width="140"/>
                                        <DataGridTextColumn Header="Car" Binding="{Binding Car, Mode=OneWay}" Width="150"/>
                                        <DataGridTextColumn Header="Model" Binding="{Binding ModelYear, Mode=OneWay}" Width="70"/>
                                        <DataGridTextColumn Header="Price Currency" Binding="{Binding PriceCurrency, Mode=OneWay}" Width="95"/>
                                        <DataGridTextColumn Header="Price" Binding="{Binding Price, Mode=OneWay, StringFormat={}{0:N1}}" Width="90"/>
                                        <DataGridTextColumn Header="Display Currency" Binding="{Binding DisplayCurrencyCode, Mode=OneWay}" Width="110"/>
                                        <DataGridTextColumn Header="Price Display" Binding="{Binding PriceDisplay, Mode=OneWay, StringFormat={}{0:N1}}" Width="105"/>
                                        <DataGridTextColumn Header="Location" Binding="{Binding Location, Mode=OneWay}" Width="100"/>
                                        <DataGridTextColumn Header="Transportation" Binding="{Binding Transportation, Mode=OneWay, StringFormat={}{0:N0}}" Width="110"/>
                                        <DataGridCheckBoxColumn Header="Received" Binding="{Binding IsReceived, Mode=OneWay}" Width="80"/>
                                        <DataGridCheckBoxColumn Header="Shipped" Binding="{Binding IsShipped, Mode=OneWay}" Width="80"/>
                                        <DataGridTextColumn Header="Total before Shipping" Binding="{Binding TotalBeforeShipping, Mode=OneWay, StringFormat={}{0:N1}}" Width="150"/>
                                        <DataGridTextColumn Header="PartOut" Binding="{Binding PartOut, Mode=OneWay, StringFormat={}{0:N1}}" Width="90"/>
                                        <DataGridTextColumn Header="Shipping" Binding="{Binding Shipping, Mode=OneWay, StringFormat={}{0:N0}}" Width="90"/>
                                        <DataGridTextColumn Header="Customs" Binding="{Binding Customs, Mode=OneWay, StringFormat={}{0:N0}}" Width="90"/>
                                        <DataGridTextColumn Header="Repairs" Binding="{Binding Repairs, Mode=OneWay, StringFormat={}{0:N0}}" Width="90"/>
                                        <DataGridTextColumn Header="Sell-Through" Binding="{Binding ExpectedSellThroughRate, Mode=OneWay, StringFormat={}{0:P0}}" Width="105"/>
                                        <DataGridTextColumn Header="Grand Total" Binding="{Binding GrandTotalDisplay, Mode=OneWay, StringFormat={}{0:N1}}" Width="120"/>
                                        <DataGridTextColumn Header="Parts Removed" Binding="{Binding PartsRemovedCount, Mode=OneWay, StringFormat={}{0:N0}}" Width="115"/>
                                        <DataGridTextColumn Header="Parts Sold" Binding="{Binding PartsSoldQuantity, Mode=OneWay, StringFormat={}{0:N0}}" Width="95"/>
                                        <DataGridTextColumn Header="Sale Price" Binding="{Binding ProfitMapSoldValueDisplay, Mode=OneWay, StringFormat={}{0:N1}}" Width="100"/>
                                        <DataGridTextColumn Header="Remaining Stock" Binding="{Binding RemainingStockValueDisplay, Mode=OneWay, StringFormat={}{0:N1}}" Width="130"/>
                                        <DataGridTextColumn Header="Net P/L" Binding="{Binding NetProfitLossDisplay, Mode=OneWay, StringFormat={}{0:N1}}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Excel Manager">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="4" Padding="24" Margin="0 0 12 0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="Excel Manager" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Choose the table, load the Excel file, map the headers, then import."
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0 0 0 16"/>

                                    <TextBlock Text="System Table *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <ComboBox ItemsSource="{Binding ExcelManagerFeature.Targets}"
                                              SelectedItem="{Binding ExcelManagerFeature.SelectedTarget, Mode=TwoWay}"
                                              DisplayMemberPath="Name"
                                              Style="{StaticResource ManagementComboBoxStyle}"/>

                                    <TextBlock Text="{Binding ExcelManagerFeature.SelectedTargetSummary}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0 0 0 16"/>

                                    <TextBlock Text="Workbook" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding ExcelManagerFeature.WorkbookPath}"
                                             IsReadOnly="True"
                                             Height="38"
                                             Margin="0 0 0 10"/>

                                    <Button Content="Browse Workbook"
                                            Command="{Binding ExcelManagerFeature.BrowseWorkbookCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Height="38"
                                            Margin="0 0 0 16"/>

                                    <Button Content="Auto Match Headers"
                                            Command="{Binding ExcelManagerFeature.AutoMatchCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Height="42"
                                            Margin="0 0 0 10"/>
                                    <Button Content="Save Mapping"
                                            Command="{Binding ExcelManagerFeature.SaveMappingCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Height="42"
                                            Margin="0 0 0 10"/>
                                    <Button Content="Import Workbook"
                                            Command="{Binding ExcelManagerFeature.ImportCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Stretch"
                                            Height="42"/>

                                    <TextBlock Text="{Binding ExcelManagerFeature.Status}"
                                               FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0 14 0 0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="4" Padding="24">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Text="Header Mapping" FontSize="13" FontWeight="Bold" Margin="0 0 0 8"/>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding ExcelManagerFeature.WorkbookSummary}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0 0 0 14"/>

                                <DataGrid Grid.Row="2"
                                          ItemsSource="{Binding ExcelManagerFeature.MappingRows}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          CanUserResizeRows="False"
                                          HeadersVisibility="Column"
                                          RowHeight="48"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Required"
                                                            Binding="{Binding RequirementLabel}"
                                                            Width="85"
                                                            IsReadOnly="True"/>
                                        <DataGridTextColumn Header="System Column"
                                                            Binding="{Binding ColumnName}"
                                                            Width="160"
                                                            IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Type"
                                                            Binding="{Binding DataTypeLabel}"
                                                            Width="95"
                                                            IsReadOnly="True"/>
                                        <DataGridTextColumn Header="Description"
                                                            Binding="{Binding Description}"
                                                            Width="*"
                                                            IsReadOnly="True"/>
                                        <DataGridTemplateColumn Header="Excel Header" Width="240">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <ComboBox ItemsSource="{Binding DataContext.ExcelManagerFeature.WorkbookHeaderOptions, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                              SelectedItem="{Binding SelectedHeader, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              Style="{StaticResource ExcelManagerInlineComboBoxStyle}"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="📒  Accounting Setup" DataContext="{Binding AccountingVm}">
                    <DockPanel Margin="10">
                        <Border DockPanel.Dock="Top"
                                Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="4"
                                Padding="12"
                                Margin="0 0 0 10">
                            <WrapPanel>
                                <Button Content="Import Accounts"
                                        Command="{Binding DataContext.ExcelManagerFeature.ImportTableCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="dbo.Accounts"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="14 6"
                                        Margin="0 0 8 0"/>
                                <Button Content="Import Account Types"
                                        Command="{Binding DataContext.ExcelManagerFeature.ImportTableCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="dbo.AccountingAccountTypes"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="14 6"
                                        Margin="0 0 8 0"/>
                                <Button Content="Import Posting Roles"
                                        Command="{Binding DataContext.ExcelManagerFeature.ImportTableCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="dbo.AccountingPostingRoles"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="14 6"
                                        Margin="0 0 8 0"/>
                                <Button Content="Import Posting Setup"
                                        Command="{Binding DataContext.ExcelManagerFeature.ImportTableCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="dbo.AccountingPostingSettings"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="14 6"/>
                            </WrapPanel>
                        </Border>
                        <local:AccountingSetupControl/>
                    </DockPanel>
                </TabItem>

                <!-- USERS (UsersVm sub-binding) -->
                <TabItem Header="👥  Users" DataContext="{Binding UsersVm}">
                    <DockPanel Margin="10">
                        <Button DockPanel.Dock="Top"
                                Content="Import from Excel"
                                Command="{Binding DataContext.ExcelManagerFeature.ImportTableCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                CommandParameter="dbo.Users"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="14 6"
                                Margin="0 0 0 10"/>
                        <controls:UsersTab/>
                    </DockPanel>
                </TabItem>

                <TabItem Header="🔑  Roles" DataContext="{Binding RolesVm}">
                    <DockPanel Margin="10">
                        <Button DockPanel.Dock="Top"
                                Content="Import from Excel"
                                Command="{Binding DataContext.ExcelManagerFeature.ImportTableCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                CommandParameter="dbo.Roles"
                                Style="{StaticResource SecondaryButtonStyle}"
                                HorizontalAlignment="Left"
                                Padding="14 6"
                                Margin="0 0 0 10"/>
                        <controls:RolesTab/>
                    </DockPanel>
                </TabItem>
            </TabControl>
        </DataTemplate>

</ResourceDictionary>
