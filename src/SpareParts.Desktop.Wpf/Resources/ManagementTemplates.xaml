                <TabItem Header="👥  Users" DataContext="{Binding UsersVm}">
                    <controls:UsersTab/>
                </TabItem>

                <TabItem Header="🔑  Roles" DataContext="{Binding RolesVm}">
                    <controls:RolesTab Margin="10"/>
                </TabItem>
            </TabControl>
        </DataTemplate>

</ResourceDictionary>
