                                    <TextBox Text="{Binding NewRequestCustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Customer Phone" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewRequestCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>

                                    <TextBlock Text="Matched Catalog Part" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 4 0 4"/>
                                    <ComboBox ItemsSource="{Binding Parts}"
                                              Style="{StaticResource ManagementComboBoxStyle}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding NewRequestPartId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              IsTextSearchEnabled="True"/>
                                    <TextBlock Text="Requested Part *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewRequestPartName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="OEM / Reference" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewRequestOem, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Vehicle Details" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewRequestVehicleDetails, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Quantity" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewRequestQuantity, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Notes" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewRequestNotes, UpdateSourceTrigger=PropertyChanged}"
                                             Height="86"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0 0 0 10"/>
                                    <CheckBox Content="Start reservation clock"
                                              IsChecked="{Binding ReserveOnCreate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Margin="0 0 0 10"/>
                                    <TextBlock Text="Reserved Until" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding ReservationExpiresAt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                             Margin="0 0 0 10"/>
                                    <TextBlock Text="Deadline Action" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <ComboBox ItemsSource="{Binding ReservationExpirationActions}"
                                              SelectedItem="{Binding ReservationExpirationAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              Style="{StaticResource ManagementComboBoxStyle}"/>
                                    <Button Content="＋  Save Request"
                                            Command="{Binding SaveCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42"/>
                                    <Button Content="🗑  Delete Selected"
                                            Command="{Binding DeleteCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>

                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Parts Request Board" FontSize="13" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding BoardSummary}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 4 0 0"/>
                                    </StackPanel>
                                    <Button Content="↻ Refresh" Command="{Binding RefreshCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="14 6"/>
                                </DockPanel>

                                <WrapPanel Grid.Row="1" Margin="0 0 0 14">
                                    <Button Content="Reserve"
                                            Command="{Binding ReserveAutoReleaseCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0 0 8 8"
                                            MinWidth="98"
                                            Height="38"/>
                                    <Button Content="Remind Staff"
                                            Command="{Binding ReserveReminderCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0 0 8 8"
                                            MinWidth="112"
                                            Height="38"/>
                                    <Button Content="Release"
                                            Command="{Binding ReleaseReservationCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0 0 8 8"
                                            MinWidth="98"
                                            Height="38"/>
                                    <Button Content="Contacted"
                                            Command="{Binding MarkContactedCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0 0 8 8"
                                            MinWidth="98"
                                            Height="38"/>
                                    <Button Content="Fulfilled"
                                            Command="{Binding MarkFulfilledCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0 0 8 8"
                                            MinWidth="98"
                                            Height="38"/>
                                    <Button Content="Reopen"
                                            Command="{Binding ReopenCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0 0 8 8"
                                            MinWidth="98"
                                            Height="38"/>
                                    <Button Content="Cancel"
                                            Command="{Binding CancelCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0 0 8 8"
                                            MinWidth="98"
                                            Height="38"/>
                                    <TextBlock Text="{Binding SelectedReservationSummary}"
