<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:SpareParts.Desktop.Wpf"
                    xmlns:controls="clr-namespace:SpareParts.Desktop.Wpf;assembly=SpareParts.Desktop.Controls"
                    xmlns:ViewModels="clr-namespace:SpareParts.Desktop.Wpf;assembly=SpareParts.Desktop.ViewModels">

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>

    <!-- ══════ Management DataTemplate ══════ -->
    <DataTemplate DataType="{x:Type ViewModels:ManagementViewModel}">
            <DataTemplate.Resources>
                <Style x:Key="ManagementComboBoxStyle"
                       TargetType="ComboBox"
                       BasedOn="{StaticResource AccountingComboBoxStyle}">
                    <Setter Property="Height" Value="44"/>
                    <Setter Property="MinHeight" Value="44"/>
                    <Setter Property="Padding" Value="13 0"/>
                    <Setter Property="Margin" Value="0 0 0 10"/>
                    <Setter Property="FontSize" Value="14"/>
                </Style>

                <Style x:Key="ManagementTabItemStyle" TargetType="TabItem">
                    <Setter Property="Background"      Value="Transparent"/>
                    <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding"         Value="0"/>
                    <Setter Property="Margin"          Value="0 0 2 0"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="3"/>
                                    </Grid.RowDefinitions>
                                    <Border x:Name="TabBorder" Grid.Row="0"
                                            Background="Transparent" Padding="16 10">
                                        <ContentPresenter ContentSource="Header"/>
                                    </Border>
                                    <Border x:Name="ActiveBar" Grid.Row="1"
                                            Background="Transparent" CornerRadius="2 2 0 0"/>
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="ActiveBar" Property="Background" Value="{DynamicResource AccentBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBorder" Property="Background" Value="#0DFFFFFF"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="ManagementActionTileButtonStyle" TargetType="Button">
                    <Setter Property="Height" Value="78"/>
                    <Setter Property="Padding" Value="10"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Background" Value="Transparent"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                    <Setter Property="BorderThickness" Value="1"/>
                    <Setter Property="Cursor" Value="Hand"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="ActionBorder"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="ActionBorder" Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                                        <Setter TargetName="ActionBorder" Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect Color="Black"
                                                                  BlurRadius="10"
                                                                  ShadowDepth="2"
                                                                  Opacity="0.16"/>
                                            </Setter.Value>
                                        </Setter>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="ActionBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                        <Setter TargetName="ActionBorder" Property="Opacity" Value="0.88"/>
                                        <Setter TargetName="ActionBorder" Property="Effect" Value="{x:Null}"/>
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter Property="Opacity" Value="0.55"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>

                <Style x:Key="ExcelManagerInlineComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ManagementComboBoxStyle}">
                    <Setter Property="Height" Value="38"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="Padding" Value="12 0"/>
                    <Setter Property="FontSize" Value="13"/>
                </Style>

            </DataTemplate.Resources>
            <TabControl Background="Transparent" BorderThickness="0" Margin="0"
                        ItemContainerStyle="{StaticResource ManagementTabItemStyle}">

                <!-- TAB 1 — CUSTOMERS -->
                <TabItem Header="👤  Customers" DataContext="{Binding CustomersFeature}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="4" Padding="24" Margin="0 0 12 0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="New Customer" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0 0 0 10"/>
                                    <Button Content="＋  New / Clear Selection"
                                            Command="{Binding DataContext.StartNewManagementItemCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="Customer"
                                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Height="38" Margin="0 0 0 16"/>
                                    <TextBlock Text="Name *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCustomerName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Phone" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCustomerPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Email" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCustomerEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Address" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCustomerAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Tax Number" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCustomerTax, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Opening Balance" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewCustomerBalance, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 20"/>
                                    <Button Content="＋  Save Customer"
                                            Command="{Binding DataContext.SaveCustomerCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42"/>
                                    <Button Content="🗑  Delete Selected"
                                            Command="{Binding DataContext.DeleteCustomerCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                                    <Button Content="Import from Excel"
                                            Command="{Binding DataContext.ExcelManagerFeature.ImportTableCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="dbo.Customers"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                                    <TextBlock Text="{Binding DataContext.Status, RelativeSource={RelativeSource AncestorType=TabControl}}" FontSize="12" Margin="0 10 0 0"
                                               Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                    <TextBlock Text="All Customers" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button Content="↻ Refresh" Command="{Binding DataContext.LoadAllCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="14 6"/>
                                </DockPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Customers}"
                                          SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                          HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID"      Binding="{Binding Id, Mode=OneWay}"             Width="50"/>
                                        <DataGridTextColumn Header="Name"    Binding="{Binding Name, Mode=OneWay}"           Width="*"/>
                                        <DataGridTextColumn Header="Phone"   Binding="{Binding Phone, Mode=OneWay}"          Width="120"/>
                                        <DataGridTextColumn Header="Email"   Binding="{Binding Email, Mode=OneWay}"          Width="160"/>
                                        <DataGridTextColumn Header="Account" Binding="{Binding AccountDisplay, Mode=OneWay}" Width="180"/>
                                        <DataGridTextColumn Header="Balance" Binding="{Binding OpeningBalance, Mode=OneWay, StringFormat={}{0:N0}}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 2 — SUPPLIERS -->
                <TabItem Header="🏭  Suppliers"
                         DataContext="{Binding SuppliersFeature}"
                         Visibility="{Binding DataContext.CanViewSupplierTab, RelativeSource={RelativeSource AncestorType=TabControl}, Converter={StaticResource BoolToVis}}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="4" Padding="24" Margin="0 0 12 0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="New Supplier" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0 0 0 10"/>
                                    <Button Content="＋  New / Clear Selection"
                                            Command="{Binding DataContext.StartNewManagementItemCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="Supplier"
                                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Height="38" Margin="0 0 0 16"/>
                                    <TextBlock Text="Name *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewSupplierName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Phone" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewSupplierPhone, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Email" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewSupplierEmail, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Address" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewSupplierAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Tax Number" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewSupplierTax, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Opening Balance" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewSupplierBalance, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 20"/>
                                    <Button Content="＋  Save Supplier"
                                            Command="{Binding DataContext.SaveSupplierCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42"/>
                                    <Button Content="🗑  Delete Selected"
                                            Command="{Binding DataContext.DeleteSupplierCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                                    <Button Content="Import from Excel"
                                            Command="{Binding DataContext.ExcelManagerFeature.ImportTableCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="dbo.Suppliers"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                    <TextBlock Text="All Suppliers" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button Content="↻ Refresh" Command="{Binding DataContext.LoadAllCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="14 6"/>
                                </DockPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Suppliers}"
                                          SelectedItem="{Binding SelectedSupplier, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                          HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID"      Binding="{Binding Id, Mode=OneWay}"             Width="50"/>
                                        <DataGridTextColumn Header="Name"    Binding="{Binding Name, Mode=OneWay}"           Width="*"/>
                                        <DataGridTextColumn Header="Phone"   Binding="{Binding Phone, Mode=OneWay}"          Width="120"/>
                                        <DataGridTextColumn Header="Account" Binding="{Binding AccountDisplay, Mode=OneWay}" Width="180"/>
                                        <DataGridTextColumn Header="Balance" Binding="{Binding OpeningBalance, Mode=OneWay, StringFormat={}{0:N0}}" Width="90"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 3 — BRANDS -->
                <TabItem Header="🏷  Brands" DataContext="{Binding BrandsFeature}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="4" Padding="24" Margin="0 0 12 0">
                            <StackPanel>
                                    <TextBlock Text="New Brand" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0 0 0 10"/>
                                    <Button Content="＋  New / Clear Selection"
                                            Command="{Binding DataContext.StartNewManagementItemCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="Brand"
                                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Height="38" Margin="0 0 0 16"/>
                                <TextBlock Text="Name *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                <TextBox Text="{Binding NewBrandName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 20"/>
                                <Button Content="＋  Save Brand"
                                        Command="{Binding DataContext.SaveBrandCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Height="42"/>
                                <Button Content="🗑  Delete Selected"
                                        Command="{Binding DataContext.DeleteBrandCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                                <Button Content="Import from Excel"
                                        Command="{Binding DataContext.ExcelManagerFeature.ImportTableCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                        CommandParameter="dbo.Brands"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>
                                <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                    <TextBlock Text="All Brands" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                    <Button Content="↻ Refresh" Command="{Binding DataContext.LoadAllCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            Style="{StaticResource SecondaryButtonStyle}" DockPanel.Dock="Right" Padding="14 6"/>
                                </DockPanel>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding Brands}"
                                          SelectedItem="{Binding SelectedBrand, Mode=TwoWay}"
                                          AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False" CanUserResizeRows="False"
                                          IsReadOnly="True" SelectionMode="Single" SelectionUnit="FullRow"
                                          HeadersVisibility="Column" BorderThickness="0" GridLinesVisibility="None"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="ID"     Binding="{Binding Id, Mode=OneWay}"       Width="50"/>
                                        <DataGridTextColumn Header="Name"   Binding="{Binding Name, Mode=OneWay}"     Width="*"/>
                                        <DataGridTextColumn Header="Active" Binding="{Binding IsActive, Mode=OneWay}" Width="70"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- TAB 4 — PARTS -->
                <TabItem Header="🔧  Parts" DataContext="{Binding PartsFeature}">
                    <Grid Margin="10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="320"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}"
                                CornerRadius="4" Padding="24" Margin="0 0 12 0">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel>
                                    <TextBlock Text="New Part" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="0 0 0 10"/>
                                    <Button Content="＋  New / Clear Selection"
                                            Command="{Binding DataContext.StartNewManagementItemCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            CommandParameter="Part"
                                            Style="{StaticResource SecondaryButtonStyle}" HorizontalAlignment="Stretch" Height="38" Margin="0 0 0 16"/>
                                    <Border Background="{DynamicResource CardHighlightBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="14"
                                            Margin="0 0 0 16">
                                        <StackPanel>
                                            <TextBlock Text="Bulk Import" FontSize="13" FontWeight="SemiBold"/>
                                            <TextBlock Text="Import `.xlsx` rows for new, used, or rebuilt parts. Supported columns include Code, Barcode, Name, OEM, Category, Brand, Cost, Sale, Average, Estimated Market, Currency, Min Stock, Notes, and optional Condition."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0 4 0 10"/>
                                            <Button Content="Import from Excel"
                                                    Command="{Binding DataContext.ExcelManagerFeature.ImportTableCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                    CommandParameter="dbo.Parts"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    Height="38"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Internal Code *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartCode, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Barcode / QR Code" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartBarcode, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Name *" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartName, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="OEM Number" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartOEM, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Category" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <ComboBox ItemsSource="{Binding DataContext.Categories, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                              Style="{StaticResource ManagementComboBoxStyle}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding NewPartCategoryId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              />
                                    <TextBlock Text="Brand" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <ComboBox ItemsSource="{Binding DataContext.Brands, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                              Style="{StaticResource ManagementComboBoxStyle}"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              SelectedValue="{Binding NewPartBrandId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                              />
                                    <TextBlock Text="Cost Price" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartCostPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Sale Price" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartSalePrice, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Average Price" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartAveragePrice, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Estimated Market Price" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartEstimatedMarketPrice, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <TextBlock Text="Currency Code" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <ComboBox ItemsSource="{Binding DataContext.CurrencyRates, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                              Style="{StaticResource ManagementComboBoxStyle}"
                                              DisplayMemberPath="Code"
                                              SelectedValuePath="Code"
                                              SelectedValue="{Binding NewPartCurrency, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                    <TextBlock Text="Min Stock" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <TextBox Text="{Binding NewPartMinStock, UpdateSourceTrigger=PropertyChanged}" Margin="0 0 0 10"/>
                                    <Border Background="{DynamicResource CardHighlightBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12"
                                            Margin="0 0 0 10">
                                        <StackPanel>
                                            <DockPanel Margin="0 0 0 6">
                                                <TextBlock Text="{Binding SmartPricingCoachBadge}"
                                                           DockPanel.Dock="Right"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="Smart Pricing Coach"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding SmartPricingCoachMessage}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBlock Text="Notes" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 4"/>
                                    <Border Background="{DynamicResource CardHighlightBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="12"
                                            Margin="0 0 0 10">
                                        <StackPanel>
                                            <TextBlock Text="AI Assist" FontSize="12" FontWeight="SemiBold"/>
                                            <TextBlock Text="Draft concise catalog notes and estimate an average selling price from the current part details."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"
                                                       Margin="0 4 0 10"/>
                                            <Button Content="{Binding DataContext.PartAiButtonText, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                    Command="{Binding DataContext.GeneratePartNotesCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    HorizontalAlignment="Stretch"
                                                    Height="36"/>
                                        </StackPanel>
                                    </Border>
                                    <TextBox Text="{Binding NewPartNotes, UpdateSourceTrigger=PropertyChanged}"
                                             Height="90"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0 0 0 20"/>
                                    <Button Content="＋  Save Part"
                                            Command="{Binding DataContext.SavePartCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42"/>
                                    <Button Content="🗑  Delete Selected"
                                            Command="{Binding DataContext.DeletePartCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                                    <Button Content="📤  Generate Listing"
                                            Command="{Binding DataContext.GenerateListingCommand, RelativeSource={RelativeSource AncestorType=TabControl}}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            HorizontalAlignment="Stretch" Height="42" Margin="0 10 0 0"/>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                        <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="4" Padding="20">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
