<UserControl x:Class="SpareParts.Desktop.Wpf.AccountingSetupControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource AccountingComboBoxStyle}"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="12"
                Padding="14"
                Margin="0 0 0 16">
            <DockPanel>
                <Button DockPanel.Dock="Right"
                        Content="↻ Refresh"
                        Command="{Binding LoadSetupCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="120"/>
                <StackPanel>
                    <TextBlock Text="Accounting Setup"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Status}"
                               Foreground="{Binding StatusBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1"
                    Background="Transparent"
                    BorderThickness="0">
            <TabItem Header="Chart of Accounts">
                <Grid Margin="0 0 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Account Editor" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding AccountsSummary}" Margin="0 6 0 14" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Code" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding AccountCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 6 0 12"/>
                            <TextBlock Text="Name" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding AccountName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 6 0 12"/>
                            <TextBlock Text="Type" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding AccountTypes}" SelectedValue="{Binding SelectedAccountTypeKey, Mode=TwoWay}" SelectedValuePath="TypeKey" DisplayMemberPath="Label" Margin="0 6 0 12"/>
                            <TextBlock Text="Parent" FontWeight="SemiBold"/>
                            <ComboBox ItemsSource="{Binding ParentAccountOptions}" SelectedValue="{Binding SelectedParentAccountId, Mode=TwoWay}" SelectedValuePath="Id" DisplayMemberPath="DisplayName" Margin="0 6 0 18"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="New" Command="{Binding StartNewAccountCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="90" Margin="0 0 10 0"/>
                                <Button Content="Save" Command="{Binding SaveAccountCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="90" Margin="0 0 10 0"/>
                                <Button Content="Delete" Command="{Binding DeleteAccountCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="90"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="18">
                        <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" Width="60"/>
                                <DataGridTextColumn Header="Code" Binding="{Binding Code, Mode=OneWay}" Width="90"/>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="Type" Binding="{Binding AccountType, Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn Header="Parent" Binding="{Binding ParentDisplay, Mode=OneWay}" Width="180"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Account Types">
                <Grid Margin="0 0 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Account Type Editor" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding AccountTypesSummary}" Margin="0 6 0 14" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Type Key" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding AccountTypeDefinitionKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditingAccountTypeDefinition}" Margin="0 6 0 12"/>
                            <TextBlock Text="Label" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding AccountTypeDefinitionLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 6 0 12"/>
                            <TextBlock Text="Description" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding AccountTypeDefinitionDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 6 0 12" AcceptsReturn="True" TextWrapping="Wrap" Height="76"/>
                            <TextBlock Text="Sort Order" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding AccountTypeDefinitionSortOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 6 0 18"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="New" Command="{Binding StartNewAccountTypeCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="90" Margin="0 0 10 0"/>
                                <Button Content="Save" Command="{Binding SaveAccountTypeCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="90" Margin="0 0 10 0"/>
                                <Button Content="Delete" Command="{Binding DeleteAccountTypeCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="90"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="18">
                        <DataGrid ItemsSource="{Binding AccountTypes}" SelectedItem="{Binding SelectedAccountTypeDefinition, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Key" Binding="{Binding TypeKey, Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn Header="Label" Binding="{Binding Label, Mode=OneWay}" Width="160"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="Sort" Binding="{Binding SortOrder, Mode=OneWay}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Posting Setup">
                <Border Margin="0 0 0 0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="18">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Posting Account Setup" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding PostingSettingsSummary}" Margin="0 6 0 14" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding PostingSettings}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Role" Binding="{Binding Label, Mode=OneWay}" IsReadOnly="True" Width="180"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=OneWay}" IsReadOnly="True" Width="*"/>
                                <DataGridTemplateColumn Header="Account" Width="250">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.PostingAccountOptions, RelativeSource={RelativeSource AncestorType=UserControl}}" SelectedValue="{Binding SelectedAccountId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Id" DisplayMemberPath="DisplayName"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                        <Button Grid.Row="2" Content="Save Posting Setup" Command="{Binding SavePostingSettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="180" HorizontalAlignment="Left" Margin="0 16 0 0"/>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Posting Roles">
                <Grid Margin="0 0 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <TextBlock Text="Posting Role Editor" FontSize="18" FontWeight="Bold"/>
                            <TextBlock Text="{Binding PostingRolesSummary}" Margin="0 6 0 14" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Role Key" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding PostingRoleDefinitionKey, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding IsEditingPostingRoleDefinition}" Margin="0 6 0 12"/>
                            <TextBlock Text="Label" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding PostingRoleDefinitionLabel, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 6 0 12"/>
                            <TextBlock Text="Description" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding PostingRoleDefinitionDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 6 0 12" AcceptsReturn="True" TextWrapping="Wrap" Height="76"/>
                            <TextBlock Text="Sort Order" FontWeight="SemiBold"/>
                            <TextBox Text="{Binding PostingRoleDefinitionSortOrder, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0 6 0 18"/>
                            <StackPanel Orientation="Horizontal">
                                <Button Content="New" Command="{Binding StartNewPostingRoleCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="90" Margin="0 0 10 0"/>
                                <Button Content="Save" Command="{Binding SavePostingRoleCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="90" Margin="0 0 10 0"/>
                                <Button Content="Delete" Command="{Binding DeletePostingRoleCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="90"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="18">
                        <DataGrid ItemsSource="{Binding PostingRoleDefinitions}" SelectedItem="{Binding SelectedPostingRoleDefinition, Mode=TwoWay}" AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Key" Binding="{Binding RoleKey, Mode=OneWay}" Width="140"/>
                                <DataGridTextColumn Header="Label" Binding="{Binding Label, Mode=OneWay}" Width="180"/>
                                <DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="Sort" Binding="{Binding SortOrder, Mode=OneWay}" Width="80"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
