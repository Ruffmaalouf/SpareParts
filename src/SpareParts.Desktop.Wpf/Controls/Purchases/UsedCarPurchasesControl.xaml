<UserControl x:Class="SpareParts.Desktop.Wpf.UsedCarPurchasesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:SpareParts.Desktop.Wpf;assembly=SpareParts.Desktop.Controls"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource AccountingComboBoxStyle}"/>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0 0 0 16"
                Padding="14"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel>
                <TextBlock Text="{Binding Status}"
                           Foreground="{Binding StatusBrush}"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding ScreenSummary}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Right"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Border Padding="18"
                    Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0 0 0 14">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="0"
                                    Margin="0 0 10 12">
                            <TextBlock Text="Used Car"
                                       Margin="0 0 0 6"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding UsedCars}"
                                      SelectedValuePath="Id"
                                      SelectedValue="{Binding SelectedUsedCarId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Car}"/>
                                            <TextBlock Text=" "/>
                                            <TextBlock Text="{Binding ModelYear}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Grid.Row="0"
                                    Grid.Column="1"
                                    Margin="10 0 0 12">
                            <TextBlock Text="Supplier"
                                       Margin="0 0 0 6"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <ComboBox ItemsSource="{Binding Suppliers}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      SelectedValue="{Binding SelectedSupplierId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <controls:SaleDatePickerControl Grid.Row="1"
                                                        Grid.Column="0"
                                                        Margin="0 0 10 0"
                                                        Label="PURCHASE DATE"
                                                        PlaceholderText="Pick purchase date"
                                                        PopupTitle="SELECT PURCHASE DATE"
                                                        DisplayFormat="dddd, dd MMM yyyy"
                                                        SelectedDate="{Binding PurchaseDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                        <StackPanel Grid.Row="1"
                                    Grid.Column="1"
                                    Margin="10 0 0 0">
                            <TextBlock Text="{Binding PaidAmountLabel}"
                                       Margin="0 0 0 6"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding PaidAmountText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="56"
                                     VerticalContentAlignment="Center"
                                     Padding="12 0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" Margin="0 0 0 14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Notes"
                                       Margin="0 0 0 6"
                                       FontSize="11"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                     MinHeight="78"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1"
                                    Margin="14 22 0 0"
                                    VerticalAlignment="Top">
                            <Button Content="↻ Refresh"
                                    Command="{Binding LoadCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="130"
                                    Margin="0 0 0 10"/>
                            <Button Content="↺ Rebuild Lines"
                                    Command="{Binding RefreshLinesCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="130"
                                    Margin="0 0 0 10"/>
                            <Button Content="💾 Save Draft"
                                    Command="{Binding SubmitCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="130"
                                    Margin="0 0 0 10"/>
                            <Button Content="✕ Reset"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="130"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0"
                                Margin="0 0 0 10"
                                Padding="12"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <WrapPanel>
                                <TextBlock Text="{Binding TotalBaseLabel}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0 0 6 0"/>
                                <TextBlock Text="{Binding TotalBaseAmount, StringFormat={}{0:N4}}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Margin="0 0 16 0"/>
                                <TextBlock Text="{Binding TotalCounterLabel}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0 0 6 0"/>
                                <TextBlock Text="{Binding TotalCounterAmount, StringFormat={}{0:N4}}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Margin="0 0 16 0"/>
                                <TextBlock Text="{Binding PaidAmountLabel}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0 0 6 0"/>
                                <TextBlock Text="{Binding PaidAmount, StringFormat={}{0:N4}}"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Margin="0 0 16 0"/>
                                <TextBlock Text="{Binding RemainingCounterLabel}"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0 0 6 0"/>
                                <TextBlock Text="{Binding RemainingCounterAmount, StringFormat={}{0:N4}}"
                                           FontSize="12"
                                           FontWeight="Bold"/>
                            </WrapPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0 0 0 10"
                                Padding="12 10"
                                Background="{DynamicResource CardHighlightBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10">
                            <TextBlock Text="Received cars now keep their accounting draft in the purchase table. Review or refresh the linked draft here, then post it from Purchase History."
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </Border>

                        <DataGrid Grid.Row="2"
                                  ItemsSource="{Binding PurchaseLines}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                                    Binding="{Binding SortOrder, Mode=OneWay}"
                                                    Width="45"/>
                                <DataGridTextColumn Header="Detail"
                                                    Binding="{Binding Description, Mode=OneWay}"
                                                    Width="180"/>
                                <DataGridTextColumn Header="Original Amount"
                                                    Binding="{Binding Amount, Mode=OneWay, StringFormat={}{0:N4}}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="Original Currency"
                                                    Binding="{Binding CurrencyCode, Mode=OneWay}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Rate"
                                                    Binding="{Binding RateToBase, Mode=OneWay, StringFormat={}{0:N8}}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Base Amount"
                                                    Binding="{Binding BaseAmount, Mode=OneWay, StringFormat={}{0:N4}}"
                                                    Width="120"/>
                                <DataGridTextColumn Header="Counter Amount"
                                                    Binding="{Binding CounterAmount, Mode=OneWay, StringFormat={}{0:N4}}"
                                                    Width="130"/>
                                <DataGridTemplateColumn Header="Account"
                                                        Width="*">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox ItemsSource="{Binding DataContext.AccountOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      SelectedValuePath="Id"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValue="{Binding AccountId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
