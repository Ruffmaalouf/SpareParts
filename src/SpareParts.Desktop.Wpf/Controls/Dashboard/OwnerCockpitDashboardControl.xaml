<UserControl x:Class="SpareParts.Desktop.Wpf.OwnerCockpitDashboardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="OwnerSectionStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="18" ShadowDepth="4" Opacity="0.28"/>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HeatmapTileStyle" TargetType="Border">
            <Setter Property="Width" Value="276"/>
            <Setter Property="MinHeight" Value="188"/>
            <Setter Property="Margin" Value="0 12 12 0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding OverallSignal}" Value="Green">
                    <Setter Property="Background" Value="#1F2BD97E"/>
                    <Setter Property="BorderBrush" Value="#992BD97E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallSignal}" Value="Yellow">
                    <Setter Property="Background" Value="#24FFB400"/>
                    <Setter Property="BorderBrush" Value="#99FFB400"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding OverallSignal}" Value="Red">
                    <Setter Property="Background" Value="#24FF4757"/>
                    <Setter Property="BorderBrush" Value="#99FF4757"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="HeatmapSignalPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="9 5"/>
            <Setter Property="Margin" Value="0 0 6 6"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="#33FFB400"/>
            <Setter Property="BorderBrush" Value="#66FFB400"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Green">
                    <Setter Property="Background" Value="#332BD97E"/>
                    <Setter Property="BorderBrush" Value="#882BD97E"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Yellow">
                    <Setter Property="Background" Value="#33FFB400"/>
                    <Setter Property="BorderBrush" Value="#88FFB400"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Red">
                    <Setter Property="Background" Value="#33FF4757"/>
                    <Setter Property="BorderBrush" Value="#88FF4757"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="24">
                <Border Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        ClipToBounds="True">
                    <Border.Effect>
                        <DropShadowEffect Color="Black" BlurRadius="22" ShadowDepth="6" Opacity="0.3"/>
                    </Border.Effect>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Top accent stripe -->
                        <Border Grid.Row="0" Background="{DynamicResource AccentBrush}"/>

                        <Grid Grid.Row="1" Margin="18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Accent bar + logo plate -->
                            <Grid Grid.Column="0" Margin="0 0 16 0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="4"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="4" CornerRadius="2"
                                        Background="{DynamicResource AccentBrush}" Margin="0 2 12 2"/>
                                <Border Grid.Column="1"
                                        Width="60" Height="60"
                                        Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                    <Image Source="/Assets/MaaloufLogo.png"
                                           Stretch="Uniform"
                                           Margin="8"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                            </Grid>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="COMMAND CENTER"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Owner Cockpit"
                                           FontSize="24"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                           Margin="0 1 0 0"/>
                                <WrapPanel Margin="0 7 0 0">
                                    <TextBlock Text="{Binding BusinessDateText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0 0 18 0"/>
                                    <TextBlock Text="{Binding LastRefreshedText}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0 0 18 0"/>
                                    <TextBlock Text="{Binding Status}"
                                               FontSize="12"
                                               Foreground="{Binding StatusBrush}"
                                               TextWrapping="Wrap"/>
                                </WrapPanel>
                            </StackPanel>

                            <StackPanel Grid.Column="2"
                                        Orientation="Horizontal"
                                        VerticalAlignment="Center">
                                <ProgressBar Width="120"
                                             Height="6"
                                             Margin="0 0 12 0"
                                             IsIndeterminate="True"
                                             Foreground="{DynamicResource AccentBrush}"
                                             Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"/>
                                <Button Content="↻  Refresh"
                                        Command="{Binding LoadCommand}"
                                        Width="118"
                                        Height="38"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <ItemsControl ItemsSource="{Binding Metrics}"
                              Margin="0 18 0 0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="224"
                                    Height="126"
                                    Margin="0 12 12 0"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    ClipToBounds="True">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" BlurRadius="14" ShadowDepth="3" Opacity="0.25"/>
                                </Border.Effect>
                                <Grid>
                                    <Border Width="5"
                                            HorizontalAlignment="Left"
                                            Background="{Binding AccentBrush}"/>
                                    <StackPanel Margin="18 14 14 12">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="11"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Text="{Binding Value}"
                                                   Margin="0 8 0 0"
                                                   FontSize="24"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Caption}"
                                                   Margin="0 8 0 0"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextTrimming="CharacterEllipsis"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Margin="0 18 0 0"
                        Style="{StaticResource OwnerSectionStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0 0 0 4">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Live Profit Heatmap"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="30-day margin | 30-day turnover | 90-day dead stock"
                                           Margin="0 4 0 0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </DockPanel>

                        <ItemsControl Grid.Row="1"
                                      ItemsSource="{Binding ProfitHeatmap}"
                                      Visibility="{Binding HasProfitHeatmap, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource HeatmapTileStyle}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <Grid Grid.Row="0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding CategoryName}"
                                                           Grid.Column="0"
                                                           FontSize="17"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Score, StringFormat={}{0}/100}"
                                                           Grid.Column="1"
                                                           Margin="10 0 0 0"
                                                           FontSize="12"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </Grid>

                                            <WrapPanel Grid.Row="1" Margin="0 12 0 2">
                                                <Border Style="{StaticResource HeatmapSignalPillStyle}"
                                                        Tag="{Binding ProfitSignal}">
                                                    <TextBlock Text="Profit"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Border>
                                                <Border Style="{StaticResource HeatmapSignalPillStyle}"
                                                        Tag="{Binding TurnoverSignal}">
                                                    <TextBlock Text="Turnover"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Border>
                                                <Border Style="{StaticResource HeatmapSignalPillStyle}"
                                                        Tag="{Binding DeadStockSignal}">
                                                    <TextBlock Text="Dead stock"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Border>
                                            </WrapPanel>

                                            <UniformGrid Grid.Row="2" Columns="3" Margin="0 8 0 0">
                                                <StackPanel Margin="0 0 10 0">
                                                    <TextBlock Text="Profit"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Profit, StringFormat={}{0:N2}}"
                                                               Margin="0 4 0 0"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding ProfitMarginPercent, StringFormat={}{0:N1}%}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel Margin="0 0 10 0">
                                                    <TextBlock Text="Turnover"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding TurnoverUnits, StringFormat={}{0:N0}}"
                                                               Margin="0 4 0 0"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding TurnoverRatePercent, StringFormat={}{0:N1}%}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                                <StackPanel>
                                                    <TextBlock Text="Dead"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding DeadStockUnits, StringFormat={}{0:N0}}"
                                                               Margin="0 4 0 0"
                                                               FontSize="16"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding DeadStockPercent, StringFormat={}{0:N1}%}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </UniformGrid>

                                            <TextBlock Grid.Row="3"
                                                       Text="{Binding DeadStockValue, StringFormat={}Dead stock value {0:N2}}"
                                                       Margin="0 12 0 0"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Grid.Row="2"
                                   Text="No category heatmap data yet."
                                   HorizontalAlignment="Center"
                                   Margin="0 18 0 6"
                                   Foreground="{DynamicResource TextSecondaryBrush}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Visible"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasProfitHeatmap}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <Grid Margin="0 18 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource OwnerSectionStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0 0 0 12">
                                <TextBlock Text="Profit Per Car"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           DockPanel.Dock="Left"/>
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <DataGrid ItemsSource="{Binding ProfitPerCar}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          MaxHeight="240"
                                          HeadersVisibility="Column"
                                          BorderThickness="0"
                                          Visibility="{Binding HasProfitPerCar, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Car" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat={}{0:N2}}" Width="110"/>
                                        <DataGridTextColumn Header="Cost" Binding="{Binding Cost, StringFormat={}{0:N2}}" Width="100"/>
                                        <DataGridTextColumn Header="Profit" Binding="{Binding Profit, StringFormat={}{0:N2}}" Width="110"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="No linked car profit yet."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasProfitPerCar}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource OwnerSectionStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0 0 0 12">
                                <TextBlock Text="Profit Per Part"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           DockPanel.Dock="Left"/>
                            </DockPanel>

                            <Grid Grid.Row="1">
                                <DataGrid ItemsSource="{Binding ProfitPerPart}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          MaxHeight="240"
                                          HeadersVisibility="Column"
                                          BorderThickness="0"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          Visibility="{Binding HasProfitPerPart, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurrencyMovementEatsProfit}" Value="True">
                                                    <Setter Property="Background" Value="#33FF4757"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Part" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="Revenue" Binding="{Binding Revenue, StringFormat={}{0:N2}}" Width="95"/>
                                        <DataGridTextColumn Header="Cost Now" Binding="{Binding Cost, StringFormat={}{0:N2}}" Width="95"/>
                                        <DataGridTextColumn Header="Margin @ Buy" Binding="{Binding MarginAtPurchaseRate, StringFormat={}{0:N2}}" Width="115"/>
                                        <DataGridTextColumn Header="Margin Now" Binding="{Binding MarginAtCurrentRate, StringFormat={}{0:N2}}" Width="105"/>
                                        <DataGridTextColumn Header="FX Impact" Binding="{Binding CurrencyMovementImpact, StringFormat={}{0:N2}}" Width="100"/>
                                        <DataGridTextColumn Header="Warning" Binding="{Binding CurrencyWarning}" Width="180"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="No part profit for today."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasProfitPerPart}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>

                <Grid Margin="0 18 0 0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0"
                            Style="{StaticResource OwnerSectionStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Unpaid Transactions"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0 0 0 12"/>

                            <Grid Grid.Row="1">
                                <DataGrid ItemsSource="{Binding UnpaidTransactions}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          IsReadOnly="True"
                                          MaxHeight="280"
                                          HeadersVisibility="Column"
                                          BorderThickness="0"
                                          Visibility="{Binding HasUnpaidTransactions, Converter={StaticResource BoolToVis}}">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding TransactionDate, StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>
                                        <DataGridTextColumn Header="Type" Binding="{Binding TransactionType}" Width="130"/>
                                        <DataGridTextColumn Header="Number" Binding="{Binding TransactionNumber}" Width="150"/>
                                        <DataGridTextColumn Header="Counterparty" Binding="{Binding Counterparty}" Width="*"/>
                                        <DataGridTextColumn Header="Remaining" Binding="{Binding RemainingAmount, StringFormat={}{0:N2}}" Width="120"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding PaymentStatus}" Width="120"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                                <TextBlock Text="No unpaid transactions."
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Visible"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HasUnpaidTransactions}" Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource OwnerSectionStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="Smart Alerts"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Margin="0 0 0 12"/>

                            <ItemsControl Grid.Row="1"
                                          ItemsSource="{Binding AccountingAlerts}"
                                          Visibility="{Binding HasAccountingAlerts, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0 0 0 10"
                                                Padding="14"
                                                Background="{DynamicResource AppBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="12">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Severity}"
                                                           FontSize="11"
                                                           FontWeight="Bold">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Critical">
                                                                    <Setter Property="Foreground" Value="#FFFF4757"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentOrangeBrush}"/>
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Severity}" Value="Info">
                                                                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                                <TextBlock Text="{Binding Title}"
                                                           Margin="0 4 0 0"
                                                           FontSize="14"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Message}"
                                                           Margin="0 4 0 0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Grid.Row="2"
                                       Text="No smart alerts."
                                       HorizontalAlignment="Center"
                                       Margin="0 18 0 6"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Visibility="{Binding HasNoAccountingAlerts, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
