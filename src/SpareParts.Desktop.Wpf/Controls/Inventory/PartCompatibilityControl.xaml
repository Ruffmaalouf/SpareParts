<UserControl x:Class="SpareParts.Desktop.Wpf.PartCompatibilityControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <UserControl.Resources>
        <Style x:Key="GraphNodeButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <ContentPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="0.88"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Opacity" Value="0.72"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="CompatibilityListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Padding="12"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0 0 0 14"
                Style="{StaticResource SectionPanelStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding Status}"
                               Foreground="{Binding StatusBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding PartCountSummary}"
                               Margin="0 4 0 0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
                <Button DockPanel.Dock="Right"
                        Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="110"
                        Height="36"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="340"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0 0 0 14">
                        <TextBlock Text="Parts"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="Search by code, OEM, name, or donor vehicle."
                                   Margin="0 4 0 0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <TextBox Grid.Row="1"
                             Height="42"
                             Padding="12 0"
                             Margin="0 0 0 12"
                             VerticalContentAlignment="Center"
                             Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"/>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding FilteredParts}"
                             SelectedItem="{Binding SelectedPart, Mode=TwoWay}"
                             ItemContainerStyle="{StaticResource CompatibilityListBoxItemStyle}"
                             BorderThickness="0"
                             Background="Transparent"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <TextBlock Text="{Binding ListSubtitle}"
                                               Margin="0 4 0 0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding OemDisplay, StringFormat=OEM {0}}"
                                               Margin="0 4 0 0"
                                               FontSize="12"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ItemsControl Grid.Row="0"
                              ItemsSource="{Binding MetricTiles}"
                              Margin="0 0 0 14">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0 0 10 0"
                                    Style="{StaticResource SectionPanelStyle}"
                                    BorderBrush="{Binding AccentBrush}">
                                <StackPanel>
                                    <TextBlock Text="{Binding Label}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12"/>
                                    <TextBlock Text="{Binding Value}"
                                               Margin="0 4 0 0"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               Foreground="{Binding AccentBrush}"/>
                                    <TextBlock Text="{Binding Detail}"
                                               Margin="0 4 0 0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Grid.Row="1"
                        Style="{StaticResource CardStyle}"
                        Padding="12">
                    <Viewbox Stretch="Uniform">
                        <Grid Width="940" Height="560">
                            <Border Background="{DynamicResource AppBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"/>

                            <ItemsControl ItemsSource="{Binding GraphEdges}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="940" Height="560"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Line X1="{Binding X1}"
                                              Y1="{Binding Y1}"
                                              X2="{Binding X2}"
                                              Y2="{Binding Y2}"
                                              Stroke="{Binding Stroke}"
                                              StrokeThickness="{Binding Thickness}"
                                              StrokeStartLineCap="Round"
                                              StrokeEndLineCap="Round"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding GraphNodes}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas Width="940" Height="560"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}"/>
                                        <Setter Property="Canvas.Top" Value="{Binding Top}"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Width="{Binding Diameter}"
                                                Height="{Binding Diameter}"
                                                Style="{StaticResource GraphNodeButtonStyle}"
                                                Command="{Binding DataContext.SelectGraphNodeCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <Grid>
                                                <Ellipse Fill="{Binding Fill}"
                                                         Stroke="{Binding Stroke}"
                                                         StrokeThickness="{Binding StrokeThickness}"/>
                                                <StackPanel HorizontalAlignment="Center"
                                                            VerticalAlignment="Center"
                                                            Margin="8">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="12"
                                                               FontWeight="Bold"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               Foreground="{Binding Foreground}"/>
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Margin="0 3 0 0"
                                                               FontSize="10"
                                                               TextWrapping="Wrap"
                                                               TextAlignment="Center"
                                                               Foreground="{Binding Foreground}"
                                                               Opacity="0.82"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Viewbox>
                </Border>

                <Border Grid.Row="2"
                        Margin="0 14 0 0"
                        Style="{StaticResource SectionPanelStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   Text="EVIDENCE PARTS"
                                   Style="{StaticResource SectionHeaderTextStyle}"/>
                        <ItemsControl Grid.Row="1"
                                      Margin="0 10 0 0"
                                      ItemsSource="{Binding ProofParts}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectProofPartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0 0 8 8"
                                            MinWidth="150"
                                            Padding="10 8">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Part.DisplayCode}"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Left"/>
                                            <TextBlock Text="{Binding Reason}"
                                                       Margin="0 3 0 0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>

            <Border Grid.Column="4"
                    Style="{StaticResource CardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Selected Part"
                                   FontSize="18"
                                   FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedPartTitle}"
                                   Margin="0 12 0 0"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding SelectedPartSubtitle}"
                                   Margin="0 6 0 0"
                                   Foreground="{DynamicResource AccentBrush}"
                                   TextWrapping="Wrap"/>

                        <Border Margin="0 16 0 16"
                                Style="{StaticResource SectionPanelStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0"
                                           Text="Vehicle"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0 0 14 8"/>
                                <TextBlock Grid.Row="0" Grid.Column="1"
                                           Text="{Binding SelectedPartVehicle}"
                                           TextWrapping="Wrap"
                                           Margin="0 0 0 8"/>

                                <TextBlock Grid.Row="1" Grid.Column="0"
                                           Text="Price"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0 0 14 8"/>
                                <TextBlock Grid.Row="1" Grid.Column="1"
                                           Text="{Binding SelectedPartPrice}"
                                           Margin="0 0 0 8"/>

                                <TextBlock Grid.Row="2" Grid.Column="0"
                                           Text="Stock"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0 0 14 0"/>
                                <TextBlock Grid.Row="2" Grid.Column="1"
                                           Text="{Binding SelectedPart.StockLabel}"
                                           TextWrapping="Wrap"/>
                            </Grid>
                        </Border>

                        <TextBlock Text="FITMENT GROUPS"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   Margin="0 0 0 0"/>
                        <ItemsControl ItemsSource="{Binding FitmentGroups}"
                                      Margin="0 10 0 0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0 0 0 10"
                                            Style="{StaticResource SectionPanelStyle}">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Binding ModelName}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding YearRange}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontWeight="SemiBold"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding PartCountText}"
                                                       Margin="0 6 0 0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding DonorCountText}"
                                                       Margin="0 3 0 0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding ReasonText}"
                                                       Margin="0 8 0 0"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding ProofCodes}"
                                                       Margin="0 6 0 0"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
