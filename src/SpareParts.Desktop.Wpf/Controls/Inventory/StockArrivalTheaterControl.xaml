<UserControl x:Class="SpareParts.Desktop.Wpf.StockArrivalTheaterControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ArrivalOpportunityItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Padding="12"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0 0 0 14"
                Padding="14"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding Status}"
                               Foreground="{Binding StatusBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Turn newly arrived purchase and used-car stock into photos, follow-ups, campaigns, and prices."
                               Margin="0 4 0 0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Width="300"
                             Height="36"
                             Padding="10 0"
                             VerticalContentAlignment="Center"
                             Margin="0 0 12 0"
                             ToolTip="Part, customer, campaign, vehicle"/>
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="110"
                            Height="36"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding MetricTiles}"
                      Margin="0 0 0 14">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1" Columns="4"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0 0 10 0"
                            Padding="14"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{Binding AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Value}"
                                       Margin="0 4 0 0"
                                       FontSize="26"
                                       FontWeight="Bold"
                                       Foreground="{Binding AccentBrush}"/>
                            <TextBlock Text="{Binding Detail}"
                                       Margin="0 4 0 0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ProgressBar Grid.Row="0"
                         Height="8"
                         IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="#22000000"
                         Margin="0 0 0 12"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="12"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Lanes}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="265"
                                            Margin="0 0 12 0"
                                            Padding="10"
                                            Background="{DynamicResource AppBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" Margin="0 0 0 10">
                                                <StackPanel DockPanel.Dock="Left">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Margin="0 3 0 0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                                <Border DockPanel.Dock="Right"
                                                        Background="{DynamicResource CardHighlightBrush}"
                                                        CornerRadius="10"
                                                        Padding="8 2">
                                                    <TextBlock Text="{Binding Count}"
                                                               FontWeight="Bold"
                                                               Foreground="{Binding AccentBrush}"/>
                                                </Border>
                                            </DockPanel>

                                            <ListBox Grid.Row="1"
                                                     ItemsSource="{Binding Opportunities}"
                                                     SelectedItem="{Binding DataContext.SelectedOpportunity, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                     ItemContainerStyle="{StaticResource ArrivalOpportunityItemStyle}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Type}"
                                                                       Foreground="{Binding AccentBrush}"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Title}"
                                                                       Margin="0 4 0 0"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Subtitle}"
                                                                       Margin="0 4 0 0"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"/>
                                                            <DockPanel Margin="0 10 0 0">
                                                                <TextBlock DockPanel.Dock="Left"
                                                                           Text="{Binding Metric}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           Text="{Binding ActionLabel}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2"
                        Padding="16"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Selected Opportunity"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedTitle}"
                                       Margin="0 10 0 0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedSubtitle}"
                                       Margin="0 4 0 12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>

                            <Border Padding="12"
                                    Background="{DynamicResource AppBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Margin="0 0 0 14">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left"
                                                   Text="Next move"
                                                   FontWeight="Bold"/>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding SelectedMetric}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding SelectedAction}"
                                               Margin="0 8 0 12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                    <Button Content="{Binding OpenSelectedWorkspaceLabel}"
                                            Command="{Binding OpenSelectedWorkspaceCommand}"
                                            IsEnabled="{Binding CanOpenSelectedWorkspace}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Height="36"/>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="Evidence"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0 0 0 8"/>
                            <ItemsControl ItemsSource="{Binding SelectedOpportunity.Evidence}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <DockPanel Margin="0 0 0 8">
                                            <TextBlock DockPanel.Dock="Left"
                                                       Text="{Binding Label}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock DockPanel.Dock="Right"
                                                       Text="{Binding Value}"
                                                       FontWeight="SemiBold"
                                                       TextAlignment="Right"
                                                       TextWrapping="Wrap"/>
                                        </DockPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Margin="0 12 0 14"
                                       Background="{DynamicResource BorderBrush}"/>

                            <DockPanel Margin="0 0 0 8">
                                <TextBlock DockPanel.Dock="Left"
                                           Text="Arrival Feed"
                                           FontSize="16"
                                           FontWeight="Bold"/>
                                <TextBlock DockPanel.Dock="Right"
                                           Text="Latest signals"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding ArrivalFeed}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="10"
                                                Margin="0 0 0 8"
                                                Background="{DynamicResource AppBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Type}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontSize="11"
                                                           FontWeight="Bold"/>
                                                <TextBlock Text="{Binding Title}"
                                                           Margin="0 4 0 0"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding Detail}"
                                                           Margin="0 4 0 0"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
