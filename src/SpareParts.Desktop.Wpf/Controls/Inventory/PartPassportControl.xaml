<UserControl x:Class="SpareParts.Desktop.Wpf.PartPassportControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1320">
    <UserControl.Resources>
        <Style x:Key="PassportCardStyle" TargetType="Border">
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="Black" BlurRadius="16" ShadowDepth="4" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Compact spec tile inside the card grid — same family, less padding, no double-shadow -->
        <Style x:Key="PassportSpecTileStyle" TargetType="Border">
            <Setter Property="Padding" Value="14"/>
            <Setter Property="Background" Value="{DynamicResource CardBgSoftBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="PassportLabelStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="14 12"
                Margin="0 0 0 16"
                Background="{Binding StatusBrush}"
                CornerRadius="12">
            <Border.Effect>
                <DropShadowEffect Color="Black" BlurRadius="12" ShadowDepth="2" Opacity="0.2"/>
            </Border.Effect>
            <TextBlock Text="{Binding Status}"
                       Foreground="#FF161616"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="370"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource PassportCardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DockPanel Margin="0 0 0 12">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="INVENTORY" Style="{StaticResource PassportLabelStyle}"/>
                            <TextBlock Text="Choose a part" FontSize="21" FontWeight="Bold"/>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Refresh"
                                Command="{Binding RefreshCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="90"/>
                    </DockPanel>

                    <TextBox Grid.Row="1"
                             Margin="0 0 0 12"
                             Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Search code, part name, OEM, or barcode"/>

                    <ListBox Grid.Row="2"
                             ItemsSource="{Binding VisibleParts}"
                             SelectedItem="{Binding SelectedPart, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border Background="Transparent">
                                                <ContentPresenter/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12"
                                        Margin="0 0 0 8"
                                        Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <TextBlock Text="{Binding InternalCode}"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="{Binding Name}"
                                                   Margin="0 3 0 0"
                                                   FontWeight="Bold"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding OEMNumber, StringFormat=OEM {0}, TargetNullValue=OEM not recorded}"
                                                   Margin="0 3 0 0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource PassportCardStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="PUBLIC CARD DRAFT"
                                   Style="{StaticResource PassportLabelStyle}"/>
                        <TextBlock Text="{Binding PartTitle}"
                                   Margin="0 4 0 0"
                                   FontSize="26"
                                   FontWeight="Bold"
                                   TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding PartCode}"
                                   Margin="0 4 0 18"
                                   Foreground="{DynamicResource AccentBrush}"
                                   FontWeight="SemiBold"/>

                        <UniformGrid Columns="2" Margin="0 0 0 14">
                            <Border Style="{StaticResource PassportSpecTileStyle}" Margin="0 0 7 7">
                                <StackPanel>
                                    <TextBlock Text="OEM NUMBER" Style="{StaticResource PassportLabelStyle}"/>
                                    <TextBlock Text="{Binding OemNumber}" Margin="0 4 0 0" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PassportSpecTileStyle}" Margin="7 0 0 7">
                                <StackPanel>
                                    <TextBlock Text="DONOR SOURCE" Style="{StaticResource PassportLabelStyle}"/>
                                    <TextBlock Text="{Binding DonorSource}" Margin="0 4 0 0" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PassportSpecTileStyle}" Margin="0 7 7 0">
                                <StackPanel>
                                    <TextBlock Text="CONDITION" Style="{StaticResource PassportLabelStyle}"/>
                                    <TextBlock Text="{Binding Condition}" Margin="0 4 0 0" FontWeight="Bold"
                                               Foreground="{DynamicResource AccentGreenBrush}"/>
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource PassportSpecTileStyle}" Margin="7 7 0 0">
                                <StackPanel>
                                    <TextBlock Text="SHELF LOCATION" Style="{StaticResource PassportLabelStyle}"/>
                                    <TextBlock Text="{Binding ShelfLocation}" Margin="0 4 0 0" FontWeight="Bold"/>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <Border Padding="16"
                                Margin="0 4 0 16"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource AccentOrangeBrush}"
                                BorderThickness="1"
                                CornerRadius="12">
                            <StackPanel>
                                <TextBlock Text="REVIEW REQUIRED"
                                           Foreground="{DynamicResource AccentOrangeBrush}"
                                           FontWeight="Bold"/>
                                <TextBlock Margin="0 5 0 0"
                                           Text="Confirm chassis fitment and attach inspection photos before sharing this draft with a customer."
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <StackPanel Margin="0 10 0 0" Orientation="Horizontal">
                                    <TextBlock Text="{Binding Availability}" FontWeight="SemiBold"/>
                                    <TextBlock Text="   |   " Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding Price}" FontWeight="SemiBold" Foreground="{DynamicResource AccentGreenBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="PUBLIC PASSPORT URL" Style="{StaticResource PassportLabelStyle}"/>
                        <TextBox Margin="0 6 0 14"
                                 Text="{Binding PublicUrl, Mode=OneWay}"
                                 IsReadOnly="True"
                                 TextWrapping="Wrap"/>

                        <WrapPanel>
                            <Button Content="Copy passport link"
                                    Command="{Binding CopyLinkCommand}"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Width="165"
                                    Margin="0 0 10 10"/>
                            <Button Content="Open public card"
                                    Command="{Binding OpenPublicCardCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="150"
                                    Margin="0 0 10 10"/>
                            <Button Content="Prepare WhatsApp"
                                    Command="{Binding PrepareWhatsAppCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="155"
                                    Margin="0 0 10 10"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
