<UserControl x:Class="SpareParts.Desktop.Wpf.WhatsAppInboxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="460">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ConversationListItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemRoot"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemRoot" Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                                <Setter TargetName="ItemRoot" Property="BorderBrush" Value="#FF25D366"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MessageBubbleStyle" TargetType="Border">
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="MaxWidth" Value="640"/>
            <Setter Property="Margin" Value="0 0 0 10"/>
            <Setter Property="Padding" Value="12 10"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsOutbound}" Value="True">
                    <Setter Property="HorizontalAlignment" Value="Right"/>
                    <Setter Property="Background" Value="#2A25D366"/>
                    <Setter Property="BorderBrush" Value="#FF25D366"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <TabControl>
        <TabItem Header="Conversations">
    <Grid Margin="0 8 0 0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <DockPanel Margin="0 0 0 10">
                        <TextBlock Text="Conversations"
                                   DockPanel.Dock="Left"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>
                        <Button Content="Refresh"
                                DockPanel.Dock="Right"
                                Command="{Binding LoadConversationsCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Width="92"
                                Height="32"/>
                    </DockPanel>

                    <Grid Margin="0 0 0 10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="88"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="SearchBox"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchBox_KeyDown"
                                 Height="34"
                                 Padding="10 6"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Search conversations"/>
                        <Button Grid.Column="1"
                                Content="Search"
                                Command="{Binding LoadConversationsCommand}"
                                Style="{DynamicResource SecondaryButtonStyle}"
                                Margin="8 0 0 0"
                                Height="34"/>
                    </Grid>
                </StackPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="10"
                        Margin="0 0 0 12">
                    <StackPanel>
                        <TextBlock Text="New Chat"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0 0 0 8"/>
                        <TextBlock Text="Name"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0 0 0 4"/>
                        <TextBox Text="{Binding ManualName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Padding="10 5"
                                 ToolTip="Contact name"/>
                        <TextBlock Text="Phone"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0 8 0 4"/>
                        <TextBox Text="{Binding ManualPhone, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Padding="10 5"
                                 Margin="0 0 0 8"
                                 ToolTip="WhatsApp phone number"/>
                        <Button Content="Start Chat"
                                Command="{Binding StartManualConversationCommand}"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Height="34"/>
                    </StackPanel>
                </Border>

                <ListBox Grid.Row="2"
                         ItemsSource="{Binding Conversations}"
                         SelectedItem="{Binding SelectedConversation, Mode=TwoWay}"
                         ItemContainerStyle="{StaticResource ConversationListItemStyle}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0"
                                        Width="36"
                                        Height="36"
                                        Background="#FF25D366"
                                        CornerRadius="18"
                                        VerticalAlignment="Top">
                                    <TextBlock Text="{Binding Initials}"
                                               Foreground="White"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>

                                <StackPanel Grid.Column="1">
                                    <DockPanel>
                                        <TextBlock Text="{Binding RecipientName}"
                                                   DockPanel.Dock="Left"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding LastMessageTimeText}"
                                                   DockPanel.Dock="Right"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   Margin="8 2 0 0"/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding RecipientPhone}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0 2 0 4"/>
                                    <TextBlock Text="{Binding LastMessagePreview}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextPrimaryBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                    <DockPanel Margin="0 6 0 0">
                                        <TextBlock Text="{Binding DirectionLabel}"
                                                   DockPanel.Dock="Left"
                                                   FontSize="10"
                                                   Foreground="#FF25D366"/>
                                        <TextBlock DockPanel.Dock="Right"
                                                   Text="{Binding MessageCount, StringFormat={}{0:N0} msg}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{DynamicResource AppBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0 0 0 1"
                        Padding="16 12">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{Binding ActiveRecipientTitle}"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding ActiveRecipientSubtitle}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis"
                                       Margin="0 3 0 0"/>
                        </StackPanel>
                        <ProgressBar DockPanel.Dock="Right"
                                     Width="150"
                                     Height="8"
                                     IsIndeterminate="True"
                                     Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                                     Foreground="#FF25D366"
                                     Background="#22000000"
                                     VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <ScrollViewer x:Name="MessagesScrollViewer"
                              Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Padding="16">
                    <ItemsControl ItemsSource="{Binding Messages}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource MessageBubbleStyle}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Body}"
                                                   TextWrapping="Wrap"
                                                   FontSize="14"
                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <DockPanel Margin="0 8 0 0">
                                            <TextBlock Text="{Binding TimeText}"
                                                       DockPanel.Dock="Left"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding StatusText}"
                                                       DockPanel.Dock="Right"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="12 0 0 0"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <Border Grid.Row="2"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0 1 0 0"
                        Padding="14">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="ComposeBox"
                                 Text="{Binding ComposeText, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="54"
                                 MaxHeight="118"
                                 Padding="12 8"
                                 VerticalScrollBarVisibility="Auto"
                                 ToolTip="Message body"/>
                        <Button Grid.Column="1"
                                Content="Send"
                                Command="{Binding SendMessageCommand}"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Height="54"
                                Margin="12 0 0 0"
                                VerticalAlignment="Bottom"/>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
        </TabItem>

        <TabItem Header="Campaign Builder">
            <Grid Margin="0 8 0 0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="320"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0 0 0 12">
                            <TextBlock Text="Campaign Setup"
                                       DockPanel.Dock="Left"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                            <Button Content="Refresh"
                                    DockPanel.Dock="Right"
                                    Command="{Binding LoadCampaignBuilderCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Width="92"
                                    Height="32"/>
                        </DockPanel>

                        <StackPanel Grid.Row="1" Margin="0 0 0 12">
                            <TextBlock Text="Segment"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0 0 0 4"/>
                            <ComboBox ItemsSource="{Binding CampaignSegments}"
                                      SelectedValue="{Binding CampaignSegment, Mode=TwoWay}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      Height="34"/>

                            <TextBlock Text="Language"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0 10 0 4"/>
                            <ComboBox ItemsSource="{Binding CampaignLanguages}"
                                      SelectedValue="{Binding CampaignLanguage, Mode=TwoWay}"
                                      SelectedValuePath="Value"
                                      DisplayMemberPath="Label"
                                      Height="34"/>

                            <CheckBox Content="Attach used-car images when available"
                                      IsChecked="{Binding CampaignIncludeImages, Mode=TwoWay}"
                                      Margin="0 12 0 0"/>

                            <TextBlock Text="Campaign Name"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0 12 0 4"/>
                            <TextBox Text="{Binding CampaignName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32"
                                     Padding="10 5"
                                     ToolTip="Optional campaign name"/>

                            <TextBlock Text="Extra Note"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0 10 0 4"/>
                            <TextBox Text="{Binding CampaignNote, UpdateSourceTrigger=PropertyChanged}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="58"
                                     Padding="10 7"
                                     ToolTip="Optional note added to the generated message"/>
                        </StackPanel>

                        <Grid Grid.Row="2" Margin="0 0 0 12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Content="Preview"
                                    Command="{Binding PreviewCampaignCommand}"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Height="36"
                                    Margin="0 0 6 0"/>
                            <Button Grid.Column="1"
                                    Content="Send"
                                    Command="{Binding SendCampaignCommand}"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Height="36"
                                    Margin="6 0 0 0"/>
                        </Grid>

                        <Border Grid.Row="3"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10">
                            <UniformGrid Columns="2">
                                <StackPanel Margin="0 0 8 10">
                                    <TextBlock Text="{Binding CampaignRecipientCount, StringFormat={}{0:N0}}"
                                               FontSize="20"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Recipients"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="0 0 0 10">
                                    <TextBlock Text="{Binding CampaignAttachmentCount, StringFormat={}{0:N0}}"
                                               FontSize="20"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Images"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel Margin="0 0 8 0">
                                    <TextBlock Text="{Binding CampaignSentCount, StringFormat={}{0:N0}}"
                                               FontSize="20"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Prepared/Sent"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding CampaignFailedCount, StringFormat={}{0:N0}}"
                                               FontSize="20"
                                               FontWeight="Bold"/>
                                    <TextBlock Text="Failed"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </UniformGrid>
                        </Border>
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="220"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Parts and Cars"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 10"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding CampaignAssets}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0 0 0 8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Top"
                                                      Margin="0 2 10 0"/>
                                            <StackPanel Grid.Column="1">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding TypeBadge}"
                                                               DockPanel.Dock="Left"
                                                               FontSize="10"
                                                               Foreground="#FF25D366"
                                                               FontWeight="Bold"
                                                               Margin="0 0 8 0"/>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </DockPanel>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextTrimming="CharacterEllipsis"
                                                           Margin="0 3 0 0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="12 0 0 0" HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding PriceText}"
                                                           FontWeight="SemiBold"
                                                           HorizontalAlignment="Right"/>
                                                <TextBlock Text="{Binding ImageText}"
                                                           FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           HorizontalAlignment="Right"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="2"
                                   Text="Generated Message"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0 12 0 10"/>
                        <TextBox Grid.Row="3"
                                 Text="{Binding CampaignMessage, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 Padding="12 10"/>
                    </Grid>
                </Border>

                <Border Grid.Column="4"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="180"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Preview Recipients"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0 0 0 10"/>
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding CampaignRecipients}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0 0 0 8">
                                        <TextBlock Text="{Binding Name}"
                                                   DockPanel.Dock="Left"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Phone}"
                                                   DockPanel.Dock="Right"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="11"
                                                   Margin="8 2 0 0"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <TextBlock Grid.Row="2"
                                   Text="Recent Campaigns"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Margin="0 14 0 10"/>
                        <ListBox Grid.Row="3"
                                 ItemsSource="{Binding RecentCampaigns}"
                                 Background="Transparent"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="10"
                                            Margin="0 0 0 8">
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock Text="{Binding Name}"
                                                           DockPanel.Dock="Left"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Status}"
                                                           DockPanel.Dock="Right"
                                                           Foreground="#FF25D366"
                                                           FontSize="11"
                                                           Margin="8 2 0 0"/>
                                            </DockPanel>
                                            <TextBlock Text="{Binding CreatedAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       FontSize="11"
                                                       Margin="0 3 0 6"/>
                                            <UniformGrid Columns="3">
                                                <TextBlock Text="{Binding RecipientCount, StringFormat={}{0:N0} sent}"
                                                           FontSize="11"/>
                                                <TextBlock Text="{Binding ReplyCount, StringFormat={}{0:N0} replies}"
                                                           FontSize="11"/>
                                                <TextBlock Text="{Binding SalesCount, StringFormat={}{0:N0} sales}"
                                                           FontSize="11"/>
                                            </UniformGrid>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
