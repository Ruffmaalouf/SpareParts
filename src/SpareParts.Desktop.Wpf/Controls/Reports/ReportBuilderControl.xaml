<UserControl x:Class="SpareParts.Desktop.Wpf.ReportBuilderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             MinHeight="520">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ReportBuilderCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style x:Key="ReportBuilderLabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Margin" Value="0 12 0 5"/>
        </Style>

        <Style x:Key="ReportBuilderSmallButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="12 4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportBuilderJoinCardStyle" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
        </Style>

        <Style x:Key="ReportBuilderPaletteItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="0 0 0 6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="PaletteBorder"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="PaletteBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="PaletteBorder" Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="PaletteBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="PaletteBorder" Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ReportBuilderColumnItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="10 8"/>
            <Setter Property="Margin" Value="0 0 0 6"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="AllowDrop" Value="True"/>
            <Setter Property="Cursor" Value="Hand"/>
            <EventSetter Event="PreviewMouseLeftButtonDown" Handler="RelationColumnItem_PreviewMouseLeftButtonDown"/>
            <EventSetter Event="PreviewMouseMove" Handler="RelationColumnItem_PreviewMouseMove"/>
            <EventSetter Event="DragOver" Handler="RelationColumnItem_DragOver"/>
            <EventSetter Event="Drop" Handler="RelationColumnItem_Drop"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ColumnItemBorder"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ColumnItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ColumnItemBorder" Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ColumnItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ColumnItemBorder" Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="420"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource ReportBuilderCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 10">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Report Builder" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="Build your own report from live database tables, joins, and custom links."
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Content="Refresh"
                            DockPanel.Dock="Right"
                            Command="{Binding LoadMetadataCommand}"
                            Style="{StaticResource ReportBuilderSmallButtonStyle}"
                            Width="92"/>
                </DockPanel>

                <TabControl x:Name="ReportBuilderTabs"
                            Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0">
                    <TabItem Header="Build">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Base Table" Style="{StaticResource ReportBuilderLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Tables}"
                                          SelectedItem="{Binding SelectedTable, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{DynamicResource ManagementComboBoxStyle}"/>
                                <TextBlock Text="{Binding SelectedTable.Key}"
                                           Margin="0 4 0 0"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                                <DockPanel Margin="0 18 0 8">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Joins" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Use foreign keys or your custom links to bring related tables into the report."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <WrapPanel DockPanel.Dock="Right"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedJoinCountText}"
                                                   Margin="0 0 10 0"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button Content="Saved Links"
                                                Click="OpenTableDesignerTab_Click"
                                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                Width="104"/>
                                    </WrapPanel>
                                </DockPanel>

                                <Border Background="{DynamicResource CardHighlightBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14"
                                        Margin="0 0 0 12">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0 0 16 0">
                                            <TextBlock Text="Need to create or fix a relation?"
                                                       FontSize="13"
                                                       FontWeight="SemiBold"/>
                                            <TextBlock Text="Open the saved links list or start a new custom relation. Every custom link opens in the visual drag-and-drop popup designer."
                                                       Margin="0 6 0 0"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center">
                                            <Button Content="Saved Links"
                                                    Click="OpenTableDesignerTab_Click"
                                                    Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                    Width="104"
                                                    Margin="0 0 8 8"/>
                                            <Button Content="New Custom Link"
                                                    Command="{Binding StartNewLinkCommand}"
                                                    Style="{DynamicResource PrimaryButtonStyle}"
                                                    Width="142"
                                                    Height="36"
                                                    Margin="0 0 0 8"/>
                                        </WrapPanel>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="10"
                                        Margin="0 0 0 10">
                                    <StackPanel>
                                        <TextBlock Text="Selected Joins"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   Margin="2 0 0 8"/>
                                        <ItemsControl ItemsSource="{Binding SelectedJoins}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ReportBuilderJoinCardStyle}">
                                                        <DockPanel LastChildFill="True">
                                                            <StackPanel DockPanel.Dock="Right"
                                                                        Margin="12 0 0 0"
                                                                        HorizontalAlignment="Right">
                                                                <Button Command="{Binding DataContext.EditLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="86"
                                                                        Margin="0 0 0 8">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource ReportBuilderSmallButtonStyle}">
                                                                            <Setter Property="Content" Value="Edit"/>
                                                                            <Setter Property="Width" Value="86"/>
                                                                            <Setter Property="Margin" Value="0 0 0 8"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSystemDefined}" Value="True">
                                                                                    <Setter Property="Content" Value="Customize"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                                <Button Content="Remove"
                                                                        Command="{Binding DataContext.RemoveJoinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                                        Width="86"/>
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding LinkName}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Description}"
                                                                           Margin="0 4 0 0"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock FontSize="10"
                                                                           Margin="0 6 0 0"
                                                                           Foreground="{DynamicResource AccentBrush}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Custom relation"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSystemDefined}" Value="True">
                                                                                    <Setter Property="Text" Value="Built-in database relation"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Add only the related tables you want in this report."
                                           Margin="0 0 0 6"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                                <TextBlock Text="Available Links" Style="{StaticResource ReportBuilderLabelStyle}"/>
                                <TextBlock Text="{Binding AvailableLinkCountText}"
                                           Margin="0 0 0 6"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>

                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8"
                                        MaxHeight="200">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsControl ItemsSource="{Binding AvailableLinks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ReportBuilderJoinCardStyle}">
                                                        <DockPanel LastChildFill="True">
                                                            <StackPanel DockPanel.Dock="Right"
                                                                        Margin="12 0 0 0"
                                                                        HorizontalAlignment="Right">
                                                                <Button Content="Add"
                                                                        Command="{Binding DataContext.AddJoinCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                                        Width="82"
                                                                        Margin="0 0 0 8"/>
                                                                <Button Command="{Binding DataContext.EditLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Width="82">
                                                                    <Button.Style>
                                                                        <Style TargetType="Button" BasedOn="{StaticResource ReportBuilderSmallButtonStyle}">
                                                                            <Setter Property="Content" Value="Edit"/>
                                                                            <Setter Property="Width" Value="82"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSystemDefined}" Value="True">
                                                                                    <Setter Property="Content" Value="Customize"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </Button.Style>
                                                                </Button>
                                                            </StackPanel>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding LinkName}" FontWeight="SemiBold"/>
                                                                <TextBlock Text="{Binding Description}"
                                                                           Margin="0 4 0 0"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           TextWrapping="Wrap"/>
                                                                <TextBlock FontSize="10"
                                                                           Margin="0 6 0 0"
                                                                           Foreground="{DynamicResource AccentBrush}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="Custom relation"/>
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsSystemDefined}" Value="True">
                                                                                    <Setter Property="Text" Value="Built-in database relation"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Border>

                                <DockPanel Margin="0 18 0 8">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Columns" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Pick the fields that should appear in the final result."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedColumnCountText}"
                                                   VerticalAlignment="Center"
                                                   Margin="0 0 8 0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <Button Content="All"
                                                Command="{Binding SelectAllColumnsCommand}"
                                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                Width="58"
                                                Margin="0 0 6 0"/>
                                        <Button Content="Clear"
                                                Command="{Binding ClearColumnsCommand}"
                                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                Width="68"/>
                                    </StackPanel>
                                </DockPanel>

                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="8"
                                        Height="210">
                                    <ListBox ItemsSource="{Binding Columns}"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Margin="0 3">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{Binding Description}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>

                                <DockPanel Margin="0 18 0 8">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Filters" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Optional conditions to narrow the rows."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <Button Content="Add"
                                            DockPanel.Dock="Right"
                                            Command="{Binding AddFilterCommand}"
                                            Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                            Width="70"/>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding Filters}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ReportBuilderJoinCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="8"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>

                                                    <ComboBox Grid.Row="0"
                                                              Grid.Column="0"
                                                              ItemsSource="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                                                              DisplayMemberPath="DisplayName"
                                                              Style="{DynamicResource ExcelManagerInlineComboBoxStyle}"/>
                                                    <ComboBox Grid.Row="0"
                                                              Grid.Column="2"
                                                              ItemsSource="{Binding DataContext.OperatorOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedItem="{Binding SelectedOperator, Mode=TwoWay}"
                                                              DisplayMemberPath="DisplayName"
                                                              Style="{DynamicResource ExcelManagerInlineComboBoxStyle}"/>
                                                    <Button Grid.Row="0"
                                                            Grid.Column="3"
                                                            Content="X"
                                                            Command="{Binding DataContext.RemoveFilterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                            Width="36"/>

                                                    <TextBox Grid.Row="1"
                                                             Grid.Column="0"
                                                             Grid.ColumnSpan="4"
                                                             Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="0 8 0 0"
                                                             ToolTip="Filter value"/>
                                                    <TextBox Grid.Row="2"
                                                             Grid.Column="0"
                                                             Grid.ColumnSpan="4"
                                                             Text="{Binding ValueTo, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="0 8 0 0"
                                                             ToolTip="Second value for Between"
                                                             Visibility="{Binding NeedsSecondValue, Converter={StaticResource BoolToVis}}"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DockPanel Margin="0 18 0 8">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Calculated Fields" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Create numeric formulas with +, -, *, /, and (). Wrap field names that contain spaces in [square brackets]."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Content="Add"
                                            DockPanel.Dock="Right"
                                            Command="{Binding AddCalculatedFieldCommand}"
                                            Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                            Width="70"/>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding CalculatedFields}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource ReportBuilderJoinCardStyle}">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="140"/>
                                                        <ColumnDefinition Width="42"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBox Grid.Row="0"
                                                             Grid.Column="0"
                                                             Grid.ColumnSpan="2"
                                                             Text="{Binding Expression, UpdateSourceTrigger=PropertyChanged}"
                                                             ToolTip="Example: [Used Car / Cost] + [Used Car / Customs]"/>
                                                    <Button Grid.Row="0"
                                                            Grid.Column="2"
                                                            Content="X"
                                                            Command="{Binding DataContext.RemoveCalculatedFieldCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                            Width="36"
                                                            Margin="8 0 0 0"/>

                                                    <TextBox Grid.Row="1"
                                                             Grid.Column="0"
                                                             Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                                                             Margin="0 8 8 0"
                                                             ToolTip="Field label"/>
                                                    <TextBlock Grid.Row="1"
                                                               Grid.Column="1"
                                                               Margin="0 12 0 0"
                                                               VerticalAlignment="Center"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Text="Numeric result only"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <DockPanel Margin="0 18 0 8">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Group And Totals" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Turn the report into a summary by grouping rows and adding totals like count, sum, average, minimum, or maximum."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <WrapPanel DockPanel.Dock="Right">
                                        <Button Content="Add Group"
                                                Command="{Binding AddGroupByCommand}"
                                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                Width="88"
                                                Margin="0 0 8 0"/>
                                        <Button Content="Add Total"
                                                Command="{Binding AddAggregateCommand}"
                                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                Width="88"/>
                                    </WrapPanel>
                                </DockPanel>

                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="Group Rows"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Each selected row becomes a grouping key in the summary."
                                                   Margin="0 4 0 10"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ItemsControl ItemsSource="{Binding GroupByColumns}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0 0 0 8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="42"/>
                                                        </Grid.ColumnDefinitions>
                                                        <ComboBox Grid.Column="0"
                                                                  ItemsSource="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                  SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                                                                  DisplayMemberPath="DisplayName"
                                                                  Style="{DynamicResource ExcelManagerInlineComboBoxStyle}"/>
                                                        <Button Grid.Column="1"
                                                                Content="X"
                                                                Command="{Binding DataContext.RemoveGroupByCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                                Width="36"
                                                                Margin="8 0 0 0"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10"
                                        Margin="0 10 0 0">
                                    <StackPanel>
                                        <TextBlock Text="Totals And Statistics"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"/>
                                        <TextBlock Text="Use Count Rows when you just need how many records are inside each group."
                                                   Margin="0 4 0 10"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <ItemsControl ItemsSource="{Binding AggregateRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Style="{StaticResource ReportBuilderJoinCardStyle}">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                            </Grid.RowDefinitions>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="170"/>
                                                                <ColumnDefinition Width="8"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="42"/>
                                                            </Grid.ColumnDefinitions>

                                                            <ComboBox Grid.Row="0"
                                                                      Grid.Column="0"
                                                                      ItemsSource="{Binding DataContext.AggregateTypeOptions, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      SelectedItem="{Binding SelectedAggregateType, Mode=TwoWay}"
                                                                      DisplayMemberPath="DisplayName"
                                                                      Style="{DynamicResource ExcelManagerInlineComboBoxStyle}"/>
                                                            <ComboBox Grid.Row="0"
                                                                      Grid.Column="2"
                                                                      ItemsSource="{Binding DataContext.Columns, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                      SelectedItem="{Binding SelectedColumn, Mode=TwoWay}"
                                                                      DisplayMemberPath="DisplayName"
                                                                      IsEnabled="{Binding NeedsSourceColumn}"
                                                                      Style="{DynamicResource ExcelManagerInlineComboBoxStyle}"/>
                                                            <Button Grid.Row="0"
                                                                    Grid.Column="3"
                                                                    Content="X"
                                                                    Command="{Binding DataContext.RemoveAggregateCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                                    Width="36"/>

                                                            <TextBox Grid.Row="1"
                                                                     Grid.Column="0"
                                                                     Grid.ColumnSpan="3"
                                                                     Text="{Binding Alias, UpdateSourceTrigger=PropertyChanged}"
                                                                     Margin="0 8 0 0"
                                                                     ToolTip="Output label"/>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Sort" Style="{StaticResource ReportBuilderLabelStyle}"/>
                                <ComboBox ItemsSource="{Binding Columns}"
                                          SelectedItem="{Binding SelectedSortColumn, Mode=TwoWay}"
                                          DisplayMemberPath="DisplayName"
                                          Style="{DynamicResource ManagementComboBoxStyle}"/>
                                <CheckBox Content="Sort descending"
                                          IsChecked="{Binding SortDescending, Mode=TwoWay}"
                                          Margin="0 10 0 0"/>

                                <TextBlock Text="Max Rows" Style="{StaticResource ReportBuilderLabelStyle}"/>
                                <TextBox Text="{Binding MaxRows, UpdateSourceTrigger=PropertyChanged}"
                                         Width="120"
                                         HorizontalAlignment="Left"/>

                                <DockPanel Margin="0 20 0 8">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Currency-Aware Reporting" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Add transaction currency, base amount, counter amount, and a selected reporting-currency amount to the final result."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </DockPanel>

                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12">
                                    <StackPanel>
                                        <CheckBox Content="Enable currency-aware columns in the result"
                                                  IsChecked="{Binding CurrencyModeEnabled, Mode=TwoWay}"
                                                  Margin="0 0 0 10"/>

                                        <UniformGrid Columns="2" Margin="0 0 0 10">
                                            <StackPanel Margin="0 0 8 8">
                                                <TextBlock Text="Amount Column" Style="{StaticResource ReportBuilderLabelStyle}" Margin="0 0 0 5"/>
                                                <ComboBox ItemsSource="{Binding Columns}"
                                                          SelectedItem="{Binding SelectedCurrencyAmountColumn, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName"
                                                          Style="{DynamicResource ManagementComboBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Margin="8 0 0 8">
                                                <TextBlock Text="Transaction Currency Column" Style="{StaticResource ReportBuilderLabelStyle}" Margin="0 0 0 5"/>
                                                <ComboBox ItemsSource="{Binding Columns}"
                                                          SelectedItem="{Binding SelectedCurrencyCodeColumn, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName"
                                                          Style="{DynamicResource ManagementComboBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0 0 8 8">
                                                <TextBlock Text="Rate To Base Column" Style="{StaticResource ReportBuilderLabelStyle}" Margin="0 0 0 5"/>
                                                <ComboBox ItemsSource="{Binding Columns}"
                                                          SelectedItem="{Binding SelectedRateToBaseColumn, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName"
                                                          Style="{DynamicResource ManagementComboBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Margin="8 0 0 8">
                                                <TextBlock Text="Base Currency Column" Style="{StaticResource ReportBuilderLabelStyle}" Margin="0 0 0 5"/>
                                                <ComboBox ItemsSource="{Binding Columns}"
                                                          SelectedItem="{Binding SelectedBaseCurrencyColumn, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName"
                                                          Style="{DynamicResource ManagementComboBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Margin="0 0 8 0">
                                                <TextBlock Text="Counter Currency Column" Style="{StaticResource ReportBuilderLabelStyle}" Margin="0 0 0 5"/>
                                                <ComboBox ItemsSource="{Binding Columns}"
                                                          SelectedItem="{Binding SelectedCounterCurrencyColumn, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName"
                                                          Style="{DynamicResource ManagementComboBoxStyle}"/>
                                            </StackPanel>
                                            <StackPanel Margin="8 0 0 0">
                                                <TextBlock Text="Counter Rate Column" Style="{StaticResource ReportBuilderLabelStyle}" Margin="0 0 0 5"/>
                                                <ComboBox ItemsSource="{Binding Columns}"
                                                          SelectedItem="{Binding SelectedCounterRateColumn, Mode=TwoWay}"
                                                          DisplayMemberPath="DisplayName"
                                                          Style="{DynamicResource ManagementComboBoxStyle}"/>
                                            </StackPanel>
                                        </UniformGrid>

                                        <StackPanel MaxWidth="220">
                                            <TextBlock Text="Reporting Currency" Style="{StaticResource ReportBuilderLabelStyle}" Margin="0 0 0 5"/>
                                            <ComboBox ItemsSource="{Binding AvailableCurrencyCodes}"
                                                      SelectedItem="{Binding SelectedReportingCurrencyCode, Mode=TwoWay}"
                                                      Style="{DynamicResource ManagementComboBoxStyle}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Table Designer">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="14"
                                        Padding="16">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <DockPanel Grid.Row="0">
                                            <StackPanel DockPanel.Dock="Left" MaxWidth="460">
                                                <TextBlock Text="Visual Relation Designer"
                                                           FontSize="16"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="Open the popup designer, pick a source table and a target table, then drag one column onto the other to create the relation."
                                                           Margin="0 6 0 0"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                            <WrapPanel DockPanel.Dock="Right"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Top">
                                                <Button Content="Edit Selected"
                                                        Command="{Binding EditLinkCommand}"
                                                        IsEnabled="{Binding HasSelectedCustomLink, Mode=OneWay}"
                                                        Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                        Width="122"
                                                        Margin="0 0 8 8"/>
                                                <Button Content="New Link"
                                                        Command="{Binding StartNewLinkCommand}"
                                                        Style="{DynamicResource PrimaryButtonStyle}"
                                                        Width="110"
                                                        Height="36"
                                                        Margin="0 0 8 8"/>
                                                <Button Content="Delete Selected"
                                                        Command="{Binding DeleteLinkCommand}"
                                                        IsEnabled="{Binding HasSelectedCustomLink, Mode=OneWay}"
                                                        Style="{DynamicResource SecondaryButtonStyle}"
                                                        Width="130"
                                                        Height="36"
                                                        Margin="0 0 0 8"/>
                                            </WrapPanel>
                                        </DockPanel>

                                        <Border Grid.Row="1"
                                                Background="{DynamicResource CardHighlightBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0 14 0 0">
                                            <StackPanel>
                                                <TextBlock Text="Current Draft"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding DesignerRelationPreviewText, Mode=OneWay}"
                                                           Margin="0 6 0 0"
                                                           FontSize="13"
                                                           TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </Border>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="10"
                                        Margin="0 14 0 0">
                                    <DockPanel>
                                        <TextBlock Text="Designer Status"
                                                   FontWeight="SemiBold"
                                                   Margin="0 0 12 0"
                                                   DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding DesignerStatus, Mode=OneWay}"
                                                   Foreground="{Binding DesignerStatusBrush, Mode=OneWay}"
                                                   TextWrapping="Wrap"/>
                                    </DockPanel>
                                </Border>

                                <DockPanel Margin="0 18 0 8">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Custom Links" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Text="Select a saved relation, then open the popup designer to adjust it visually."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding CustomLinkCountText, Mode=OneWay}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               DockPanel.Dock="Right"
                                               VerticalAlignment="Center"/>
                                </DockPanel>

                                <DataGrid x:Name="CustomLinksGrid"
                                          ItemsSource="{Binding CustomLinks}"
                                          SelectedItem="{Binding SelectedCustomLink, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          MinHeight="280"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0"
                                          MouseDoubleClick="CustomLinksGrid_MouseDoubleClick">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Link" Binding="{Binding LinkName, Mode=OneWay}" Width="2*"/>
                                        <DataGridTextColumn Header="Source" Binding="{Binding SourceTableDisplayName, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="Source Column" Binding="{Binding SourceColumnName, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="Target" Binding="{Binding TargetTableDisplayName, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="Target Column" Binding="{Binding TargetColumnName, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="Join" Binding="{Binding JoinType, Mode=OneWay}" Width="90"/>
                                        <DataGridTemplateColumn Header="Action" Width="108">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Edit"
                                                            Command="{Binding DataContext.EditLinkCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                            Width="76"
                                                            Height="30"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Saved Reports">
                        <Grid Margin="0 8 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <DockPanel Margin="0 0 0 10">
                                    <StackPanel DockPanel.Dock="Left">
                                        <TextBlock Text="Saved Reports" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="Load favorites, secure sensitive layouts, and reuse the same joins, filters, grouping, exports, charts, and currency settings."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <Button Content="Load Selected"
                                            DockPanel.Dock="Right"
                                            Command="{Binding LoadSavedReportCommand}"
                                            Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                            Width="108"/>
                                </DockPanel>

                                <DataGrid ItemsSource="{Binding SavedReports}"
                                          SelectedItem="{Binding SelectedSavedReport, Mode=TwoWay}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          MinHeight="360"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="2*"/>
                                        <DataGridTextColumn Header="Table" Binding="{Binding TableDisplayName, Mode=OneWay}" Width="*"/>
                                        <DataGridCheckBoxColumn Header="Fav" Binding="{Binding IsFavorite, Mode=OneWay}" Width="56"/>
                                        <DataGridCheckBoxColumn Header="Sensitive" Binding="{Binding IsSensitive, Mode=OneWay}" Width="78"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>

                            <Border Grid.Column="2"
                                    Background="{DynamicResource AppBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="14"
                                    Padding="14">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="Layout Details" FontSize="15" FontWeight="SemiBold"/>
                                        <TextBlock Text="Save the current designer state as a reusable report, then choose who can view, edit, and export it."
                                                   Margin="0 6 0 0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>

                                        <TextBlock Text="Name" Style="{StaticResource ReportBuilderLabelStyle}"/>
                                        <TextBox Text="{Binding SavedReportName, UpdateSourceTrigger=PropertyChanged}"/>

                                        <TextBlock Text="Description" Style="{StaticResource ReportBuilderLabelStyle}"/>
                                        <TextBox Text="{Binding SavedReportDescription, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True"
                                                 MinHeight="72"
                                                 TextWrapping="Wrap"/>

                                        <CheckBox Content="Mark this report as sensitive"
                                                  IsChecked="{Binding SavedReportIsSensitive, Mode=TwoWay}"
                                                  Margin="0 12 0 0"/>

                                        <TextBlock Text="Default Export" Style="{StaticResource ReportBuilderLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding AvailableExportFormats}"
                                                  SelectedItem="{Binding SelectedExportFormat, Mode=TwoWay}"
                                                  Style="{DynamicResource ManagementComboBoxStyle}"/>

                                        <TextBlock Text="Default Chart" Style="{StaticResource ReportBuilderLabelStyle}"/>
                                        <ComboBox ItemsSource="{Binding AvailableChartTypes}"
                                                  SelectedItem="{Binding SelectedChartType, Mode=TwoWay}"
                                                  Style="{DynamicResource ManagementComboBoxStyle}"/>

                                        <TextBlock Text="Role Security" Style="{StaticResource ReportBuilderLabelStyle}"/>
                                        <DataGrid ItemsSource="{Binding ReportRoleAccess}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  MinHeight="220"
                                                  HeadersVisibility="Column"
                                                  GridLinesVisibility="Horizontal"
                                                  BorderThickness="0">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Role" Binding="{Binding RoleName, Mode=OneWay}" Width="*"/>
                                                <DataGridCheckBoxColumn Header="View" Binding="{Binding CanView, Mode=TwoWay}" Width="68"/>
                                                <DataGridCheckBoxColumn Header="Edit" Binding="{Binding CanEdit, Mode=TwoWay}" Width="68"/>
                                                <DataGridCheckBoxColumn Header="Export" Binding="{Binding CanExport, Mode=TwoWay}" Width="78"/>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <WrapPanel Margin="0 14 0 0">
                                            <Button Content="Save Current"
                                                    Command="{Binding SaveCurrentReportCommand}"
                                                    Style="{DynamicResource PrimaryButtonStyle}"
                                                    Width="118"
                                                    Height="38"
                                                    Margin="0 0 8 8"/>
                                            <Button Content="Load Selected"
                                                    Command="{Binding LoadSavedReportCommand}"
                                                    Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                    Width="112"
                                                    Margin="0 0 8 8"/>
                                            <Button Content="Favorite"
                                                    Command="{Binding ToggleFavoriteReportCommand}"
                                                    Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                                    Width="92"
                                                    Margin="0 0 8 8"/>
                                            <Button Content="Delete"
                                                    Command="{Binding DeleteSavedReportCommand}"
                                                    IsEnabled="{Binding CanDeleteSelectedSavedReport}"
                                                    Style="{DynamicResource SecondaryButtonStyle}"
                                                    Width="92"
                                                    Height="38"
                                                    Margin="0 0 0 8"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </TabItem>
                </TabControl>

                <Button Grid.Row="2"
                        Content="Run Report"
                        Command="{Binding RunReportCommand}"
                        Style="{DynamicResource PrimaryButtonStyle}"
                        Height="44"
                        Margin="0 16 0 0"/>
            </Grid>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource ReportBuilderCardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding ResultViewerTitle}" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding ResultViewerHint}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <WrapPanel DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top">
                        <Button Content="Excel (.xls)"
                                Command="{Binding ExportResultsCommand}"
                                CommandParameter="xls"
                                IsEnabled="{Binding CanExportCurrentResult}"
                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                Width="96"
                                Margin="0 0 8 8"/>
                        <Button Content="PDF"
                                Command="{Binding ExportResultsCommand}"
                                CommandParameter="pdf"
                                IsEnabled="{Binding CanExportCurrentResult}"
                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                Width="64"
                                Margin="0 0 8 8"/>
                        <Button Content="CSV"
                                Command="{Binding ExportResultsCommand}"
                                CommandParameter="csv"
                                IsEnabled="{Binding CanExportCurrentResult}"
                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                Width="64"
                                Margin="0 0 8 8"/>
                        <Button Content="JSON"
                                Command="{Binding ExportResultsCommand}"
                                CommandParameter="json"
                                IsEnabled="{Binding CanExportCurrentResult}"
                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                Width="68"
                                Margin="0 0 8 8"/>
                        <Button Content="SQL Preview"
                                Command="{Binding ToggleSqlPreviewCommand}"
                                IsEnabled="{Binding HasSqlPreview}"
                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                Width="92"
                                Margin="0 0 8 8"/>
                        <Button Content="Row Details"
                                Command="{Binding OpenRowDetailsCommand}"
                                IsEnabled="{Binding HasResult}"
                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                Width="92"
                                Margin="0 0 8 8"/>
                        <Button Content="Drill Down"
                                Command="{Binding DrillDownCommand}"
                                IsEnabled="{Binding CanDrillDown}"
                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                Width="88"
                                Margin="0 0 8 8"/>
                        <Button Content="Run Report"
                                Command="{Binding RunReportCommand}"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Width="130"
                                Height="38"
                                Margin="0 0 0 8"/>
                    </WrapPanel>
                </DockPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0 14 0 14">
                    <DockPanel>
                        <TextBlock Text="Status"
                                   FontWeight="SemiBold"
                                   Margin="0 0 12 0"
                                   DockPanel.Dock="Left"/>
                         <TextBlock Text="{Binding Status}"
                                    Foreground="{Binding StatusBrush}"
                                    TextWrapping="Wrap"/>
                     </DockPanel>
                 </Border>

                <UniformGrid Grid.Row="2"
                             Columns="3"
                             Margin="0 0 0 14">
                    <Border Background="{DynamicResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0 0 10 0">
                        <StackPanel>
                            <TextBlock Text="Report Source"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding ResultTableName}"
                                       Margin="0 6 0 0"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0 0 10 0">
                        <StackPanel>
                            <TextBlock Text="Returned Data"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Margin="0 6 0 0"
                                       FontSize="16"
                                       FontWeight="Bold">
                                <Run Text="{Binding ResultRowsText, Mode=OneWay}"/>
                                <Run Text=" • "/>
                                <Run Text="{Binding ResultColumnsText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource AppBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Last Run"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding LastRunText}"
                                       Margin="0 6 0 0"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <Border Grid.Row="3"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10"
                        Margin="0 0 0 14"
                        Visibility="{Binding HasSqlPreview, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <DockPanel Margin="0 0 0 8">
                            <TextBlock Text="Generated SQL"
                                       FontWeight="SemiBold"
                                       DockPanel.Dock="Left"/>
                            <Button Content="Copy SQL"
                                    DockPanel.Dock="Right"
                                    Command="{Binding CopySqlPreviewCommand}"
                                    Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                    Width="82"/>
                        </DockPanel>
                        <TextBox Text="{Binding SqlPreviewText, Mode=OneWay}"
                                 IsReadOnly="True"
                                 FontFamily="Consolas"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 HorizontalScrollBarVisibility="Auto"
                                 MinHeight="120">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding HasSqlPreview}" Value="True"/>
                                                <Condition Binding="{Binding IsSqlPreviewVisible}" Value="True"/>
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </StackPanel>
                </Border>

                <TabControl Grid.Row="4"
                            Background="Transparent"
                            BorderThickness="0">
                    <TabItem Header="Grid">
                        <Grid Margin="0 8 0 0">
                            <Border Background="{DynamicResource AppBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="28">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Visible"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasResult}" Value="True">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MaxWidth="420">
                                    <TextBlock Text="Report Viewer"
                                               FontSize="24"
                                               FontWeight="Bold"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Run a report from the builder on the left to preview live rows here. After that you can export the result to Excel, PDF, CSV, or JSON."
                                               Margin="0 10 0 0"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>

                            <DataGrid x:Name="ResultDataGrid"
                                      Visibility="{Binding HasResult, Converter={StaticResource BoolToVis}}"
                                      SelectedItem="{Binding SelectedResultRow, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="All"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0"
                                      MouseDoubleClick="ResultDataGrid_MouseDoubleClick"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto"/>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Charts">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0 8 0 0">
                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="180"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="Chart Type" Style="{StaticResource ReportBuilderLabelStyle}" Margin="0 0 0 5"/>
                                            <ComboBox ItemsSource="{Binding AvailableChartTypes}"
                                                      SelectedItem="{Binding SelectedChartType, Mode=TwoWay}"
                                                      Style="{DynamicResource ManagementComboBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Category Column" Style="{StaticResource ReportBuilderLabelStyle}" Margin="0 0 0 5"/>
                                            <ComboBox ItemsSource="{Binding ResultColumnNames}"
                                                      SelectedItem="{Binding SelectedChartCategoryColumnName, Mode=TwoWay}"
                                                      Style="{DynamicResource ManagementComboBoxStyle}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="4">
                                            <TextBlock Text="Value Column" Style="{StaticResource ReportBuilderLabelStyle}" Margin="0 0 0 5"/>
                                            <ComboBox ItemsSource="{Binding ResultColumnNames}"
                                                      SelectedItem="{Binding SelectedChartValueColumnName, Mode=TwoWay}"
                                                      Style="{DynamicResource ManagementComboBoxStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="12"
                                        Margin="0 12 0 12">
                                    <TextBlock Text="{Binding ChartStatusText}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </Border>

                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14"
                                        Margin="0 0 0 12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedChartType}" Value="bar">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ItemsControl ItemsSource="{Binding ChartPoints}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0 0 0 10">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="180"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="120"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="{Binding Label}"
                                                               VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <ProgressBar Grid.Column="1"
                                                                 Margin="10 0"
                                                                 Height="16"
                                                                 Minimum="0"
                                                                 Maximum="1"
                                                                 Value="{Binding Percentage}"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding Value, StringFormat={}{0:N2}}"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14"
                                        Margin="0 0 0 12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedChartType}" Value="line">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <Canvas x:Name="LineChartCanvas" Width="720" Height="320"/>
                                    </ScrollViewer>
                                </Border>

                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14"
                                        Margin="0 0 0 12">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedChartType}" Value="pie">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                        <Canvas x:Name="PieChartCanvas" Width="720" Height="360"/>
                                    </ScrollViewer>
                                </Border>

                                <ItemsControl ItemsSource="{Binding KpiCards}">
                                    <ItemsControl.Style>
                                        <Style TargetType="ItemsControl">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding SelectedChartType}" Value="kpi">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ItemsControl.Style>
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Columns="2"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AppBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="12"
                                                    Padding="16"
                                                    Margin="0 0 12 12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Label}"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    <TextBlock Text="{Binding Value}"
                                                               Margin="0 8 0 0"
                                                               FontSize="24"
                                                               FontWeight="Bold"/>
                                                    <TextBlock Text="{Binding Hint}"
                                                               Margin="0 8 0 0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Schema Inspector">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="0 8 0 0">
                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="12"
                                        Padding="14">
                                    <StackPanel>
                                        <TextBlock Text="{Binding SchemaInspector.DisplayName, TargetNullValue=Choose a table}"
                                                   FontSize="18"
                                                   FontWeight="Bold"/>
                                        <TextBlock Text="{Binding SchemaInspectorSummaryText}"
                                                   Margin="0 8 0 0"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SchemaInspector.Description, Mode=OneWay}"
                                                   Margin="0 10 0 0"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="Columns" Style="{StaticResource ReportBuilderLabelStyle}"/>
                                <DataGrid ItemsSource="{Binding SchemaInspector.Columns}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          MinHeight="280"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Column" Binding="{Binding DisplayName, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="SQL Type" Binding="{Binding SqlDataType, Mode=OneWay}" Width="120"/>
                                        <DataGridCheckBoxColumn Header="PK" Binding="{Binding IsPrimaryKey, Mode=OneWay}" Width="56"/>
                                        <DataGridCheckBoxColumn Header="FK" Binding="{Binding IsForeignKey, Mode=OneWay}" Width="56"/>
                                        <DataGridCheckBoxColumn Header="Nullable" Binding="{Binding IsNullable, Mode=OneWay}" Width="74"/>
                                        <DataGridTextColumn Header="Samples" Binding="{Binding SampleValuesText, Mode=OneWay}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <TextBlock Text="Relations" Style="{StaticResource ReportBuilderLabelStyle}"/>
                                <DataGrid ItemsSource="{Binding SchemaInspector.Relations}"
                                          AutoGenerateColumns="False"
                                          CanUserAddRows="False"
                                          CanUserDeleteRows="False"
                                          IsReadOnly="True"
                                          MinHeight="180"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Direction" Binding="{Binding Direction, Mode=OneWay}" Width="96"/>
                                        <DataGridTextColumn Header="Column" Binding="{Binding ColumnName, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="Related Table" Binding="{Binding RelatedTableDisplayName, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="Related Column" Binding="{Binding RelatedColumnName, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="Cardinality" Binding="{Binding CardinalityLabel, Mode=OneWay}" Width="96"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Join Graph">
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                            <Canvas x:Name="JoinGraphCanvas" Width="960" Height="520" Margin="0 8 0 0"/>
                        </ScrollViewer>
                    </TabItem>
                    <TabItem Header="Background Runs">
                        <StackPanel Margin="0 8 0 0">
                            <DockPanel Margin="0 0 0 10">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Background Execution" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock Text="Queue heavier reports in the background, track progress, and open the result when it is ready."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                                <WrapPanel DockPanel.Dock="Right">
                                    <Button Content="Refresh"
                                            Command="{Binding RefreshBackgroundRunsCommand}"
                                            Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                            Width="88"
                                            Margin="0 0 8 0"/>
                                    <Button Content="Queue Current"
                                            Command="{Binding QueueBackgroundRunCommand}"
                                            Style="{DynamicResource PrimaryButtonStyle}"
                                            Width="118"
                                            Height="38"/>
                                </WrapPanel>
                            </DockPanel>

                            <DataGrid ItemsSource="{Binding BackgroundRuns}"
                                      SelectedItem="{Binding SelectedBackgroundRun, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      IsReadOnly="True"
                                      MinHeight="360"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Report" Binding="{Binding ReportName, Mode=OneWay}" Width="2*"/>
                                    <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="96"/>
                                    <DataGridTextColumn Header="Progress" Binding="{Binding ProgressPercent, Mode=OneWay}" Width="86"/>
                                    <DataGridTextColumn Header="Rows" Binding="{Binding RowCount, Mode=OneWay}" Width="72"/>
                                    <DataGridTextColumn Header="Summary" Binding="{Binding Summary, Mode=OneWay}" Width="2*"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <WrapPanel Margin="0 12 0 0">
                                <Button Content="Open Result"
                                        Command="{Binding OpenBackgroundRunResultCommand}"
                                        IsEnabled="{Binding CanOpenSelectedBackgroundRun}"
                                        Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                        Width="104"
                                        Margin="0 0 8 0"/>
                                <TextBlock Text="{Binding SelectedBackgroundRun.ErrorMessage}"
                                           VerticalAlignment="Center"
                                           Foreground="OrangeRed"
                                           TextWrapping="Wrap"/>
                            </WrapPanel>
                        </StackPanel>
                    </TabItem>
                </TabControl>
            </Grid>
        </Border>

        <Grid Grid.ColumnSpan="3"
              Panel.ZIndex="24"
              Background="#700E0E0E"
              Visibility="{Binding IsRowDetailsOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18"
                    Padding="20"
                    Margin="48"
                    MaxWidth="820"
                    MaxHeight="760"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="{Binding RowDetailsTitle}"
                                       FontSize="20"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Review the selected row values, then drill into the raw rows if this is a grouped summary."
                                       Margin="0 6 0 0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Content="Close"
                                DockPanel.Dock="Right"
                                Command="{Binding CloseRowDetailsCommand}"
                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                Width="82"
                                Height="36"/>
                    </DockPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RowDetails}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              IsReadOnly="True"
                              Margin="0 16 0 16"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Field" Binding="{Binding Label, Mode=OneWay}" Width="2*"/>
                            <DataGridTextColumn Header="Value" Binding="{Binding Value, Mode=OneWay}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <WrapPanel Grid.Row="2"
                               HorizontalAlignment="Right">
                        <Button Content="Drill Down"
                                Command="{Binding DrillDownCommand}"
                                IsEnabled="{Binding CanDrillDown}"
                                Style="{DynamicResource PrimaryButtonStyle}"
                                Width="110"
                                Height="38"
                                Margin="0 0 8 0"/>
                        <Button Content="Close"
                                Command="{Binding CloseRowDetailsCommand}"
                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                Width="82"
                                Height="38"/>
                    </WrapPanel>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.ColumnSpan="3"
              Panel.ZIndex="30"
              Background="#800E0E0E"
              Visibility="{Binding IsDesignerPopupOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="22"
                    Margin="28"
                    MaxWidth="1380"
                    MaxHeight="900"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Left" MaxWidth="760">
                            <TextBlock Text="Relation Designer"
                                       FontSize="22"
                                       FontWeight="Bold"/>
                            <TextBlock Text="Pick a source table and a target table, drag one column onto the other, then save the relation."
                                       Margin="0 6 0 0"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Content="Close"
                                DockPanel.Dock="Right"
                                Command="{Binding CloseDesignerPopupCommand}"
                                Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                Width="82"
                                Height="36"/>
                    </DockPanel>

                    <Grid Grid.Row="1" Margin="0 16 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="280"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource CardHighlightBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">
                            <StackPanel>
                                <TextBlock Text="Live Draft"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Text="{Binding DesignerRelationPreviewText, Mode=OneWay}"
                                           Margin="0 6 0 0"
                                           FontSize="14"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="180"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Link Name"
                                               Style="{StaticResource ReportBuilderLabelStyle}"
                                               Margin="0 0 0 5"/>
                                    <TextBox Text="{Binding DesignerLinkName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Join Type"
                                               Style="{StaticResource ReportBuilderLabelStyle}"
                                               Margin="0 0 0 5"/>
                                    <ComboBox ItemsSource="{Binding JoinTypeOptions}"
                                              SelectedItem="{Binding SelectedJoinType, Mode=TwoWay}"
                                              DisplayMemberPath="DisplayName"
                                              Style="{DynamicResource ManagementComboBoxStyle}"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="2" Margin="0 18 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="220"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Source Tables"
                                           FontWeight="SemiBold"
                                           Margin="0 0 0 10"/>
                                <TextBlock Text="Choose the table you are linking from."
                                           Margin="0 0 0 10"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <ListBox ItemsSource="{Binding Tables}"
                                         SelectedItem="{Binding SelectedDesignerSourceTable, Mode=TwoWay}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ItemContainerStyle="{StaticResource ReportBuilderPaletteItemStyle}"
                                         SelectionChanged="RelationSelectionChanged"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Key}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="12">
                            <Canvas x:Name="RelationCanvas"
                                    MinHeight="520"
                                    ClipToBounds="True"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    SizeChanged="RelationCanvas_SizeChanged">
                                <Path x:Name="RelationConnectorPath"
                                      Visibility="Collapsed"
                                      Stroke="{DynamicResource AccentBrush}"
                                      StrokeThickness="3"
                                      StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      IsHitTestVisible="False"/>
                                <Ellipse x:Name="SourceRelationDot"
                                         Width="10"
                                         Height="10"
                                         Fill="{DynamicResource AccentBrush}"
                                         Visibility="Collapsed"
                                         IsHitTestVisible="False"/>
                                <Ellipse x:Name="TargetRelationDot"
                                         Width="10"
                                         Height="10"
                                         Fill="{DynamicResource AccentBrush}"
                                         Visibility="Collapsed"
                                         IsHitTestVisible="False"/>

                                <Border x:Name="SourceTableCard"
                                        Width="300"
                                        Canvas.Left="36"
                                        Canvas.Top="32"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Loaded="RelationVisual_Loaded"
                                        SizeChanged="RelationVisual_SizeChanged">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Background="{DynamicResource CardHighlightBrush}"
                                                Padding="12"
                                                CornerRadius="16 16 0 0"
                                                Cursor="SizeAll"
                                                MouseLeftButtonDown="RelationCardHeader_MouseLeftButtonDown"
                                                MouseMove="RelationCardHeader_MouseMove"
                                                MouseLeftButtonUp="RelationCardHeader_MouseLeftButtonUp"
                                                LostMouseCapture="RelationCardHeader_LostMouseCapture">
                                            <StackPanel>
                                                <TextBlock Text="Source Table • drag to move"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedDesignerSourceTable.DisplayName, Mode=OneWay, TargetNullValue=Choose a source table}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SelectedDesignerSourceTable.Key, Mode=OneWay, TargetNullValue=No table selected}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Grid Grid.Row="1" Margin="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Drag a source column"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0 0 0 8"/>
                                            <ListBox x:Name="SourceColumnsListBox"
                                                     Grid.Row="1"
                                                     Tag="Source"
                                                     ItemsSource="{Binding DesignerSourceColumns}"
                                                     SelectedItem="{Binding SelectedDesignerSourceColumn, Mode=TwoWay}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ItemContainerStyle="{StaticResource ReportBuilderColumnItemStyle}"
                                                     SelectionChanged="RelationSelectionChanged"
                                                     Loaded="RelationVisual_Loaded"
                                                     SizeChanged="RelationVisual_SizeChanged"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding SqlDataType}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Grid>
                                </Border>

                                <Border x:Name="TargetTableCard"
                                        Width="300"
                                        Canvas.Left="470"
                                        Canvas.Top="132"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="16"
                                        Loaded="RelationVisual_Loaded"
                                        SizeChanged="RelationVisual_SizeChanged">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                        </Grid.RowDefinitions>
                                        <Border Grid.Row="0"
                                                Background="{DynamicResource CardHighlightBrush}"
                                                Padding="12"
                                                CornerRadius="16 16 0 0"
                                                Cursor="SizeAll"
                                                MouseLeftButtonDown="RelationCardHeader_MouseLeftButtonDown"
                                                MouseMove="RelationCardHeader_MouseMove"
                                                MouseLeftButtonUp="RelationCardHeader_MouseLeftButtonUp"
                                                LostMouseCapture="RelationCardHeader_LostMouseCapture">
                                            <StackPanel>
                                                <TextBlock Text="Target Table • drag to move"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                <TextBlock Text="{Binding SelectedDesignerTargetTable.DisplayName, Mode=OneWay, TargetNullValue=Choose a target table}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding SelectedDesignerTargetTable.Key, Mode=OneWay, TargetNullValue=No table selected}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Grid Grid.Row="1" Margin="12">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="Drop on a target column"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       Margin="0 0 0 8"/>
                                            <ListBox x:Name="TargetColumnsListBox"
                                                     Grid.Row="1"
                                                     Tag="Target"
                                                     ItemsSource="{Binding DesignerTargetColumns}"
                                                     SelectedItem="{Binding SelectedDesignerTargetColumn, Mode=TwoWay}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     ItemContainerStyle="{StaticResource ReportBuilderColumnItemStyle}"
                                                     SelectionChanged="RelationSelectionChanged"
                                                     Loaded="RelationVisual_Loaded"
                                                     SizeChanged="RelationVisual_SizeChanged"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding SqlDataType}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </Canvas>
                        </Border>

                        <Border Grid.Column="4"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="12">
                            <StackPanel>
                                <TextBlock Text="Target Tables"
                                           FontWeight="SemiBold"
                                           Margin="0 0 0 10"/>
                                <TextBlock Text="Choose the table you are linking to."
                                           Margin="0 0 0 10"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <ListBox ItemsSource="{Binding Tables}"
                                         SelectedItem="{Binding SelectedDesignerTargetTable, Mode=TwoWay}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ItemContainerStyle="{StaticResource ReportBuilderPaletteItemStyle}"
                                         SelectionChanged="RelationSelectionChanged"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel>
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Key}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0 18 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12"
                                Margin="0 0 16 0">
                            <DockPanel>
                                <TextBlock Text="Designer Status"
                                           FontWeight="SemiBold"
                                           Margin="0 0 12 0"
                                           DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding DesignerStatus, Mode=OneWay}"
                                           Foreground="{Binding DesignerStatusBrush, Mode=OneWay}"
                                           TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>

                        <WrapPanel Grid.Column="1"
                                   HorizontalAlignment="Right">
                            <Button Content="New Link"
                                    Command="{Binding StartNewLinkCommand}"
                                    Style="{StaticResource ReportBuilderSmallButtonStyle}"
                                    Width="110"
                                    Margin="0 0 8 0"/>
                            <Button Content="Save Link"
                                    Command="{Binding SaveLinkCommand}"
                                    Style="{DynamicResource PrimaryButtonStyle}"
                                    Width="120"
                                    Height="38"
                                    Margin="0 0 8 0"/>
                            <Button Content="Delete Selected"
                                    Command="{Binding DeleteLinkCommand}"
                                    IsEnabled="{Binding HasSelectedCustomLink, Mode=OneWay}"
                                    Style="{DynamicResource SecondaryButtonStyle}"
                                    Width="132"
                                    Height="38"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
