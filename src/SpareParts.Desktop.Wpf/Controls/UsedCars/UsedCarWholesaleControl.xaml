<UserControl x:Class="SpareParts.Desktop.Wpf.UsedCarWholesaleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style TargetType="ComboBox" BasedOn="{StaticResource AccountingComboBoxStyle}"/>

        <Style x:Key="WholesaleShellPanelStyle" TargetType="Border">
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>

        <Style x:Key="WholesaleLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0 0 0 4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
        </Style>

        <Style x:Key="WholesaleSectionLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>

        <Style x:Key="WholesaleMetricTextStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style x:Key="WholesaleListBoxStyle" TargetType="ListBox">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="2"/>
        </Style>

        <Style x:Key="WholesaleListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Padding" Value="4"/>
            <Setter Property="Margin" Value="0 0 0 2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="3"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WholesaleDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource CardHighlightBrush}"/>
            <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="ColumnHeaderHeight" Value="34"/>
            <Setter Property="RowHeight" Value="34"/>
        </Style>

        <Style x:Key="WholesaleDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10 6"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DataGridCell">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WholesaleDataGridRowStyle" TargetType="DataGridRow">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WholesaleDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="0 0 0 1"/>
            <Setter Property="Padding" Value="10 8"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="WholesaleGridTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        </Style>

        <Style TargetType="{x:Type primitives:DatePickerTextBox}">
            <Setter Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10 7"/>
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type primitives:DatePickerTextBox}">
                        <Border x:Name="DateTextBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="3">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="DateTextBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="DateTextBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WholesaleDatePickerStyle" TargetType="DatePicker">
            <Setter Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="38"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0 0 0 10"
                Style="{StaticResource SectionPanelStyle}">
            <DockPanel LastChildFill="True">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                    <Button Content="Refresh"
                            Command="{Binding LoadCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="96"
                            Margin="0 0 8 0"/>
                    <Button Content="Reset"
                            Command="{Binding ResetCommand}"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Width="86"
                            Margin="0 0 8 0"/>
                    <Button Content="Record Sale"
                            Command="{Binding SubmitCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="124"/>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Used Car Wholesale"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <StackPanel Orientation="Horizontal" Margin="0 3 0 0">
                        <TextBlock Text="{Binding ScreenSummary}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="  |  "
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Status}"
                                   Foreground="{Binding StatusBrush}"
                                   FontWeight="SemiBold"/>
                    </StackPanel>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="1.15*"/>
                <ColumnDefinition Width="1.35*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0 0 10 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0 0 0 10">
                        <TextBlock Text="AVAILABLE CARS"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   Margin="0 0 0 4"/>
                        <TextBlock Text="Sold cars are removed from this list after posting."
                                   Margin="0 3 0 0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding AvailableCars}"
                             SelectedValuePath="Id"
                             SelectedValue="{Binding SelectedUsedCarId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource WholesaleListBoxStyle}"
                             ItemContainerStyle="{StaticResource WholesaleListBoxItemStyle}"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4">
                                    <TextBlock FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Car}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding ModelYear}"/>
                                    </TextBlock>
                                    <TextBlock FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextTrimming="CharacterEllipsis">
                                        <Run Text="{Binding Barcode}"/>
                                        <Run Text="  |  Cost "/>
                                        <Run Text="{Binding FullCostBase, StringFormat={}{0:N2}}"/>
                                        <Run Text=" "/>
                                        <Run Text="{Binding BaseCurrencyCode}"/>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource CardStyle}"
                    Margin="0 0 10 0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Wholesale Ticket"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding SelectedCarSummary}"
                                   Margin="0 4 0 12"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                        <Border Style="{StaticResource SectionPanelStyle}" Margin="0 0 0 14">
                            <StackPanel>
                                <TextBlock Text="DEAL SUMMARY" Style="{StaticResource SectionHeaderTextStyle}"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0 0 8 0">
                                        <TextBlock Text="Loaded Cost" Style="{StaticResource WholesaleLabelStyle}"/>
                                        <TextBlock Text="{Binding LoadedCostLabel}" Style="{StaticResource WholesaleMetricTextStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="8 0 8 0">
                                        <TextBlock Text="Repair Total" Style="{StaticResource WholesaleLabelStyle}"/>
                                        <TextBlock Text="{Binding RepairTotalLabel}" Style="{StaticResource WholesaleMetricTextStyle}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="8 0 0 0">
                                        <TextBlock Text="Result" Style="{StaticResource WholesaleLabelStyle}"/>
                                        <TextBlock Text="{Binding ProjectedProfitLossLabel}" Style="{StaticResource WholesaleMetricTextStyle}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Two-column grouped layout: Buyer/Money on the left, Condition/Repairs/Notes on the right -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0 0 0 14">
                                    <StackPanel>
                                        <TextBlock Text="BUYER" Style="{StaticResource SectionHeaderTextStyle}"/>
                                        <Grid Margin="0 0 0 12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.1*"/>
                                                <ColumnDefinition Width="0.8*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0 0 8 0">
                                                <TextBlock Text="Customer" Style="{StaticResource WholesaleLabelStyle}"/>
                                                <ComboBox ItemsSource="{Binding Customers}"
                                                          SelectedValuePath="Id"
                                                          DisplayMemberPath="Name"
                                                          SelectedValue="{Binding SelectedCustomerId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8 0 0 0">
                                                <TextBlock Text="Sale Date" Style="{StaticResource WholesaleLabelStyle}"/>
                                                <DatePicker SelectedDate="{Binding SaleDate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            SelectedDateFormat="Short"
                                                            Style="{StaticResource WholesaleDatePickerStyle}"
                                                            Height="38"/>
                                            </StackPanel>
                                        </Grid>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0 0 8 0">
                                                <TextBlock Text="Buyer Name" Style="{StaticResource WholesaleLabelStyle}"/>
                                                <TextBox Text="{Binding BuyerName, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="38"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8 0 0 0">
                                                <TextBlock Text="Buyer Phone" Style="{StaticResource WholesaleLabelStyle}"/>
                                                <TextBox Text="{Binding BuyerPhone, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="38"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="MONEY" Style="{StaticResource SectionHeaderTextStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.75*"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0 0 8 0">
                                                <TextBlock Text="Currency" Style="{StaticResource WholesaleLabelStyle}"/>
                                                <ComboBox ItemsSource="{Binding CurrencyOptions}"
                                                          SelectedItem="{Binding CurrencyCode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8 0 8 0">
                                                <TextBlock Text="Sale Price" Style="{StaticResource WholesaleLabelStyle}"/>
                                                <TextBox Text="{Binding SalePriceText, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="38"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Margin="8 0 0 0">
                                                <TextBlock Text="Paid Amount" Style="{StaticResource WholesaleLabelStyle}"/>
                                                <TextBox Text="{Binding PaidAmountText, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="38"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0 0 0 14">
                                    <StackPanel>
                                        <TextBlock Text="CONDITION" Style="{StaticResource SectionHeaderTextStyle}"/>
                                        <Grid Margin="0 0 0 8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsForParts, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="For parts only"
                                                      FontWeight="SemiBold"
                                                      Margin="0 0 8 0"/>
                                            <CheckBox Grid.Column="1"
                                                      IsChecked="{Binding SoldAsIsAcknowledged, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Content="As-is acknowledged"
                                                      FontWeight="SemiBold"
                                                      Margin="8 0 0 0"/>
                                        </Grid>
                                        <TextBlock Text="{Binding SaleConditionLabel}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionPanelStyle}" Margin="0 0 0 14">
                                    <StackPanel IsEnabled="{Binding IsRepairListEnabled}">
                                        <TextBlock Text="REPAIR ITEMS" Style="{StaticResource SectionHeaderTextStyle}"/>
                                        <Grid Margin="0 0 0 8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="110"/>
                                                <ColumnDefinition Width="72"/>
                                                <ColumnDefinition Width="72"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Grid.Column="0"
                                                     Text="{Binding RepairDescription, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="36"
                                                     Margin="0 0 6 0"
                                                     ToolTip="Repair description"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding RepairPriceText, UpdateSourceTrigger=PropertyChanged}"
                                                     Height="36"
                                                     Margin="6 0"
                                                     ToolTip="Repair price"/>
                                            <Button Grid.Column="2"
                                                    Content="Add"
                                                    Command="{Binding AddRepairItemCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Height="36"
                                                    Margin="6 0"/>
                                            <Button Grid.Column="3"
                                                    Content="Clear"
                                                    Command="{Binding ClearRepairItemsCommand}"
                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                    Height="36"
                                                    Margin="6 0 0 0"/>
                                        </Grid>

                                        <DataGrid ItemsSource="{Binding RepairItems}"
                                                  Style="{StaticResource WholesaleDataGridStyle}"
                                                  CellStyle="{StaticResource WholesaleDataGridCellStyle}"
                                                  RowStyle="{StaticResource WholesaleDataGridRowStyle}"
                                                  ColumnHeaderStyle="{StaticResource WholesaleDataGridHeaderStyle}"
                                                  AutoGenerateColumns="False"
                                                  CanUserAddRows="False"
                                                  CanUserDeleteRows="False"
                                                  HeadersVisibility="Column"
                                                  MaxHeight="136"
                                                  BorderThickness="1">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Description"
                                                                    Binding="{Binding Description, Mode=OneWay}"
                                                                    ElementStyle="{StaticResource WholesaleGridTextStyle}"
                                                                    Width="*"/>
                                                <DataGridTextColumn Header="Price"
                                                                    Binding="{Binding Price, Mode=OneWay, StringFormat={}{0:N2}}"
                                                                    ElementStyle="{StaticResource WholesaleGridTextStyle}"
                                                                    Width="86"/>
                                                <DataGridTemplateColumn Header="" Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="Remove"
                                                                    Command="{Binding DataContext.RemoveRepairItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"
                                                                    Style="{StaticResource SecondaryButtonStyle}"
                                                                    Padding="6 2"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SectionPanelStyle}">
                                    <StackPanel>
                                        <TextBlock Text="PAYMENT NOTES" Style="{StaticResource SectionHeaderTextStyle}"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="0.8*"/>
                                                <ColumnDefinition Width="1.2*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0 0 8 0">
                                                <TextBlock Text="Payment Method" Style="{StaticResource WholesaleLabelStyle}"/>
                                                <TextBox Text="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}"
                                                         Height="38"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Margin="8 0 0 0">
                                                <TextBlock Text="Notes" Style="{StaticResource WholesaleLabelStyle}"/>
                                                <TextBox Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}"
                                                         MinHeight="68"
                                                         AcceptsReturn="True"
                                                         TextWrapping="Wrap"
                                                         VerticalScrollBarVisibility="Auto"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0 0 0 10">
                        <TextBlock Text="RECENT WHOLESALE SALES"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   Margin="0 0 0 4"/>
                        <TextBlock Text="Posted sales, parts-only flags, payment status, and repair exposure."
                                   Margin="0 3 0 0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <DataGrid Grid.Row="1"
                              ItemsSource="{Binding RecentSales}"
                              Style="{StaticResource WholesaleDataGridStyle}"
                              CellStyle="{StaticResource WholesaleDataGridCellStyle}"
                              RowStyle="{StaticResource WholesaleDataGridRowStyle}"
                              ColumnHeaderStyle="{StaticResource WholesaleDataGridHeaderStyle}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              CanUserDeleteRows="False"
                              HeadersVisibility="Column"
                              IsReadOnly="True"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sale #"
                                                Binding="{Binding SaleNumber, Mode=OneWay}"
                                                ElementStyle="{StaticResource WholesaleGridTextStyle}"
                                                Width="118"/>
                            <DataGridTextColumn Header="Car"
                                                Binding="{Binding UsedCar, Mode=OneWay}"
                                                ElementStyle="{StaticResource WholesaleGridTextStyle}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Buyer"
                                                Binding="{Binding BuyerName, Mode=OneWay}"
                                                ElementStyle="{StaticResource WholesaleGridTextStyle}"
                                                Width="130"/>
                            <DataGridTextColumn Header="Date"
                                                Binding="{Binding SaleDate, Mode=OneWay, StringFormat={}{0:dd MMM yyyy}}"
                                                ElementStyle="{StaticResource WholesaleGridTextStyle}"
                                                Width="100"/>
                            <DataGridTextColumn Header="Price"
                                                Binding="{Binding SalePrice, Mode=OneWay, StringFormat={}{0:N2}}"
                                                ElementStyle="{StaticResource WholesaleGridTextStyle}"
                                                Width="88"/>
                            <DataGridTextColumn Header="Paid"
                                                Binding="{Binding PaidAmount, Mode=OneWay, StringFormat={}{0:N2}}"
                                                ElementStyle="{StaticResource WholesaleGridTextStyle}"
                                                Width="84"/>
                            <DataGridCheckBoxColumn Header="Parts"
                                                    Binding="{Binding IsForParts, Mode=OneWay}"
                                                    Width="62"/>
                            <DataGridTextColumn Header="Repairs"
                                                Binding="{Binding RepairTotalAmount, Mode=OneWay, StringFormat={}{0:N2}}"
                                                ElementStyle="{StaticResource WholesaleGridTextStyle}"
                                                Width="82"/>
                            <DataGridTextColumn Header="Status"
                                                Binding="{Binding PaymentStatus, Mode=OneWay}"
                                                ElementStyle="{StaticResource WholesaleGridTextStyle}"
                                                Width="104"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
