<UserControl x:Class="SpareParts.Desktop.Wpf.RepairPrepBoardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="1280">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PrepCarListBoxItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Root"
                                Padding="10"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Margin="0 0 0 14"
                Padding="14"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding Status}"
                               Foreground="{Binding StatusBrush}"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Track bought cars through inspection, parts, repair, photos, listing, and sale."
                               Margin="0 4 0 0"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center">
                    <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}"
                             Width="260"
                             Height="36"
                             Padding="10 0"
                             VerticalContentAlignment="Center"
                             Margin="0 0 12 0"/>
                    <Button Content="Refresh"
                            Command="{Binding RefreshCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="110"
                            Height="36"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <ItemsControl Grid.Row="1"
                      ItemsSource="{Binding MetricTiles}"
                      Margin="0 0 0 14">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Rows="1"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Margin="0 0 10 0"
                            Padding="14"
                            Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{Binding AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="{Binding Label}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"/>
                            <TextBlock Text="{Binding Value}"
                                       Margin="0 4 0 0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       Foreground="{Binding AccentBrush}"/>
                            <TextBlock Text="{Binding Detail}"
                                       Margin="0 4 0 0"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ProgressBar Grid.Row="0"
                         Height="8"
                         IsIndeterminate="True"
                         Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}"
                         Foreground="{DynamicResource AccentBrush}"
                         Background="#22000000"
                         Margin="0 0 0 12"/>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Padding="12"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Columns}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="250"
                                            Margin="0 0 12 0"
                                            Padding="10"
                                            Background="{DynamicResource AppBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="*"/>
                                            </Grid.RowDefinitions>

                                            <DockPanel Grid.Row="0" Margin="0 0 0 10">
                                                <TextBlock DockPanel.Dock="Left"
                                                           Text="{Binding Label}"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <Border DockPanel.Dock="Right"
                                                        Background="{DynamicResource CardHighlightBrush}"
                                                        CornerRadius="10"
                                                        Padding="8 2">
                                                    <TextBlock Text="{Binding Count}"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </Border>
                                            </DockPanel>

                                            <ListBox Grid.Row="1"
                                                     ItemsSource="{Binding Cars}"
                                                     SelectedItem="{Binding DataContext.SelectedCar, RelativeSource={RelativeSource AncestorType=UserControl}, Mode=TwoWay}"
                                                     ItemContainerStyle="{StaticResource PrepCarListBoxItemStyle}"
                                                     BorderThickness="0"
                                                     Background="Transparent"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       TextWrapping="Wrap"/>
                                                            <TextBlock Text="{Binding Subtitle}"
                                                                       Margin="0 4 0 0"
                                                                       FontSize="12"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                                         Maximum="100"
                                                                         Height="6"
                                                                         Margin="0 10 0 6"
                                                                         Foreground="{DynamicResource AccentBrush}"
                                                                         Background="#22000000"/>
                                                            <DockPanel>
                                                                <TextBlock DockPanel.Dock="Left"
                                                                           Text="{Binding LinkedPartsLabel}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                <TextBlock DockPanel.Dock="Right"
                                                                           Text="{Binding CostLabel}"
                                                                           FontSize="12"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                            </DockPanel>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Border>

                <Border Grid.Column="2"
                        Padding="16"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock Text="Selected Car"
                                       FontSize="18"
                                       FontWeight="Bold"/>
                            <TextBlock Text="{Binding SelectedCarTitle}"
                                       Margin="0 10 0 0"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SelectedCarSubtitle}"
                                       Margin="0 4 0 12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextWrapping="Wrap"/>

                            <ItemsControl ItemsSource="{Binding Columns}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}"
                                                Command="{Binding DataContext.MoveSelectedToStatusCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Key}"
                                                Margin="0 0 8 8"
                                                Padding="10 6"
                                                Style="{StaticResource SecondaryButtonStyle}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="{Binding SelectedProgressLabel}"
                                       Margin="0 8 0 2"
                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding SelectedPrepCostLabel}"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0 0 0 12"/>

                            <TextBlock Text="Tasks"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0 8 0 8"/>
                            <ItemsControl ItemsSource="{Binding SelectedTasks}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0 0 0 8"
                                                Padding="10"
                                                Background="{DynamicResource AppBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <DockPanel>
                                                <CheckBox DockPanel.Dock="Left"
                                                          IsChecked="{Binding IsDone, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          VerticalAlignment="Center"
                                                          Margin="0 0 10 0"/>
                                                <Button DockPanel.Dock="Right"
                                                        Content="x"
                                                        Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Width="34"
                                                        Height="30"
                                                        Margin="10 0 0 0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding CostLabel, StringFormat=Cost {0}}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Grid Margin="0 6 0 12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="90"/>
                                    <ColumnDefinition Width="86"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0"
                                         Text="{Binding NewTaskTitle, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36"
                                         Padding="10 0"
                                         VerticalContentAlignment="Center"
                                         Margin="0 0 8 0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding NewTaskCost, UpdateSourceTrigger=PropertyChanged}"
                                         Height="36"
                                         Padding="10 0"
                                         VerticalContentAlignment="Center"
                                         Margin="0 0 8 0"/>
                                <Button Grid.Column="2"
                                        Content="Add"
                                        Command="{Binding AddTaskCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Height="36"/>
                            </Grid>

                            <TextBlock Text="Linked Parts"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Margin="0 8 0 8"/>
                            <ItemsControl ItemsSource="{Binding SelectedLinkedParts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Margin="0 0 0 8"
                                                Padding="10"
                                                Background="{DynamicResource AppBackgroundBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right"
                                                           Text="{Binding Value}"
                                                           Foreground="{DynamicResource AccentBrush}"
                                                           FontWeight="SemiBold"
                                                           Margin="12 0 0 0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
