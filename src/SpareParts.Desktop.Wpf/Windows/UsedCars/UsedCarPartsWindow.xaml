<Window x:Class="SpareParts.Desktop.Wpf.UsedCarPartsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Used Car Parts"
        Width="1380"
        Height="820"
        MinWidth="1100"
        MinHeight="660"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <Style x:Key="PartsGridStyle" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="SelectionUnit" Value="FullRow"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="ColumnHeaderHeight" Value="38"/>
            <Setter Property="RowHeight" Value="86"/>
        </Style>

        <Style x:Key="HeaderActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="132"/>
            <Setter Property="Padding" Value="16 0"/>
            <Setter Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ButtonBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="Black"
                                                          BlurRadius="12"
                                                          ShadowDepth="2"
                                                          Opacity="0.18"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder" Property="Opacity" Value="0.9"/>
                                <Setter TargetName="ButtonBorder" Property="Effect" Value="{x:Null}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TransferButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="54"/>
            <Setter Property="Padding" Value="18 0"/>
            <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="TransferBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="16">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TransferBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="TransferBorder" Property="Opacity" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.55"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PartCodeCellTemplate">
            <Border Background="{DynamicResource CardHighlightBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10 5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding InternalCode}"
                           FontSize="11"
                           FontWeight="SemiBold"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PartInfoCellTemplate">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Name}"
                           FontSize="13"
                           FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis"/>
                <WrapPanel Margin="0 4 0 0">
                    <TextBlock Text="{Binding OEMNumber, TargetNullValue=No OEM number}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0 0 10 0"/>
                    <Border Background="{DynamicResource CardHighlightBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9"
                            Padding="8 3">
                        <TextBlock Text="{Binding Condition}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PartPricingCellTemplate">
            <Grid VerticalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock Text="Cost"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding CostPrice, StringFormat={}{0:N2}}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Right"/>
                </DockPanel>

                <DockPanel Grid.Row="1" LastChildFill="False" Margin="0 4 0 0">
                    <TextBlock Text="Min"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding MinimumSellPrice, StringFormat={}{0:N2}}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Right"/>
                </DockPanel>

                <DockPanel Grid.Row="2" LastChildFill="False" Margin="0 4 0 0">
                    <TextBlock Text="Sale"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding SalePrice, StringFormat={}{0:N2}}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Right"/>
                </DockPanel>

                <DockPanel Grid.Row="3" LastChildFill="False" Margin="0 4 0 0">
                    <TextBlock Text="Target"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               DockPanel.Dock="Left"/>
                    <TextBlock Text="{Binding RecommendedPrice, StringFormat={}{0:N2}}"
                               FontSize="12"
                               FontWeight="SemiBold"
                               DockPanel.Dock="Right"/>
                </DockPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="PartCurrencyCellTemplate">
            <Border Background="{DynamicResource CardHighlightBrush}"
                    BorderBrush="{DynamicResource AccentBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="10 5"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center">
                <TextBlock Text="{Binding Currency}"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}"/>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="PartRecommendationTemplate">
            <Border Background="{DynamicResource CardHighlightBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="14"
                    Margin="0 0 12 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9"
                                Padding="8 3"
                                DockPanel.Dock="Left">
                            <TextBlock Text="{Binding SourceLabel}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                        <Button Content="Select"
                                Click="SelectRecommendation_Click"
                                Style="{StaticResource HeaderActionButtonStyle}"
                                Height="30"
                                MinWidth="70"
                                Padding="10 0"
                                FontSize="11"
                                DockPanel.Dock="Right"/>
                    </DockPanel>

                    <TextBlock Grid.Row="1"
                               Text="{Binding Name}"
                               FontSize="14"
                               FontWeight="Bold"
                               TextTrimming="CharacterEllipsis"
                               Margin="0 10 0 0"/>
                    <TextBlock Grid.Row="2"
                               Text="{Binding Code}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0 3 0 10"/>

                    <UniformGrid Grid.Row="3" Columns="3">
                        <StackPanel Margin="0 0 10 0">
                            <TextBlock Text="Target" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding RecommendedLabel}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel Margin="0 0 10 0">
                            <TextBlock Text="Margin" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding MarginLabel}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="Stock" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="{Binding QuantityLabel}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </UniformGrid>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}"
                Padding="22"
                Margin="0 0 0 16">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="{Binding WindowTitle}" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="{Binding WindowSubtitle}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Margin="0 6 0 0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="ImportExcel_Click"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            BorderBrush="{DynamicResource AccentBrush}"
                            Margin="0 0 10 0"
                            IsEnabled="{Binding CanImportParts}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24"
                                    Height="24"
                                    Background="#22FFFFFF"
                                    CornerRadius="12"
                                    Margin="0 0 10 0">
                                <TextBlock Text="↓"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Import Excel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="Refresh_Click"
                            Style="{StaticResource HeaderActionButtonStyle}"
                            Margin="0 0 10 0">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24"
                                    Height="24"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Margin="0 0 10 0">
                                <TextBlock Text="↻"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Refresh" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="Close_Click"
                            Style="{StaticResource HeaderActionButtonStyle}">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="24"
                                    Height="24"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Margin="0 0 10 0">
                                <TextBlock Text="×"
                                           FontSize="14"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="Close" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Style="{StaticResource SectionPanelStyle}"
                Margin="0 0 0 16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="360"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Background="{DynamicResource CardHighlightBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="12 6"
                        Margin="0 0 12 0"
                        VerticalAlignment="Center">
                    <TextBlock Text="FILTER"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"/>
                </Border>

                <TextBox Grid.Column="1"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         VerticalAlignment="Center"
                         Margin="0 0 16 0"/>

                <TextBlock Grid.Column="2"
                           Text="{Binding SearchSummary}"
                           VerticalAlignment="Center"
                           FontSize="12"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextAlignment="Right"/>
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource SectionPanelStyle}"
                Margin="0 0 0 16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 14">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="BEST NEXT PARTS"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   Margin="0"/>
                        <TextBlock Text="Teardown Profit Map"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Margin="0 5 0 0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding RecommendationSummary}"
                               DockPanel.Dock="Right"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center"
                               TextAlignment="Right"/>
                </DockPanel>

                <Grid Grid.Row="1">
                    <TextBlock Text="No stocked linked parts or candidates match the current search."
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasRecommendedParts}" Value="False">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <ItemsControl ItemsSource="{Binding RecommendedParts}"
                                  ItemTemplate="{StaticResource PartRecommendationTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Grid>
        </Border>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.35*"/>
                <ColumnDefinition Width="196"/>
                <ColumnDefinition Width="2.35*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Style="{StaticResource CardStyle}"
                    Margin="0 0 16 0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0 0 0 14">
                        <TextBlock Text="UNASSIGNED INVENTORY"
                                   Style="{StaticResource SectionHeaderTextStyle}"
                                   Margin="0"/>
                        <TextBlock Text="Available Parts" FontSize="18" FontWeight="Bold" Margin="0 5 0 0"/>
                        <TextBlock Text="{Binding AvailableSummary}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0 6 0 0"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#0AFFFFFF"
                            CornerRadius="16"
                            Padding="6">
                        <Grid>
                            <TextBlock Text="No unassigned parts match the current search."
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAvailableParts}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DataGrid ItemsSource="{Binding AvailableParts}"
                                      SelectedItem="{Binding SelectedAvailablePart, Mode=TwoWay}"
                                      Style="{StaticResource PartsGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Code" Width="132" CellTemplate="{StaticResource PartCodeCellTemplate}"/>
                                    <DataGridTemplateColumn Header="Part" Width="*" CellTemplate="{StaticResource PartInfoCellTemplate}"/>
                                    <DataGridTemplateColumn Header="Pricing" Width="180" CellTemplate="{StaticResource PartPricingCellTemplate}"/>
                                    <DataGridTemplateColumn Header="Currency" Width="104" CellTemplate="{StaticResource PartCurrencyCellTemplate}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Background="{DynamicResource CardHighlightBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="18"
                    Margin="0 0 16 0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="FLOW"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"/>
                    <TextBlock Text="Move Parts"
                               FontSize="18"
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               Margin="0 6 0 0"/>
                    <TextBlock Text="Pick one row, then move it to the other side."
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Margin="0 8 0 20"/>

                    <Button Click="AssignSelected_Click"
                            Style="{StaticResource TransferButtonStyle}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            BorderBrush="{DynamicResource AccentBrush}"
                            Margin="0 0 0 12"
                            IsEnabled="{Binding CanAssignPart}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="Assign"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="  →"
                                       FontSize="15"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Button Click="RemoveSelected_Click"
                            Style="{StaticResource TransferButtonStyle}"
                            Margin="0 0 0 18"
                            IsEnabled="{Binding CanRemovePart}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="←  "
                                       FontSize="15"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="Remove"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Background="{DynamicResource CardBackgroundBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="16"
                            Padding="14">
                        <StackPanel>
                            <TextBlock Text="Current Selection"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SelectedPartSummary}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0 10 0 0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="18"
                    Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0 0 0 14">
                        <TextBlock Text="LINKED TO CAR"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"/>
                        <TextBlock Text="Assigned To This Used Car" FontSize="18" FontWeight="Bold" Margin="0 5 0 0"/>
                        <TextBlock Text="{Binding AssignedSummary}"
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0 6 0 0"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Background="#0AFFFFFF"
                            CornerRadius="16"
                            Padding="6">
                        <Grid>
                            <TextBlock Text="No parts are currently linked to this used car."
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasAssignedParts}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <DataGrid ItemsSource="{Binding AssignedParts}"
                                      SelectedItem="{Binding SelectedAssignedPart, Mode=TwoWay}"
                                      Style="{StaticResource PartsGridStyle}">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Code" Width="132" CellTemplate="{StaticResource PartCodeCellTemplate}"/>
                                    <DataGridTemplateColumn Header="Part" Width="*" CellTemplate="{StaticResource PartInfoCellTemplate}"/>
                                    <DataGridTemplateColumn Header="Pricing" Width="180" CellTemplate="{StaticResource PartPricingCellTemplate}"/>
                                    <DataGridTemplateColumn Header="Currency" Width="104" CellTemplate="{StaticResource PartCurrencyCellTemplate}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Row="4"
                Background="{DynamicResource CardBackgroundBrush}"
                CornerRadius="14"
                Padding="16"
                Margin="0 16 0 0">
            <TextBlock Text="{Binding FooterStatus}" FontSize="12" Foreground="{DynamicResource AccentBrush}"/>
        </Border>
    </Grid>
</Window>
