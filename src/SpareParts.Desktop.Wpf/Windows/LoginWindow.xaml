<Window x:Class="SpareParts.Desktop.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maalouf Auto Parts — Login"
        Width="1020" Height="640"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/SpareParts.Desktop.Wpf;component/Themes/ApexTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- Login field style — dark themed rounded inputs -->
            <Style x:Key="LoginFieldStyle" TargetType="TextBox">
                <Setter Property="Background"               Value="#0E0E0E"/>
                <Setter Property="Foreground"               Value="#FFEEF1F5"/>
                <Setter Property="BorderBrush"              Value="#1AC23A32"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="Padding"                  Value="14 0"/>
                <Setter Property="FontSize"                 Value="14"/>
                <Setter Property="FontFamily"               Value="Segoe UI"/>
                <Setter Property="CaretBrush"               Value="#FFC23A32"/>
                <Setter Property="SelectionBrush"           Value="#33C23A32"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    MinHeight="48">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"
                                              Foreground="#FFEEF1F5"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FFC23A32"/>
                                    <Setter TargetName="Bd" Property="Background"  Value="#161616"/>
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#FFC23A32" BlurRadius="10"
                                                              ShadowDepth="0" Opacity="0.25"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#44C23A32"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Login password style -->
            <Style x:Key="LoginPasswordStyle" TargetType="PasswordBox">
                <Setter Property="Background"               Value="#0E0E0E"/>
                <Setter Property="Foreground"               Value="#FFEEF1F5"/>
                <Setter Property="BorderBrush"              Value="#1AC23A32"/>
                <Setter Property="BorderThickness"          Value="1"/>
                <Setter Property="Padding"                  Value="14 0"/>
                <Setter Property="FontSize"                 Value="18"/>
                <Setter Property="FontFamily"               Value="Segoe UI"/>
                <Setter Property="PasswordChar"             Value="●"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="2"
                                    MinHeight="48">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FFC23A32"/>
                                    <Setter TargetName="Bd" Property="Background"  Value="#161616"/>
                                    <Setter TargetName="Bd" Property="Effect">
                                        <Setter.Value>
                                            <DropShadowEffect Color="#FFC23A32" BlurRadius="10"
                                                              ShadowDepth="0" Opacity="0.25"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#44C23A32"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer shell with drop shadow -->
    <Border CornerRadius="3" Background="#FF11161C">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="60" ShadowDepth="12" Opacity="0.7"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══ LEFT — Branding Panel ══ -->
            <Border Grid.Column="0" CornerRadius="20 0 0 20" ClipToBounds="True">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF0E0E0E" Offset="0"/>
                        <GradientStop Color="#FF161616" Offset="0.5"/>
                        <GradientStop Color="#FF050505" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Decorative aurora glow orbs -->
                    <Ellipse Width="420" Height="420"
                             HorizontalAlignment="Left" VerticalAlignment="Top"
                             Margin="-140,-140,0,0" Opacity="0.12">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFC23A32" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="300" Height="300"
                             HorizontalAlignment="Right" VerticalAlignment="Bottom"
                             Margin="0,0,-100,-100" Opacity="0.08">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FF2F9461" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <Ellipse Width="160" Height="160"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Margin="0,60,0,0" Opacity="0.06">
                        <Ellipse.Fill>
                            <RadialGradientBrush>
                                <GradientStop Color="#FFC23A32" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </RadialGradientBrush>
                        </Ellipse.Fill>
                    </Ellipse>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="44">

                        <!-- Logo ring -->
                        <Grid HorizontalAlignment="Center" Margin="0 0 0 32">
                            <Ellipse Width="108" Height="108">
                                <Ellipse.Stroke>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#FFC23A32" Offset="0"/>
                                        <GradientStop Color="#FF2F9461" Offset="1"/>
                                    </LinearGradientBrush>
                                </Ellipse.Stroke>
                                <Ellipse.StrokeThickness>1.5</Ellipse.StrokeThickness>
                                <Ellipse.Effect>
                                    <DropShadowEffect Color="#FFC23A32" BlurRadius="18" ShadowDepth="0" Opacity="0.5"/>
                                </Ellipse.Effect>
                            </Ellipse>
                            <Ellipse Width="94" Height="94">
                                <Ellipse.Fill>
                                    <RadialGradientBrush>
                                        <GradientStop Color="#14C23A32" Offset="0"/>
                                        <GradientStop Color="#08C23A32" Offset="1"/>
                                    </RadialGradientBrush>
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="M" FontSize="44" FontWeight="Bold"
                                       Foreground="#FFC23A32"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FFC23A32" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Grid>

                        <TextBlock Text="MAALOUF"
                                   FontSize="28" FontWeight="Bold"
                                   Foreground="#FFEEF1F5" HorizontalAlignment="Center"
                                   FontFamily="Bahnschrift SemiBold"/>
                        <TextBlock Text="AUTO PARTS"
                                   FontSize="12" FontWeight="Light"
                                   HorizontalAlignment="Center"
                                   Margin="0 3 0 0" FontFamily="Bahnschrift">
                            <TextBlock.Foreground>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#FFC23A32" Offset="0"/>
                                    <GradientStop Color="#FF2F9461" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                        </TextBlock>

                        <!-- Divider line gradient -->
                        <Border Height="1" Width="160" Margin="0 28 0 28" HorizontalAlignment="Center">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="Transparent" Offset="0"/>
                                    <GradientStop Color="#44C23A32" Offset="0.5"/>
                                    <GradientStop Color="Transparent" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>

                        <!-- Platform badges -->
                        <TextBlock Text="CONNECTED PLATFORMS"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="#FF8B96A3"
                                   HorizontalAlignment="Center"
                                   Margin="0 0 0 12" FontFamily="Segoe UI"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Border CornerRadius="2" Padding="10 6" Margin="4 0"
                                    BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#12C23A32" Offset="0"/>
                                        <GradientStop Color="#0A8A2923" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#1AC23A32"/>
                                </Border.BorderBrush>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🖥" FontSize="12" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="Desktop" FontSize="10" Foreground="#FFC23A32"
                                               VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="2" Padding="10 6" Margin="4 0"
                                    BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#128A2923" Offset="0"/>
                                        <GradientStop Color="#0A8A2923" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#12C23A32"/>
                                </Border.BorderBrush>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🌐" FontSize="12" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="Web" FontSize="10" Foreground="#FF8B96A3"
                                               VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Border>
                            <Border CornerRadius="2" Padding="10 6" Margin="4 0"
                                    BorderThickness="1">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                        <GradientStop Color="#128A2923" Offset="0"/>
                                        <GradientStop Color="#0A8A2923" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>
                                <Border.BorderBrush>
                                    <SolidColorBrush Color="#12C23A32"/>
                                </Border.BorderBrush>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📱" FontSize="12" VerticalAlignment="Center" Margin="0 0 5 0"/>
                                    <TextBlock Text="Mobile" FontSize="10" Foreground="#FF8B96A3"
                                               VerticalAlignment="Center" FontFamily="Segoe UI"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <TextBlock Text="v5.0  ·  Apex Design System"
                                   FontSize="10" Foreground="#FF5D6773"
                                   HorizontalAlignment="Center"
                                   Margin="0 22 0 0" FontFamily="Segoe UI"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ══ RIGHT — Login Form ══ -->
            <Border Grid.Column="1" CornerRadius="0 20 20 0">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF171D25" Offset="0"/>
                        <GradientStop Color="#FF0E0E0E" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>

                <Grid>
                    <!-- Close button -->
                    <Button Content="✕"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0 16 16 0" Width="30" Height="30"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#FF5D6773" FontSize="13"
                            Cursor="Hand" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="2"
                                                    Background="{TemplateBinding Background}" Padding="2">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#22FF6B6B"/>
                                                    <Setter Property="Foreground"                  Value="#FFFF6B6B"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Drag area -->
                    <Border Height="48" VerticalAlignment="Top" Background="Transparent"
                            MouseLeftButtonDown="DragBar_MouseDown"/>

                    <!-- Form content -->
                    <StackPanel VerticalAlignment="Center" Margin="56 0 56 0">

                        <!-- Welcome header -->
                        <TextBlock Text="Welcome back"
                                   FontSize="26" FontWeight="SemiBold"
                                   Foreground="#FFEEF1F5" Margin="0 0 0 4"
                                   FontFamily="Bahnschrift SemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0 0 0 36">
                            <TextBlock Text="Sign in to " FontSize="13" Foreground="#FF8B96A3" FontFamily="Segoe UI"/>
                            <TextBlock Text="Maalouf Auto Parts" FontSize="13" Foreground="#FFC23A32" FontFamily="Segoe UI"/>
                        </StackPanel>

                        <!-- Username field -->
                        <Grid Margin="0 0 0 16">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 8">
                                <Border Width="16" Height="16" CornerRadius="3"
                                        Background="#14C23A32" Margin="0 0 7 0">
                                    <TextBlock Text="U" FontSize="8" FontWeight="Bold"
                                               Foreground="#FFC23A32"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="USERNAME" FontSize="10" FontWeight="Bold"
                                           Foreground="#FF8B96A3" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <TextBox x:Name="UsernameBox" Grid.Row="1"
                                     Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource LoginFieldStyle}"
                                     Height="48" KeyDown="Field_KeyDown"/>
                        </Grid>

                        <!-- Password field -->
                        <Grid Margin="0 0 0 0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 8">
                                <Border Width="16" Height="16" CornerRadius="3"
                                        Background="#14C23A32" Margin="0 0 7 0">
                                    <TextBlock Text="P" FontSize="8" FontWeight="Bold"
                                               Foreground="#FFC23A32"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold"
                                           Foreground="#FF8B96A3" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <PasswordBox x:Name="PasswordBox" Grid.Row="1"
                                         Style="{StaticResource LoginPasswordStyle}"
                                         Height="48" KeyDown="Field_KeyDown"/>
                        </Grid>

                        <!-- Error banner -->
                        <Border Margin="0 16 0 0" CornerRadius="2" Padding="14 10"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <Border.Background>
                                <SolidColorBrush Color="#1AE53935"/>
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="#33E53935"/>
                            </Border.BorderBrush>
                            <Border.BorderThickness>1</Border.BorderThickness>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠  " Foreground="#FFFF6B6B" FontSize="13"/>
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="#FFE57373" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Sign In button -->
                        <Button x:Name="LoginBtn"
                                Height="50" Margin="0 24 0 0"
                                Cursor="Hand" Click="LoginButton_Click"
                                IsEnabled="{Binding IsIdle}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="2">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Color="#FFC23A32" Offset="0"/>
                                                            <GradientStop Color="#FF8A2923" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#FFC23A32" BlurRadius="20"
                                                                          ShadowDepth="0" Opacity="0.4"/>
                                                    </Border.Effect>
                                                    <TextBlock x:Name="Txt" Text="SIGN IN  →"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="#FF11161C"
                                                               FontSize="13" FontWeight="Bold"
                                                               FontFamily="Segoe UI"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Background">
                                                            <Setter.Value>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                                    <GradientStop Color="#FFD6453B" Offset="0"/>
                                                                    <GradientStop Color="#FFC23A32" Offset="1"/>
                                                                </LinearGradientBrush>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Background">
                                                            <Setter.Value>
                                                                <SolidColorBrush Color="#FF8A2923"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                        <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                                        <Setter TargetName="Txt" Property="Text"   Value="SIGNING IN…"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>

                    <!-- API status bar -->
                    <Border VerticalAlignment="Bottom" Padding="22 12" CornerRadius="0 0 20 0">
                        <Border.BorderBrush>
                            <SolidColorBrush Color="#0AC23A32"/>
                        </Border.BorderBrush>
                        <Border.BorderThickness>0 1 0 0</Border.BorderThickness>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StatusDot}" FontSize="9"
                                           Foreground="{Binding StatusBrush}"
                                           VerticalAlignment="Center" Margin="0 0 7 0"/>
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="11" Foreground="#FF5D6773"
                                           VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ServiceStatusText}"
                                       Margin="16 5 0 0"
                                       FontSize="10"
                                       Foreground="#FF5D6773"
                                       TextWrapping="Wrap"
                                       LineHeight="16"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
