<Window x:Class="SpareParts.Desktop.Wpf.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Maalouf Auto Parts — Login"
        Width="1000" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Themes/AuroraTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <Style x:Key="LoginFieldStyle" TargetType="TextBox">
                <Setter Property="Background"               Value="#FF111111"/>
                <Setter Property="Foreground"               Value="#FFEBEBEB"/>
                <Setter Property="BorderBrush"              Value="#FF262626"/>
                <Setter Property="BorderThickness"          Value="0 0 0 2"/>
                <Setter Property="Padding"                  Value="14 0"/>
                <Setter Property="FontSize"                 Value="14"/>
                <Setter Property="FontFamily"               Value="Segoe UI"/>
                <Setter Property="CaretBrush"               Value="{DynamicResource AccentBrush}"/>
                <Setter Property="SelectionBrush"           Value="#55D40000"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Bd"
                                    Background="#FF111111"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3 3 0 0"
                                    MinHeight="46">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Bd" Property="Background"  Value="#FF161616"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#88D40000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="LoginPasswordStyle" TargetType="PasswordBox">
                <Setter Property="Background"               Value="#FF111111"/>
                <Setter Property="Foreground"               Value="#FFEBEBEB"/>
                <Setter Property="BorderBrush"              Value="#FF262626"/>
                <Setter Property="BorderThickness"          Value="0 0 0 2"/>
                <Setter Property="Padding"                  Value="14 0"/>
                <Setter Property="FontSize"                 Value="18"/>
                <Setter Property="FontFamily"               Value="Segoe UI"/>
                <Setter Property="PasswordChar"             Value="●"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="PasswordBox">
                            <Border x:Name="Bd"
                                    Background="#FF111111"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="3 3 0 0"
                                    MinHeight="46">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter TargetName="Bd" Property="Background"  Value="#FF161616"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#88D40000"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <!-- Outer shell with red rim + drop shadow -->
    <Border CornerRadius="6" Background="#FF080808"
            BorderBrush="#FF1E1E1E" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="48" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="440"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ══════════ LEFT — CARBON HERO ══════════ -->
            <Border Grid.Column="0" CornerRadius="6 0 0 6" ClipToBounds="True"
                    Background="{DynamicResource CarbonFiberBrush}">
                <Grid>
                    <!-- Big diagonal red speed wedge -->
                    <Path Stretch="Fill" Opacity="0.10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Data="M 0,0 L 1,0 L 1,0.42 L 0,1 Z">
                        <Path.Fill>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#FFD40000" Offset="0"/>
                                <GradientStop Color="Transparent" Offset="1"/>
                            </LinearGradientBrush>
                        </Path.Fill>
                    </Path>

                    <!-- Thin diagonal speed lines -->
                    <Canvas ClipToBounds="True">
                        <Line X1="-40" Y1="640" X2="320" Y2="-40" Stroke="#22D40000" StrokeThickness="2"/>
                        <Line X1="20"  Y1="640" X2="380" Y2="-40" Stroke="#18D40000" StrokeThickness="2"/>
                        <Line X1="80"  Y1="640" X2="440" Y2="-40" Stroke="#10D40000" StrokeThickness="2"/>
                    </Canvas>

                    <!-- Top full-bleed red stripe -->
                    <Border Height="4" VerticalAlignment="Top"
                            Background="{DynamicResource RacingStripeBrush}"/>

                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="44">

                        <!-- Monogram plate -->
                        <Border Width="104" Height="104" CornerRadius="6"
                                Margin="0 0 0 30" HorizontalAlignment="Center"
                                BorderThickness="1.5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FF161616" Offset="0"/>
                                    <GradientStop Color="#FF0A0A0A" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <Border.BorderBrush>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FFD40000" Offset="0"/>
                                    <GradientStop Color="#FF3A0000" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.BorderBrush>
                            <Border.Effect>
                                <DropShadowEffect Color="#FFD40000" BlurRadius="28"
                                                  ShadowDepth="0" Opacity="0.45"/>
                            </Border.Effect>
                            <TextBlock Text="M" FontSize="52" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Segoe UI">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#FFD40000" BlurRadius="12" ShadowDepth="0" Opacity="0.7"/>
                                </TextBlock.Effect>
                            </TextBlock>
                        </Border>

                        <TextBlock Text="MAALOUF"
                                   FontSize="34" FontWeight="Bold"
                                   Foreground="#FFEBEBEB" HorizontalAlignment="Center"
                                   FontFamily="Segoe UI"/>
                        <TextBlock Text="A U T O   P A R T S"
                                   FontSize="12" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   HorizontalAlignment="Center"
                                   Margin="0 4 0 0" FontFamily="Segoe UI"/>

                        <!-- Red divider -->
                        <Border Height="2" Width="160" Margin="0 26 0 24"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource RacingStripeBrush}"/>

                        <TextBlock Text="PARTS MANAGEMENT SYSTEM"
                                   FontSize="11" Foreground="#FF707070"
                                   HorizontalAlignment="Center" FontFamily="Segoe UI"
                                   TextAlignment="Center"/>
                        <TextBlock Text="v3.0  ·  API-CONNECTED"
                                   FontSize="9" Foreground="#FF4A4A4A"
                                   HorizontalAlignment="Center"
                                   Margin="0 6 0 0" FontFamily="Segoe UI"/>
                    </StackPanel>

                    <!-- Bottom checkered hint bar -->
                    <Border Height="3" VerticalAlignment="Bottom"
                            Background="{DynamicResource RacingStripeBrush}"/>
                </Grid>
            </Border>

            <!-- ══════════ RIGHT — LOGIN FORM ══════════ -->
            <Border Grid.Column="1" CornerRadius="0 6 6 0" Background="#FF0C0C0C">
                <Grid>
                    <!-- Close button -->
                    <Button Content="✕"
                            HorizontalAlignment="Right" VerticalAlignment="Top"
                            Margin="0 16 16 0" Width="30" Height="30"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#FF555555" FontSize="13"
                            Cursor="Hand" Click="CloseButton_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" CornerRadius="3"
                                                    Background="{TemplateBinding Background}" Padding="2">
                                                <ContentPresenter HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#22D40000"/>
                                                    <Setter Property="Foreground"                  Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </Button.Style>
                    </Button>

                    <!-- Drag bar -->
                    <Border Height="46" VerticalAlignment="Top" Background="Transparent"
                            MouseLeftButtonDown="DragBar_MouseDown"/>

                    <!-- Form -->
                    <StackPanel VerticalAlignment="Center" Margin="56 0 56 0">

                        <TextBlock Text="WELCOME BACK"
                                   FontSize="10" FontWeight="Bold"
                                   Foreground="{DynamicResource AccentBrush}"
                                   Margin="0 0 0 6" FontFamily="Segoe UI"/>
                        <TextBlock Text="Driver Sign-In"
                                   FontSize="26" FontWeight="Bold"
                                   Foreground="#FFEBEBEB" Margin="0 0 0 2" FontFamily="Segoe UI"/>
                        <TextBlock Text="Enter your credentials to enter the pit."
                                   FontSize="13" Foreground="#FF707070"
                                   Margin="0 0 0 34" FontFamily="Segoe UI"/>

                        <!-- Username -->
                        <TextBlock Text="USERNAME" FontSize="10" FontWeight="Bold"
                                   Foreground="#FF808080" Margin="0 0 0 7" FontFamily="Segoe UI"/>
                        <TextBox x:Name="UsernameBox"
                                 Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource LoginFieldStyle}"
                                 Height="46" KeyDown="Field_KeyDown"/>

                        <!-- Password -->
                        <TextBlock Text="PASSWORD" FontSize="10" FontWeight="Bold"
                                   Foreground="#FF808080" Margin="0 20 0 7" FontFamily="Segoe UI"/>
                        <PasswordBox x:Name="PasswordBox"
                                     Style="{StaticResource LoginPasswordStyle}"
                                     Height="46" KeyDown="Field_KeyDown"/>

                        <!-- Error banner -->
                        <Border Margin="0 14 0 0" Background="#1AD40000" CornerRadius="3"
                                BorderBrush="#44D40000" BorderThickness="1"
                                Padding="12 8"
                                Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="⚠  " Foreground="{DynamicResource AccentBrush}" FontSize="13"/>
                                <TextBlock Text="{Binding ErrorMessage}"
                                           Foreground="#FFE57373" FontSize="13" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Sign In button -->
                        <Button x:Name="LoginBtn"
                                Height="48" Margin="0 24 0 0"
                                FontSize="13" FontWeight="Bold"
                                Cursor="Hand" Click="LoginButton_Click"
                                IsEnabled="{Binding IsIdle}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="Bd" CornerRadius="3">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                            <GradientStop Color="#FFE01010" Offset="0"/>
                                                            <GradientStop Color="#FF9C0000" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                    <Border.Effect>
                                                        <DropShadowEffect Color="#FFD40000" BlurRadius="18"
                                                                          ShadowDepth="0" Opacity="0.45"/>
                                                    </Border.Effect>
                                                    <TextBlock x:Name="Txt" Text="SIGN IN  →"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               Foreground="#FF080C14"
                                                               FontSize="13" FontWeight="Bold"
                                                               FontFamily="Segoe UI"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="Effect">
                                                            <Setter.Value>
                                                                <DropShadowEffect Color="#FFFF2020" BlurRadius="26"
                                                                                  ShadowDepth="0" Opacity="0.7"/>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="Bd" Property="Effect" Value="{x:Null}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                                                        <Setter TargetName="Txt" Property="Text"   Value="SIGNING IN…"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                        </Button>

                    </StackPanel>

                    <!-- API status bar -->
                    <Border VerticalAlignment="Bottom" Padding="22 12"
                            CornerRadius="0 0 6 0"
                            Background="#FF0A0A0A"
                            BorderBrush="#FF1A1A1A" BorderThickness="0 1 0 0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding StatusDot}" FontSize="9"
                                           Foreground="{Binding StatusBrush}"
                                           VerticalAlignment="Center" Margin="0 0 7 0"/>
                                <TextBlock Text="{Binding StatusText}"
                                           FontSize="11" Foreground="#FF707070"
                                           VerticalAlignment="Center" FontFamily="Segoe UI"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ServiceStatusText}"
                                       Margin="16 5 0 0"
                                       FontSize="10"
                                       Foreground="#FF5A5A5A"
                                       TextWrapping="Wrap"
                                       LineHeight="16"
                                       FontFamily="Consolas"/>
                        </StackPanel>
                    </Border>

                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
