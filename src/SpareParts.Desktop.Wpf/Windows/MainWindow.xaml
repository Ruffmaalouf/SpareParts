<Window x:Class="SpareParts.Desktop.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SpareParts.Desktop.Wpf"
        xmlns:controls="clr-namespace:SpareParts.Desktop.Wpf;assembly=SpareParts.Desktop.Controls"
        xmlns:vm="clr-namespace:SpareParts.Desktop.Wpf.ViewModels"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        x:Name="RootWindow"
        Title="Maalouf Auto Parts"
        Width="1300" Height="850"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Background="{DynamicResource AppBackgroundBrush}">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/ManagementTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <local:ScreenToVisibilityConverter x:Key="ScreenToVisibilityConverter"/>
            <BooleanToVisibilityConverter      x:Key="BoolToVis"/>

        <Style x:Key="InvoiceIconButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontFamily" Value="Segoe UI Symbol"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconButtonRoot"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="0"
                                CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="IconButtonRoot" Property="Background" Value="#22FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="IconButtonRoot" Property="Background" Value="#33FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        
        <!-- ══════ Invoice Tab Item ══════ -->
        <Style x:Key="InvoiceTabItemStyle" TargetType="TabItem">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="Foreground"      Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Margin"          Value="0 0 4 0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="Transparent" BorderThickness="1"
                                CornerRadius="6 6 0 0" Padding="14 7">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabBorder" Property="Background"  Value="{DynamicResource CardHighlightBrush}"/>
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ══════ Invoice TabControl ══════ -->
        <Style x:Key="InvoiceTabControlStyle" TargetType="TabControl">
            <Setter Property="Background"      Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding"         Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Background="{DynamicResource AppBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="0 0 0 1" Padding="8 6 8 0">
                                <DockPanel>
                                    <TabPanel x:Name="HeaderPanel" DockPanel.Dock="Left"
                                              IsItemsHost="True" VerticalAlignment="Bottom"/>
                                    <Button DockPanel.Dock="Left" Content="＋  New Invoice"
                                            Command="{Binding CreateInvoiceCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Visibility="{Binding CanCreateInvoice, Converter={StaticResource BoolToVis}}"
                                            Height="30" Padding="12 4"
                                            Margin="8 0 0 4" VerticalAlignment="Bottom"/>
                                </DockPanel>
                            </Border>
                            <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}">
                                <ContentPresenter x:Name="PART_SelectedContentHost"
                                                  ContentSource="SelectedContent"/>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickMenuToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="52"/>
            <Setter Property="Padding" Value="14 12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="ToggleRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="14">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ContentPresenter Grid.Column="0"
                                                  VerticalAlignment="Center"/>
                                <Border Grid.Column="1"
                                        Margin="12 0 0 0"
                                        Padding="8 4"
                                        Background="#12FFFFFF"
                                        CornerRadius="9">
                                    <TextBlock x:Name="ChevronIcon"
                                               Text="▾"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ToggleRoot" Property="Background" Value="#0DFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="ToggleRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="ToggleRoot" Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                                <Setter TargetName="ChevronIcon" Property="Text" Value="▴"/>
                                <Setter TargetName="ChevronIcon" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="QuickActionMenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Padding" Value="12 0"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="MenuButtonRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="MenuButtonRoot" Property="Background" Value="#0DFFFFFF"/>
                                <Setter TargetName="MenuButtonRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="MenuButtonRoot" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SectionExpanderStyle" TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Margin" Value="0 0 0 8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border x:Name="OuterBorder"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="4">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <ToggleButton x:Name="HeaderSite"
                                              Grid.Row="0"
                                              Background="Transparent"
                                              BorderThickness="0"
                                              Cursor="Hand"
                                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ToggleButton.Template>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="Transparent" Padding="8 10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ContentPresenter Grid.Column="0"
                                                                      VerticalAlignment="Center"/>
                                                    <Border Grid.Column="1"
                                                            Padding="8 4"
                                                            Background="#12FFFFFF"
                                                            CornerRadius="9"
                                                            Margin="10 0 0 0">
                                                        <TextBlock x:Name="Arrow"
                                                                   Text="▶"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsChecked" Value="True">
                                                    <Setter TargetName="Arrow" Property="Text" Value="▼"/>
                                                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </ToggleButton.Template>
                                    <ContentPresenter ContentSource="Header"/>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite"
                                                  Grid.Row="1"
                                                  Margin="0 8 0 0"
                                                  Visibility="Collapsed"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource CardBackgroundBrush}"/>
                            </Trigger>
                            <Trigger SourceName="HeaderSite" Property="IsMouseOver" Value="True">
                                <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BrandTileStyle" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Width" Value="84"/>
            <Setter Property="Height" Value="78"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Container"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Container" Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
                                <Setter TargetName="Container" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Container" Property="Opacity" Value="0.92"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SidebarToggleButtonStyle" TargetType="Button" BasedOn="{StaticResource InvoiceIconButtonStyle}">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource CardHighlightBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="SidebarToggleRoot"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SidebarToggleRoot" Property="Background" Value="{DynamicResource AppBackgroundBrush}"/>
                                <Setter TargetName="SidebarToggleRoot" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="SidebarToggleRoot" Property="Opacity" Value="0.9"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        </ResourceDictionary>
    </Window.Resources>

    <!-- ══════════════════════════════════════════════════════════════════════
         ROOT GRID — Sidebar | Content
    ════════════════════════════════════════════════════════════════════════ -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ══ SIDEBAR ════════════════════════════════════════════════════ -->
        <Border x:Name="SidebarHost"
                Grid.Column="0"
                Width="280"
                MinWidth="0"
                ClipToBounds="True"
                Background="{DynamicResource CardBackgroundBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0 0 1 0"
                Panel.ZIndex="2">
            <Grid x:Name="SidebarContent" Margin="18 18 18 20">
                <Grid.RenderTransform>
                    <TranslateTransform x:Name="SidebarContentTranslate"/>
                </Grid.RenderTransform>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0"
                        Background="{DynamicResource AppBackgroundBrush}"
                        CornerRadius="18"
                        Padding="16"
                        Margin="0 0 0 16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="Navigation"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <Button DockPanel.Dock="Right"
                                    Click="HideSidebarButton_Click"
                                    Style="{StaticResource SidebarToggleButtonStyle}"
                                    ToolTip="Hide navigation panel">
                                <TextBlock Text="◀"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </Button>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0 14 0 0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="56"
                                    Height="56"
                                    Background="#14FFFFFF"
                                    CornerRadius="14">
                                <Image Source="/Assets/MaaloufLogo.png"
                                       Stretch="Uniform"
                                       Margin="7"/>
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14 0 0 0">
                                <TextBlock FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="Maalouf Auto Parts"/>
                                <TextBlock Text="Browse brands and open tools without clutter."
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0 4 0 0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                            <Grid.InputBindings>
                                <MouseBinding Command="{Binding GoToHomeCommand}" MouseAction="LeftClick"/>
                            </Grid.InputBindings>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Selected brand card -->
                <Border Grid.Row="1"
                        Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="14 12"
                        Margin="0 0 0 16">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedBrand}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="Selected Brand"
                                       FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <StackPanel Orientation="Horizontal"
                                        Margin="0 8 0 0"
                                        VerticalAlignment="Center">
                                <Border Width="38"
                                        Height="38"
                                        Background="#14FFFFFF"
                                        CornerRadius="10"
                                        Margin="0 0 10 0">
                                    <Image Source="{Binding SelectedBrand.Logo}"
                                           Margin="5"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding SelectedBrand.Name}"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="White"/>
                                    <TextBlock Text="{Binding SelectedBrand.Country}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Button DockPanel.Dock="Right"
                                Content="Browse"
                                Click="OpenBrandsPanelButton_Click"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="12 6"
                                Margin="12 0 0 0"
                                VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>

                <!-- Compact brand browser -->
                <Grid Grid.Row="2">
                    <StackPanel VerticalAlignment="Top">
                        <TextBlock Text="Browse Brands"
                                   FontSize="15"
                                   FontWeight="SemiBold"/>
                        <TextBlock Text="Open the drawer when you want to switch manufacturer."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0 4 0 0"/>

                        <ToggleButton x:Name="BrandsToggle"
                                      HorizontalAlignment="Stretch"
                                      Style="{StaticResource QuickMenuToggleStyle}"
                                      Checked="SidebarMenuToggle_Checked"
                                      Margin="0 14 0 0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="🏷"
                                           FontSize="15"
                                           Margin="0 0 10 0"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Brand Browser"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Open drawer"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>

                        <Popup Placement="Right"
                               PlacementTarget="{Binding ElementName=BrandsToggle}"
                               HorizontalOffset="14"
                               VerticalOffset="-8"
                               IsOpen="{Binding IsChecked, ElementName=BrandsToggle}"
                               StaysOpen="False"
                               AllowsTransparency="True"
                               PopupAnimation="Slide">
                            <Border Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="16"
                                    Padding="14"
                                    Width="372"
                                    MaxHeight="640">
                                <StackPanel>
                                    <TextBlock Text="Brand Browser"
                                               FontSize="14"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Pick a region, then choose the manufacturer."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               Margin="0 4 0 12"/>

                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  MaxHeight="560">
                                        <ItemsControl ItemsSource="{Binding BrandGroups}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Expander Style="{StaticResource SectionExpanderStyle}"
                                                              Header="{Binding RegionGroup}"
                                                              IsExpanded="False">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                      HorizontalScrollBarVisibility="Disabled"
                                                                      MaxHeight="228">
                                                            <ItemsControl ItemsSource="{Binding Brands}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <WrapPanel/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Button Style="{StaticResource BrandTileStyle}"
                                                                                Click="BrandMenuItem_Click"
                                                                                Command="{Binding DataContext.SelectBrandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}"
                                                                                ToolTip="{Binding Name}">
                                                                            <StackPanel VerticalAlignment="Center">
                                                                                <Image Source="{Binding Logo}"
                                                                                       Height="34"
                                                                                       Margin="0 0 0 6"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                                <TextBlock Text="{Binding Name}"
                                                                                           FontSize="11"
                                                                                           HorizontalAlignment="Center"
                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </ScrollViewer>
                                                    </Expander>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </StackPanel>
                </Grid>

                <!-- Bottom: compact popups + date -->
                <StackPanel Grid.Row="3" Margin="0 14 0 0" VerticalAlignment="Bottom">
                    <StackPanel Margin="0 0 0 12">
                        <ToggleButton x:Name="QuickActionsToggle"
                                      HorizontalAlignment="Stretch"
                                      Style="{StaticResource QuickMenuToggleStyle}"
                                      Checked="SidebarMenuToggle_Checked">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="☰"
                                           FontSize="15"
                                           Margin="0 0 10 0"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Quick Links"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Hidden list"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>

                        <ToggleButton x:Name="ThemesToggle"
                                      HorizontalAlignment="Stretch"
                                      Style="{StaticResource QuickMenuToggleStyle}"
                                      Checked="SidebarMenuToggle_Checked"
                                      Margin="0 10 0 0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="◌"
                                           FontSize="15"
                                           Margin="0 0 10 0"
                                           VerticalAlignment="Center"/>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Themes"
                                               FontSize="12"
                                               FontWeight="SemiBold"/>
                                    <TextBlock Text="Switch look"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </Grid>
                        </ToggleButton>
                    </StackPanel>

                    <Popup Placement="Top"
                           PlacementTarget="{Binding ElementName=QuickActionsToggle}"
                           IsOpen="{Binding IsChecked, ElementName=QuickActionsToggle}"
