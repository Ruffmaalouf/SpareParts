                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Part Code" Binding="{Binding PartCode, Mode=OneWay}" Width="140"/>
                            <DataGridTextColumn Header="Part Name" Binding="{Binding PartName, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Warehouse" Binding="{Binding Warehouse, Mode=OneWay}" Width="220"/>
                            <DataGridTextColumn Header="On Hand" Binding="{Binding OnHand, Mode=OneWay}" Width="100"/>
                            <DataGridTextColumn Header="Available" Binding="{Binding Available, Mode=OneWay}" Width="100"/>
                            <DataGridTextColumn Header="Min Stock" Binding="{Binding MinStock, Mode=OneWay}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Smart Pricing Coach" Binding="{Binding PricingCoachMessage, Mode=OneWay}" Width="320"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ── Dead Stock Resurrection ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=DeadStockResurrection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Dead Stock Resurrection Mode" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Find stale inventory and choose the recovery action with the best odds."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"
                                Margin="0 0 10 0"/>
                        <Button Content="Open Stock"
                                Command="{Binding GoToStockManagementCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="130"
                                Margin="0 0 10 0"/>
                        <Button Content="Refresh"
                                Command="{Binding DeadStockVm.RefreshCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="120"/>
                    </StackPanel>
                </DockPanel>

                <local:DeadStockResurrectionControl Grid.Row="1"
                                                     DataContext="{Binding DeadStockVm}"/>
            </Grid>

            <!-- Money Finder Lab -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=GrowthLab}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Money Finder Lab" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Turn stock, donor cars, part requests, and auction listings into the next profitable action."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="110"
                                Margin="0 0 10 0"/>
                        <Button Content="Stock"
                                Command="{Binding GoToStockManagementCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="110"
                                Margin="0 0 10 0"/>
                        <Button Content="Part Requests"
                                Command="{Binding OpenManagementCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="135"
                                Margin="0 0 10 0"/>
                        <Button Content="Refresh"
                                Command="{Binding GrowthLabVm.RefreshCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="110"/>
                    </StackPanel>
                </DockPanel>

                <local:GrowthLabControl Grid.Row="1"
                                        DataContext="{Binding GrowthLabVm}"/>
            </Grid>

            <!-- Part Passport -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=PartPassport}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Part Passport" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Choose a part, review its customer-facing proof card, and prepare a WhatsApp-ready public link."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="110"
                                Margin="0 0 10 0"/>
                        <Button Content="Stock"
                                Command="{Binding GoToStockManagementCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="110"
                                Margin="0 0 10 0"/>
                        <Button Content="Refresh"
                                Command="{Binding PartPassportVm.RefreshCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="110"/>
                    </StackPanel>
                </DockPanel>

                <local:PartPassportControl Grid.Row="1"
                                           DataContext="{Binding PartPassportVm}"/>
            </Grid>

            <!-- ── Part Compatibility Graph ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=PartCompatibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Part Compatibility Graph" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="See which parts fit the same cars, models, and years."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120" Margin="0 0 10 0"/>
                        <Button Content="Open Stock"
                                Command="{Binding GoToStockManagementCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="140"/>
                    </StackPanel>
                </DockPanel>

                <local:PartCompatibilityControl Grid.Row="1"
                                                DataContext="{Binding PartCompatibilityVm}"/>
            </Grid>

            <!-- ── Barcode / QR Mode ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=BarcodeMode}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="AR Picture Search" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Search parts by picture, resolve scans, sell parts, move warehouse stock, and link parts to used cars."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"
                                Margin="0 0 10 0"/>
                        <Button Content="Refresh"
                                Command="{Binding BarcodeModeVm.LoadCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"
                                Margin="0 0 10 0"/>
                        <Button Content="Print Labels"
                                Command="{Binding BarcodeModeVm.PrintLabelsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="140"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Parts" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BarcodeModeVm.SelectedPartSummary}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0 4 0 0"/>
                            </StackPanel>

                            <TextBox Grid.Row="1"
                                     Text="{Binding BarcodeModeVm.PartFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="38"
                                     Margin="0 14 0 10"
                                     Padding="10 0"
                                     VerticalContentAlignment="Center"/>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding BarcodeModeVm.Parts}"
                                      SelectedItem="{Binding BarcodeModeVm.SelectedPart, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding InternalCode, Mode=OneWay}" Width="110"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode, Mode=OneWay}" Width="120"/>
                                    <DataGridTextColumn Header="Avail" Binding="{Binding AvailableQuantity, Mode=OneWay}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <UniformGrid Grid.Row="3" Columns="2" Margin="0 12 0 0">
                                <Button Content="Generate Selected"
                                        Command="{Binding BarcodeModeVm.GenerateSelectedLabelCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0 0 6 0"/>
                                <Button Content="Generate Visible"
                                        Command="{Binding BarcodeModeVm.GenerateVisibleLabelsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="6 0 0 0"/>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="150"/>
                                <RowDefinition Height="145"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Scan" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BarcodeModeVm.StatusMessage}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0 4 0 0"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0 14 0 10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BarcodeScanBox"
                                         Text="{Binding BarcodeModeVm.ScanText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="38"
                                         Padding="10 0"
                                         VerticalContentAlignment="Center"
                                         KeyDown="BarcodeScanBox_KeyDown"/>
                                <Button Grid.Column="2"
                                        Content="Resolve"
                                        Command="{Binding BarcodeModeVm.ResolveScanCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                            </Grid>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding BarcodeModeVm.ScanResults}"
                                      SelectedItem="{Binding BarcodeModeVm.SelectedScanResult, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding TargetType, Mode=OneWay}" Width="95"/>
                                    <DataGridTextColumn Header="Result" Binding="{Binding DisplayText, Mode=OneWay}" Width="*"/>
                                    <DataGridTemplateColumn Header="" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Use"
                                                        Command="{Binding DataContext.BarcodeModeVm.SelectScanResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="8 2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid Grid.Row="3"
                                      ItemsSource="{Binding BarcodeModeVm.StockRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      Margin="0 10 0 0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, Mode=OneWay}" Width="60"/>
                                    <DataGridTextColumn Header="Reserved" Binding="{Binding ReservedQuantity, Mode=OneWay}" Width="80"/>
                                    <DataGridTextColumn Header="Avail" Binding="{Binding AvailableQuantity, Mode=OneWay}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="4"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0 12 0 0">
                                <StackPanel>
                                    <TextBlock Text="AR Picture Search" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding BarcodeModeVm.VisualSearchSummary}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0 4 0 8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding BarcodeModeVm.VisualHint, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="34"
                                                 Padding="8 0"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Optional hint, for example BMW headlight or brake sensor"/>
                                        <Button Grid.Column="2"
                                                Content="Search Picture"
                                                Command="{Binding BarcodeModeVm.SearchByPictureCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding BarcodeModeVm.VisualMatches}"
                                              SelectedItem="{Binding BarcodeModeVm.SelectedVisualMatch, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              Height="118"
                                              Margin="0 8 0 0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Code" Binding="{Binding InternalCode, Mode=OneWay}" Width="90"/>
                                            <DataGridTextColumn Header="Part" Binding="{Binding PartName, Mode=OneWay}" Width="*"/>
                                            <DataGridTextColumn Header="Avail" Binding="{Binding AvailableQuantity, Mode=OneWay}" Width="55"/>
                                            <DataGridTemplateColumn Header="" Width="60">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Use"
                                                                Command="{Binding DataContext.BarcodeModeVm.SelectVisualMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="8 2"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="0 12 0 0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Qty" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding BarcodeModeVm.ActionQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="34"
                                                 Padding="8 0"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="Sell" FontWeight="SemiBold" Margin="0 14 0 6"/>
                                    <ComboBox ItemsSource="{Binding BarcodeModeVm.Warehouses}"
                                              SelectedValue="{Binding BarcodeModeVm.SellWarehouseId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Height="34"/>
                                    <Button Content="Sell Scanned Part"
                                            Command="{Binding BarcodeModeVm.SellPartCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0 8 0 0"/>

                                    <TextBlock Text="Move Warehouse" FontWeight="SemiBold" Margin="0 16 0 6"/>
                                    <ComboBox ItemsSource="{Binding BarcodeModeVm.Warehouses}"
                                              SelectedValue="{Binding BarcodeModeVm.FromWarehouseId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Height="34"/>
                                    <ComboBox ItemsSource="{Binding BarcodeModeVm.Warehouses}"
                                              SelectedValue="{Binding BarcodeModeVm.ToWarehouseId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Height="34"
                                              Margin="0 6 0 0"/>
                                    <Button Content="Move Stock"
                                            Command="{Binding BarcodeModeVm.TransferPartCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0 8 0 0"/>

                                    <TextBlock Text="Used Car" FontWeight="SemiBold" Margin="0 16 0 6"/>
                                    <ComboBox ItemsSource="{Binding BarcodeModeVm.UsedCars}"
                                              SelectedValue="{Binding BarcodeModeVm.SelectedUsedCarId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              Height="34">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Car}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding ModelYear}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <UniformGrid Columns="2" Margin="0 8 0 0">
                                        <Button Content="Attach"
                                                Command="{Binding BarcodeModeVm.AttachUsedCarCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0 0 6 0"/>
                                        <Button Content="Detach"
                                                Command="{Binding BarcodeModeVm.DetachUsedCarCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="6 0 0 0"/>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="185"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Labels" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="Preview and print sheet"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Clear"
                                        Command="{Binding BarcodeModeVm.ClearLabelsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="82"/>
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Background="White"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0 14 0 12">
                                <Grid DataContext="{Binding BarcodeModeVm.PreviewLabel}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding PartCode}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="Black"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Grid Grid.Row="1" Margin="0 8 0 4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding BarcodeModules}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Rectangle Width="{Binding Width}" Height="54" Fill="{Binding Fill}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding BarcodeText}"
                                                       FontSize="10"
                                                       Foreground="Black"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <Image Grid.Column="1"
                                               Source="{Binding QrImage}"
                                               Width="64"
                                               Height="64"
                                               Margin="8 0 0 0"/>
                                    </Grid>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding PartName}"
                                               FontSize="11"
                                               Foreground="Black"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="2"
                                       Text="Generated Sheet"
                                       FontWeight="SemiBold"
                                       Margin="0 0 0 8"/>

                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding BarcodeModeVm.Labels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="220"
                                                    Height="150"
                                                    Background="White"
                                                    BorderBrush="#33000000"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="9"
                                                    Margin="0 0 8 8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding PartCode}"
                                                               FontWeight="Bold"
                                                               Foreground="Black"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Grid Grid.Row="1" Margin="0 8 0 4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <ItemsControl ItemsSource="{Binding BarcodeModules}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Rectangle Width="{Binding Width}" Height="48" Fill="{Binding Fill}"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{Binding BarcodeText}"
                                                                       FontSize="9"
                                                                       Foreground="Black"
                                                                       HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Image Grid.Column="1"
                                                               Source="{Binding QrImage}"
                                                               Width="54"
                                                               Height="54"
                                                               Margin="7 0 0 0"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="2"
                                                               Text="{Binding PartName}"
                                                               FontSize="10"
                                                               Foreground="Black"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ── Car Selection ── -->
            <Grid Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=CarSelection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.Background>
                    <VisualBrush Stretch="Uniform" AlignmentX="Center" AlignmentY="Center" Opacity="0.04">
                        <VisualBrush.Visual>
                            <Image Source="{Binding SelectedBrand.Logo}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.Background>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20 20 20 10">
                    <Button Content="⟵ Back" Command="{Binding GoToHomeCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="100" Margin="0 0 20 0"/>
                    <Image Source="{Binding SelectedBrand.Logo}" Height="50" Margin="0 0 16 0"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding SelectedBrand.Name}" FontSize="26" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AvailableCars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectCarCommand, ElementName=RootWindow}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Margin="8" Padding="0">
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            CornerRadius="8" Padding="10" Width="220">
                                        <StackPanel>
                                            <Image Source="{Binding Image}" Height="100"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0 8 0 0"/>
                                            <TextBlock Text="{Binding BrandName}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ── Part Selection ── -->
            <Grid Margin="20" Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=PartSelection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 20">
                    <Button Content="⟵ Back to Cars" Command="{Binding GoToCarSelectionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="150" Margin="0 0 20 0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedCar.Name, TargetNullValue='Select a car'}"
                                   FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedCar.BrandName}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AvailableParts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectPartCommand, ElementName=RootWindow}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Margin="8" Padding="0">
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            CornerRadius="8" Padding="10" Width="260">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Code}" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0 4 0 0"/>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0} USD}"
                                                       FontSize="14" FontWeight="SemiBold" Margin="0 8 0 0"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ── POS Invoice Tabs ── -->
            <TabControl Margin="10"
                        Style="{StaticResource InvoiceTabControlStyle}"
                        ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource InvoiceTabItemStyle}"
                        Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=Pos}">

                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Header}" FontSize="13" VerticalAlignment="Center"/>
                            <Button Content="✕"
                                    Command="{Binding DataContext.CloseTabCommand, ElementName=RootWindow}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="11" Padding="8 0 0 0"
                                    VerticalAlignment="Center" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <!-- POS content: 5-row layout, no outer margin (tab strip provides framing) -->
                        <Grid Background="{DynamicResource AppBackgroundBrush}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="54"/>   <!-- header command bar -->
                                <RowDefinition Height="Auto"/> <!-- form card -->
                                <RowDefinition Height="Auto"/> <!-- timeline (conditional) -->
                                <RowDefinition Height="*"/>    <!-- cart grid -->
                                <RowDefinition Height="Auto"/> <!-- footer totals + payment -->
                            </Grid.RowDefinitions>

                            <!-- ── Header command bar ───────────────────────────────────── -->
                            <Grid Grid.Row="0" Background="{DynamicResource CardBackgroundBrush}">
                                <Border Width="3" HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentBrush}"/>
                                <DockPanel Margin="12 0">
                                    <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SaleModeTitle}"
                                                   FontSize="15" FontWeight="Bold" VerticalAlignment="Center"/>
                                        <Border Background="#22D40000" CornerRadius="3" Padding="6 2" Margin="10 0 0 0">
                                            <TextBlock Text="{Binding SaleModeSubtitle}" FontSize="10"
                                                       Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/>
                                        </Border>
                                    </StackPanel>
                                    <!-- Action buttons — only when viewing a saved invoice -->
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal"
                                                HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadedFromSearch}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <Button ToolTip="Edit Invoice" Command="{Binding EditInvoiceCommand}"
                                                IsEnabled="{Binding IsEditEnabled}"
                                                Style="{StaticResource TopBarButtonStyle}"
                                                Padding="10 6" Margin="0 0 4 0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="✎" FontSize="13" Margin="0 0 5 0"/>
                                                <TextBlock Text="Edit" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button ToolTip="Save Invoice" Command="{Binding SaveInvoiceCommand}"
                                                IsEnabled="{Binding IsSaveEnabled}"
                                                Style="{StaticResource TopBarButtonStyle}"
                                                Padding="10 6" Margin="0 0 4 0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="💾" FontSize="11" Margin="0 0 5 0"/>
                                                <TextBlock Text="Save" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button ToolTip="Reset Invoice" Command="{Binding ResetInvoiceCommand}"
                                                IsEnabled="{Binding IsResetEnabled}"
                                                Style="{StaticResource TopBarButtonStyle}"
                                                Padding="10 6" Margin="0 0 4 0">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="↺" FontSize="13" Margin="0 0 5 0"/>
                                                <TextBlock Text="Reset" FontSize="12"/>
                                            </StackPanel>
                                        </Button>
                                        <Button ToolTip="Send WhatsApp" Command="{Binding SendWhatsAppInvoiceCommand}"
                                                IsEnabled="{Binding IsCommunicationEnabled}"
                                                Style="{StaticResource TopBarButtonStyle}"
                                                Padding="10 6" Margin="0 0 4 0">
                                            <TextBlock Text="WA" FontSize="11" FontWeight="Bold"/>
                                        </Button>
                                        <Button ToolTip="Send SMS" Command="{Binding SendSmsReminderCommand}"
                                                IsEnabled="{Binding IsCommunicationEnabled}"
                                                Style="{StaticResource TopBarButtonStyle}"
                                                Padding="10 6">
                                            <TextBlock Text="SMS" FontSize="11" FontWeight="Bold"/>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                            </Grid>

                            <!-- ── Form card ─────────────────────────────────────────────── -->
                            <Border Grid.Row="1" CornerRadius="4" Margin="12 8 12 8"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    IsEnabled="{Binding IsInvoiceContentEnabled}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="3"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{DynamicResource AccentBrush}" CornerRadius="4 4 0 0"/>
                                    <StackPanel Grid.Row="1" Margin="16 12 16 16">
                                        <!-- Customer + Warehouse + Date -->
                                        <Grid Margin="0 0 0 12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="270"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:CustomerSearchControl Grid.Column="0"
                                                SelectedCustomerId="{Binding CustomerId, Mode=TwoWay}"
                                                VerticalAlignment="Top"/>
                                            <controls:WarehouseSearchControl Grid.Column="4"
                                                SelectedWarehouseId="{Binding WarehouseId, Mode=TwoWay}"
                                                VerticalAlignment="Top"/>
                                            <controls:SaleDatePickerControl Grid.Column="6"
                                                Label="DATE" PopupTitle="SELECT INVOICE DATE"
                                                SelectedDate="{Binding InvoiceDate, Mode=TwoWay}"
                                                VerticalAlignment="Top"/>
                                        </Grid>
                                        <!-- Base Rate + Currency -->
                                        <Grid Margin="0 0 0 12">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="320"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="BASE RATE" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 5"/>
                                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Height="44" Padding="12 0">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SelectedCounterRate, StringFormat={}{0:N6}}"
                                                                   FontSize="14" FontWeight="SemiBold"/>
                                                        <TextBlock Text=" " FontSize="14"/>
                                                        <TextBlock Text="{Binding SelectedCurrencyCode}"
                                                                   FontSize="14" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <controls:CurrencyCodeSelectorControl Grid.Column="2"
                                                CurrencyCodes="{Binding CurrencyCodes}"
                                                SelectedCurrencyCode="{Binding SelectedCurrencyCode, Mode=TwoWay}"
                                                VerticalAlignment="Top"/>
                                        </Grid>
                                        <!-- Part | Qty | Price | Add | Submit -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="10"/>
                                                <ColumnDefinition Width="170"/>
                                            </Grid.ColumnDefinitions>
                                            <controls:PartSearchControl Grid.Column="0"
                                                SelectedPartId="{Binding NewPartId, Mode=TwoWay}"
                                                SelectedPartPrice="{Binding NewUnitPrice, Mode=TwoWay}"
                                                SelectedPartDescription="{Binding NewPartDescription, Mode=TwoWay}"
                                                VerticalAlignment="Top"/>
                                            <!-- QTY -->
                                            <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                                <TextBlock Text="QTY" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 5"/>
                                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Height="44">
                                                    <TextBox Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                             Background="Transparent" BorderThickness="0"
                                                             Foreground="White" FontSize="14"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             Padding="6 0" CaretBrush="{DynamicResource AccentBrush}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="TextBox">
                                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                                          Margin="{TemplateBinding Padding}"
                                                                                          VerticalAlignment="Center"
                                                                                          HorizontalAlignment="Center"/>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Border>
                                            </StackPanel>
                                            <!-- UNIT PRICE -->
                                            <StackPanel Grid.Column="4" VerticalAlignment="Top">
                                                <TextBlock Text="UNIT PRICE" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 5"/>
                                                <Border Background="{DynamicResource AppBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="4" Height="44">
                                                    <TextBox Text="{Binding NewUnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                                                             Background="Transparent" BorderThickness="0"
                                                             Foreground="White" FontSize="14"
                                                             HorizontalContentAlignment="Right"
                                                             VerticalContentAlignment="Center"
                                                             Padding="8 0" CaretBrush="{DynamicResource AccentBrush}">
                                                        <TextBox.Style>
                                                            <Style TargetType="TextBox">
                                                                <Setter Property="Template">
                                                                    <Setter.Value>
                                                                        <ControlTemplate TargetType="TextBox">
                                                                            <ScrollViewer x:Name="PART_ContentHost"
                                                                                          Margin="{TemplateBinding Padding}"
                                                                                          VerticalAlignment="Center"/>
                                                                        </ControlTemplate>
                                                                    </Setter.Value>
                                                                </Setter>
                                                            </Style>
                                                        </TextBox.Style>
                                                    </TextBox>
                                                </Border>
                                            </StackPanel>
                                            <!-- Add Line -->
                                            <Button Grid.Column="6" Content="＋  Add Line"
                                                    Command="{Binding AddItemCommand}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    Height="44" Margin="0 15 0 0" VerticalAlignment="Top"/>
                                            <!-- Submit Invoice -->
                                            <Button Grid.Column="8" Content="✔  Submit Invoice"
                                                    Command="{Binding SubmitSaleCommand}"
                                                    Height="44" Margin="0 15 0 0" VerticalAlignment="Top">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsModifyMode}" Value="True">
                                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- ── Auto Posting Timeline ─────────────────────────────────── -->
                            <Border Grid.Row="2" CornerRadius="4"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Padding="14" Margin="12 0 12 8"
                                    Visibility="{Binding HasPostingTimeline, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel Margin="0 0 0 8">
                                        <TextBlock Text="AUTO POSTING TIMELINE" FontSize="10" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentBrush}"
                                                   VerticalAlignment="Center" DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding Header}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   FontSize="12" DockPanel.Dock="Right" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <ItemsControl ItemsSource="{Binding PostingTimeline}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="190" MinHeight="110" Margin="0 0 8 8" Padding="12"
                                                        Background="{DynamicResource AppBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1" CornerRadius="4">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>
                                                        <DockPanel Grid.Row="0">
                                                            <Border x:Name="StepDot" Width="20" Height="20" CornerRadius="10"
                                                                    Background="#FF757575" DockPanel.Dock="Left">
                                                                <TextBlock Text="{Binding Sequence}" FontSize="10" FontWeight="Bold"
                                                                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Border x:Name="StatusBadge" Padding="6 2"
                                                                    BorderBrush="#66757575" BorderThickness="1" CornerRadius="3"
                                                                    HorizontalAlignment="Right" DockPanel.Dock="Right">
                                                                <TextBlock x:Name="StatusText" Text="{Binding Status}"
                                                                           FontSize="10" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </Border>
                                                        </DockPanel>
                                                        <TextBlock Grid.Row="1" Text="{Binding Title}"
                                                                   Margin="0 7 0 0" FontWeight="Bold" FontSize="12"/>
                                                        <TextBlock Grid.Row="2" Text="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                                   Margin="0 2 0 0" FontSize="10"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Grid.Row="3" Text="{Binding Detail}"
                                                                   Margin="0 6 0 0" FontSize="10" TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                        <Setter TargetName="StepDot" Property="Background" Value="#FF4CAF50"/>
                                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#994CAF50"/>
                                                        <Setter TargetName="StatusText" Property="Foreground" Value="#FF81C784"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                        <Setter TargetName="StepDot" Property="Background" Value="#FFFFA000"/>
                                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#99FFA000"/>
                                                        <Setter TargetName="StatusText" Property="Foreground" Value="#FFFFCC80"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ── Cart Items DataGrid ───────────────────────────────────── -->
                            <Border Grid.Row="3" CornerRadius="4" Margin="12 0 12 0"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    IsEnabled="{Binding IsInvoiceContentEnabled}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="36"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Border Grid.Row="0" Background="{DynamicResource AppBackgroundBrush}"
                                            CornerRadius="4 4 0 0" Padding="12 0">
                                        <DockPanel VerticalAlignment="Center">
                                            <Border Width="3" Height="14" Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="2" Margin="0 0 8 0" DockPanel.Dock="Left"/>
                                            <TextBlock Text="CART" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center"/>
                                        </DockPanel>
                                    </Border>
                                    <DataGrid Grid.Row="1" ItemsSource="{Binding Items}"
                                              AutoGenerateColumns="False" CanUserAddRows="False"
                                              HeadersVisibility="Column" BorderThickness="0"
                                              GridLinesVisibility="None"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.CanContentScroll="True">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Part #" Binding="{Binding PartId, Mode=OneWay}" Width="80"/>
                                            <DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=OneWay}" Width="*"/>
                                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="60"/>
                                            <DataGridTextColumn Header="Unit Price" Binding="{Binding UnitPrice, StringFormat={}{0:N0}}" Width="120"/>
                                            <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, Mode=OneWay, StringFormat={}{0:N0}}" Width="110" FontWeight="Bold"/>
                                            <DataGridTextColumn Header="Base Amount" Binding="{Binding BaseAmount, Mode=OneWay, StringFormat={}{0:N0}}" Width="130"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>

                            <!-- ── Footer: financial totals + payment ────────────────────── -->
                            <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}"
                                    Margin="12 8 12 12" CornerRadius="4" Padding="12 10">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <!-- Totals strip — uniform columns -->
                                    <UniformGrid Grid.Row="0" Rows="1" Margin="0 0 0 8">
                                        <Border Margin="0 0 4 0" Padding="12 8"
                                                Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding TotalCounterLabel}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 3"/>
                                                <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0}}"
                                                           FontSize="16" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0 0 4 0" Padding="12 8"
                                                Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="BASE AMOUNT" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 3"/>
                                                <TextBlock Text="{Binding BaseAmountTotal, StringFormat={}{0:N0}}"
                                                           FontSize="16" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0 0 4 0" Padding="12 8"
                                                Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding PaidCounterLabel}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 3"/>
                                                <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                                                         FontSize="16" FontWeight="SemiBold"
                                                         Background="Transparent" BorderThickness="0 0 0 1"
                                                         BorderBrush="{DynamicResource AccentBrush}"
                                                         IsEnabled="{Binding IsInvoiceContentEnabled}"
                                                         Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0 0 4 0" Padding="12 8"
                                                Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="PAID (BASE)" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 3"/>
                                                <TextBlock Text="{Binding PaidAmountBase, StringFormat={}{0:N0}}"
                                                           FontSize="16" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Margin="0 0 4 0" Padding="12 8"
                                                Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="{Binding RemainingCounterLabel}" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 3"/>
                                                <TextBlock Text="{Binding RemainingAmountUsd, StringFormat={}{0:N0}}"
                                                           FontSize="16" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                        <Border Padding="12 8"
                                                Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4">
                                            <StackPanel>
                                                <TextBlock Text="REMAINING (BASE)" FontSize="10" FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 3"/>
                                                <TextBlock Text="{Binding RemainingAmountBase, StringFormat={}{0:N0}}"
                                                           FontSize="16" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </Border>
                                    </UniformGrid>
                                    <!-- Payment panel — only for saved invoices -->
                                    <Border Grid.Row="1" Padding="12 10"
                                            Background="{DynamicResource AppBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="4">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadedFromSearch}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <DockPanel VerticalAlignment="Center">
                                            <TextBlock Text="ISSUE PAYMENT" FontSize="10" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}"
                                                       VerticalAlignment="Center" Margin="0 0 16 0"
                                                       DockPanel.Dock="Left"/>
                                            <Button Content="Post Payment"
                                                    Command="{Binding IssueSalePaymentCommand}"
                                                    IsEnabled="{Binding CanIssueSalePayment}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    MinWidth="130" Height="38" DockPanel.Dock="Right"/>
                                            <WrapPanel VerticalAlignment="Center">
                                                <TextBlock Text="Amount" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="0 0 6 0"/>
                                                <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                                         Width="110" FontSize="13" FontWeight="SemiBold"
                                                         Background="Transparent" BorderThickness="0 0 0 1"
                                                         BorderBrush="{DynamicResource AccentBrush}" Margin="0 0 12 0"/>
                                                <controls:SaleDatePickerControl Width="210"
                                                    Label="PAYMENT DATE" PopupTitle="SELECT PAYMENT DATE"
                                                    DisplayFormat="dd MMM yyyy"
                                                    SelectedDate="{Binding PaymentDate, Mode=TwoWay}"
                                                    Margin="0 0 12 0"/>
                                                <TextBlock Text="Method" FontSize="11"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Center" Margin="0 0 6 0"/>
                                                <TextBox Text="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}"
                                                         Width="100" FontSize="13"
                                                         Background="Transparent" BorderThickness="0 0 0 1"
                                                         BorderBrush="{DynamicResource AccentBrush}" Margin="0 0 12 0"/>
                                            </WrapPanel>
                                        </DockPanel>
                                    </Border>
                                </Grid>
                            </Border>

                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>


            </TabControl>

            <!-- ══ GLOBAL APP FEEDBACK CENTER ══ -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0 0 24 24"
                    Width="430"
                    MaxHeight="260"
                    Background="#CC10141E"
                    CornerRadius="10"
                    Padding="12"
                    Panel.ZIndex="10">
                <StackPanel>
                    <DockPanel Margin="0 0 0 8">
                        <TextBlock Text="Activity Feed"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>
                        <Button Content="{Binding FeedToggleText}"
                                Command="{Binding ToggleFeedCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10 4"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="220">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFeedVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Margin="0 2 0 2" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFE57373"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF81C784"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>


            <!-- ══ INVOICE SEARCH OVERLAY ══ -->
            <Grid Panel.ZIndex="18">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInvoiceSearchOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Background="#80000000"/>

                <Border Width="760"
                        MaxHeight="620"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0 0 0 12">
                            <TextBlock Text="Search Invoices"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       DockPanel.Dock="Left"/>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding OpenInvoiceSearchCommand}"
                                    Content="✕"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="40"
                                    Height="34"/>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0 0 0 12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding InvoiceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="40"
                                     FontSize="14"
                                     Padding="10"
                                     VerticalContentAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Margin="8 0 0 0"
                                    Width="110"
                                    Height="40"
                                    Content="↻ Reload"
                                    Command="{Binding ReloadInvoiceSearchCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>

                        <DataGrid Grid.Row="2"
                                  Name="InvoiceSearchResultsGrid"
                                  ItemsSource="{Binding InvoiceSearchResults}"
                                  AutoGenerateColumns="False"
                                  MouseDoubleClick="InvoiceSearchResults_MouseDoubleClick"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber, Mode=OneWay}" Width="170"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerId, Mode=OneWay}" Width="90"/>
                                <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseId, Mode=OneWay}" Width="90"/>
                                <DataGridTextColumn Header="Currency" Binding="{Binding CounterCurrencyCode, Mode=OneWay}" Width="90"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, Mode=OneWay, StringFormat={}{0:N0}}" Width="120"/>
                                <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, Mode=OneWay, StringFormat={}{0:N0}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Reorder Center ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=Reorder}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Reorder Center" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Parts that have fallen below their reorder point and need restocking."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home" Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0 0 10 0"/>
                        <Button Content="↻ Refresh" Command="{Binding ReorderVm.LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Width="120"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding ReorderVm.Status}" Foreground="{Binding ReorderVm.StatusBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                    <DataGrid ItemsSource="{Binding ReorderVm.Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding PartCode, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding PartName, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="In Stock" Binding="{Binding CurrentStock, Mode=OneWay}" Width="80"/>
                            <DataGridTextColumn Header="Reorder Pt" Binding="{Binding ReorderPoint, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="Order Qty" Binding="{Binding SuggestedOrderQuantity, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding PreferredSupplierName, Mode=OneWay}" Width="160"/>
                            <DataGridTextColumn Header="Last Price" Binding="{Binding LastPurchasePrice, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Sales 30d" Binding="{Binding SalesLast30Days, Mode=OneWay}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ── Expiry Alerts ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=ExpiryAlerts}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Expiry Alerts" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Parts approaching or past their expiry date that need immediate attention."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home" Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0 0 10 0"/>
                        <Button Content="↻ Refresh" Command="{Binding ExpiryAlertsVm.LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Width="120"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding ExpiryAlertsVm.Status}" Foreground="{Binding ExpiryAlertsVm.StatusBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                    <DataGrid ItemsSource="{Binding ExpiryAlertsVm.Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Code" Binding="{Binding PartCode, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding PartName, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                            <DataGridTextColumn Header="Days Left" Binding="{Binding DaysUntilExpiry, Mode=OneWay}" Width="90"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding AlertLevel, Mode=OneWay}" Width="100"/>
                            <DataGridTextColumn Header="In Stock" Binding="{Binding CurrentStock, Mode=OneWay}" Width="80"/>
                            <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName, Mode=OneWay}" Width="140"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ── Loyalty ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=Loyalty}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Loyalty" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Top customers ranked by loyalty points. Reward and engage your best clients."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home" Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0 0 10 0"/>
                        <Button Content="↻ Refresh" Command="{Binding LoyaltyVm.LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Width="120"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding LoyaltyVm.Status}" Foreground="{Binding LoyaltyVm.StatusBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                    <DataGrid ItemsSource="{Binding LoyaltyVm.Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Points" Binding="{Binding TotalPoints, Mode=OneWay}" Width="100"/>
                            <DataGridTextColumn Header="Redeemed" Binding="{Binding RedeemedPoints, Mode=OneWay}" Width="100"/>
                            <DataGridTextColumn Header="Balance" Binding="{Binding AvailablePoints, Mode=OneWay}" Width="100"/>
                            <DataGridTextColumn Header="Last Earned" Binding="{Binding LastEarnedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}" Width="130"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ── Warranty & Returns ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=Warranty}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Warranty &amp; Returns" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Track open and resolved warranty claims and return requests."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home" Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0 0 10 0"/>
                        <Button Content="↻ Refresh" Command="{Binding WarrantyVm.LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Width="120"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding WarrantyVm.Status}" Foreground="{Binding WarrantyVm.StatusBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                    <DataGrid ItemsSource="{Binding WarrantyVm.Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Claim #" Binding="{Binding ClaimNumber, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Part" Binding="{Binding PartName, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="100"/>
                            <DataGridTextColumn Header="Reason" Binding="{Binding Reason, Mode=OneWay}" Width="180"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ── Shipments ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=Shipments}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Shipments" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Track incoming and outgoing shipments with real-time status updates."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home" Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0 0 10 0"/>
                        <Button Content="↻ Refresh" Command="{Binding ShipmentsVm.LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Width="120"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding ShipmentsVm.Status}" Foreground="{Binding ShipmentsVm.StatusBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                    <DataGrid ItemsSource="{Binding ShipmentsVm.Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Shipment #" Binding="{Binding ShipmentNumber, Mode=OneWay}" Width="130"/>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="110"/>
                            <DataGridTextColumn Header="Expected" Binding="{Binding ExpectedArrival, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                            <DataGridTextColumn Header="Tracking" Binding="{Binding TrackingNumber, Mode=OneWay}" Width="160"/>
                            <DataGridTextColumn Header="Created" Binding="{Binding CreatedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ── Quotes / Estimates ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=Quotes}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Quotes / Estimates" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Review saved quotes, update their status, and convert accepted work into invoices."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home" Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0 0 10 0"/>
                        <Button Content="↻ Refresh" Command="{Binding QuotesVm.LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Width="120"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 16">
                    <DockPanel>
                        <TextBlock Text="Status" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding QuotesVm.Status}" Foreground="{Binding QuotesVm.StatusBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="2*"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding QuotesVm.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0 0 12 0"
                                 Padding="10 6"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding QuotesVm.StatusFilters}"
                                  SelectedItem="{Binding QuotesVm.StatusFilter}"
                                  Margin="0 0 12 0"
                                  Padding="8 4"/>
                        <Button Grid.Column="2"
                                Content="Load"
                                Command="{Binding QuotesVm.LoadCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="110"/>
                    </Grid>
                </Border>
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                        <DataGrid ItemsSource="{Binding QuotesVm.Items}"
                                  SelectedItem="{Binding QuotesVm.SelectedItem, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  IsReadOnly="True"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Quote #" Binding="{Binding QuoteNumber, Mode=OneWay}" Width="110"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName, Mode=OneWay}" Width="*"/>
                                <DataGridTextColumn Header="Phone" Binding="{Binding CustomerPhone, Mode=OneWay}" Width="120"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding QuoteDate, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>
                                <DataGridTextColumn Header="Expiry" Binding="{Binding ExpiryDate, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}" Width="110"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="100"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <DockPanel Grid.Row="0" Margin="0 0 0 12">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{Binding QuotesVm.SelectedQuote.QuoteNumber}" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding QuotesVm.SelectedQuote.CustomerName}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Open"
                                        Command="{Binding QuotesVm.OpenSelectedCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="110"/>
                            </DockPanel>
                            <WrapPanel Grid.Row="1" Margin="0 0 0 12">
                                <Button Content="Mark Sent"
                                        Command="{Binding QuotesVm.MarkSentCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="110" Margin="0 0 10 10"
                                        IsEnabled="{Binding QuotesVm.CanMarkSent}"/>
                                <Button Content="Accept"
                                        Command="{Binding QuotesVm.MarkAcceptedCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="110" Margin="0 0 10 10"
                                        IsEnabled="{Binding QuotesVm.CanMarkAccepted}"/>
                                <Button Content="Decline"
                                        Command="{Binding QuotesVm.MarkDeclinedCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="110" Margin="0 0 10 10"
                                        IsEnabled="{Binding QuotesVm.CanMarkDeclined}"/>
                                <Button Content="To Invoice"
                                        Command="{Binding QuotesVm.ConvertSelectedCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="120" Margin="0 0 10 10"
                                        IsEnabled="{Binding QuotesVm.CanConvert}"/>
                                <Button Content="Delete"
                                        Command="{Binding QuotesVm.DeleteSelectedCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="110" Margin="0 0 10 10"
                                        IsEnabled="{Binding QuotesVm.CanDelete}"/>
                            </WrapPanel>
                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding QuotesVm.SelectedQuote.Items}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      BorderThickness="0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Description" Binding="{Binding Description, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, Mode=OneWay}" Width="70"/>
                                    <DataGridTextColumn Header="Unit" Binding="{Binding UnitPrice, Mode=OneWay, StringFormat={}{0:N2}}" Width="90"/>
                                    <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, Mode=OneWay, StringFormat={}{0:N2}}" Width="90"/>
                                    <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
                <Border Grid.Row="4" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 16 0 0">
                    <TextBlock Text="{Binding QuotesVm.SelectedQuote.Notes}" TextWrapping="Wrap"/>
                </Border>
            </Grid>

            <!-- ── Customer Aging ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=CustomerAging}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Customer Aging" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Outstanding receivables grouped by aging bucket so follow-up stays consistent across desktop, web, and mobile."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home" Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0 0 10 0"/>
                        <Button Content="↻ Refresh" Command="{Binding CustomerAgingVm.LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Width="120"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding CustomerAgingVm.Status}" Foreground="{Binding CustomerAgingVm.StatusBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                    <DataGrid ItemsSource="{Binding CustomerAgingVm.Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Customer" Binding="{Binding CustomerName, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding Current, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="1-30" Binding="{Binding Days1To30, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="31-60" Binding="{Binding Days31To60, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="61-90" Binding="{Binding Days61To90, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="90+" Binding="{Binding Over90Days, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalBalance, Mode=OneWay, StringFormat={}{0:N2}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ── Supplier Aging ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=SupplierAging}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Supplier Aging" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Outstanding payables grouped by aging bucket so payment planning matches the web and mobile finance views."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home" Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0 0 10 0"/>
                        <Button Content="↻ Refresh" Command="{Binding SupplierAgingVm.LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Width="120"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding SupplierAgingVm.Status}" Foreground="{Binding SupplierAgingVm.StatusBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                    <DataGrid ItemsSource="{Binding SupplierAgingVm.Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Supplier" Binding="{Binding SupplierName, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Phone" Binding="{Binding Phone, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Current" Binding="{Binding Current, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="1-30" Binding="{Binding Days1To30, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="31-60" Binding="{Binding Days31To60, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="61-90" Binding="{Binding Days61To90, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="90+" Binding="{Binding Over90Days, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                            <DataGridTextColumn Header="Total" Binding="{Binding TotalBalance, Mode=OneWay, StringFormat={}{0:N2}}" Width="110"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ── Activity Log ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=ActivityLog}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Activity Log" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Full audit trail of system activity. Track who did what and when."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home" Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0 0 10 0"/>
                        <Button Content="↻ Refresh" Command="{Binding ActivityLogVm.LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Width="120"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding ActivityLogVm.Status}" Foreground="{Binding ActivityLogVm.StatusBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                    <DataGrid ItemsSource="{Binding ActivityLogVm.Items}" AutoGenerateColumns="False" CanUserAddRows="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="When" Binding="{Binding OccurredAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
                            <DataGridTextColumn Header="User" Binding="{Binding UserName, Mode=OneWay}" Width="130"/>
                            <DataGridTextColumn Header="Action" Binding="{Binding Action, Mode=OneWay}" Width="130"/>
                            <DataGridTextColumn Header="Entity" Binding="{Binding EntityType, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Entity ID" Binding="{Binding EntityId, Mode=OneWay}" Width="80"/>
                            <DataGridTextColumn Header="Details" Binding="{Binding Details, Mode=OneWay}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ── Billing & Subscription ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=BillingSubscription}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Billing &amp; Subscription" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Manage your plan, payment methods, payment history and invoices."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home" Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0 0 10 0"/>
                        <Button Content="↻ Refresh" Command="{Binding BillingSubscriptionVm.LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Width="120"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding BillingSubscriptionVm.Status}" Foreground="{Binding BillingSubscriptionVm.StatusBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>

                        <!-- Current Plan -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20"
                                Visibility="{Binding BillingSubscriptionVm.HasSubscription, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Current Plan" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="{Binding BillingSubscriptionVm.PackageName}" FontSize="22" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding BillingSubscriptionVm.BillingCycleLabel}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 4 0 0"/>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 4 0 0">
                                            <Run Text="Current period:"/>
                                            <Run Text="{Binding BillingSubscriptionVm.CurrentPeriodStart, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}"/>
                                            <Run Text="→"/>
                                            <Run Text="{Binding BillingSubscriptionVm.CurrentPeriodEnd, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}"/>
                                        </TextBlock>
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 4 0 0"
                                                   Visibility="{Binding BillingSubscriptionVm.HasTrial, Converter={StaticResource BoolToVis}}">
                                            <Run Text="Trial ends:"/>
                                            <Run Text="{Binding BillingSubscriptionVm.TrialEndsAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}"/>
                                        </TextBlock>
                                        <TextBlock Text="This subscription will be cancelled at the end of the current billing period."
                                                   FontSize="12" Foreground="{DynamicResource AccentBrush}" Margin="0 6 0 0" TextWrapping="Wrap"
                                                   Visibility="{Binding BillingSubscriptionVm.CancelAtPeriodEnd, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" MinWidth="160">
                                        <Border Background="{Binding BillingSubscriptionVm.SubscriptionStatusBrush}" CornerRadius="10" Padding="10 4" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding BillingSubscriptionVm.SubscriptionStatusLabel}" FontSize="12" FontWeight="SemiBold" Foreground="#FF101010"/>
                                        </Border>
                                        <Button Content="Cancel at period end" Command="{Binding BillingSubscriptionVm.CancelAtPeriodEndCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" Margin="0 12 0 0" HorizontalAlignment="Stretch"
                                                Visibility="{Binding BillingSubscriptionVm.ShowCancelAtPeriodEndButton, Converter={StaticResource BoolToVis}}"/>
                                        <Button Content="Cancel now" Command="{Binding BillingSubscriptionVm.CancelImmediatelyCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}" Margin="0 6 0 0" HorizontalAlignment="Stretch"
                                                Visibility="{Binding BillingSubscriptionVm.CanCancel, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- Usage & Limits -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                            <StackPanel>
                                <TextBlock Text="Usage &amp; Limits" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 10"/>
                                <DataGrid ItemsSource="{Binding BillingSubscriptionVm.UsageRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Limit" Binding="{Binding Label, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="Value" Binding="{Binding ValueLabel, Mode=OneWay}" Width="220"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Plan Features -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                            <StackPanel>
                                <TextBlock Text="Plan Features" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 10"/>
                                <DataGrid ItemsSource="{Binding BillingSubscriptionVm.FeatureRows}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Feature" Binding="{Binding Label, Mode=OneWay}" Width="*"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding ValueLabel, Mode=OneWay}" Width="220"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Manual payment instructions -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20"
                                Visibility="{Binding BillingSubscriptionVm.HasCheckoutInstructions, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Payment Instructions" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 10"/>
                                <TextBlock Text="{Binding BillingSubscriptionVm.CheckoutInstructions}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding BillingSubscriptionVm.CheckoutPaymentLabel}" FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 6 0 0"/>
                            </StackPanel>
                        </Border>

                        <!-- Available Plans -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                            <StackPanel>
                                <DockPanel Margin="0 0 0 10">
                                    <TextBlock Text="Available Plans" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left" VerticalAlignment="Center"/>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Monthly" Command="{Binding BillingSubscriptionVm.SelectMonthlyCommand}" Width="100" Margin="0 0 8 0">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BillingSubscriptionVm.IsMonthlySelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                        <Button Content="Yearly" Command="{Binding BillingSubscriptionVm.SelectYearlyCommand}" Width="100">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding BillingSubscriptionVm.IsYearlySelected}" Value="True">
                                                            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>
                                    </StackPanel>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding BillingSubscriptionVm.Packages}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource CardHighlightBrush}" CornerRadius="12" Padding="14" Margin="0 0 14 14" Width="240">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"/>
                                                        <Border Grid.Column="1" Background="{DynamicResource AccentBrush}" CornerRadius="10" Padding="8 2" VerticalAlignment="Top"
                                                                Visibility="{Binding IsCurrent, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="Current" FontSize="10" FontWeight="SemiBold" Foreground="#FF101010"/>
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap" Margin="0 6 0 10" Height="60"/>
                                                    <TextBlock Text="{Binding PriceLabel}" FontSize="18" FontWeight="SemiBold" Margin="0 0 0 10"/>
                                                    <Button Content="{Binding ActionLabel}"
                                                            Command="{Binding DataContext.BillingSubscriptionVm.UpgradeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource PrimaryButtonStyle}"
                                                            Visibility="{Binding ShowUpgradeButton, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Content="{Binding ActionLabel}"
                                                            Command="{Binding DataContext.BillingSubscriptionVm.SwitchPlanCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Visibility="{Binding ShowDowngradeButton, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Content="{Binding ActionLabel}"
                                                            Command="{Binding DataContext.BillingSubscriptionVm.ContactSalesCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Visibility="{Binding ShowContactButton, Converter={StaticResource BoolToVis}}"/>
                                                    <Button Content="Start 14-day trial"
                                                            Command="{Binding DataContext.BillingSubscriptionVm.StartTrialCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource SecondaryButtonStyle}"
                                                            Margin="0 6 0 0"
                                                            Visibility="{Binding ShowTrialButton, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Payment History -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                            <StackPanel>
                                <TextBlock Text="Payment History" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 10"/>
                                <DataGrid ItemsSource="{Binding BillingSubscriptionVm.Payments}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Date" Binding="{Binding CreatedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
                                        <DataGridTextColumn Header="Plan" Binding="{Binding PackageCode, Mode=OneWay}" Width="110"/>
                                        <DataGridTextColumn Header="Cycle" Binding="{Binding BillingCycle, Mode=OneWay}" Width="90"/>
                                        <DataGridTextColumn Header="Provider" Binding="{Binding ProviderCode, Mode=OneWay}" Width="100"/>
                                        <DataGridTextColumn Header="Amount" Binding="{Binding Amount, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                                        <DataGridTextColumn Header="Currency" Binding="{Binding Currency, Mode=OneWay}" Width="80"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                        <!-- Invoices -->
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="Invoices" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 10"/>
                                <DataGrid ItemsSource="{Binding BillingSubscriptionVm.Invoices}" AutoGenerateColumns="False" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber, Mode=OneWay}" Width="160"/>
                                        <DataGridTextColumn Header="Issued" Binding="{Binding IssuedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="100"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, Mode=OneWay, StringFormat={}{0:N2}}" Width="100"/>
                                        <DataGridTextColumn Header="Currency" Binding="{Binding Currency, Mode=OneWay}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ── Sales Returns ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=SalesReturns}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Sales Returns" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Search returns, view details, and create a new return from an existing invoice."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home" Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="120" Margin="0 0 10 0"/>
                        <Button Content="↻ Refresh" Command="{Binding SalesReturnsVm.LoadCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" Width="120"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding SalesReturnsVm.Status}" Foreground="{Binding SalesReturnsVm.StatusBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 16">
                            <StackPanel>
                                <DockPanel Margin="0 0 0 10">
                                    <TextBox Text="{Binding SalesReturnsVm.SearchQuery, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0 0 10 0"/>
                                    <Button Content="Search Returns" Command="{Binding SalesReturnsVm.LoadCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="140"/>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding SalesReturnsVm.ReturnsTable.DefaultView}" SelectedItem="{Binding SalesReturnsVm.SelectedReturnRow}"
                                          AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" BorderThickness="0" MaxHeight="240"/>
                                <Button Content="View Detail" Command="{Binding SalesReturnsVm.ViewDetailCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="140" Margin="0 10 0 0" HorizontalAlignment="Left"/>
                                <TextBlock Text="{Binding SalesReturnsVm.DetailText}" TextWrapping="Wrap" Margin="0 10 0 10"/>
                                <DataGrid ItemsSource="{Binding SalesReturnsVm.DetailItemsTable.DefaultView}" AutoGenerateColumns="True" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" MaxHeight="200"/>
                            </StackPanel>
                        </Border>
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Text="New Return" FontSize="16" FontWeight="SemiBold" Margin="0 0 0 10"/>
                                <Button Content="Load Warehouses" Command="{Binding SalesReturnsVm.LoadWarehousesCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="160" HorizontalAlignment="Left" Margin="0 0 0 10"/>
                                <DataGrid ItemsSource="{Binding SalesReturnsVm.WarehousesTable.DefaultView}" AutoGenerateColumns="True" CanUserAddRows="False"
                                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0" MaxHeight="120" Margin="0 0 0 14"/>
                                <DockPanel Margin="0 0 0 10">
                                    <TextBox Text="{Binding SalesReturnsVm.InvoiceSearch, UpdateSourceTrigger=PropertyChanged}" Width="260" Margin="0 0 10 0"/>
                                    <Button Content="Search Invoices" Command="{Binding SalesReturnsVm.SearchInvoicesCommand}" Style="{StaticResource PrimaryButtonStyle}" Width="140"/>
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding SalesReturnsVm.InvoiceSearchResultsTable.DefaultView}" SelectedItem="{Binding SalesReturnsVm.SelectedInvoiceRow}"
                                          AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal" BorderThickness="0" MaxHeight="160" Margin="0 0 0 10"/>
                                <Button Content="Select Invoice / Load Returnable Lines" Command="{Binding SalesReturnsVm.SelectInvoiceCommand}" Style="{StaticResource SecondaryButtonStyle}" Width="260" HorizontalAlignment="Left" Margin="0 0 0 10"/>
                                <TextBlock Margin="0 0 0 10"><Run Text="Selected Invoice ID:"/><Run Text="{Binding SalesReturnsVm.SelectedInvoiceId, Mode=OneWay}"/></TextBlock>
