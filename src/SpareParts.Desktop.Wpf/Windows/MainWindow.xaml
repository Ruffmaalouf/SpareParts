                                <Button Content="Scan" Command="{Binding ArFinderVm.ScanCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0 8 0 0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding ArFinderVm.ResultText}" TextWrapping="Wrap" FontFamily="Consolas"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ── Price Report ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=PriceReport}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Price Report" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Generate a price report for a part across the market."
                                   FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home" Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}" Width="120"/>
                    </StackPanel>
                </DockPanel>
                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status" DockPanel.Dock="Left" FontWeight="SemiBold" Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding PriceReportVm.Status}" Foreground="{Binding PriceReportVm.StatusBrush}" TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14" Margin="0 0 16 0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Generate" FontWeight="SemiBold" Margin="0 0 0 10"/>
                                <TextBlock Text="Part Name" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding PriceReportVm.PartName, UpdateSourceTrigger=PropertyChanged}" Margin="0 2 0 8"/>
                                <TextBlock Text="Make" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding PriceReportVm.Make, UpdateSourceTrigger=PropertyChanged}" Margin="0 2 0 8"/>
                                <TextBlock Text="Model" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding PriceReportVm.Model, UpdateSourceTrigger=PropertyChanged}" Margin="0 2 0 8"/>
                                <TextBlock Text="Year" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBox Text="{Binding PriceReportVm.Year, UpdateSourceTrigger=PropertyChanged}" Margin="0 2 0 8"/>
                                <Button Content="Generate Report" Command="{Binding PriceReportVm.GenerateCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0 8 0 0"/>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="14">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock Text="{Binding PriceReportVm.ResultText}" TextWrapping="Wrap" FontFamily="Consolas"/>
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>

            <!-- ══ MANAGEMENT OVERLAY — ZIndex 20, shown when IsManagementOpen=True ══ -->
            <Grid Panel.ZIndex="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsManagementOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Dim backdrop -->
                <Border Background="#AA000000"/>

                <!-- Panel -->
                <Border Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1 0 0 0"
                        HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel header bar -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0 0 0 1" Padding="20 14">
                            <DockPanel>
                                <TextBlock Text="⚙  Management"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center"
                                           DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding ManagementVm.Status}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="16 0 0 0"
                                           DockPanel.Dock="Left"/>
                                <Button Content="✕  Close"
                                        Command="{Binding OpenManagementCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Padding="16 6"
                                        DockPanel.Dock="Right"/>
                            </DockPanel>
                        </Border>

                        <!-- Management tabs via DataTemplate (defined in Window.Resources above) -->
                        <ContentControl Grid.Row="1"
                                        Content="{Binding ManagementVm}"
                                        Margin="0"/>
                    </Grid>
                </Border>
            </Grid>

            </Grid><!-- end content host (Grid.Row=1) -->
        </Grid><!-- end main content Grid -->

        <!-- ══ GLOBAL DATA LOADING PRELOADER ══ -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="40">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGlobalLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource PreloaderOverlayBrush}"/>

            <Border Width="320"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PreloaderCardBrush}"
                    BorderBrush="{DynamicResource PreloaderBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="0"
                                      Opacity="0.35"
                                      Color="#FF000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Syncing dashboard"
                               HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ProgressBar IsIndeterminate="True"
                                 Height="10"
                                 Margin="0 16 0 0"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="#22000000"/>
                    <TextBlock Text="Fetching latest inventory, pricing, and customer data..."
                               Margin="0 14 0 0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid><!-- end root Grid -->
</Window>
