                                        <TextBlock Text="◉" FontSize="11" Foreground="#FF3A1010" Margin="0 0 10 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Yard Tour" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding GoToInstantOfferCommand}"
                                        Style="{StaticResource NavItemStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◉" FontSize="11" Foreground="#FF3A1010" Margin="0 0 10 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Instant Offer" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding GoToPartInsuranceCommand}"
                                        Style="{StaticResource NavItemStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◉" FontSize="11" Foreground="#FF3A1010" Margin="0 0 10 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Part Insurance" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding GoToKareemCommand}"
                                        Style="{StaticResource NavItemStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◉" FontSize="11" Foreground="#FF3A1010" Margin="0 0 10 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Kareem AI" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding GoToArFinderCommand}"
                                        Style="{StaticResource NavItemStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◉" FontSize="11" Foreground="#FF3A1010" Margin="0 0 10 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="AR Finder" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                                <Button Command="{Binding GoToPriceReportCommand}"
                                        Style="{StaticResource NavItemStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="◉" FontSize="11" Foreground="#FF3A1010" Margin="0 0 10 0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Price Report" FontSize="12"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>

                <!-- Hidden element kept for code-behind mutual-exclusion logic -->
                <ToggleButton x:Name="QuickActionsToggle"
                              Grid.Row="3"
                              Visibility="Collapsed"
                              Checked="SidebarMenuToggle_Checked"/>

                <!-- ══ Bottom footer ════════════════════════════════ -->
                <StackPanel Grid.Row="3" Margin="0 10 0 0" VerticalAlignment="Bottom">

                    <!-- Red racing separator -->
                    <Border Height="1" Margin="0 0 0 10"
                            Background="{DynamicResource RacingStripeBrush}"/>

                    <!-- Status line -->
                    <TextBlock Text="ONLINE · READY"
                               FontSize="9"
                               FontWeight="Bold"
                               Foreground="#FF1A8C3A"
                               Margin="2 0 0 4"/>

                    <!-- Brand Browser Popup -->
                    <Popup Placement="Bottom"
                           VerticalOffset="6"
                           PlacementTarget="{Binding ElementName=BrandsToggle}"
                           IsOpen="{Binding IsChecked, ElementName=BrandsToggle}"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Slide">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="16"
                                Padding="14"
                                Width="360"
                                MaxHeight="580">
                            <StackPanel>
                                <TextBlock Text="Brand Browser"
                                           FontSize="14"
                                           FontWeight="SemiBold"/>
                                <TextBlock Text="Pick a region, then choose the manufacturer."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="0 4 0 12"/>
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              MaxHeight="500">
                                    <ItemsControl ItemsSource="{Binding BrandGroups}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Expander Style="{StaticResource SectionExpanderStyle}"
                                                          Header="{Binding RegionGroup}"
                                                          IsExpanded="False">
                                                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                                                  HorizontalScrollBarVisibility="Disabled"
                                                                  MaxHeight="228">
                                                        <ItemsControl ItemsSource="{Binding Brands}">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel/>
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate>
                                                                    <Button Style="{StaticResource BrandTileStyle}"
                                                                            Click="BrandMenuItem_Click"
                                                                            Command="{Binding DataContext.SelectBrandCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                            CommandParameter="{Binding}"
                                                                            ToolTip="{Binding Name}">
                                                                        <StackPanel VerticalAlignment="Center">
                                                                            <Image Source="{Binding Logo}"
                                                                                   Height="34"
                                                                                   Margin="0 0 0 6"
                                                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                            <TextBlock Text="{Binding Name}"
                                                                                       FontSize="11"
                                                                                       HorizontalAlignment="Center"
                                                                                       TextTrimming="CharacterEllipsis"/>
                                                                        </StackPanel>
                                                                    </Button>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </ScrollViewer>
                                                </Expander>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <!-- Themes Popup -->
                    <Popup Placement="Bottom"
                           VerticalOffset="6"
                           PlacementTarget="{Binding ElementName=ThemesToggle}"
                           IsOpen="{Binding IsChecked, ElementName=ThemesToggle}"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           PopupAnimation="Fade">
                        <Border Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="10"
                                Width="252">
                            <StackPanel>
                                <TextBlock Text="Themes"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="4 2 4 10"/>
                                <ScrollViewer MaxHeight="220"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Themes}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Button Margin="0 0 0 6"
                                                        Click="ThemeMenuItem_Click"
                                                        Command="{Binding DataContext.SelectThemeCommand, ElementName=RootWindow}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Template>
                                                        <ControlTemplate TargetType="Button">
                                                            <Border x:Name="Card"
                                                                    Background="{DynamicResource AppBackgroundBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="12"
                                                                    Padding="10 8">
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="Auto"/>
                                                                    </Grid.ColumnDefinitions>
                                                                    <Ellipse Grid.Column="0"
                                                                             Width="10" Height="10"
                                                                             Fill="{Binding AccentBrush}"
                                                                             VerticalAlignment="Center"
                                                                             Margin="0 0 10 0"/>
                                                                    <StackPanel Grid.Column="1">
                                                                        <TextBlock Text="{Binding Name}"
                                                                                   FontSize="12"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                        <TextBlock Text="{Binding SubTitle}"
                                                                                   FontSize="10"
                                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                                    </StackPanel>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="✓"
                                                                               FontSize="12"
                                                                               Foreground="{DynamicResource AccentBrush}"
                                                                               Visibility="{Binding IsSelected, Converter={StaticResource BoolToVis}}"
                                                                               VerticalAlignment="Center"
                                                                               Margin="6 0 0 0"/>
                                                                </Grid>
                                                            </Border>
                                                            <ControlTemplate.Triggers>
                                                                <Trigger Property="IsMouseOver" Value="True">
                                                                    <Setter TargetName="Card" Property="Background" Value="#0DFFFFFF"/>
                                                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                                </Trigger>
                                                            </ControlTemplate.Triggers>
                                                        </ControlTemplate>
                                                    </Button.Template>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>

                    <TextBlock Text="{Binding Source={x:Static sys:DateTime.Now}, StringFormat='{}{0:D}'}"
                               FontSize="10"
                               Foreground="#FF383838"
                               HorizontalAlignment="Right"
                               Margin="0 4 4 0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ══ MAIN CONTENT AREA ══════════════════════════════════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ══ TOP COMMAND BAR ══════════════════════════════════════ -->
            <Border Grid.Row="0"
                    Background="#FF0A0A0A"
                    BorderBrush="#FF1A1A1A"
                    BorderThickness="0 0 0 1"
                    Panel.ZIndex="15">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="3"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Red hairline along the very top -->
                    <Border Grid.Row="0" Background="{DynamicResource RacingStripeBrush}"/>

                    <DockPanel Grid.Row="1" Height="64" Margin="18 0" LastChildFill="False">

                        <!-- Reveal-sidebar button (visible only when collapsed) -->
                        <Button x:Name="ShowSidebarButton"
                                DockPanel.Dock="Left"
                                Click="ShowSidebarButton_Click"
                                Style="{StaticResource SidebarToggleButtonStyle}"
                                Width="40" Height="40"
                                VerticalAlignment="Center"
                                Margin="0 0 14 0"
                                ToolTip="Show navigation panel"
                                Visibility="Collapsed"
                                Opacity="0">
                            <TextBlock Text="☰"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>

                        <!-- Context label -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="5" Height="24" CornerRadius="2"
                                    Background="{DynamicResource AccentBrush}" Margin="0 0 12 0"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="WORKSPACE"
                                           FontSize="9" FontWeight="Bold"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="Maalouf Auto Parts"
                                           FontSize="15" FontWeight="Bold"
                                           Foreground="#FFEBEBEB"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Right-aligned global actions -->
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding CreateInvoiceCommand}"
                                    Style="{StaticResource TopBarPrimaryStyle}"
                                    Visibility="{Binding CanCreateInvoice, Converter={StaticResource BoolToVis}}"
                                    Content="＋  New Invoice"/>
                            <Button Command="{Binding OpenInvoiceSearchCommand}"
                                    Style="{StaticResource TopBarButtonStyle}"
                                    Visibility="{Binding CanViewInvoiceSearch, Converter={StaticResource BoolToVis}}"
                                    Content="🔎  Invoices"/>
                            <Button Command="{Binding OpenManagementCommand}"
                                    Style="{StaticResource TopBarButtonStyle}"
                                    Visibility="{Binding CanViewManagementScreen, Converter={StaticResource BoolToVis}}"
                                    Content="⚙  Management"/>

                            <Border Width="1" Height="24" Background="#FF242424"
                                    Margin="4 0 12 0" VerticalAlignment="Center"/>

                            <ToggleButton x:Name="BrandsToggle"
                                          Style="{StaticResource TopBarToggleStyle}"
                                          Checked="SidebarMenuToggle_Checked"
                                          Content="🏷  Brands"/>
                            <ToggleButton x:Name="ThemesToggle"
                                          Style="{StaticResource TopBarToggleStyle}"
                                          Checked="SidebarMenuToggle_Checked"
                                          Margin="0"
                                          Content="◐  Theme"/>
                        </StackPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!-- ══ CONTENT HOST — all screens overlap here ══════════════ -->
            <Grid Grid.Row="1">

            <!-- ── Home Page ── -->
            <Grid Margin="5,0,40,10"
                  Background="{DynamicResource AppBackgroundBrush}"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=HomePage}">
                <local:OwnerCockpitDashboardControl DataContext="{Binding OwnerCockpitVm}"/>
            </Grid>

            <!-- ── Accounting ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=Accounting}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Accounting Review" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Review journal activity, inspect posted entries, and monitor ledger and trial balance results."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"
                                Margin="0 0 10 0"/>
                        <Button Content="↻ Refresh"
                                Command="{Binding ManagementVm.AccountingVm.LoadReviewCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"
                                Margin="0 0 10 0"/>
                        <Button Content="Manual Journal"
                                Command="{Binding GoToManualJournalCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanViewManualJournalScreen, Converter={StaticResource BoolToVis}}"
                                Width="150"
                                Margin="0 0 10 0"/>
                        <Button Content="Open Management"
                                Command="{Binding OpenManagementCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding CanViewManagementScreen, Converter={StaticResource BoolToVis}}"
                                Width="170"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status"
                                   DockPanel.Dock="Left"
                                   FontWeight="SemiBold"
                                   Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding ManagementVm.AccountingVm.Status}"
                                   Foreground="{Binding ManagementVm.AccountingVm.StatusBrush}"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <local:AccountingWorkspaceControl Grid.Row="2"
                                                 DataContext="{Binding ManagementVm.AccountingVm}"/>

                <Grid Grid.Row="2"
                      Visibility="Collapsed"
                      DataContext="{x:Null}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="18" Margin="0 0 0 12">
                            <StackPanel>
                                <TextBlock Text="Posting Rules" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="{Binding ManagementVm.AccountingPostingSummary}"
                                           Margin="0 6 0 14"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <ItemsControl ItemsSource="{Binding ManagementVm.AccountingPostingRules}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AppBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12"
                                                    Margin="0 0 0 10">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Area}" FontSize="15" FontWeight="SemiBold" DockPanel.Dock="Left"/>
                                                        <TextBlock Text="{Binding Trigger}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" DockPanel.Dock="Right"/>
                                                    </DockPanel>
                                                    <TextBlock Margin="0 8 0 0"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap">
                                                        <Run Text="Debit: "/>
                                                        <Run Text="{Binding DebitAccounts}"/>
                                                    </TextBlock>
                                                    <TextBlock Margin="0 4 0 0"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap">
                                                        <Run Text="Credit: "/>
                                                        <Run Text="{Binding CreditAccounts}"/>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Notes}"
                                                               Margin="0 8 0 0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource CardBackgroundBrush}" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <TextBlock Text="Configured Posting Accounts" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="These are the key accounts the current application configuration points to."
                                           Margin="0 6 0 14"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <ItemsControl ItemsSource="{Binding ManagementVm.ConfiguredAccountingAccounts}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource AppBackgroundBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="10"
                                                    Padding="12"
                                                    Margin="0 0 0 10">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Left">
                                                            <TextBlock Text="{Binding Code}" FontWeight="Bold"/>
                                                            <TextBlock Text="{Binding Name}" Margin="0 4 0 0"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding PostingRoleLabel}"
                                                                   DockPanel.Dock="Right"
                                                                   Foreground="{DynamicResource AccentBrush}"
                                                                   FontSize="11"
                                                                   VerticalAlignment="Top"/>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding UsageSummary}"
                                                               Margin="0 8 0 0"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Selected Account" FontSize="16" FontWeight="SemiBold" Margin="0 6 0 6"/>
                                <TextBlock Text="{Binding ManagementVm.SelectedAccountingAccountTitle}" FontWeight="Bold" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding ManagementVm.SelectedAccountingAccountRole}"
                                           Margin="0 6 0 0"
                                           Foreground="{DynamicResource AccentBrush}"/>
                                <TextBlock Text="{Binding ManagementVm.SelectedAccountingAccountUsage}"
                                           Margin="0 8 0 0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Margin="0 8 0 0"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="Parent: "/>
                                    <Run Text="{Binding ManagementVm.SelectedAccountingAccountParent, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="2"
                            Background="{DynamicResource CardBackgroundBrush}"
                            CornerRadius="12"
                            Padding="18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel Grid.Row="0" Margin="0 0 0 14">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Chart of Accounts" FontSize="18" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding ManagementVm.AccountingChartSummary}"
                                               Margin="0 6 0 0"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                            </DockPanel>

                            <DataGrid Grid.Row="1"
                                      ItemsSource="{Binding ManagementVm.AccountingAccounts}"
                                      SelectedItem="{Binding ManagementVm.SelectedAccountingAccount, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      CanUserResizeRows="False"
                                      IsReadOnly="True"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HeadersVisibility="Column"
                                      BorderThickness="0"
                                      GridLinesVisibility="Horizontal"
                                      ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Binding="{Binding Id, Mode=OneWay}" Width="55"/>
                                    <DataGridTextColumn Header="Code" Binding="{Binding Code, Mode=OneWay}" Width="90"/>
                                    <DataGridTextColumn Header="Account" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Type" Binding="{Binding AccountType, Mode=OneWay}" Width="120"/>
                                    <DataGridTextColumn Header="Parent" Binding="{Binding ParentDisplay, Mode=OneWay}" Width="80"/>
                                    <DataGridCheckBoxColumn Header="Configured" Binding="{Binding IsConfiguredPostingAccount, Mode=OneWay}" Width="90"/>
                                    <DataGridTextColumn Header="Role" Binding="{Binding PostingRoleLabel, Mode=OneWay}" Width="180"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ── Manual Journal ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=ManualJournal}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="720">
                        <TextBlock Text="Manual Journal" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Post standalone journal entries with dedicated access control, separate from chart setup and reporting."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"
                                Margin="0 0 10 0"/>
                        <Button Content="↻ Refresh"
                                Command="{Binding ManagementVm.AccountingVm.LoadManualJournalCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"
                                Margin="0 0 10 0"/>
                        <Button Content="Open Accounting"
                                Command="{Binding GoToAccountingCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanViewAccountingScreen, Converter={StaticResource BoolToVis}}"
                                Width="150"
                                Margin="0 0 10 0"/>
                        <Button Content="Open Management"
                                Command="{Binding OpenManagementCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Visibility="{Binding CanViewManagementScreen, Converter={StaticResource BoolToVis}}"
                                Width="170"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status"
                                   DockPanel.Dock="Left"
                                   FontWeight="SemiBold"
                                   Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding ManagementVm.AccountingVm.Status}"
                                   Foreground="{Binding ManagementVm.AccountingVm.StatusBrush}"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <local:ManualJournalPostingControl Grid.Row="2"
                                                  DataContext="{Binding ManagementVm.AccountingVm}"/>
            </Grid>

            <!-- ── Report Builder ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=ReportBuilder}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 12">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="760">
                        <TextBlock Text="Report Builder" FontSize="19" FontWeight="Bold"/>
                        <TextBlock Text="Build custom reports from live database tables and preview them in a dedicated viewer with export options."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"
                                Margin="0 0 10 0"/>
                        <Button Content="Refresh Schema"
                                Command="{Binding ReportBuilderVm.LoadMetadataCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="150"
                                Margin="0 0 10 0"/>
                        <Button Content="Run Report"
                                Command="{Binding ReportBuilderVm.RunReportCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="130"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status"
                                   DockPanel.Dock="Left"
                                   FontWeight="SemiBold"
                                   Margin="0 0 12 0"/>
                        <TextBlock Text="{Binding ReportBuilderVm.Status}"
                                   Foreground="{Binding ReportBuilderVm.StatusBrush}"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <local:ReportBuilderControl Grid.Row="2"
                                            DataContext="{Binding ReportBuilderVm}"/>
            </Grid>

