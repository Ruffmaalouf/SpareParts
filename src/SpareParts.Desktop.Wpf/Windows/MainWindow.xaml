                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding PurchasesVm.RecentPurchases}"
                                  SelectedItem="{Binding PurchasesVm.SelectedRecentPurchase, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Margin="0 0 0 18">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Purchase #"
                                                    Binding="{Binding PurchaseNumber, Mode=OneWay}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Date"
                                                    Binding="{Binding PurchaseDate, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}"
                                                    Width="105"/>
                                <DataGridTextColumn Header="Used Car"
                                                    Binding="{Binding UsedCar, Mode=OneWay}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Supplier"
                                                    Binding="{Binding SupplierName, Mode=OneWay}"
                                                    Width="160"/>
                                <DataGridTextColumn Header="Base"
                                                    Binding="{Binding BaseCurrencyCode, Mode=OneWay}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Counter"
                                                    Binding="{Binding CounterCurrencyCode, Mode=OneWay}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Total Base"
                                                    Binding="{Binding TotalBaseAmount, Mode=OneWay, StringFormat={}{0:N4}}"
                                                    Width="105"/>
                                <DataGridTextColumn Header="Total Counter"
                                                    Binding="{Binding TotalCounterAmount, Mode=OneWay, StringFormat={}{0:N4}}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Paid Base"
                                                    Binding="{Binding PaidAmount, Mode=OneWay, StringFormat={}{0:N4}}"
                                                    Width="95"/>
                                <DataGridTextColumn Header="Paid Counter"
                                                    Binding="{Binding PaidCounterAmount, Mode=OneWay, StringFormat={}{0:N4}}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Lines"
                                                    Binding="{Binding LineCount, Mode=OneWay}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Payment"
                                                    Binding="{Binding PaymentStatus, Mode=OneWay}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="Posting"
                                                    Binding="{Binding PostingStatus, Mode=OneWay}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="Posted At"
                                                    Binding="{Binding PostedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                    Width="145"/>
                            </DataGrid.Columns>
                        </DataGrid>

