                                               Margin="0 6 0 0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <Border Grid.Row="2"
                                        Margin="0 0 0 12"
                                        Padding="12"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding PurchasesVm.HasSelectedPurchaseTimeline, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel Margin="0 0 0 10">
                                            <TextBlock Text="Auto Posting Timeline"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding PurchasesVm.SelectedPurchaseDetail.PurchaseNumber}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding PurchasesVm.SelectedPurchaseDetail.Timeline}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="198"
                                                            MinHeight="110"
                                                            Margin="0 0 10 10"
                                                            Padding="11"
                                                            Background="{DynamicResource AppBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <DockPanel Grid.Row="0">
                                                                <Border x:Name="StepDot"
                                                                        Width="22"
                                                                        Height="22"
                                                                        CornerRadius="11"
                                                                        Background="#FF757575"
                                                                        DockPanel.Dock="Left">
                                                                    <TextBlock Text="{Binding Sequence}"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock x:Name="StatusText"
                                                                           Text="{Binding Status}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           DockPanel.Dock="Right"/>
                                                            </DockPanel>
                                                            <TextBlock Grid.Row="1"
                                                                       Text="{Binding Title}"
                                                                       Margin="0 8 0 0"
                                                                       FontWeight="Bold"/>
                                                            <TextBlock Grid.Row="2"
                                                                       Text="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Grid.Row="3"
                                                                       Text="{Binding Detail}"
                                                                       Margin="0 7 0 0"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                            <Setter TargetName="StepDot" Property="Background" Value="#FF4CAF50"/>
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="#FF81C784"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                            <Setter TargetName="StepDot" Property="Background" Value="#FFFFA000"/>
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="#FFFFCC80"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <DataGrid Grid.Row="3"
                                          ItemsSource="{Binding PurchasesVm.SelectedPurchaseDetail.Lines}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#"
                                                            Binding="{Binding SortOrder, Mode=OneWay}"
