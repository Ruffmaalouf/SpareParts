                                        <DataGridTextColumn Header="Account Name"
                                                            Binding="{Binding AccountName, Mode=OneWay}"
                                                            Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

