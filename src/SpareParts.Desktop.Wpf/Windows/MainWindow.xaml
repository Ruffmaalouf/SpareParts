                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=BusinessAssistant}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left" MaxWidth="760">
                        <TextBlock Text="AI Business Assistant" FontSize="30" FontWeight="Bold"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"
                                Margin="0 0 10 0"/>
                        <Button Content="Report Builder"
                                Command="{Binding GoToReportBuilderCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Visibility="{Binding CanViewReportBuilderScreen, Converter={StaticResource BoolToVis}}"
                                Width="150"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="Status"
                                   DockPanel.Dock="Left"
                                   FontWeight="SemiBold"
                                   Margin="0 0 12 0"/>
                        <ProgressBar DockPanel.Dock="Right"
                                     Width="180"
                                     Height="8"
                                     IsIndeterminate="True"
                                     Visibility="{Binding BusinessAssistantVm.IsLoading, Converter={StaticResource BoolToVis}}"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Background="#22000000"
                                     VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding BusinessAssistantVm.Status}"
                                   Foreground="{Binding BusinessAssistantVm.StatusBrush}"
                                   TextWrapping="Wrap"/>
                    </DockPanel>
                </Border>

                <local:BusinessAssistantControl Grid.Row="2"
                                                DataContext="{Binding BusinessAssistantVm}"/>
            </Grid>

            <!-- ── Part Purchases ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=PartPurchases}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Part Purchases" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Search, create, and edit supplier purchases using the same unified transaction flow as sales."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120" Margin="0 0 10 0"/>
                        <Button Content="Used Car Purchases"
                                Command="{Binding GoToUsedCarPurchasesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="170" Margin="0 0 10 0"/>
                        <Button Content="Open POS"
                                Command="{Binding GoToPosCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="120"/>
                    </StackPanel>
                </DockPanel>

                <local:PartPurchasesControl Grid.Row="1"
                                            DataContext="{Binding PartPurchasesVm}"/>
            </Grid>

            <!-- ── Used Car Purchases ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=Purchases}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Used Car Purchases" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Received used cars sync to linked purchase drafts here. Review the draft, then post it from Used Car Purchase History."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120" Margin="0 0 10 0"/>
                        <Button Content="Part Purchases"
                                Command="{Binding GoToPurchasesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="150" Margin="0 0 10 0"/>
                        <Button Content="Used Car History"
                                Command="{Binding GoToPurchaseHistoryCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="160" Margin="0 0 10 0"/>
                        <Button Content="Wholesale"
                                Command="{Binding GoToUsedCarWholesaleCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="130" Margin="0 0 10 0"/>
                        <Button Content="Stock Arrival"
                                Command="{Binding GoToStockArrivalCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="150" Margin="0 0 10 0"/>
                        <Button Content="Repair / Prep"
                                Command="{Binding GoToRepairPrepCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="140" Margin="0 0 10 0"/>
                        <Button Content="Open POS"
                                Command="{Binding GoToPosCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="120"/>
                    </StackPanel>
                </DockPanel>

                <local:UsedCarPurchasesControl Grid.Row="1"
                                               DataContext="{Binding PurchasesVm}"/>
            </Grid>

            <!-- ── Used Car Wholesale ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=UsedCarWholesale}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Used Car Wholesale" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Sell a complete used car as-is, record the buyer, price, paid amount, and acknowledgement."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Used Car Purchases"
                                Command="{Binding GoToUsedCarPurchasesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="180" Margin="0 0 10 0"/>
                        <Button Content="Repair / Prep"
                                Command="{Binding GoToRepairPrepCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="140" Margin="0 0 10 0"/>
                        <Button Content="Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"/>
                    </StackPanel>
                </DockPanel>

                <local:UsedCarWholesaleControl Grid.Row="1"
                                               DataContext="{Binding UsedCarWholesaleVm}"/>
            </Grid>

            <!-- ── Used Car Purchase History ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=PurchaseHistory}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Used Car Purchase History" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Load saved purchases from the purchase table, post drafts, and delete mistakes."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Used Car Purchases"
                                Command="{Binding GoToUsedCarPurchasesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="180" Margin="0 0 10 0"/>
                        <Button Content="⟵ Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1"
                        Background="{DynamicResource CardBackgroundBrush}"
                        CornerRadius="12"
                        Padding="14"
                        Margin="0 0 0 20">
                    <DockPanel>
                        <TextBlock Text="{Binding PurchasesVm.Status}"
                                   Foreground="{Binding PurchasesVm.StatusBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>
                        <TextBlock Text="{Binding PurchasesVm.ScreenSummary}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Right"/>
                    </DockPanel>
                </Border>

                <Border Grid.Row="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0 0 0 12">
                            <StackPanel DockPanel.Dock="Left">
                                <TextBlock Text="Saved Purchases"
                                           FontSize="18"
                                           FontWeight="Bold"/>
                                <TextBlock Text="Select a row to load its saved lines, post the draft, or delete the purchase."
                                           Margin="0 4 0 0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Right"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right">
                                <Button Content="↻ Refresh"
                                        Command="{Binding PurchasesVm.LoadCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="120"
                                        Margin="0 0 10 0"/>
                                <Button Content="✓ Post Selected"
                                        Command="{Binding PurchasesVm.PostSelectedPurchaseCommand}"
                                        IsEnabled="{Binding PurchasesVm.CanPostSelectedPurchase}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="150"
                                        Margin="0 0 10 0"/>
                                <Button Content="🗑 Delete Selected"
                                        Command="{Binding PurchasesVm.DeleteSelectedPurchaseCommand}"
                                        IsEnabled="{Binding PurchasesVm.CanDeleteSelectedPurchase}"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        Width="160"/>
                            </StackPanel>
                        </DockPanel>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding PurchasesVm.RecentPurchases}"
                                  SelectedItem="{Binding PurchasesVm.SelectedRecentPurchase, Mode=TwoWay}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  GridLinesVisibility="Horizontal"
                                  BorderThickness="0"
                                  Margin="0 0 0 18">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Purchase #"
                                                    Binding="{Binding PurchaseNumber, Mode=OneWay}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Date"
                                                    Binding="{Binding PurchaseDate, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}"
                                                    Width="105"/>
                                <DataGridTextColumn Header="Used Car"
                                                    Binding="{Binding UsedCar, Mode=OneWay}"
                                                    Width="*"/>
                                <DataGridTextColumn Header="Supplier"
                                                    Binding="{Binding SupplierName, Mode=OneWay}"
                                                    Width="160"/>
                                <DataGridTextColumn Header="Base"
                                                    Binding="{Binding BaseCurrencyCode, Mode=OneWay}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Counter"
                                                    Binding="{Binding CounterCurrencyCode, Mode=OneWay}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Total Base"
                                                    Binding="{Binding TotalBaseAmount, Mode=OneWay, StringFormat={}{0:N4}}"
                                                    Width="105"/>
                                <DataGridTextColumn Header="Total Counter"
                                                    Binding="{Binding TotalCounterAmount, Mode=OneWay, StringFormat={}{0:N4}}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Paid Base"
                                                    Binding="{Binding PaidAmount, Mode=OneWay, StringFormat={}{0:N4}}"
                                                    Width="95"/>
                                <DataGridTextColumn Header="Paid Counter"
                                                    Binding="{Binding PaidCounterAmount, Mode=OneWay, StringFormat={}{0:N4}}"
                                                    Width="110"/>
                                <DataGridTextColumn Header="Lines"
                                                    Binding="{Binding LineCount, Mode=OneWay}"
                                                    Width="70"/>
                                <DataGridTextColumn Header="Payment"
                                                    Binding="{Binding PaymentStatus, Mode=OneWay}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="Posting"
                                                    Binding="{Binding PostingStatus, Mode=OneWay}"
                                                    Width="90"/>
                                <DataGridTextColumn Header="Posted At"
                                                    Binding="{Binding PostedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                    Width="145"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Grid.Row="2"
                                Padding="12"
                                Background="{DynamicResource AppBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                VerticalAlignment="Stretch">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Text="Purchase Lines"
                                           FontSize="17"
                                           FontWeight="Bold"/>

                                <StackPanel Grid.Row="1"
                                            Margin="0 8 0 12">
                                    <TextBlock Text="{Binding PurchasesVm.SelectedPurchaseDetailSummary}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <TextBlock Text="{Binding PurchasesVm.SelectedPurchaseNotes}"
                                               Margin="0 6 0 0"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>

                                <Border Grid.Row="2"
                                        Margin="0 0 0 12"
                                        Padding="12"
                                        Background="{DynamicResource CardBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Visibility="{Binding PurchasesVm.HasSelectedPurchaseTimeline, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <DockPanel Margin="0 0 0 10">
                                            <TextBlock Text="Auto Posting Timeline"
                                                       FontSize="16"
                                                       FontWeight="Bold"
                                                       DockPanel.Dock="Left"/>
                                            <TextBlock Text="{Binding PurchasesVm.SelectedPurchaseDetail.PurchaseNumber}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       DockPanel.Dock="Right"/>
                                        </DockPanel>
                                        <ItemsControl ItemsSource="{Binding PurchasesVm.SelectedPurchaseDetail.Timeline}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Width="198"
                                                            MinHeight="110"
                                                            Margin="0 0 10 10"
                                                            Padding="11"
                                                            Background="{DynamicResource AppBackgroundBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8">
                                                        <Grid>
                                                            <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                            </Grid.RowDefinitions>
                                                            <DockPanel Grid.Row="0">
                                                                <Border x:Name="StepDot"
                                                                        Width="22"
                                                                        Height="22"
                                                                        CornerRadius="11"
                                                                        Background="#FF757575"
                                                                        DockPanel.Dock="Left">
                                                                    <TextBlock Text="{Binding Sequence}"
                                                                               FontSize="11"
                                                                               FontWeight="Bold"
                                                                               Foreground="White"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                                <TextBlock x:Name="StatusText"
                                                                           Text="{Binding Status}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                                           DockPanel.Dock="Right"/>
                                                            </DockPanel>
                                                            <TextBlock Grid.Row="1"
                                                                       Text="{Binding Title}"
                                                                       Margin="0 8 0 0"
                                                                       FontWeight="Bold"/>
                                                            <TextBlock Grid.Row="2"
                                                                       Text="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            <TextBlock Grid.Row="3"
                                                                       Text="{Binding Detail}"
                                                                       Margin="0 7 0 0"
                                                                       FontSize="11"
                                                                       TextWrapping="Wrap"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        </Grid>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                            <Setter TargetName="StepDot" Property="Background" Value="#FF4CAF50"/>
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="#FF81C784"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                            <Setter TargetName="StepDot" Property="Background" Value="#FFFFA000"/>
                                                            <Setter TargetName="StatusText" Property="Foreground" Value="#FFFFCC80"/>
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <DataGrid Grid.Row="3"
                                          ItemsSource="{Binding PurchasesVm.SelectedPurchaseDetail.Lines}"
                                          AutoGenerateColumns="False"
                                          IsReadOnly="True"
                                          CanUserAddRows="False"
                                          HeadersVisibility="Column"
                                          GridLinesVisibility="Horizontal"
                                          BorderThickness="0">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="#"
                                                            Binding="{Binding SortOrder, Mode=OneWay}"
                                                            Width="45"/>
                                        <DataGridTextColumn Header="Detail"
                                                            Binding="{Binding Description, Mode=OneWay}"
                                                            Width="170"/>
                                        <DataGridTextColumn Header="Amount"
                                                            Binding="{Binding Amount, Mode=OneWay, StringFormat={}{0:N4}}"
                                                            Width="110"/>
                                        <DataGridTextColumn Header="Currency"
                                                            Binding="{Binding CurrencyCode, Mode=OneWay}"
                                                            Width="90"/>
                                        <DataGridTextColumn Header="Rate"
                                                            Binding="{Binding RateToBase, Mode=OneWay, StringFormat={}{0:N8}}"
                                                            Width="110"/>
                                        <DataGridTextColumn Header="Base"
                                                            Binding="{Binding BaseAmount, Mode=OneWay, StringFormat={}{0:N4}}"
                                                            Width="110"/>
                                        <DataGridTextColumn Header="Counter"
                                                            Binding="{Binding CounterAmount, Mode=OneWay, StringFormat={}{0:N4}}"
                                                            Width="110"/>
                                        <DataGridTextColumn Header="Account"
                                                            Binding="{Binding AccountCode, Mode=OneWay}"
                                                            Width="100"/>
                                        <DataGridTextColumn Header="Account Name"
                                                            Binding="{Binding AccountName, Mode=OneWay}"
                                                            Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>

            <!-- ── Stock Arrival Theater ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=StockArrivalTheater}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Stock Arrival Theater" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="When inventory lands, turn it into photos, customer follow-ups, campaigns, and pricing work."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Part Purchases"
                                Command="{Binding GoToPurchasesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="150" Margin="0 0 10 0"/>
                        <Button Content="Used Car Purchases"
                                Command="{Binding GoToUsedCarPurchasesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="180" Margin="0 0 10 0"/>
                        <Button Content="Repair / Prep"
                                Command="{Binding GoToRepairPrepCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="140" Margin="0 0 10 0"/>
                        <Button Content="Open Stock"
                                Command="{Binding GoToStockManagementCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="130" Margin="0 0 10 0"/>
                        <Button Content="WhatsApp"
                                Command="{Binding GoToWhatsAppCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="120"/>
                    </StackPanel>
                </DockPanel>

                <local:StockArrivalTheaterControl Grid.Row="1"
                                                  DataContext="{Binding StockArrivalVm}"/>
            </Grid>

            <!-- ── Repair / Prep Board ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=RepairPrepBoard}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Repair / Prep Board" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Track bought cars through inspection, parts, repair, photos, listing, and sale."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Used Car Purchases"
                                Command="{Binding GoToUsedCarPurchasesCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="180" Margin="0 0 10 0"/>
                        <Button Content="Stock Arrival"
                                Command="{Binding GoToStockArrivalCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="150" Margin="0 0 10 0"/>
                        <Button Content="⟵ Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"/>
                    </StackPanel>
                </DockPanel>

                <local:RepairPrepBoardControl Grid.Row="1"
                                              DataContext="{Binding RepairPrepVm}"/>
            </Grid>

            <!-- ── Stock Management ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=StockManagement}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Stock Management" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Monitor stock levels and replenish low inventory."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="⟵ Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120" Margin="0 0 10 0"/>
                        <Button Content="Refresh Stock"
                                Command="{Binding GoToStockManagementCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="140" Margin="0 0 10 0"/>
                        <Button Content="Open Part Purchases"
                                Command="{Binding GoToPurchasesCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="170"
                                Margin="0 0 10 0"/>
                        <Button Content="Stock Arrival"
                                Command="{Binding GoToStockArrivalCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="150"
                                Margin="0 0 10 0"/>
                        <Button Content="Dead Stock"
                                Command="{Binding GoToDeadStockCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="170"/>
                    </StackPanel>
                </DockPanel>

                <Border Grid.Row="1" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="12">
                    <DataGrid ItemsSource="{Binding StockSnapshots}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="True"
                              HeadersVisibility="Column"
                              GridLinesVisibility="Horizontal">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Part Code" Binding="{Binding PartCode, Mode=OneWay}" Width="140"/>
                            <DataGridTextColumn Header="Part Name" Binding="{Binding PartName, Mode=OneWay}" Width="*"/>
                            <DataGridTextColumn Header="Warehouse" Binding="{Binding Warehouse, Mode=OneWay}" Width="220"/>
                            <DataGridTextColumn Header="On Hand" Binding="{Binding OnHand, Mode=OneWay}" Width="100"/>
                            <DataGridTextColumn Header="Available" Binding="{Binding Available, Mode=OneWay}" Width="100"/>
                            <DataGridTextColumn Header="Min Stock" Binding="{Binding MinStock, Mode=OneWay}" Width="100"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status, Mode=OneWay}" Width="120"/>
                            <DataGridTextColumn Header="Smart Pricing Coach" Binding="{Binding PricingCoachMessage, Mode=OneWay}" Width="320"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>

            <!-- ── Dead Stock Resurrection ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=DeadStockResurrection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Dead Stock Resurrection Mode" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Find stale inventory and choose the recovery action with the best odds."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"
                                Margin="0 0 10 0"/>
                        <Button Content="Open Stock"
                                Command="{Binding GoToStockManagementCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="130"
                                Margin="0 0 10 0"/>
                        <Button Content="Refresh"
                                Command="{Binding DeadStockVm.RefreshCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="120"/>
                    </StackPanel>
                </DockPanel>

                <local:DeadStockResurrectionControl Grid.Row="1"
                                                     DataContext="{Binding DeadStockVm}"/>
            </Grid>

            <!-- Money Finder Lab -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=GrowthLab}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Money Finder Lab" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Turn stock, donor cars, part requests, and auction listings into the next profitable action."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="110"
                                Margin="0 0 10 0"/>
                        <Button Content="Stock"
                                Command="{Binding GoToStockManagementCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="110"
                                Margin="0 0 10 0"/>
                        <Button Content="Part Requests"
                                Command="{Binding OpenManagementCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="135"
                                Margin="0 0 10 0"/>
                        <Button Content="Refresh"
                                Command="{Binding GrowthLabVm.RefreshCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="110"/>
                    </StackPanel>
                </DockPanel>

                <local:GrowthLabControl Grid.Row="1"
                                        DataContext="{Binding GrowthLabVm}"/>
            </Grid>

            <!-- Part Passport -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=PartPassport}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Part Passport" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Choose a part, review its customer-facing proof card, and prepare a WhatsApp-ready public link."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">
                        <Button Content="Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="110"
                                Margin="0 0 10 0"/>
                        <Button Content="Stock"
                                Command="{Binding GoToStockManagementCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="110"
                                Margin="0 0 10 0"/>
                        <Button Content="Refresh"
                                Command="{Binding PartPassportVm.RefreshCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="110"/>
                    </StackPanel>
                </DockPanel>

                <local:PartPassportControl Grid.Row="1"
                                           DataContext="{Binding PartPassportVm}"/>
            </Grid>

            <!-- ── Part Compatibility Graph ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=PartCompatibility}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="Part Compatibility Graph" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="See which parts fit the same cars, models, and years."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120" Margin="0 0 10 0"/>
                        <Button Content="Open Stock"
                                Command="{Binding GoToStockManagementCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="140"/>
                    </StackPanel>
                </DockPanel>

                <local:PartCompatibilityControl Grid.Row="1"
                                                DataContext="{Binding PartCompatibilityVm}"/>
            </Grid>

            <!-- ── Barcode / QR Mode ── -->
            <Grid Margin="20"
                  Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=BarcodeMode}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" Margin="0 0 0 20">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="AR Picture Search" FontSize="30" FontWeight="Bold"/>
                        <TextBlock Text="Search parts by picture, resolve scans, sell parts, move warehouse stock, and link parts to used cars."
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Home"
                                Command="{Binding GoToHomeCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"
                                Margin="0 0 10 0"/>
                        <Button Content="Refresh"
                                Command="{Binding BarcodeModeVm.LoadCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Width="120"
                                Margin="0 0 10 0"/>
                        <Button Content="Print Labels"
                                Command="{Binding BarcodeModeVm.PrintLabelsCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Width="140"/>
                    </StackPanel>
                </DockPanel>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.15*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="1.1*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="0.95*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Parts" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BarcodeModeVm.SelectedPartSummary}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0 4 0 0"/>
                            </StackPanel>

                            <TextBox Grid.Row="1"
                                     Text="{Binding BarcodeModeVm.PartFilterText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="38"
                                     Margin="0 14 0 10"
                                     Padding="10 0"
                                     VerticalContentAlignment="Center"/>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding BarcodeModeVm.Parts}"
                                      SelectedItem="{Binding BarcodeModeVm.SelectedPart, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Code" Binding="{Binding InternalCode, Mode=OneWay}" Width="110"/>
                                    <DataGridTextColumn Header="Name" Binding="{Binding Name, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Barcode" Binding="{Binding Barcode, Mode=OneWay}" Width="120"/>
                                    <DataGridTextColumn Header="Avail" Binding="{Binding AvailableQuantity, Mode=OneWay}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <UniformGrid Grid.Row="3" Columns="2" Margin="0 12 0 0">
                                <Button Content="Generate Selected"
                                        Command="{Binding BarcodeModeVm.GenerateSelectedLabelCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="0 0 6 0"/>
                                <Button Content="Generate Visible"
                                        Command="{Binding BarcodeModeVm.GenerateVisibleLabelsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Margin="6 0 0 0"/>
                            </UniformGrid>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="150"/>
                                <RowDefinition Height="145"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="Scan" FontSize="20" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding BarcodeModeVm.StatusMessage}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0 4 0 0"/>
                            </StackPanel>

                            <Grid Grid.Row="1" Margin="0 14 0 10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="BarcodeScanBox"
                                         Text="{Binding BarcodeModeVm.ScanText, UpdateSourceTrigger=PropertyChanged}"
                                         Height="38"
                                         Padding="10 0"
                                         VerticalContentAlignment="Center"
                                         KeyDown="BarcodeScanBox_KeyDown"/>
                                <Button Grid.Column="2"
                                        Content="Resolve"
                                        Command="{Binding BarcodeModeVm.ResolveScanCommand}"
                                        Style="{StaticResource PrimaryButtonStyle}"/>
                            </Grid>

                            <DataGrid Grid.Row="2"
                                      ItemsSource="{Binding BarcodeModeVm.ScanResults}"
                                      SelectedItem="{Binding BarcodeModeVm.SelectedScanResult, Mode=TwoWay}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding TargetType, Mode=OneWay}" Width="95"/>
                                    <DataGridTextColumn Header="Result" Binding="{Binding DisplayText, Mode=OneWay}" Width="*"/>
                                    <DataGridTemplateColumn Header="" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="Use"
                                                        Command="{Binding DataContext.BarcodeModeVm.SelectScanResultCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource SecondaryButtonStyle}"
                                                        Padding="8 2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <DataGrid Grid.Row="3"
                                      ItemsSource="{Binding BarcodeModeVm.StockRows}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="True"
                                      HeadersVisibility="Column"
                                      GridLinesVisibility="Horizontal"
                                      Margin="0 10 0 0">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseName, Mode=OneWay}" Width="*"/>
                                    <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, Mode=OneWay}" Width="60"/>
                                    <DataGridTextColumn Header="Reserved" Binding="{Binding ReservedQuantity, Mode=OneWay}" Width="80"/>
                                    <DataGridTextColumn Header="Avail" Binding="{Binding AvailableQuantity, Mode=OneWay}" Width="70"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Grid.Row="4"
                                    Background="{DynamicResource InputBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Padding="10"
                                    Margin="0 12 0 0">
                                <StackPanel>
                                    <TextBlock Text="AR Picture Search" FontSize="18" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding BarcodeModeVm.VisualSearchSummary}"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0 4 0 8"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="8"/>
                                            <ColumnDefinition Width="130"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding BarcodeModeVm.VisualHint, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="34"
                                                 Padding="8 0"
                                                 VerticalContentAlignment="Center"
                                                 ToolTip="Optional hint, for example BMW headlight or brake sensor"/>
                                        <Button Grid.Column="2"
                                                Content="Search Picture"
                                                Command="{Binding BarcodeModeVm.SearchByPictureCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"/>
                                    </Grid>
                                    <DataGrid ItemsSource="{Binding BarcodeModeVm.VisualMatches}"
                                              SelectedItem="{Binding BarcodeModeVm.SelectedVisualMatch, Mode=TwoWay}"
                                              AutoGenerateColumns="False"
                                              CanUserAddRows="False"
                                              IsReadOnly="True"
                                              HeadersVisibility="Column"
                                              GridLinesVisibility="Horizontal"
                                              Height="118"
                                              Margin="0 8 0 0">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Code" Binding="{Binding InternalCode, Mode=OneWay}" Width="90"/>
                                            <DataGridTextColumn Header="Part" Binding="{Binding PartName, Mode=OneWay}" Width="*"/>
                                            <DataGridTextColumn Header="Avail" Binding="{Binding AvailableQuantity, Mode=OneWay}" Width="55"/>
                                            <DataGridTemplateColumn Header="" Width="60">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Use"
                                                                Command="{Binding DataContext.BarcodeModeVm.SelectVisualMatchCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Style="{StaticResource SecondaryButtonStyle}"
                                                                Padding="8 2"/>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Border>

                            <ScrollViewer Grid.Row="5" VerticalScrollBarVisibility="Auto" Margin="0 12 0 0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="90"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Qty" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBox Grid.Column="1"
                                                 Text="{Binding BarcodeModeVm.ActionQuantity, UpdateSourceTrigger=PropertyChanged}"
                                                 Height="34"
                                                 Padding="8 0"
                                                 VerticalContentAlignment="Center"/>
                                    </Grid>

                                    <TextBlock Text="Sell" FontWeight="SemiBold" Margin="0 14 0 6"/>
                                    <ComboBox ItemsSource="{Binding BarcodeModeVm.Warehouses}"
                                              SelectedValue="{Binding BarcodeModeVm.SellWarehouseId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Height="34"/>
                                    <Button Content="Sell Scanned Part"
                                            Command="{Binding BarcodeModeVm.SellPartCommand}"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            Margin="0 8 0 0"/>

                                    <TextBlock Text="Move Warehouse" FontWeight="SemiBold" Margin="0 16 0 6"/>
                                    <ComboBox ItemsSource="{Binding BarcodeModeVm.Warehouses}"
                                              SelectedValue="{Binding BarcodeModeVm.FromWarehouseId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Height="34"/>
                                    <ComboBox ItemsSource="{Binding BarcodeModeVm.Warehouses}"
                                              SelectedValue="{Binding BarcodeModeVm.ToWarehouseId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              DisplayMemberPath="Name"
                                              Height="34"
                                              Margin="0 6 0 0"/>
                                    <Button Content="Move Stock"
                                            Command="{Binding BarcodeModeVm.TransferPartCommand}"
                                            Style="{StaticResource SecondaryButtonStyle}"
                                            Margin="0 8 0 0"/>

                                    <TextBlock Text="Used Car" FontWeight="SemiBold" Margin="0 16 0 6"/>
                                    <ComboBox ItemsSource="{Binding BarcodeModeVm.UsedCars}"
                                              SelectedValue="{Binding BarcodeModeVm.SelectedUsedCarId, Mode=TwoWay}"
                                              SelectedValuePath="Id"
                                              Height="34">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock>
                                                    <Run Text="{Binding Car}"/>
                                                    <Run Text=" "/>
                                                    <Run Text="{Binding ModelYear}"/>
                                                </TextBlock>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <UniformGrid Columns="2" Margin="0 8 0 0">
                                        <Button Content="Attach"
                                                Command="{Binding BarcodeModeVm.AttachUsedCarCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="0 0 6 0"/>
                                        <Button Content="Detach"
                                                Command="{Binding BarcodeModeVm.DetachUsedCarCommand}"
                                                Style="{StaticResource SecondaryButtonStyle}"
                                                Margin="6 0 0 0"/>
                                    </UniformGrid>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Border>

                    <Border Grid.Column="4" Background="{DynamicResource CardBackgroundBrush}" CornerRadius="10" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="185"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="Labels" FontSize="20" FontWeight="SemiBold"/>
                                    <TextBlock Text="Preview and print sheet"
                                               FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                                </StackPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="Clear"
                                        Command="{Binding BarcodeModeVm.ClearLabelsCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Width="82"/>
                            </DockPanel>

                            <Border Grid.Row="1"
                                    Background="White"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10"
                                    Margin="0 14 0 12">
                                <Grid DataContext="{Binding BarcodeModeVm.PreviewLabel}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding PartCode}"
                                               FontSize="17"
                                               FontWeight="Bold"
                                               Foreground="Black"
                                               TextTrimming="CharacterEllipsis"/>
                                    <Grid Grid.Row="1" Margin="0 8 0 4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <ItemsControl ItemsSource="{Binding BarcodeModules}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Rectangle Width="{Binding Width}" Height="54" Fill="{Binding Fill}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            <TextBlock Text="{Binding BarcodeText}"
                                                       FontSize="10"
                                                       Foreground="Black"
                                                       HorizontalAlignment="Center"/>
                                        </StackPanel>
                                        <Image Grid.Column="1"
                                               Source="{Binding QrImage}"
                                               Width="64"
                                               Height="64"
                                               Margin="8 0 0 0"/>
                                    </Grid>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding PartName}"
                                               FontSize="11"
                                               Foreground="Black"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </Border>

                            <TextBlock Grid.Row="2"
                                       Text="Generated Sheet"
                                       FontWeight="SemiBold"
                                       Margin="0 0 0 8"/>

                            <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding BarcodeModeVm.Labels}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="220"
                                                    Height="150"
                                                    Background="White"
                                                    BorderBrush="#33000000"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="9"
                                                    Margin="0 0 8 8">
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Text="{Binding PartCode}"
                                                               FontWeight="Bold"
                                                               Foreground="Black"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <Grid Grid.Row="1" Margin="0 8 0 4">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <ItemsControl ItemsSource="{Binding BarcodeModules}">
                                                                <ItemsControl.ItemsPanel>
                                                                    <ItemsPanelTemplate>
                                                                        <StackPanel Orientation="Horizontal"/>
                                                                    </ItemsPanelTemplate>
                                                                </ItemsControl.ItemsPanel>
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate>
                                                                        <Rectangle Width="{Binding Width}" Height="48" Fill="{Binding Fill}"/>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                            <TextBlock Text="{Binding BarcodeText}"
                                                                       FontSize="9"
                                                                       Foreground="Black"
                                                                       HorizontalAlignment="Center"/>
                                                        </StackPanel>
                                                        <Image Grid.Column="1"
                                                               Source="{Binding QrImage}"
                                                               Width="54"
                                                               Height="54"
                                                               Margin="7 0 0 0"/>
                                                    </Grid>
                                                    <TextBlock Grid.Row="2"
                                                               Text="{Binding PartName}"
                                                               FontSize="10"
                                                               Foreground="Black"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <!-- ── Car Selection ── -->
            <Grid Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=CarSelection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.Background>
                    <VisualBrush Stretch="Uniform" AlignmentX="Center" AlignmentY="Center" Opacity="0.04">
                        <VisualBrush.Visual>
                            <Image Source="{Binding SelectedBrand.Logo}"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Grid.Background>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="20 20 20 10">
                    <Button Content="⟵ Back" Command="{Binding GoToHomeCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="100" Margin="0 0 20 0"/>
                    <Image Source="{Binding SelectedBrand.Logo}" Height="50" Margin="0 0 16 0"
                           Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <TextBlock Text="{Binding SelectedBrand.Name}" FontSize="26" FontWeight="Bold"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AvailableCars}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectCarCommand, ElementName=RootWindow}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Margin="8" Padding="0">
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            CornerRadius="8" Padding="10" Width="220">
                                        <StackPanel>
                                            <Image Source="{Binding Image}" Height="100"
                                                   Stretch="UniformToFill"
                                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" Margin="0 8 0 0"/>
                                            <TextBlock Text="{Binding BrandName}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ── Part Selection ── -->
            <Grid Margin="20" Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=PartSelection}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0 0 0 20">
                    <Button Content="⟵ Back to Cars" Command="{Binding GoToCarSelectionCommand}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Width="150" Margin="0 0 20 0"/>
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedCar.Name, TargetNullValue='Select a car'}"
                                   FontSize="22" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedCar.BrandName}" FontSize="12"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding AvailableParts}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SelectPartCommand, ElementName=RootWindow}"
                                        CommandParameter="{Binding}"
                                        Background="Transparent" BorderThickness="0"
                                        Margin="8" Padding="0">
                                    <Border Background="{DynamicResource CardBackgroundBrush}"
                                            CornerRadius="8" Padding="10" Width="260">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Code}" FontSize="14" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding Description}" FontSize="12"
                                                       TextWrapping="Wrap" Margin="0 4 0 0"/>
                                            <TextBlock Text="{Binding UnitPrice, StringFormat={}{0:N0} USD}"
                                                       FontSize="14" FontWeight="SemiBold" Margin="0 8 0 0"/>
                                        </StackPanel>
                                    </Border>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>

            <!-- ── POS Invoice Tabs ── -->
            <TabControl Margin="10"
                        Style="{StaticResource InvoiceTabControlStyle}"
                        ItemsSource="{Binding Tabs}"
                        SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                        ItemContainerStyle="{StaticResource InvoiceTabItemStyle}"
                        Visibility="{Binding ActiveScreen, Converter={StaticResource ScreenToVisibilityConverter}, ConverterParameter=Pos}">

                <TabControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Header}" FontSize="13" VerticalAlignment="Center"/>
                            <Button Content="✕"
                                    Command="{Binding DataContext.CloseTabCommand, ElementName=RootWindow}"
                                    CommandParameter="{Binding}"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    FontSize="11" Padding="8 0 0 0"
                                    VerticalAlignment="Center" Cursor="Hand">
                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                    </DataTemplate>
                </TabControl.ItemTemplate>
                <TabControl.ContentTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- ── Header ───────────────────────────────────────────────── -->
                            <DockPanel Grid.Row="0" Margin="20,20,20,10">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{Binding SaleModeTitle}" FontSize="26" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding SaleModeSubtitle}" FontSize="14"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 4 0 0"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <StackPanel.Style>
                                        <Style TargetType="StackPanel">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsLoadedFromSearch}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </StackPanel.Style>
                                    <Button ToolTip="Edit Invoice"
                                            Command="{Binding EditInvoiceCommand}"
                                            IsEnabled="{Binding IsEditEnabled}"
                                            Style="{StaticResource InvoiceIconButtonStyle}"
                                            Width="52"
                                            Height="52"
                                            Margin="0 0 8 0">
                                        <TextBlock Text="✎" FontSize="24" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button ToolTip="Save Invoice"
                                            Command="{Binding SaveInvoiceCommand}"
                                            IsEnabled="{Binding IsSaveEnabled}"
                                            Style="{StaticResource InvoiceIconButtonStyle}"
                                            Width="52"
                                            Height="52"
                                            Margin="0 0 8 0">
                                        <TextBlock Text="💾" FontSize="20"/>
                                    </Button>
                                    <Button ToolTip="Reset Invoice"
                                            Command="{Binding ResetInvoiceCommand}"
                                            IsEnabled="{Binding IsResetEnabled}"
                                            Style="{StaticResource InvoiceIconButtonStyle}"
                                            Width="52"
                                            Height="52"
                                            Margin="0 0 8 0">
                                        <TextBlock Text="↺" FontSize="24" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button ToolTip="Send invoice on WhatsApp"
                                            Command="{Binding SendWhatsAppInvoiceCommand}"
                                            IsEnabled="{Binding IsCommunicationEnabled}"
                                            Style="{StaticResource InvoiceIconButtonStyle}"
                                            Width="52"
                                            Height="52"
                                            Margin="0 0 8 0">
                                        <TextBlock Text="WA" FontSize="14" FontWeight="SemiBold"/>
                                    </Button>
                                    <Button ToolTip="Send SMS payment reminder"
                                            Command="{Binding SendSmsReminderCommand}"
                                            IsEnabled="{Binding IsCommunicationEnabled}"
                                            Style="{StaticResource InvoiceIconButtonStyle}"
                                            Width="52"
                                            Height="52">
                                        <TextBlock Text="SMS" FontSize="12" FontWeight="SemiBold"/>
                                    </Button>
                                </StackPanel>
                            </DockPanel>

                            <!-- ── Form card ─────────────────────────────────────────────── -->
                            <Border Grid.Row="1"
                    Background="{DynamicResource CardBackgroundBrush}"
                    CornerRadius="8" Padding="20" Margin="20,0,20,15"
                    IsEnabled="{Binding IsInvoiceContentEnabled}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="20" ShadowDepth="5"/>
                                </Border.Effect>

                                <StackPanel>

                                    <!-- Row 1: Customer + Warehouse -->
                                    <Grid Margin="0 0 0 16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="270"/>
                                        </Grid.ColumnDefinitions>

                                        <controls:CustomerSearchControl
                            Grid.Column="0"
                            SelectedCustomerId="{Binding CustomerId, Mode=TwoWay}"
                            VerticalAlignment="Top"/>

                                        <controls:WarehouseSearchControl
                            Grid.Column="4"
                            SelectedWarehouseId="{Binding WarehouseId, Mode=TwoWay}"
                            VerticalAlignment="Top"/>

                                        <controls:SaleDatePickerControl
                            Grid.Column="6"
                            Label="DATE"
                            PopupTitle="SELECT INVOICE DATE"
                            SelectedDate="{Binding InvoiceDate, Mode=TwoWay}"
                            VerticalAlignment="Top"/>
                                    </Grid>

                                    <Grid Margin="0 0 0 16">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="320"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="220"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Text="BASE RATE" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 0 6"/>
                                            <Border Background="#FF1A1A22" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Height="52" Padding="14 0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedCounterRate, StringFormat={}{0:N6}}" FontSize="15" FontWeight="SemiBold"/>
                                                    <TextBlock Text=" " FontSize="15"/>
                                                    <TextBlock Text="{Binding SelectedCurrencyCode}" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>

                                        <controls:CurrencyCodeSelectorControl
                                            Grid.Column="2"
                                            CurrencyCodes="{Binding CurrencyCodes}"
                                            SelectedCurrencyCode="{Binding SelectedCurrencyCode, Mode=TwoWay}"
                                            VerticalAlignment="Top"/>
                                    </Grid>

                                    <!-- Row 2: Part | Qty | Price | [Add] [Submit] -->
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <!-- Part search -->
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="88"/>
                                            <!-- Qty -->
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="120"/>
                                            <!-- Unit Price -->
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="130"/>
                                            <!-- Add button -->
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="180"/>
                                            <!-- Submit button -->
                                        </Grid.ColumnDefinitions>

                                        <!--
                            PartSearchControl
                            SelectedPartId          → NewPartId          (part FK for the invoice line)
                            SelectedPartPrice       → NewUnitPrice       (auto-fills price)
                            SelectedPartDescription → NewPartDescription  (stored so Description column shows)
                        -->
                                        <controls:PartSearchControl
                            Grid.Column="0"
                            SelectedPartId="{Binding NewPartId,          Mode=TwoWay}"
                            SelectedPartPrice="{Binding NewUnitPrice,     Mode=TwoWay}"
                            SelectedPartDescription="{Binding NewPartDescription, Mode=TwoWay}"
                            VerticalAlignment="Top"/>

                                        <!-- Qty pill -->
                                        <StackPanel Grid.Column="2" VerticalAlignment="Top">
                                            <TextBlock Text="QTY" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0 0 0 6"/>
                                            <Border Background="#FF1A1A22"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Height="52">
                                                <TextBox Text="{Binding NewQuantity, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="15"
                                         HorizontalContentAlignment="Center"
                                         VerticalContentAlignment="Center"
                                         Padding="8 0" CaretBrush="{DynamicResource AccentBrush}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center"
                                                                      HorizontalAlignment="Center"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Border>
                                        </StackPanel>

                                        <!-- Unit Price pill (auto-filled, cashier can override) -->
                                        <StackPanel Grid.Column="4" VerticalAlignment="Top">
                                            <TextBlock Text="UNIT PRICE" FontSize="11" FontWeight="Bold"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       Margin="0 0 0 6"/>
                                            <Border Background="#FF1A1A22"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="10" Height="52">
                                                <TextBox Text="{Binding NewUnitPrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                                         Background="Transparent" BorderThickness="0"
                                         Foreground="White" FontSize="15"
                                         HorizontalContentAlignment="Right"
                                         VerticalContentAlignment="Center"
                                         Padding="8 0" CaretBrush="{DynamicResource AccentBrush}">
                                                    <TextBox.Style>
                                                        <Style TargetType="TextBox">
                                                            <Setter Property="Template">
                                                                <Setter.Value>
                                                                    <ControlTemplate TargetType="TextBox">
                                                                        <ScrollViewer x:Name="PART_ContentHost"
                                                                      Margin="{TemplateBinding Padding}"
                                                                      VerticalAlignment="Center"/>
                                                                    </ControlTemplate>
                                                                </Setter.Value>
                                                            </Setter>
                                                        </Style>
                                                    </TextBox.Style>
                                                </TextBox>
                                            </Border>
                                        </StackPanel>

                                        <!--
                            ＋ Add button  — PrimaryButtonStyle (same glowing pill as Submit)
                            Height="52" matches the pill inputs above for perfect alignment
                        -->
                                        <Button Grid.Column="6"
                                Content="＋  Add Line"
                                Command="{Binding AddItemCommand}"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Height="52"
                                Margin="0,17,0,0"
                                VerticalAlignment="Top"/>

                                        <!-- Submit Invoice button -->
                                        <Button Grid.Column="8"
                                Content="✔  Submit Invoice"
                                Command="{Binding SubmitSaleCommand}" 
                                Height="52"
                                Margin="0,17,0,0"
                                VerticalAlignment="Top">
                                            <Button.Style>
                                                <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsModifyMode}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- ── Auto Posting Timeline ─────────────────────────────────── -->
                            <Border Grid.Row="2"
                                    CornerRadius="8"
                                    Background="{DynamicResource CardBackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    Padding="14"
                                    Margin="20,0,20,15"
                                    Visibility="{Binding HasPostingTimeline, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <DockPanel Margin="0 0 0 10">
                                        <TextBlock Text="Auto Posting Timeline"
                                                   FontSize="16"
                                                   FontWeight="Bold"
                                                   DockPanel.Dock="Left"/>
                                        <TextBlock Text="{Binding Header}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                   DockPanel.Dock="Right"/>
                                    </DockPanel>

                                    <ItemsControl ItemsSource="{Binding PostingTimeline}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="198"
                                                        MinHeight="118"
                                                        Margin="0 0 10 10"
                                                        Padding="12"
                                                        Background="{DynamicResource AppBackgroundBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                    <Grid>
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="Auto"/>
                                                            <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <DockPanel Grid.Row="0">
                                                            <Border x:Name="StepDot"
                                                                    Width="22"
                                                                    Height="22"
                                                                    CornerRadius="11"
                                                                    Background="#FF757575"
                                                                    DockPanel.Dock="Left">
                                                                <TextBlock Text="{Binding Sequence}"
                                                                           FontSize="11"
                                                                           FontWeight="Bold"
                                                                           Foreground="White"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"/>
                                                            </Border>
                                                            <Border x:Name="StatusBadge"
                                                                    Padding="7 2"
                                                                    BorderBrush="#66757575"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    HorizontalAlignment="Right"
                                                                    DockPanel.Dock="Right">
                                                                <TextBlock x:Name="StatusText"
                                                                           Text="{Binding Status}"
                                                                           FontSize="10"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </Border>
                                                        </DockPanel>

                                                        <TextBlock Grid.Row="1"
                                                                   Text="{Binding Title}"
                                                                   Margin="0 9 0 0"
                                                                   FontWeight="Bold"/>
                                                        <TextBlock Grid.Row="2"
                                                                   Text="{Binding OccurredAt, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                                   Margin="0 2 0 0"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                        <TextBlock Grid.Row="3"
                                                                   Text="{Binding Detail}"
                                                                   Margin="0 8 0 0"
                                                                   FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                    </Grid>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding Status}" Value="Complete">
                                                        <Setter TargetName="StepDot" Property="Background" Value="#FF4CAF50"/>
                                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#994CAF50"/>
                                                        <Setter TargetName="StatusText" Property="Foreground" Value="#FF81C784"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Status}" Value="Partial">
                                                        <Setter TargetName="StepDot" Property="Background" Value="#FFFFA000"/>
                                                        <Setter TargetName="StatusBadge" Property="BorderBrush" Value="#99FFA000"/>
                                                        <Setter TargetName="StatusText" Property="Foreground" Value="#FFFFCC80"/>
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!-- ── Items DataGrid ────────────────────────────────────────── -->
                            <Border Grid.Row="3" CornerRadius="8"
                    Background="{DynamicResource CardBackgroundBrush}"
                    Margin="20,0,20,0"
                    IsEnabled="{Binding IsInvoiceContentEnabled}">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.10" BlurRadius="15" ShadowDepth="3"/>
                                </Border.Effect>
                                <DataGrid ItemsSource="{Binding Items}"
                          AutoGenerateColumns="False" CanUserAddRows="False"
                          HeadersVisibility="Column" BorderThickness="0"
                          GridLinesVisibility="None"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.CanContentScroll="True">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Part #"
                                            Binding="{Binding PartId, Mode=OneWay}"
                                            Width="80"/>
                                        <DataGridTextColumn Header="Description"
                                            Binding="{Binding Description, Mode=OneWay}"
                                            Width="*"/>
                                        <DataGridTextColumn Header="Qty"
                                            Binding="{Binding Quantity}"
                                            Width="60"/>
                                        <DataGridTextColumn Header="Unit Price"
                                            Binding="{Binding UnitPrice, StringFormat={}{0:N0}}"
                                            Width="120"/>
                                        <DataGridTextColumn Header="Total"
                                            Binding="{Binding LineTotal, Mode=OneWay, StringFormat={}{0:N0}}"
                                            Width="110"
                                            FontWeight="Bold"/>
                                        <DataGridTextColumn Header="Base Amount"
                                            Binding="{Binding BaseAmount, Mode=OneWay, StringFormat={}{0:N0}}"
                                            Width="130"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Border>

                            <!-- ── Footer totals ─────────────────────────────────────────── -->
                            <Border Grid.Row="4" Margin="20,10,20,20" Padding="16 12">
                                <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TotalCounterLabel}" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBlock Text="{Binding TotalAmount, StringFormat={}{0:N0}}"
                               FontSize="14" FontWeight="SemiBold" Margin="0 0 30 0"/>

                                    <TextBlock Text="Base Amount:" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBlock Text="{Binding BaseAmountTotal, StringFormat={}{0:N0}}"
                               FontSize="14" FontWeight="SemiBold" Margin="0 0 30 0"/>

                                    <TextBlock Text="{Binding PaidCounterLabel}" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBox Text="{Binding PaidAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N0}}"
                             Width="150" FontSize="14" FontWeight="SemiBold"
                             Background="Transparent" BorderThickness="0 0 0 1"
                             IsEnabled="{Binding IsInvoiceContentEnabled}"
                             Margin="0 0 30 0"/>

                                    <TextBlock Text="Paid (Base):" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBlock Text="{Binding PaidAmountBase, StringFormat={}{0:N0}}"
                               FontSize="14" FontWeight="SemiBold" Margin="0 0 30 0"/>

                                    <TextBlock Text="{Binding RemainingCounterLabel}" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBlock Text="{Binding RemainingAmountUsd, StringFormat={}{0:N0}}"
                               FontSize="14" FontWeight="SemiBold" Margin="0 0 30 0"/>

                                    <TextBlock Text="Remaining (Base):" FontSize="14"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0 0 10 0"/>
                                    <TextBlock Text="{Binding RemainingAmountBase, StringFormat={}{0:N0}}"
                               FontSize="14" FontWeight="SemiBold" Margin="0 0 30 0"/>

                                    <Border Padding="12 10"
                                            Margin="0 8 0 0"
                                            Background="{DynamicResource CardBackgroundBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="10">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsLoadedFromSearch}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <WrapPanel VerticalAlignment="Center">
                                            <TextBlock Text="Issue Sale Payment"
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       VerticalAlignment="Center"
                                                       Margin="0 0 14 0"/>
                                            <TextBlock Text="Amount"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0 0 8 0"/>
                                            <TextBox Text="{Binding PaymentAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                                     Width="120"
                                                     FontSize="14"
                                                     FontWeight="SemiBold"
                                                     Background="Transparent"
                                                     BorderThickness="0 0 0 1"
                                                     Margin="0 0 14 0"/>
                                            <controls:SaleDatePickerControl
                                                Width="220"
                                                Label="PAYMENT DATE"
                                                PopupTitle="SELECT PAYMENT DATE"
                                                DisplayFormat="dd MMM yyyy"
                                                SelectedDate="{Binding PaymentDate, Mode=TwoWay}"
                                                Margin="0 0 14 0"/>
                                            <TextBlock Text="Method"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       Margin="0 0 8 0"/>
                                            <TextBox Text="{Binding PaymentMethod, UpdateSourceTrigger=PropertyChanged}"
                                                     Width="110"
                                                     FontSize="14"
                                                     Background="Transparent"
                                                     BorderThickness="0 0 0 1"
                                                     Margin="0 0 14 0"/>
                                            <Button Content="Post Payment"
                                                    Command="{Binding IssueSalePaymentCommand}"
                                                    IsEnabled="{Binding CanIssueSalePayment}"
                                                    Style="{StaticResource PrimaryButtonStyle}"
                                                    MinWidth="135"
                                                    Height="40"/>
                                        </WrapPanel>
                                    </Border>
                                </WrapPanel>
                            </Border>

                        </Grid>
                    </DataTemplate>
                </TabControl.ContentTemplate>


            </TabControl>

            <!-- ══ GLOBAL APP FEEDBACK CENTER ══ -->
            <Border HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0 0 24 24"
                    Width="430"
                    MaxHeight="260"
                    Background="#CC10141E"
                    CornerRadius="10"
                    Padding="12"
                    Panel.ZIndex="10">
                <StackPanel>
                    <DockPanel Margin="0 0 0 8">
                        <TextBlock Text="Activity Feed"
                                   FontSize="12"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   DockPanel.Dock="Left"/>
                        <Button Content="{Binding FeedToggleText}"
                                Command="{Binding ToggleFeedCommand}"
                                Style="{StaticResource SecondaryButtonStyle}"
                                Padding="10 4"
                                FontSize="11"
                                HorizontalAlignment="Right"
                                DockPanel.Dock="Right"/>
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  MaxHeight="220">
                        <ScrollViewer.Style>
                            <Style TargetType="ScrollViewer">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFeedVisible}" Value="False">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ScrollViewer.Style>
                        <ItemsControl ItemsSource="{Binding Notifications}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Text}" Margin="0 2 0 2" FontSize="12">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#FFE57373"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuccess}" Value="True">
                                                        <Setter Property="Foreground" Value="#FF81C784"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>


            <!-- ══ INVOICE SEARCH OVERLAY ══ -->
            <Grid Panel.ZIndex="18">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsInvoiceSearchOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <Border Background="#80000000"/>

                <Border Width="760"
                        MaxHeight="620"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource CardBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="20">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="0 0 0 12">
                            <TextBlock Text="Search Invoices"
                                       FontSize="24"
                                       FontWeight="Bold"
                                       DockPanel.Dock="Left"/>
                            <Button DockPanel.Dock="Right"
                                    Command="{Binding OpenInvoiceSearchCommand}"
                                    Content="✕"
                                    Style="{StaticResource SecondaryButtonStyle}"
                                    Width="40"
                                    Height="34"/>
                        </DockPanel>

                        <Grid Grid.Row="1" Margin="0 0 0 12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0"
                                     Text="{Binding InvoiceSearchText, UpdateSourceTrigger=PropertyChanged}"
                                     Height="40"
                                     FontSize="14"
                                     Padding="10"
                                     VerticalContentAlignment="Center"/>

                            <Button Grid.Column="1"
                                    Margin="8 0 0 0"
                                    Width="110"
                                    Height="40"
                                    Content="↻ Reload"
                                    Command="{Binding ReloadInvoiceSearchCommand}"
                                    Style="{StaticResource SecondaryButtonStyle}"/>
                        </Grid>

                        <DataGrid Grid.Row="2"
                                  Name="InvoiceSearchResultsGrid"
                                  ItemsSource="{Binding InvoiceSearchResults}"
                                  AutoGenerateColumns="False"
                                  MouseDoubleClick="InvoiceSearchResults_MouseDoubleClick"
                                  CanUserAddRows="False"
                                  HeadersVisibility="Column"
                                  IsReadOnly="True">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Invoice #" Binding="{Binding InvoiceNumber, Mode=OneWay}" Width="170"/>
                                <DataGridTextColumn Header="Date" Binding="{Binding InvoiceDate, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}" Width="120"/>
                                <DataGridTextColumn Header="Customer" Binding="{Binding CustomerId, Mode=OneWay}" Width="90"/>
                                <DataGridTextColumn Header="Warehouse" Binding="{Binding WarehouseId, Mode=OneWay}" Width="90"/>
                                <DataGridTextColumn Header="Currency" Binding="{Binding CounterCurrencyCode, Mode=OneWay}" Width="90"/>
                                <DataGridTextColumn Header="Total" Binding="{Binding TotalAmount, Mode=OneWay, StringFormat={}{0:N0}}" Width="120"/>
                                <DataGridTextColumn Header="Paid" Binding="{Binding PaidAmount, Mode=OneWay, StringFormat={}{0:N0}}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ══ MANAGEMENT OVERLAY — ZIndex 20, shown when IsManagementOpen=True ══ -->
            <Grid Panel.ZIndex="20">
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsManagementOpen}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <!-- Dim backdrop -->
                <Border Background="#AA000000"/>

                <!-- Panel -->
                <Border Background="{DynamicResource AppBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1 0 0 0"
                        HorizontalAlignment="Stretch">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Panel header bar -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBackgroundBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0 0 0 1" Padding="20 14">
                            <DockPanel>
                                <TextBlock Text="⚙  Management"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="White" VerticalAlignment="Center"
                                           DockPanel.Dock="Left"/>
                                <TextBlock Text="{Binding ManagementVm.Status}"
                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="16 0 0 0"
                                           DockPanel.Dock="Left"/>
                                <Button Content="✕  Close"
                                        Command="{Binding OpenManagementCommand}"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        HorizontalAlignment="Right"
                                        Padding="16 6"
                                        DockPanel.Dock="Right"/>
                            </DockPanel>
                        </Border>

                        <!-- Management tabs via DataTemplate (defined in Window.Resources above) -->
                        <ContentControl Grid.Row="1"
                                        Content="{Binding ManagementVm}"
                                        Margin="0"/>
                    </Grid>
                </Border>
            </Grid>

        </Grid><!-- end main content Grid -->

        <!-- ══ GLOBAL DATA LOADING PRELOADER ══ -->
        <Grid Grid.ColumnSpan="2" Panel.ZIndex="40">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGlobalLoading}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Background="{DynamicResource PreloaderOverlayBrush}"/>

            <Border Width="320"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource PreloaderCardBrush}"
                    BorderBrush="{DynamicResource PreloaderBorderBrush}"
                    BorderThickness="1.5"
                    CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24"
                                      ShadowDepth="0"
                                      Opacity="0.35"
                                      Color="#FF000000"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Syncing dashboard"
                               HorizontalAlignment="Center"
                               FontSize="16"
                               FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <ProgressBar IsIndeterminate="True"
                                 Height="10"
                                 Margin="0 16 0 0"
                                 Foreground="{DynamicResource AccentBrush}"
                                 Background="#22000000"/>
                    <TextBlock Text="Fetching latest inventory, pricing, and customer data..."
                               Margin="0 14 0 0"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontSize="13"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid><!-- end root Grid -->
</Window>
