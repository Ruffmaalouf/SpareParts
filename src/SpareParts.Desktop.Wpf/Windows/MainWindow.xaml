                                           FontSize="12"
                                           Foreground="{DynamicResource TextSecondaryBrush}">
                                    <Run Text="Parent: "/>
                                    <Run Text="{Binding ManagementVm.SelectedAccountingAccountParent, Mode=OneWay}"/>
                                </TextBlock>
                            </StackPanel>
